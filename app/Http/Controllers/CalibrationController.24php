                'STDs3' => $STDs3[$i] ?? null,
                'STDms3' => $STDms3[$i] ?? null,
                'STDm4' => $STDm4[$i] ?? null,
                'STDs4' => $STDs4[$i] ?? null,
                'STDms4' => $STDms4[$i] ?? null,
                'STDm5' => $STDm5[$i] ?? null,
                'STDs5' => $STDs5[$i] ?? null,
                'STDms5' => $STDms5[$i] ?? null,
                // UUT
                'UUTm1' => $UUTm1[$i] ?? null,
                'UUTs1' => $UUTs1[$i] ?? null,
                'UUTms1' => $UUTms1[$i] ?? null,
                'UUTm2' => $UUTm2[$i] ?? null,
                'UUTs2' => $UUTs2[$i] ?? null,
                'UUTms2' => $UUTms2[$i] ?? null,
                'UUTm3' => $UUTm3[$i] ?? null,
                'UUTs3' => $UUTs3[$i] ?? null,
                'UUTms3' => $UUTms3[$i] ?? null,
                'UUTm4' => $UUTm4[$i] ?? null,
                'UUTs4' => $UUTs4[$i] ?? null,
                'UUTms4' => $UUTms4[$i] ?? null,
                'UUTm5' => $UUTm5[$i] ?? null,
                'UUTs5' => $UUTs5[$i] ?? null,
                'UUTms5' => $UUTms5[$i] ?? null,
            ];
            
            DetailAbrationTester::create($detailData);
            \Log::info("✅ Detail saved for titik ukur {$i}", [
                'nominalRPM' => $detailData['nominalRPM'],
                'resolusi' => $detailData['resolusi']
            ]);
        }
        
        \Log::info('✅ storeAbrationTester completed', [
            'head_id' => $head->id,
            'detail_count' => 10
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('Error storeAbrationTester: ' . $e->getMessage());
        throw $e;
    }
}

private function updateAbrationTester($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateAbrationTester - Abration Tester Calibration', [
            'calibration_id' => $calibration->id,
            'new_certificate_id' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->nama_alat_final ?? $request->nama_alat ?? $calibration->nama_alat;
        
        // Ambil head abration tester untuk cek certificate_id
        $headAbrationTester = HeadAbrationTester::where('calibration_id', $calibration->id)->first();
        $currentCertificateId = $headAbrationTester->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->nama_alat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->nama_alat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE HEAD ABRATION TESTER
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        // Data untuk update head
        $headUpdateData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => $request->calibrationMethod ?? 'Metode Kalibrasi Abration Tester',
            'catatan' => $request->catatan ?? null,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headUpdateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headUpdateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($head = $calibration->headAbrationTester) {
            $head->update($headUpdateData);
            \Log::info('✅ HeadAbrationTester updated:', $headUpdateData);
        } else {
            // Jika head belum ada, buat baru
            $head = HeadAbrationTester::create(array_merge([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateIdBaru ?? $calibration->certificate_id,
            ], $headUpdateData));
            \Log::info('➕ HeadAbrationTester created baru:', ['head_id' => $head->id]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL ABRATION TESTER (DELETE & RECREATE 10 BARIS)
        // ==================================================================
        // Hapus data detail lama
        DetailAbrationTester::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records');
        
        // Ambil data dari form (ARRAY)
        $titikUkur = $request->titikUkur ?? [];
        $nominalRPM = $request->nominalRPM ?? [];
        $resolusi = $request->resolusi_alat ?? [];
        
        // Data STD (array)
        $STD1 = $request->STD1 ?? [];
        $STD2 = $request->STD2 ?? [];
        $STD3 = $request->STD3 ?? [];
        $STD4 = $request->STD4 ?? [];
        $STD5 = $request->STD5 ?? [];
        
        // Data STD terpisah
        $STDm1 = $request->STDm1 ?? [];
        $STDs1 = $request->STDs1 ?? [];
        $STDms1 = $request->STDms1 ?? [];
        $STDm2 = $request->STDm2 ?? [];
        $STDs2 = $request->STDs2 ?? [];
        $STDms2 = $request->STDms2 ?? [];
        $STDm3 = $request->STDm3 ?? [];
        $STDs3 = $request->STDs3 ?? [];
        $STDms3 = $request->STDms3 ?? [];
        $STDm4 = $request->STDm4 ?? [];
        $STDs4 = $request->STDs4 ?? [];
        $STDms4 = $request->STDms4 ?? [];
        $STDm5 = $request->STDm5 ?? [];
        $STDs5 = $request->STDs5 ?? [];
        $STDms5 = $request->STDms5 ?? [];
        
        // Data UUT
        $UUTm1 = $request->UUTm1 ?? [];
        $UUTs1 = $request->UUTs1 ?? [];
        $UUTms1 = $request->UUTms1 ?? [];
        $UUTm2 = $request->UUTm2 ?? [];
        $UUTs2 = $request->UUTs2 ?? [];
        $UUTms2 = $request->UUTms2 ?? [];
        $UUTm3 = $request->UUTm3 ?? [];
        $UUTs3 = $request->UUTs3 ?? [];
        $UUTms3 = $request->UUTms3 ?? [];
        $UUTm4 = $request->UUTm4 ?? [];
        $UUTs4 = $request->UUTs4 ?? [];
        $UUTms4 = $request->UUTms4 ?? [];
        $UUTm5 = $request->UUTm5 ?? [];
        $UUTs5 = $request->UUTs5 ?? [];
        $UUTms5 = $request->UUTms5 ?? [];
        
        $detailCount = 0;
        
        // Loop untuk 10 titik ukur
        for ($i = 0; $i < 10; $i++) {
            $detailData = [
                'calibration_id' => $calibration->id,
                'head_abration_tester_id' => $head->id,
                'nominalRPM' => $nominalRPM[$i] ?? null,
                'resolusi' => $resolusi[$i] ?? null,
                'titikUkur' => $titikUkur[$i] ?? null,
                // STD gabungan
                'STD1' => $STD1[$i] ?? null,
                'STD2' => $STD2[$i] ?? null,
                'STD3' => $STD3[$i] ?? null,
                'STD4' => $STD4[$i] ?? null,
                'STD5' => $STD5[$i] ?? null,
                // STD terpisah
                'STDm1' => $STDm1[$i] ?? null,
                'STDs1' => $STDs1[$i] ?? null,
                'STDms1' => $STDms1[$i] ?? null,
                'STDm2' => $STDm2[$i] ?? null,
                'STDs2' => $STDs2[$i] ?? null,
                'STDms2' => $STDms2[$i] ?? null,
                'STDm3' => $STDm3[$i] ?? null,
                'STDs3' => $STDs3[$i] ?? null,
                'STDms3' => $STDms3[$i] ?? null,
                'STDm4' => $STDm4[$i] ?? null,
                'STDs4' => $STDs4[$i] ?? null,
                'STDms4' => $STDms4[$i] ?? null,
                'STDm5' => $STDm5[$i] ?? null,
                'STDs5' => $STDs5[$i] ?? null,
                'STDms5' => $STDms5[$i] ?? null,
                // UUT
                'UUTm1' => $UUTm1[$i] ?? null,
                'UUTs1' => $UUTs1[$i] ?? null,
                'UUTms1' => $UUTms1[$i] ?? null,
                'UUTm2' => $UUTm2[$i] ?? null,
                'UUTs2' => $UUTs2[$i] ?? null,
                'UUTms2' => $UUTms2[$i] ?? null,
                'UUTm3' => $UUTm3[$i] ?? null,
                'UUTs3' => $UUTs3[$i] ?? null,
                'UUTms3' => $UUTms3[$i] ?? null,
                'UUTm4' => $UUTm4[$i] ?? null,
                'UUTs4' => $UUTs4[$i] ?? null,
                'UUTms4' => $UUTms4[$i] ?? null,
                'UUTm5' => $UUTm5[$i] ?? null,
                'UUTs5' => $UUTs5[$i] ?? null,
                'UUTms5' => $UUTms5[$i] ?? null,
            ];
            
            DetailAbrationTester::create($detailData);
            $detailCount++;
        }
        
        \Log::info('✅ DetailAbrationTester updated:', ['total_records' => $detailCount]);

        // ==================================================================
        // 3. UPDATE CALIBRATION (HANYA YANG PERLU)
        // ==================================================================
        $updateData = [];
        
        // Update certificate_id di calibration jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk calibration: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $updateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk calibration dari parameter: {$newCertificateId}");
        }
        
        // Update nama alat jika berubah (untuk keperluan generate certificate ID)
        if ($request->filled('nama_alat') && $request->nama_alat != $calibration->nama_alat) {
            $updateData['nama_alat'] = $request->nama_alat;
        }
        
        // Update calibrated_by dan verified_by
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated', array_keys($updateData));
        }

        // ==================================================================
        // 4. LOG HASIL AKHIR
        // ==================================================================
        $finalDetailCount = DetailAbrationTester::where('calibration_id', $calibration->id)->count();
        
        // Ambil head terbaru untuk cek certificate_id
        $finalHead = HeadAbrationTester::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📋 UPDATE SUMMARY (Abration Tester):', [
            'calibration_id' => $calibration->id,
            'certificate_id_calibration' => $calibration->certificate_id,
            'certificate_id_head' => $finalHead->certificate_id ?? null,
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'detail_records' => $finalDetailCount,
            'standard' => $alatStandarString,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updateAbrationTester COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateAbrationTester:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        throw $e;
    }
}

/**
 * Format bytes ke readable size
 */
private function formatBytes($bytes, $precision = 2)
{
    $units = ['B', 'KB', 'MB', 'GB', 'TB'];
    
    $bytes = max($bytes, 0);
    $pow = floor(($bytes ? log($bytes) : 0) / log(1024));
    $pow = min($pow, count($units) - 1);
    
    $bytes /= pow(1024, $pow);
    
    return round($bytes, $precision) . ' ' . $units[$pow];
}




// ==================================================================
// HELPER FUNCTIONS
// ==================================================================

/**
 * Ambil alat standar dari request (support array dan text)
 */
private function getAlatStandarFromRequest($request)
{
    // Coba ambil dari array dulu
    $alatStandar = $request->alat_standar ?? [];
    
    if (!empty($alatStandar) && is_array($alatStandar)) {
        return implode(', ', $alatStandar);
    }
    
    // Jika array kosong, coba dari text
    if ($request->filled('alat_standar_text')) {
        return $request->alat_standar_text;
    }
    
    // Coba dari field lain
    if ($request->filled('alatStandar')) {
        return $request->alatStandar;
    } 
    
    return '';
}

/**
 * Simpan Head Thermohygrometer
 */
private function saveHeadThermohygrometer($calibrationId, $certificateId, $standard, $method)
{
    // Cek apakah head sudah ada (untuk update scenario)
    $headThermohygrometer = \App\Models\HeadThermohygrometer::where('calibration_id', $calibrationId)->first();
    
    if ($headThermohygrometer) {
        // Update head yang sudah ada
        $headThermohygrometer->update([
            'standard' => $standard,
            'calibrationMethod' => $method,
            'certificate_id' => $certificateId,
        ]);
        \Log::info('✅ Updated existing HeadThermohygrometer');
    } else {
        // Buat head baru
        \App\Models\HeadThermohygrometer::create([
            'calibration_id' => $calibrationId,
            'certificate_id' => $certificateId,
            'standard' => $standard,
            'calibrationMethod' => $method,
        ]);
        \Log::info('✅ Created new HeadThermohygrometer');
    }
}

/**
 * Simpan detail untuk type IN/OUT (7 baris)
 */
private function saveInOutDetails($request, $calibration)
{
    $detailCount = 0;
    \Log::info('Processing IN/OUT data (7 rows)...');
    
    for ($i = 0; $i < 7; $i++) {
        $tempData = $request->input("temp.{$i}", []);
        $humidityData = $request->input("humidity.{$i}", []);
        
        // Debug log
        \Log::debug("IN/OUT Row {$i}", [
            'temp' => $tempData,
            'humidity' => $humidityData
        ]);
        
        // Cek apakah ada data untuk baris ini
        $hasTempData = !empty(array_filter($tempData, function($value) {
            return $value !== null && $value !== '' && $value !== 'null';
        }));
        
        $hasHumidityData = !empty(array_filter($humidityData, function($value) {
            return $value !== null && $value !== '' && $value !== 'null';
        }));
        
        if ($hasTempData || $hasHumidityData) {
            try {
                \App\Models\DetailThermohygrometer::create([
                    'calibration_id' => $calibration->id,
                    
                    // Data Temperatur
                    'titikUkur_T' => $tempData['set_point'] ?? null,
                    'T_STD1' => $tempData['std_x1'] ?? null,
                    'T_STD2' => $tempData['std_x2'] ?? null,
                    'T_STD3' => $tempData['std_x3'] ?? null,
                    'T_IN1' => $tempData['in_x1'] ?? null,
                    'T_IN2' => $tempData['in_x2'] ?? null,
                    'T_IN3' => $tempData['in_x3'] ?? null,
                    'T_OUT1' => $tempData['out_x1'] ?? null,
                    'T_OUT2' => $tempData['out_x2'] ?? null,
                    'T_OUT3' => $tempData['out_x3'] ?? null,
                    
                    // Data Kelembaban
                    'titikUkur_RH' => $humidityData['set_point'] ?? null,
                    'RH_STD1' => $humidityData['std_x1'] ?? null,
                    'RH_STD2' => $humidityData['std_x2'] ?? null,
                    'RH_STD3' => $humidityData['std_x3'] ?? null,
                    'RH_ALAT1' => $humidityData['alat_x1'] ?? null,
                    'RH_ALAT2' => $humidityData['alat_x2'] ?? null,
                    'RH_ALAT3' => $humidityData['alat_x3'] ?? null,
                ]);
                
                $detailCount++;
                \Log::debug("✅ Saved IN/OUT row {$i}");
                
            } catch (\Exception $e) {
                \Log::error("❌ Failed to save IN/OUT row {$i}: " . $e->getMessage());
            }
        } else {
            \Log::debug("⏭️ Skipping IN/OUT row {$i} - no data");
        }
    }
    
    return $detailCount;
}

/**
 * Simpan detail untuk type SINGLE (10 baris)
 */
private function saveSingleDetails($request, $calibration)
{
    $detailCount = 0;
    \Log::info('Processing SINGLE data (10 rows)...');
    
    for ($i = 1; $i <= 10; $i++) {
        // Cek apakah ada data untuk baris ini
        $hasTempData = $request->filled("t_set{$i}") || 
                      $request->filled("t_std{$i}_1") ||
                      $request->filled("t_inst{$i}_1");
        
        $hasHumidityData = $request->filled("h_set{$i}") || 
                          $request->filled("h_std{$i}_1") ||
                          $request->filled("h_inst{$i}_1");
        
        if ($hasTempData || $hasHumidityData) {
            try {
                \App\Models\DetailThermohygrometer::create([
                    'calibration_id' => $calibration->id,
                    
                    // Data Temperatur
                    'titikUkur_T' => $this->formatNumericValue($request->input("t_set{$i}")),
                    'T_STD1' => $this->formatNumericValue($request->input("t_std{$i}_1")),
                    'T_STD2' => $this->formatNumericValue($request->input("t_std{$i}_2")),
                    'T_STD3' => $this->formatNumericValue($request->input("t_std{$i}_3")),
                    'T_IN1' => null,  // DIKOSONGKAN untuk type single
                    'T_IN2' => null,  // DIKOSONGKAN untuk type single
                    'T_IN3' => null,  // DIKOSONGKAN untuk type single
                    'T_OUT1' => null, // DIKOSONGKAN untuk type single
                    'T_OUT2' => null, // DIKOSONGKAN untuk type single
                    'T_OUT3' => null, // DIKOSONGKAN untuk type single
                    
                    // Data Kelembaban
                    'titikUkur_RH' => $this->formatNumericValue($request->input("h_set{$i}")),
                    'RH_STD1' => $this->formatNumericValue($request->input("h_std{$i}_1")),
                    'RH_STD2' => $this->formatNumericValue($request->input("h_std{$i}_2")),
                    'RH_STD3' => $this->formatNumericValue($request->input("h_std{$i}_3")),
                    'RH_ALAT1' => $this->formatNumericValue($request->input("h_inst{$i}_1")),
                    'RH_ALAT2' => $this->formatNumericValue($request->input("h_inst{$i}_2")),
                    'RH_ALAT3' => $this->formatNumericValue($request->input("h_inst{$i}_3")),
                ]);
                
                $detailCount++;
                \Log::debug("✅ Saved SINGLE row {$i} (T_IN/T_OUT fields nulled)");
                
            } catch (\Exception $e) {
                \Log::error("❌ Failed to save SINGLE row {$i}: " . $e->getMessage());
            }
        } else {
            \Log::debug("⏭️ Skipping SINGLE row {$i} - no data");
        }
    }
    
    return $detailCount;
}

/**
 * Simpan data tambahan ke calibration
 */
private function saveAdditionalCalibrationData($calibration, $request, $alatStandarString)
{
    $additionalData = [];
    
    if ($request->filled('calibrated_by')) {
        $additionalData['calibrated_by'] = $request->calibrated_by;
        \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
    }
    
    if ($request->filled('verified_by')) {
        $additionalData['verified_by'] = $request->verified_by;
        \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
    }
    
    if ($request->filled('uncertainty')) {
        $additionalData['uncertainty'] = $request->uncertainty;
        $additionalData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
    }
    
    // Tanggal kalibrasi jika ada
    if ($request->filled('calibration_date')) {
        try {
            $additionalData['calibration_date'] = \Carbon\Carbon::parse($request->calibration_date);
        } catch (\Exception $e) {
            \Log::warning('⚠️ Invalid calibration date: ' . $e->getMessage());
        }
    }
    
    // Simpan alat standar ke calibration
    if (!empty($alatStandarString)) {
        $additionalData['alat_standar'] = $alatStandarString;
    }
    
    if ($request->filled('calibration_method')) {
        $additionalData['calibration_method'] = $request->calibration_method;
    }
    
    if (!empty($additionalData)) {
        $calibration->update($additionalData);
        \Log::info('✅ Additional data saved to calibration');
    }
}

/**
 * Log summary
 */
private function logStoreSummary($calibration, $type, $certificateId, $detailCount, $alatStandarString, $calibrationMethod)
{
    $savedDetailCount = \App\Models\DetailThermohygrometer::where('calibration_id', $calibration->id)->count();
    
    \Log::info('📋 STORE SUMMARY (Thermohygrometer):', [
        'calibration_id' => $calibration->id,
        'type' => $type,
        'detail_records' => $savedDetailCount,
        'certificate_id' => $certificateId,
        'alat_standar' => $alatStandarString,
        'calibration_method' => $calibrationMethod,
        'calibrated_by' => $calibration->calibrated_by ?? null,
        'verified_by' => $calibration->verified_by ?? null,
        'uncertainty' => $calibration->uncertainty ?? null,
    ]);
    
    // Validasi jika ada mismatch
    if ($detailCount !== $savedDetailCount) {
        \Log::warning("⚠️ Mismatch: Saved {$detailCount} records but {$savedDetailCount} in database");
    }
}

private function generateCertificateIdFromNamaAlat($namaAlat)
{
    try {
        // ======================================================
        // BERSIHKAN NAMA ALAT UNTUK CERTIFICATE ID
        // ======================================================
        
        // 1. Trim spasi
        $cleanNamaAlat = trim($namaAlat);
        
        // 2. Hapus karakter yang tidak valid untuk certificate ID
        //    Hanya izinkan: huruf, angka, spasi, tanda minus
        $cleanNamaAlat = preg_replace('/[^\w\s\-]/', '', $cleanNamaAlat);
        
        // 3. Ganti spasi berlebih dengan satu spasi
        $cleanNamaAlat = preg_replace('/\s+/', ' ', $cleanNamaAlat);
        
        // 4. Jika nama alat adalah "MANUAL_INPUT", cari nilai sebenarnya
        if ($cleanNamaAlat === 'MANUAL_INPUT') {
            // Coba ambil dari request jika ada (misalnya dari hidden field)
            if (request()->has('nama_alat_manual') && !empty(request()->nama_alat_manual)) {
                $cleanNamaAlat = trim(request()->nama_alat_manual);
            } elseif (request()->has('nama_alat_final') && !empty(request()->nama_alat_final)) {
                $cleanNamaAlat = trim(request()->nama_alat_final);
            } else {
                $cleanNamaAlat = 'CUSTOM_ALAT';
            }
        }
        
        // 5. Jika masih kosong setelah pembersihan
        if (empty($cleanNamaAlat)) {
            $cleanNamaAlat = 'UNKNOWN_ALAT';
        }
        
        \Log::info('🧹 Cleaned nama alat for certificate ID:', [
            'original' => $namaAlat,
            'cleaned' => $cleanNamaAlat
        ]);
        
        // ======================================================
        // GENERATE NOMOR URUT UNIK
        // ======================================================
        
        // Gunakan total count SEMUA calibration, bukan berdasarkan nama alat
        // Ini untuk memastikan nomor urut selalu unik di seluruh sistem
        $count = Calibration::count() + 1;
        $formattedNumber = str_pad($count, 5, '0', STR_PAD_LEFT);
        
        // Tahun 2 digit terakhir
        $currentYear = date('y');
        
        // ======================================================
        // FORMAT CERTIFICATE ID (PERTAHANKAN FORMAT ASLI)
        // ======================================================
        
        // Format: PAS-(XXXXX)-KXX-NAMAALAT
        $certificateId = "PAS-{$formattedNumber}-K{$currentYear}-{$cleanNamaAlat}";
        
        \Log::info('📄 Generated Certificate ID:', [
            'nama_alat_input' => $namaAlat,
            'nama_alat_cleaned' => $cleanNamaAlat,
            'count' => $count,
            'formatted_number' => $formattedNumber,
            'year' => $currentYear,
            'certificate_id' => $certificateId
        ]);
        
        return $certificateId;

    } catch (\Exception $e) {
        \Log::error('💥 Error generating certificate ID:', [
            'error' => $e->getMessage(),
            'nama_alat' => $namaAlat,
            'trace' => $e->getTraceAsString()
        ]);
        
        // Emergency fallback - tetap pertahankan format
        $timestamp = substr(time(), -6);
        $formattedNumber = str_pad($timestamp, 5, '0', STR_PAD_LEFT);
        $currentYear = date('y');
        
        // Gunakan nama alat asli atau default
        $fallbackNama = !empty($namaAlat) ? $namaAlat : 'ALAT';
        $fallbackNama = preg_replace('/[^\w\s\-]/', '', $fallbackNama);
        $fallbackNama = preg_replace('/\s+/', ' ', $fallbackNama);
        
        return "PAS-({$formattedNumber})-K{$currentYear}-{$fallbackNama}";
    }
}


    private function generateCertificateId($namaAlat)
    {
        try {
            // Gunakan count dari records yang ada + 1
            $count = Calibration::count() + 1;
            $formattedNumber = str_pad($count, 5, '0', STR_PAD_LEFT);
            $lastDigit = substr($count, -1);
            $currentYear = date('y');
            
            $certificateId = "PAS-{$formattedNumber}-K{$currentYear}-{$namaAlat}";

            // \Log::info('📄 Generated Certificate ID:', [
            //     'count' => $count,
            //     'certificate_id' => $certificateId
            // ]);

            return $certificateId;

        } catch (\Exception $e) {
            \Log::error('💥 Error generating certificate ID:', ['error' => $e->getMessage()]);
            
            // Emergency fallback dengan timestamp
            $timestamp = time();
            return "PAS-EMG-{$timestamp}-{$namaAlat}";
        }
    }

