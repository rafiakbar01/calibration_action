                $sheet->setCellValue('B13', $calibration->tanggalKalibrasi ? date('d-m-Y', strtotime($calibration->tanggalKalibrasi)) : '');
                
                $sheet->setCellValue('B15', $calibration->tempatKalibrasi ?? '');
                $sheet->setCellValue('B14', $calibration->jenisPembacaan ?? '');
                $sheet->setCellValue('B11', $calibration->pemilikAlat ?? '');
                $sheet->setCellValue('B16', $calibration->lokasiPT ?? '');
                $sheet->setCellValue('B19', $calibration->kode_th ?? '');
                
                // Suhu & RH
                $sheet->setCellValue('B22', $calibration->RT_condition1 ?? '');
                $sheet->setCellValue('C22', $calibration->RT_condition2 ?? '');
                $sheet->setCellValue('D22', $calibration->RT_condition3 ?? '');
                $sheet->setCellValue('B23', $calibration->RH_condition1 ?? '');
                $sheet->setCellValue('C23', $calibration->RH_condition2 ?? '');
                $sheet->setCellValue('D23', $calibration->RH_condition3 ?? '');
                
                // Calibrated & Verified by
                $sheet->setCellValue('B45', $calibration->calibratedBy ?? '');
                $sheet->setCellValue('B46', $calibration->verifiedBy ?? '');
            }
            
            // ==============================================================
            // HEAD DATA KHUSUS DEPTH MICROMETER PER FORM
            // Data ini diambil dari HeadDepthMicrometer (per form)
            // ==============================================================
            if ($head) {
                // === DATA DARI HEAD DEPTH MICROMETER ===
                // Range Min & Max (dari head)
                $sheet->setCellValue('B7', $head->range_min ?? '');
                $sheet->setCellValue('B8', $head->range_max ?? '');
                
                // Kapasitas & Resolusi (dari head)
                $sheet->setCellValue('B9', $head->kapasitas ?? '');
                $sheet->setCellValue('B10', $head->resolusi ?? '');
                
                // Alat Standar & Metode Kalibrasi
                $sheet->setCellValue('B43', $head->standard ?? '');
                $sheet->setCellValue('B44', $head->calibrationMethod ?? '');
                
                // Satuan Unit (jika ada di head)
                $sheet->setCellValue('B24', $head->satuan_unit ?? 'mm');
                
                \Log::info("Form {$formIndex}: Head data filled from HeadDepthMicrometer", [
                    'range_min' => $head->range_min ?? 'not set',
                    'range_max' => $head->range_max ?? 'not set',
                    'kapasitas' => $head->kapasitas ?? 'not set',
                    'resolusi' => $head->resolusi ?? 'not set',
                    'standard' => $head->standard ?? 'not set',
                    'calibrationMethod' => $head->calibrationMethod ?? 'not set',
                    'satuan_unit' => $head->satuan_unit ?? 'mm',
                ]);
            } else {
                \Log::warning("Form {$formIndex}: No head data found, using empty values");
                
                // Set empty values jika head tidak ditemukan
                $sheet->setCellValue('B7',  '');
                $sheet->setCellValue('B8',  '');
                $sheet->setCellValue('B9',  '');
                $sheet->setCellValue('B10', '');
                $sheet->setCellValue('B43', '');
                $sheet->setCellValue('B44', '');
                $sheet->setCellValue('B24', 'mm');
            }
            
            // ==============================================================
            // DETAIL DATA (baris mulai 27) PER FORM
            // ==============================================================
            if ($formDetails && $formDetails->count() > 0) {
                $sortedDetails = $formDetails->sortBy('id');
                $row = 27;
                foreach ($sortedDetails as $index => $detail) {
                    if ($index >= 20) break;
                    
                    $sheet->setCellValue('A' . $row, $detail->titikUkur ?? '');
                    $sheet->setCellValue('B' . $row, $detail->ulangan01 ?? '');
                    $sheet->setCellValue('C' . $row, $detail->ulangan02 ?? '');
                    $sheet->setCellValue('D' . $row, $detail->ulangan03 ?? '');
                    $sheet->setCellValue('E' . $row, $detail->ulangan04 ?? '');
                    $sheet->setCellValue('F' . $row, $detail->ulangan05 ?? '');
                    
                    $row++;
                }
                \Log::info("Form {$formIndex}: Filled {$formDetails->count()} detail rows");
            } else {
                \Log::warning("Form {$formIndex}: No detail data found");
            }
        }
        
        // ==================================================================
        // OPTIMASI UNTUK PRESERVE MACRO
        // ==================================================================
        $spreadsheet->setActiveSheetIndex(0);
        $spreadsheet->garbageCollect();
        
        $calculationEngine = \PhpOffice\PhpSpreadsheet\Calculation\Calculation::getInstance($spreadsheet);
        $calculationEngine->setCalculationCacheEnabled(false);
        $calculationEngine->clearCalculationCache();
        
        $writer = new \PhpOffice\PhpSpreadsheet\Writer\Xlsx($spreadsheet);
        $writer->setPreCalculateFormulas(false);
        $writer->save($filePath);
        
        \Log::info('SUKSES! Data Depth Micrometer berhasil diisi ke Excel', [
            'calibration_id' => $calibration->id,
            'total_forms' => $jumlahForm,
            'sheets_processed' => $jumlahForm
        ]);
        
    } catch (Exception $e) {
        \Log::error('Error fillDepthMicrometerExcel: ' . $e->getMessage(), [
            'calibration_id' => $calibration->id ?? null,
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}


       public function fillThermometerExcel($filePath, $calibration)
{
    try {
        \Log::info('Mengisi data Excel untuk Thermometer', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $calibration->jumlah_form ?? 1
        ]);

        $spreadsheet = \PhpOffice\PhpSpreadsheet\IOFactory::load($filePath);
        
        // Ambil jumlah form
        $jumlahForm = $calibration->jumlah_form ?? 1;
        $jumlahForm = max(1, $jumlahForm);
        
        // Ambil data dengan query langsung ke model
        $allHeads = \App\Models\HeadThermometer::where('calibration_id', $calibration->id)->get();
        $allDetails = \App\Models\DetailThermometer::where('calibration_id', $calibration->id)->orderBy('id', 'asc')->get();
        
        // Kelompokkan data per form index
        $headsByForm = [];
        foreach ($allHeads as $head) {
            if ($head && isset($head->form_index)) {
                $headsByForm[$head->form_index] = $head;
            }
        }
        
        $detailsByForm = [];
        foreach ($allDetails as $detail) {
            if ($detail && isset($detail->form_index)) {
                if (!isset($detailsByForm[$detail->form_index])) {
                    $detailsByForm[$detail->form_index] = collect();
                }
                $detailsByForm[$detail->form_index]->push($detail);
            }
        }
        
        \Log::info('📊 Data grouped by form', [
            'heads_found' => array_keys($headsByForm),
            'details_found' => array_keys($detailsByForm),
            'jumlah_form_dari_calibration' => $jumlahForm
        ]);
        
        // ==================================================================
        // LOOPING UNTUK SETIAP FORM INDEX (1 sampai jumlahForm)
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            // Tentukan nama sheet
            $sheetName = ($formIndex == 1) ? 'ACTION' : "ACTION ({$formIndex})";
            
            // Coba ambil sheet, jika tidak ada maka buat
            $sheet = $spreadsheet->getSheetByName($sheetName);
            
            if (!$sheet) {
                // Jika sheet tidak ada, clone dari sheet ACTION
                $sourceSheet = $spreadsheet->getSheetByName('ACTION');
                if ($sourceSheet) {
                    $newSheet = clone $sourceSheet;
                    $newSheet->setTitle($sheetName);
                    $spreadsheet->addSheet($newSheet);
                    $sheet = $newSheet;
                    \Log::info("Created new sheet: {$sheetName}");
                } else {
                    throw new \Exception("Sheet 'ACTION' tidak ditemukan di template Thermometer");
                }
            }
            
            // Ambil head untuk form ini
            $head = $headsByForm[$formIndex] ?? null;
            
            // Ambil details untuk form ini
            $formDetails = $detailsByForm[$formIndex] ?? collect();
            
            \Log::info("📝 Processing form index {$formIndex}", [
                'sheet_name' => $sheetName,
                'has_head' => !is_null($head),
                'details_count' => $formDetails->count()
            ]);
            
            // ==============================================================
            // DATA UMUM DARI TABEL CALIBRATION (HANYA UNTUK FORM 1)
            // ==============================================================
            if ($formIndex == 1) {
                $sheet->setCellValue('B1',  $calibration->id ?? '');
                $sheet->setCellValue('E1',  $head->certificate_id ?? $calibration->certificate_id ?? '');
                $sheet->setCellValue('B2',  $calibration->namaAlat ?? '');
                $sheet->setCellValue('B3',  $calibration->brandAlat ?? '');
                $sheet->setCellValue('B5',  $calibration->typeAlat ?? '');
                $sheet->setCellValue('B6',  $calibration->NoSeri ?? '');
                $sheet->setCellValue('B4',  $calibration->kodeAlat ?? '');
                $sheet->setCellValue('B18', $calibration->keterangan ?? '');
                $sheet->setCellValue('B17', $calibration->kondisiAlat ?? '');
                
                $sheet->setCellValue('B12', $calibration->tanggalMasuk ? date('d-m-Y', strtotime($calibration->tanggalMasuk)) : '');
                $sheet->setCellValue('B13', $calibration->tanggalKalibrasi ? date('d-m-Y', strtotime($calibration->tanggalKalibrasi)) : '');
                
                $sheet->setCellValue('B15', $calibration->tempatKalibrasi ?? '');
                $sheet->setCellValue('B14', $calibration->jenisPembacaan ?? '');
                $sheet->setCellValue('B11', $calibration->pemilikAlat ?? '');
                $sheet->setCellValue('B16', $calibration->lokasiPT ?? '');
                $sheet->setCellValue('B19', $calibration->kode_th ?? '');
                
                // Suhu & RH
                $sheet->setCellValue('B22', $calibration->RT_condition1 ?? '');
                $sheet->setCellValue('C22', $calibration->RT_condition2 ?? '');
                $sheet->setCellValue('D22', $calibration->RT_condition3 ?? '');
                $sheet->setCellValue('B23', $calibration->RH_condition1 ?? '');
                $sheet->setCellValue('C23', $calibration->RH_condition2 ?? '');
                $sheet->setCellValue('D23', $calibration->RH_condition3 ?? '');
                
                // Calibrated & Verified by
                $sheet->setCellValue('B67', $calibration->calibratedBy ?? '');
                $sheet->setCellValue('B68', $calibration->verifiedBy ?? '');
            }
            
            // ==============================================================
            // HEAD DATA KHUSUS THERMOMETER PER FORM
            // Data ini diambil dari HeadThermometer (per form)
            // ==============================================================
            if ($head) {
                // === DATA DARI HEAD THERMOMETER ===
                // Range Min & Max (dari head)
                $sheet->setCellValue('B7', $head->rentang_ukur_min ?? '');
                $sheet->setCellValue('B8', $head->rentang_ukur_max ?? '');
                
                // Kapasitas & Resolusi (dari head)
                $sheet->setCellValue('B9', $head->kapasitas ?? '');
                $sheet->setCellValue('B10', $head->resolusi ?? '');
                
                // Alat Standar & Metode Kalibrasi
                $sheet->setCellValue('B65', $head->standard ?? '');
                $sheet->setCellValue('B66', $head->calibrationMethod ?? '');
                
                // Satuan Suhu Kiri & Kanan
                $sheet->setCellValue('B24', $head->satuan_suhu_kiri ?? ' ');
                $sheet->setCellValue('E24', $head->satuan_suhu_kanan ?? ' ');
                
                \Log::info("Form {$formIndex}: Head data filled from HeadThermometer", [
                    'range_min' => $head->range_min ?? 'not set',
                    'range_max' => $head->range_max ?? 'not set',
                    'kapasitas' => $head->kapasitas ?? 'not set',
                    'resolusi' => $head->resolusi ?? 'not set',
                    'standard' => $head->standard ?? 'not set',
                    'calibrationMethod' => $head->calibrationMethod ?? 'not set',
                    'satuan_suhu_kiri' => $head->satuan_suhu_kiri ?? ' ',
                    'satuan_suhu_kanan' => $head->satuan_suhu_kanan ?? ' ',
                ]);
            } else {
                \Log::warning("Form {$formIndex}: No head data found, using empty values");
                
                // Set empty values jika head tidak ditemukan
                $sheet->setCellValue('B7',  '');
                $sheet->setCellValue('B8',  '');
                $sheet->setCellValue('B9',  '');
                $sheet->setCellValue('B10', '');
                $sheet->setCellValue('B65', '');
                $sheet->setCellValue('B66', '');
                $sheet->setCellValue('B24', '°C');
                $sheet->setCellValue('E24', '°C');
            }
            
            // ==============================================================
            // DETAIL DATA PER FORM (mulai baris 28, loncat 3 baris per titik ukur)
            // ==============================================================
            if ($formDetails && $formDetails->count() > 0) {
                $sortedDetails = $formDetails->sortBy('id');
                $row = 28;
                
                foreach ($sortedDetails as $index => $detail) {
                    if ($index >= 12) break;
                    
                    $sheet->setCellValue('A' . $row, $detail->titikUkur ?? '');
                    $sheet->setCellValue('B' . $row, $detail->STD01 ?? '');
                    $sheet->setCellValue('C' . $row, $detail->UUT01 ?? '');
                    
                    $sheet->setCellValue('A' . ($row + 1), '');
                    $sheet->setCellValue('B' . ($row + 1), $detail->STD02 ?? '');
                    $sheet->setCellValue('C' . ($row + 1), $detail->UUT02 ?? '');
                    
                    $sheet->setCellValue('A' . ($row + 2), '');
                    $sheet->setCellValue('B' . ($row + 2), $detail->STD03 ?? '');
                    $sheet->setCellValue('C' . ($row + 2), $detail->UUT03 ?? '');
                    
                    $row += 3;
                }
                
                \Log::info("Form {$formIndex}: Filled {$formDetails->count()} detail rows");
            } else {
                \Log::warning("Form {$formIndex}: No detail data found");
            }
        }
        
        // ==================================================================
        // OPTIMASI UNTUK PRESERVE MACRO
        // ==================================================================
        $spreadsheet->setActiveSheetIndex(0);
        $spreadsheet->garbageCollect();
        
        $calculationEngine = \PhpOffice\PhpSpreadsheet\Calculation\Calculation::getInstance($spreadsheet);
        $calculationEngine->setCalculationCacheEnabled(false);
        $calculationEngine->clearCalculationCache();
        
        $writer = new \PhpOffice\PhpSpreadsheet\Writer\Xlsx($spreadsheet);
        $writer->setPreCalculateFormulas(false);
        $writer->save($filePath);
        
        \Log::info('SUKSES! Data Thermometer berhasil diisi ke Excel', [
            'calibration_id' => $calibration->id,
            'total_forms' => $jumlahForm,
            'sheets_processed' => $jumlahForm
        ]);
        
    } catch (Exception $e) {
        \Log::error('Error fillThermometerExcel: ' . $e->getMessage(), [
            'calibration_id' => $calibration->id ?? null,
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

       public function downloadVerified($id)
        {
            try {
                \Log::info('🟢 START DOWNLOAD VERIFIED');
        
                $calibration = Calibration::findOrFail($id);
        
                if ($calibration->status !== 'verified') {
                    return back()->with('error', 'File hanya bisa di-download saat status Verified.');
                }
        
                if (empty($calibration->location_data)) {
                    return back()->with('error', 'File verified belum tersedia.');
                }
        
                // === UPDATE approved DAN SAVE NAMA SESSION LOGIN ===
                try {
                    $userName = auth()->user()->nama ?? auth()->user()->username ?? 'System';
                    $calibration->approved = now();
                    $calibration->approvedBy = $userName;
                    $calibration->save();
                    
                    \Log::info('✅ Approved status updated by: ' . $userName);
                } catch (\Exception $e) {
                    \Log::error('❌ Failed to update approved: ' . $e->getMessage());
                }
        
                // ============================================
                // PERBAIKAN UTAMA: EXTRACT PATH DARI URL
                // ============================================
                $locationData = $calibration->location_data;
                
                // Jika berupa URL lengkap, extract path-nya
                if (strpos($locationData, 'https://paperless.pascalibration.com/') === 0) {
                    // Hapus base URL
                    $relativePath = str_replace('https://paperless.pascalibration.com/', '', $locationData);
                    \Log::info('Extracted from URL: ' . $relativePath);
                } else {
                    // Jika sudah berupa path, gunakan langsung
                    $relativePath = ltrim($locationData, '/\\');
                }
                
                // Pastikan path benar
                if (!str_starts_with($relativePath, 'data_verified/')) {
                    \Log::error('Security violation: bukan folder data_verified');
                    return back()->with('error', 'Akses file tidak diizinkan.');
                }
        
                $fullPath = public_path($relativePath);
                
                \Log::info('Download Info:');
                \Log::info('  - DB value: ' . $locationData);
                \Log::info('  - Relative path: ' . $relativePath);
                \Log::info('  - Full path: ' . $fullPath);
                \Log::info('  - File exists: ' . (file_exists($fullPath) ? 'YES' : 'NO'));
        
                if (!file_exists($fullPath)) {
                    \Log::error('File tidak ditemukan: ' . $fullPath);
                    return back()->with('error', 'File tidak ditemukan di server: ' . basename($fullPath));
                }
        
                // === ISI DATA approvedBy KE SHEET SERTIFIKAT CELL J59 ===
                try {
                    \Log::info('📝 Mengisi ApprovedBy ke sheet SERTIFIKAT cell J59: ' . $calibration->approvedBy);
                    
                    // Load file Excel
                    $spreadsheet = \PhpOffice\PhpSpreadsheet\IOFactory::load($fullPath);
                    
                    // Ambil sheet SERTIFIKAT
                    $sheet = $spreadsheet->getSheetByName('SERTIFIKAT');
                    
                    if ($sheet) {
                        // Isi data di cell J59
                        $sheet->setCellValue('J59', $calibration->approvedBy);
                        
                        // Optimasi untuk preserve macro
                        $spreadsheet->setActiveSheetIndex(0);
                        $spreadsheet->garbageCollect();
                        
                        $calculationEngine = \PhpOffice\PhpSpreadsheet\Calculation\Calculation::getInstance($spreadsheet);
                        $calculationEngine->setCalculationCacheEnabled(false);
                        $calculationEngine->clearCalculationCache();
                        
                        // Simpan file
                        $writer = new \PhpOffice\PhpSpreadsheet\Writer\Xlsx($spreadsheet);
                        $writer->setPreCalculateFormulas(false);
                        $writer->save($fullPath);
                        
                        \Log::info('✅ Berhasil mengisi ApprovedBy ke sheet SERTIFIKAT cell J59');
                    } else {
                        \Log::warning("Sheet 'SERTIFIKAT' tidak ditemukan, skip mengisi approvedBy");
                    }
                    
                } catch (\Exception $e) {
                    \Log::error('❌ Gagal mengisi ApprovedBy ke certificate: ' . $e->getMessage());
                    // Lanjutkan download meskipun gagal mengisi data
                }
        
                $fileName = basename($fullPath);
                
                // HEADER UNTUK .xlsm (Excel Macro)
                $headers = [
                    'Content-Type' => 'application/vnd.ms-excel.sheet.macroEnabled.12',
                    'Content-Disposition' => 'attachment; filename="' . $fileName . '"',
                    'Cache-Control' => 'no-cache, no-store, must-revalidate',
                    'Pragma' => 'no-cache',
                    'Expires' => '0'
                ];
        
                \App\Helpers\LogHelper::log('download_verified', "Mengunduh Excel Terverifikasi: {$calibration->namaAlat}", $calibration);
        
                return response()->download($fullPath, $fileName, $headers);
        
            } catch (\Exception $e) {
                \Log::error('ERROR download verified: ' . $e->getMessage());
                return back()->with('error', 'Gagal download file.');
            }
        }


      public function downloadRejected($id)
{
    try {
        \Log::info('🟢 ===== START DOWNLOAD FILE REJECTED =====');

        // 1. Ambil data calibration
        $calibration = Calibration::findOrFail($id);

        // Validasi status harus 'rejected'
        if ($calibration->status !== 'rejected') {
            \Log::warning("Attempt to download rejected file but status is: " . $calibration->status);
            return back()->with('error', 'File hanya bisa di-download saat status Ditolak.');
        }

        // Validasi location_data
        if (empty($calibration->location_data)) {
            \Log::error("location_data kosong untuk ID: " . $id);
            return back()->with('error', 'File rejected belum tersedia.');
        }
        
          // === UPDATE verified DAN SAVE NAMA SESSION LOGIN ===
                try {
                    $userName = auth()->user()->nama ?? auth()->user()->username ?? 'System';
                    $calibration->verified = now();
                    $calibration->verifiedBy = $userName;
                     
                    $calibration->save();
                    
                    \Log::info('✅ Verified status updated by: ' . $userName);
                } catch (\Exception $e) {
                    \Log::error('❌ Failed to update verified: ' . $e->getMessage());
                }

        $locationData = $calibration->location_data;
        \Log::info('🌐 Location Data dari DB: ' . $locationData);

        // ==============================
        // EXTRACT RELATIVE PATH
        // ==============================
        $relativePath = '';

        if (strpos($locationData, 'https://paperless.pascalibration.com/') === 0) {
            $relativePath = str_replace('https://paperless.pascalibration.com/', '', $locationData);
        } elseif (strpos($locationData, 'data_rejected/') === 0) {
            $relativePath = $locationData;
        } elseif (strpos($locationData, 'public/data_rejected/') !== false) {
            $relativePath = str_replace('public/', '', $locationData);
        } else {
            \Log::error('Format location_data tidak dikenali');
            return back()->with('error', 'Format path file tidak valid.');
        }

        // Security check
        if (!str_starts_with($relativePath, 'data_rejected/')) {
            \Log::error('Security violation path: ' . $relativePath);
            return back()->with('error', 'Akses file tidak diizinkan.');
        }

        // ==============================
        // PATH FILE ASLI
        // ==============================
        $fullPath = public_path($relativePath);

        if (!file_exists($fullPath)) {
            $storagePath = storage_path('app/public/' . $relativePath);
            if (file_exists($storagePath)) {
                $fullPath = $storagePath;
            } else {
                return back()->with('error', 'File rejected tidak ditemukan.');
            }
        }

        $fileName = basename($fullPath);
        $fileSize = filesize($fullPath);

        if ($fileSize < 100) {
            return back()->with('error', 'File corrupt atau kosong.');
        }

        // ==============================
        // COPY FILE KE TEMP (AMAN XLSM)
        // ==============================
        $tempFileName =  $fileName;
        $tempPath = storage_path('app/temp/' . $tempFileName);

        if (!is_dir(dirname($tempPath))) {
            mkdir(dirname($tempPath), 0755, true);
        }

        copy($fullPath, $tempPath);
        \Log::info('📄 File copied to temp: ' . $tempPath);

        // ==============================
        // ISI CELL U13 (INPUT DATA)
        // ==============================
        try {
            $this->fillRejectedExcel($tempPath, $calibration);
            \Log::info('✅ Excel rejected berhasil diisi (U13)');
        } catch (\Exception $e) {
            \Log::warning('⚠️ Gagal isi Excel rejected: ' . $e->getMessage());
        }

        // ==============================
        // DOWNLOAD
        // ==============================
        
        \App\Helpers\LogHelper::log('download_rejected', "Mengunduh Excel Ditolak: {$calibration->namaAlat}", $calibration);
        
        return response()->download(
            $tempPath,
            $tempFileName,
            [
                'Content-Type' => 'application/vnd.ms-excel.sheet.macroEnabled.12',
                'Content-Disposition' => 'attachment; filename="' . $tempFileName . '"',
                'Content-Length' => filesize($tempPath),
                'Cache-Control' => 'no-cache, no-store, must-revalidate',
                'Pragma' => 'no-cache',
                'Expires' => '0',
            ]
        )->deleteFileAfterSend(true);

    } catch (\Exception $e) {
        \Log::error('💥 ERROR download rejected: ' . $e->getMessage());
        return back()->with('error', 'Terjadi kesalahan saat mengunduh file.');
    }
}


       
         private function fillRejectedExcel($filePath, $calibration)
{
    \Log::info('📝 Mengisi Excel REJECTED', [
        'calibration_id' => $calibration->id,
        'form_type' => $calibration->form_type
    ]);

    $spreadsheet = \PhpOffice\PhpSpreadsheet\IOFactory::load($filePath);

    // Pastikan nama sheet BENAR (case-sensitive)
    $sheet = $spreadsheet->getSheetByName('input data');

    if (!$sheet) {
        throw new \Exception('Sheet "input data" tidak ditemukan');
    }

    $rejectReason = $calibration->reason ?? 'REJECTED';
    $formType = strtolower($calibration->form_type ?? '');

    // ===============================
    // ISI CELL BERDASARKAN FORM TYPE
    // ===============================
    
    // Untuk Thermometer: pakai cell U3
    if ($formType === 'thermometer') {
        $sheet->setCellValue('U3', $rejectReason);
        \Log::info('✅ Thermometer: cell U3 diisi: ' . $rejectReason);
    } 
    // Untuk Inside, Outside, Depth Micrometer: pakai cell U13
    else {
        $sheet->setCellValue('U13', $rejectReason);
        \Log::info('✅ Inside/Outside/Depth: cell U13 diisi: ' . $rejectReason);
    }

    // ===============================
    // OPTIMASI XLSM (PRESERVE MACRO)
    // ===============================
    $spreadsheet->setActiveSheetIndex(0);
    $spreadsheet->garbageCollect();

    $calc = \PhpOffice\PhpSpreadsheet\Calculation\Calculation::getInstance($spreadsheet);
    $calc->setCalculationCacheEnabled(false);
    $calc->clearCalculationCache();

    $writer = new \PhpOffice\PhpSpreadsheet\Writer\Xlsx($spreadsheet);
    $writer->setPreCalculateFormulas(false);
    $writer->save($filePath);

    \Log::info('✅ Excel rejected berhasil di-update', [
        'form_type' => $formType,
        'cell' => $formType === 'thermometer' ? 'U3' : 'U13',
        'value' => $rejectReason
    ]);
}

        /**
         * Generate nama file
         */
        private function generateFileName($calibration)
        {
            $safeName = preg_replace('/[^\w\s\-]/', '_', $calibration->namaAlat);
            $safeSerial = preg_replace('/[^\w\s\-]/', '_', $calibration->NoSeri ?? '');
            
            $safeName = str_replace(' ', '_', $safeName);
            $safeSerial = str_replace(' ', '_', $safeSerial);
            
            $safeName = preg_replace('/_+/', '_', $safeName);
            $safeSerial = preg_replace('/_+/', '_', $safeSerial);
            
            // PASTIKAN .xlsm
            return "Calibrasi_{$safeName}_{$safeSerial}_" . date('Ymd_His') . '.xlsm';
        }
        
     
              /**
         * Kirim SATU data draft ke checker
         */
        public function sendToChecker($id)
        {
            try {
                $user = auth()->user();
                $calibration = Calibration::findOrFail($id);
                
                // Validasi: hanya teknisi atau super admin
                if (!in_array($user->role, ['teknisi', 'super admin'])) {
                    return redirect()->back()->with('error', 'Anda tidak memiliki izin.');
                }
                
                // Validasi status
                if ($calibration->status !== 'draft') {
                    return redirect()->back()->with('error', 'Hanya data draft yang dapat dikirim.');
                }
                
                // Validasi kepemilikan untuk teknisi
                if ($user->role === 'teknisi' && $calibration->calibratedBy !== $user->nama) {
                    return redirect()->back()->with('error', 'Anda hanya bisa mengirim data milik sendiri.');
                }
                
                $calibration->markAsWaitingVerification($user->nama);
                
                  \App\Helpers\LogHelper::log('send_to_checker', "Data {$calibration->id} dikirim ke checker oleh {$user->nama}");
                
                return redirect()->route('calibrations.index')
                    ->with('success', 'Data berhasil dikirim ke checker.');
                    
            } catch (\Exception $e) {
                \Log::error('Error send to checker: ' . $e->getMessage());
                return redirect()->back()->with('error', 'Terjadi kesalahan.');
            }
        }
        
        /**
         * Kirim SEMUA data draft ke checker
         */
        public function sendAllToChecker()
        {
            try {
                $user = auth()->user();
                
                if (!in_array($user->role, ['teknisi', 'super admin'])) {
                    return redirect()->back()->with('error', 'Anda tidak memiliki izin.');
                }
                
                $query = Calibration::where('status', 'draft');
                
                if ($user->role === 'teknisi') {
                    $query->where('calibratedBy', $user->nama);
                }
                
                $totalDraft = $query->count();
                
                if ($totalDraft === 0) {
                    return redirect()->back()->with('error', 'Tidak ada data draft.');
                }
                
                $updated = 0;
                $calibrations = $query->get();
                
                foreach ($calibrations as $calibration) {
                    $calibration->markAsWaitingVerification($user->nama);
                    $updated++;
                }
                
                   \App\Helpers\LogHelper::log('send_all_to_checker', "{$updated} data draft dikirim ke checker oleh {$user->nama}");
                
                return redirect()->route('calibrations.index')
                    ->with('success', "Berhasil mengirim {$updated} data draft ke checker.");
                    
            } catch (\Exception $e) {
                \Log::error('Error send all to checker: ' . $e->getMessage());
                return redirect()->back()->with('error', 'Terjadi kesalahan.');
            }
        }
        
        /**
         * Update Next Tanggal Kalibrasi via AJAX (saat print)
         */
      public function updateNextDate(Request $request, $id)
        {
            try {
                \Log::info('📅 UPDATE NEXT DATE REQUEST:', [
                    'calibration_id' => $id,
                    'next_date' => $request->next_date
                ]);
                
                $request->validate([
                    'next_date' => 'required|date',
                ]);
                
                $calibration = Calibration::findOrFail($id);
                
                // Update kolom NextTanggalKalibrasi di tabel calibrations
                $calibration->update([
                    'NextTanggalKalibrasi' => $request->next_date
                ]);
                
                \Log::info('✅ Next date updated successfully', [
                    'calibration_id' => $id,
                    'next_date' => $request->next_date
                ]);
                
                return response()->json([
                    'success' => true, 
                    'message' => 'Next date berhasil disimpan'
                ]);
                
            } catch (\Exception $e) {
                \Log::error('❌ Error updating next date:', [
                    'message' => $e->getMessage(),
                    'file' => $e->getFile(),
                    'line' => $e->getLine()
                ]);
                
                return response()->json([
                    'success' => false, 
                    'error' => $e->getMessage()
                ], 500);
            }
        }
        
  
       
}