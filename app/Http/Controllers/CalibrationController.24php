            'nominalRPM (12 baris)' => $nominalRPM,
            'resolusi_alat (12 baris)' => $resolusi,
            'titikUkur (10 baris)' => $titikUkur,
        ]);
        
        // Loop untuk 10 titik ukur (sesuai dengan detail abration tester)
        for ($i = 0; $i < 10; $i++) {
            $detailData = [
                'calibration_id' => $calibration->id,
                'head_abration_tester_id' => $head->id,
                // nominalRPM dan resolusi ambil dari baris ke-$i (jika ada)
                'nominalRPM' => $nominalRPM[$i] ?? null,
                'resolusi' => $resolusi[$i] ?? null,
                'titikUkur' => $titikUkur[$i] ?? null,
                // STD gabungan (12 baris, ambil sesuai index)
                'STD1' => $STD1[$i] ?? null,
                'STD2' => $STD2[$i] ?? null,
                'STD3' => $STD3[$i] ?? null,
                'STD4' => $STD4[$i] ?? null,
                'STD5' => $STD5[$i] ?? null,
                // STD terpisah
                'STDm1' => $STDm1[$i] ?? null,
                'STDs1' => $STDs1[$i] ?? null,
                'STDms1' => $STDms1[$i] ?? null,
                'STDm2' => $STDm2[$i] ?? null,
                'STDs2' => $STDs2[$i] ?? null,
                'STDms2' => $STDms2[$i] ?? null,
