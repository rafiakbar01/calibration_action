public function store(Request $request)
{
    try {
       // CEK APAKAH INI AJAX REQUEST ATAU MULTIPLE FORM SUBMIT ATAU TAB MODE
        $isAjax = $request->ajax() || $request->wantsJson() || $request->has('submit_all') || $request->has('is_tabbed_mode');
        $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        $jumlahForm = (int) ($request->jumlah_form ?? 1);
        
       // 🔥 LOG DETAIL REQUEST
        \Log::info('🔍=== STORE REQUEST DETAIL ===', [
            'is_ajax' => $isAjax,
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm,
            'has_submit_all' => $request->has('submit_all'),
            'has_is_tabbed_mode' => $request->has('is_tabbed_mode'),
            'all_headers' => $request->headers->all(),
            'all_input_keys' => array_keys($request->all()),
            'url' => $request->fullUrl(),
            'method' => $request->method()
        ]);
        // ==================================================================
        // EKSTRAK DATA UNTUK MULTIPLE SUBMIT
        // ==================================================================
        $formDataForValidation = [];
        
        if ($isMultipleSubmit) {
            // Ekstrak data form 1 untuk validasi
            foreach ($request->all() as $key => $value) {
                if (strpos($key, 'form_1_') === 0) {
                    $originalKey = substr($key, 7);
                    $formDataForValidation[$originalKey] = $value;
                } elseif ($key === 'form_type' || $key === 'jumlah_form' || $key === 'submit_all' || $key === '_token') {
                    continue;
                } elseif (!strpos($key, 'form_') === 0 && !in_array($key, ['_token', 'submit_all', 'jumlah_form', 'form_type'])) {
                    $formDataForValidation[$key] = $value;
                }
            }
            
            \Log::info('📋 Extracted form 1 data for validation:', array_keys($formDataForValidation));
            
            // Validasi menggunakan data yang sudah diekstrak
            $validator = validator($formDataForValidation, [
                'form_type' => 'required',
                'merek' => 'required',
                'kode_alat' => 'nullable',
                'type_alat' => 'nullable',
                'no_seri' => 'required',
                'kapasitas' => 'required',
                'resolusi' => 'required',
                'rentang_ukur_min' => 'nullable',
                'rentang_ukur_max' => 'nullable',
                'nama_pemilik' => 'required',
                'tanggal_alat_masuk' => 'required|date',
                'tanggal_kalibrasi' => 'required|date',
                'jenis_pembacaan' => 'nullable',
                'tempat_kalibrasi' => 'required',
                'lokasi_pt' => 'nullable',
                'fungsi_komponen' => 'required',
                'suhu_awal' => 'required',
                'suhu_tengah' => 'required',
                'suhu_akhir' => 'required',
                'rh_awal' => 'required',
                'rh_tengah' => 'required',
                'rh_akhir' => 'required',
                'calibrated_by' => 'required',
                'verified_by' => 'nullable',
                'kode_th' => 'nullable',
            ]);
            
            if ($validator->fails()) {
                \Log::error('Validation failed:', $validator->errors()->toArray());
                if ($isAjax) {
                    return response()->json([
                        'success' => false,
                        'error' => 'Validasi gagal: ' . implode(', ', $validator->errors()->all())
                    ], 422);
                }
                return redirect()->back()->withErrors($validator)->withInput();
            }
            
            // Merge data untuk diproses
            $request->merge($formDataForValidation);
        } else {
            // Validasi normal untuk single form
            $request->validate([
                'form_type' => 'required',
                'merek' => 'required',
                'kode_alat' => 'nullable',
                'type_alat' => 'nullable',
                'no_seri' => 'required',
                'kapasitas' => 'required',
                'resolusi' => 'required',
                'rentang_ukur_min' => 'nullable',
                'rentang_ukur_max' => 'nullable',
                'nama_pemilik' => 'required',
                'tanggal_alat_masuk' => 'required|date',
                'tanggal_kalibrasi' => 'required|date',
                'jenis_pembacaan' => 'nullable',
                'tempat_kalibrasi' => 'required',
                'lokasi_pt' => 'nullable',
                'fungsi_komponen' => 'required',
                'suhu_awal' => 'required',
                'suhu_tengah' => 'required',
                'suhu_akhir' => 'required',
                'rh_awal' => 'required',
                'rh_tengah' => 'required',
                'rh_akhir' => 'required',
                'calibrated_by' => 'required',
                'verified_by' => 'nullable',
                'no_label' => 'nullable',
                'type' => 'nullable',
                'jumlah_form' => 'nullable',
                 'kode_th' => 'nullable',
            ]);
        }
        
        \Log::info('🔍=== RAW REQUEST DATA ===', [
            'form_type' => $request->input('form_type'),
            'all_input' => $request->except(['_token']),
        ]);
        
        // Log proses generate ID
        \Log::info('=== MEMULAI PROSES GENERATE ID CUSTOM ===');
        \Log::info('User: ' . auth()->user()->nama . ' (' . auth()->user()->nik . ')');
        
        // ==================================================================
        // 1. TENTUKAN NOMOR URUT GLOBAL
        // ==================================================================
        $lastCalibration = Calibration::where('id', 'LIKE', 'PAS-%')
            ->orderBy('id', 'desc')
            ->first();
        
        if ($lastCalibration) {
            preg_match('/PAS-(\d+)-K/', $lastCalibration->id, $matches);
            if (isset($matches[1])) {
                $lastNumber = intval($matches[1]);
                $newNumber = $lastNumber + 1;
            } else {
                $lastNumber = intval(substr($lastCalibration->id, 4));
                $newNumber = $lastNumber + 1;
            }
            \Log::info('Data terakhir ditemukan:', ['last_id' => $lastCalibration->id, 'new_number' => $newNumber]);
        } else {
            $newNumber = 1;
            \Log::info('Tidak ada data sebelumnya, memulai dari nomor 1');
        }
        
        $nomorUrutFormatted = str_pad($newNumber, 6, '0', STR_PAD_LEFT);
        $tahunSekarang = date('y');
        
        // ==================================================================
        // 2. TENTUKAN ID_ALAT
        // ==================================================================
        $existingAlat = Calibration::where('NoSeri', $request->no_seri)
            ->where('brandAlat', $request->merek)
            ->where('typeAlat', $request->type_alat)
            ->orderBy('created_at', 'desc')
            ->first();
        
        if ($existingAlat && !empty($existingAlat->id_alat)) {
            $idAlat = $existingAlat->id_alat;
            if (preg_match('/PAS-(\d+)-K(\d+)/', $idAlat, $matches)) {
                $nomorUrutAlat = $matches[1];
                $tahunAlat = $matches[2];
            } else {
                $nomorUrutAlat = $nomorUrutFormatted;
                $tahunAlat = $tahunSekarang;
                $idAlat = 'PAS-' . $nomorUrutAlat . '-K' . $tahunAlat;
            }
            \Log::info('Alat sudah pernah dikalibrasi:', ['id_alat_lama' => $idAlat]);
        } else {
            $nomorUrutAlat = $nomorUrutFormatted;
            $tahunAlat = $tahunSekarang;
            $idAlat = 'PAS-' . $nomorUrutAlat . '-K' . $tahunAlat;
            \Log::info('Alat baru, membuat id_alat:', ['id_alat_baru' => $idAlat]);
        }
        
        // ==================================================================
        // 3. TENTUKAN URUTAN KALIBRASI
        // ==================================================================
        $allCalibrations = Calibration::where('id_alat', $idAlat)->get();
        if ($allCalibrations->isEmpty() && $existingAlat) {
            $allCalibrations = Calibration::where('NoSeri', $request->no_seri)
                ->where('brandAlat', $request->merek)
                ->where('typeAlat', $request->type_alat)
                ->orderBy('tanggalKalibrasi', 'asc')
                ->get();
        }
        
        $urutanKalibrasi = $allCalibrations->count() + 1;
        
        do {
            $customId = $idAlat . '-' . $urutanKalibrasi;
            $exists = Calibration::where('id', $customId)->exists();
            if ($exists) {
                \Log::warning('⚠️ ID sudah ada, increment urutan', ['id' => $customId]);
                $urutanKalibrasi++;
            }
        } while ($exists);
        
        \Log::info('Membuat record kalibrasi baru:', [
            'id_alat' => $idAlat,
            'id' => $customId,
            'urutan_kalibrasi_ke' => $urutanKalibrasi
        ]);
        
        // ==================================================================
        // 4. PERSIAPAN DATA CALIBRATION
        // ==================================================================
        $namaAlatFinal = $request->nama_alat === 'MANUAL_INPUT'
            ? $request->nama_alat_manual
            : $request->nama_alat;
        
        $formType = $request->form_type ?? 'default';
        
        $namaAlatLower = strtolower($namaAlatFinal);
        $enclosureAlat = ['freezer', 'oven', 'furnace', 'incubator', 'waterbath', 'autoclave'];
        
        if (in_array($namaAlatLower, $enclosureAlat) && $formType !== 'enclosure') {
            \Log::warning('⚠️ FORM TYPE SALAH!', ['dikirim' => $formType, 'seharusnya' => 'enclosure']);
            $formType = 'enclosure';
            $request->merge(['form_type' => 'enclosure']);
        }
        
        \Log::info('✅ FORM TYPE FINAL:', ['form_type' => $formType, 'nama_alat' => $namaAlatFinal]);
        
        $certificateId = $this->generateCertificateIdFromNamaAlat($namaAlatFinal);
        $userNik = auth()->user()->nik;
        $userName = auth()->user()->nama;
        $lkCode = $this->getLkCodeByFormType($formType);
        $initialStatus = Calibration::STATUS_DRAFT;
        
        // ==================================================================
        // 5. BUAT DATA CALIBRATION
        // ==================================================================
        $calibrationData = [
            'id' => $customId,
            'id_alat' => $idAlat,
            'NIK' => $userNik,
            'LK' => $lkCode,
            'jenisPembacaan' => $request->jenis_pembacaan,
            'lokasiPT' => $request->lokasi_pt,
            'no_label' => null,
            'form_type' => $formType,
            'namaAlat' => $namaAlatFinal,
            'brandAlat' => $request->merek,
            'kodeAlat' => $request->kode_alat,
            'typeAlat' => $request->type_alat,
            'NoSeri' => $request->no_seri,
            'kapasitas' => $request->kapasitas,
            'resolusi' => $request->resolusi,
            'rangeMin' => $request->rentang_ukur_min,
            'rangeMax' => $request->rentang_ukur_max,
            'type' => $request->type,
            'pemilikAlat' => $request->nama_pemilik,
            'tanggalMasuk' => $request->tanggal_alat_masuk,
            'tanggalKalibrasi' => $request->tanggal_kalibrasi,
            'tempatKalibrasi' => $request->tempat_kalibrasi,
            'kondisiAlat' => $request->fungsi_komponen,
            'keterangan' => $request->keterangan_fungsi_komponen,
            'status' => $initialStatus,
            'RT_condition1' => $request->suhu_awal,
            'RT_condition2' => $request->suhu_tengah,
            'RT_condition3' => $request->suhu_akhir,
            'RH_condition1' => $request->rh_awal,
            'RH_condition2' => $request->rh_tengah,
            'RH_condition3' => $request->rh_akhir,
            'calibratedBy' => $request->calibrated_by,
            'verifiedBy' => $request->verified_by,
            'jumlah_form' => $jumlahForm,
            'kode_th' => $request->kode_th,
        ];
        
        $calibrationData = $this->autoCompleteRequiredColumns($calibrationData);
        
        \Log::info('Menyimpan data ke database...');
        $calibration = Calibration::create($calibrationData);
        
        \Log::info('Data berhasil disimpan:', [
            'id' => $calibration->id,
            'id_alat' => $calibration->id_alat,
            'status' => $calibration->status
        ]);
        
        $calibration->markAsDraft($userName);
        
        // ==================================================================
        // 6. SIMPAN DATA SPESIFIK ALAT (INSIDE MICROMETER)
        // ==================================================================
        $this->storeAlatSpecificData($request, $calibration, $certificateId, $formType, $isMultipleSubmit, $jumlahForm);
        // $this->storeInsideMicrometer($request, $calibration, $certificateId, $isMultipleSubmit, $jumlahForm);
        // $this->storeOutsideMicrometer($request, $calibration, $certificateId, $isMultipleSubmit, $jumlahForm);
        \Log::info('Data spesifik alat berhasil disimpan');
        
        // ==================================================================
        // 7. LOG RINGKASAN AKHIR
        // ==================================================================
        \Log::info('=== RINGKASAN KALIBRASI ===');
        \Log::info('ID Alat (tetap): ' . $calibration->id_alat);
        \Log::info('ID Kalibrasi (unik): ' . $calibration->id);
        \Log::info('No Seri Alat: ' . $calibration->NoSeri);
        \Log::info('Ini adalah kalibrasi ke-' . $urutanKalibrasi . ' untuk alat ini');
        
        LogHelper::log('create', "Membuat data kalibrasi baru: {$calibration->namaAlat} ({$calibration->NoSeri}) - ID: {$calibration->id}", $calibration);
        
         // ==================================================================
        // 8. RETURN RESPONSE
        // ==================================================================
        
        // 🔥 LOG SEBELUM RETURN RESPONSE
        \Log::info('🔍=== SEBELUM RETURN RESPONSE ===', [
            'isAjax_final' => $isAjax,
            'will_return_json' => $isAjax ? 'YES' : 'NO',
            'will_redirect' => $isAjax ? 'NO' : 'YES'
        ]);
        
        if ($isAjax) {
            $responseData = [
                'success' => true,
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'calibration_data' => [
                    'id' => $calibration->id,
                    'nama_alat' => $calibration->namaAlat,
                    'no_seri' => $calibration->NoSeri,
                    'tanggal_kalibrasi' => $calibration->tanggalKalibrasi,
                ],
                'message' => 'Data kalibrasi berhasil disimpan',
                'print_label_url' => route('calibrations.print-label', ['id' => $calibration->id])
            ];
            
            // 🔥 LOG RESPONSE YANG AKAN DIKIRIM
            \Log::info('✅ JSON RESPONSE YANG DIKIRIM:', [
                'response_keys' => array_keys($responseData),
                'has_redirect' => isset($responseData['redirect']),
                'has_print_label_url' => isset($responseData['print_label_url']),
                'print_label_url' => $responseData['print_label_url'] ?? 'not set'
            ]);
            
            return response()->json($responseData)->header('Content-Type', 'application/json');
        }
        
        // 🔥 LOG REDIRECT YANG TERJADI
        \Log::info('🔴 REDIRECT KE PRINT LABEL (NON-AJAX):', [
            'url' => route('calibrations.print-label', ['id' => $calibration->id, 'show_modal' => true]),
            'calibration_id' => $calibration->id
        ]);
        
        return redirect()->route('calibrations.print-label', [
            'id' => $calibration->id,
            'show_modal' => true
        ])->with('success', 'Data kalibrasi berhasil disimpan!');
        
    } catch (\Exception $e) {
        \Log::error('=== ERROR SAAT MENYIMPAN DATA ===');
        \Log::error('Error message: ' . $e->getMessage());
        \Log::error('Error trace: ' . $e->getTraceAsString());
        
        $errorMessage = $this->getUserFriendlyErrorMessage($e);
        
        if ($request->ajax() || $request->wantsJson() || $request->has('submit_all') || $request->has('is_tabbed_mode')) {
            return response()->json([
                'success' => false,
                'error' => $errorMessage
            ], 500)->header('Content-Type', 'application/json');
        }
        
        return redirect()->back()
            ->with('swal_error', true)
            ->with('swal_title', 'Gagal Menyimpan Data')
            ->with('swal_text', $errorMessage)
            ->withInput();
    }
}

/**
 * Mendapatkan pesan error yang user-friendly
 */
private function getUserFriendlyErrorMessage($e)
{
    $message = $e->getMessage();
    
    if (str_contains($message, 'Out of range value')) {
        return 'Nilai yang dimasukkan tidak valid. Pastikan format angka sudah benar.';
    }
    
    if (str_contains($message, 'Duplicate entry')) {
        return 'Data dengan ID yang sama sudah ada. Silakan coba lagi.';
    }
    
    if (str_contains($message, 'foreign key constraint')) {
        return 'Gagal menyimpan data referensi. Silakan coba lagi.';
    }
    
    if (str_contains($message, 'Column not found')) {
        return 'Terjadi kesalahan struktur data. Silakan hubungi administrator.';
    }
    
    if (str_contains($message, 'Connection refused')) {
        return 'Koneksi database terputus. Silakan hubungi administrator.';
    }
    
    return 'Terjadi kesalahan saat menyimpan data. Silakan coba lagi.';
}

  /**
     * Halaman cetak label kalibrasi — dipanggil otomatis setelah store()
     */
        public function printLabel($id)
{
    $calibration = Calibration::findOrFail($id);

    // Hitung next kalibrasi (+1 tahun)
    $tglKalibrasi     = Carbon::parse($calibration->tanggalKalibrasi);
    $nextKalibrasi    = $tglKalibrasi->copy()->addYear();

    $data = [
        'id_alat'             => $calibration->id_alat,
        'id'             => $calibration->id,
        'LK'                  => $calibration->LK,
        'NoSeri'              => $calibration->NoSeri,
        'namaAlat'            => $calibration->namaAlat,
        'tanggalKalibrasi'    => $tglKalibrasi->format('d-m-Y'),
        'nextTanggalKalibrasi'=> $nextKalibrasi->format('d-m-Y'),
        'today'               => now()->format('d-m-Y'),
         'no_label' => $calibration->no_label,
        // NO LABEL TIDAK DITAMPILKAN DI SINI
    ];
  $showModal = empty($calibration->no_label);
    $successMessage = session('success');
    
    // 🔹 Fix Logo
    $logoBase64 = '';
    $logoUrl = 'https://www.pascalibration.com/wp-content/uploads/2023/09/logo_pas_basic.png';
    
    $ctx = stream_context_create([
        'http' => [
            'timeout' => 10,
            'header'  => "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)\r\n"
        ],
        'ssl' => [
            'verify_peer' => false,
            'verify_peer_name' => false,
        ]
    ]);
    
    try {
        $imgData = @file_get_contents($logoUrl, false, $ctx);
        if ($imgData !== false) {
             $logoBase64 = 'data:image/png;base64,' . base64_encode($imgData);
        }
    } catch (\Exception $e) { }

    // Fallback ke local public path jika gagal
    if (empty($logoBase64)) {
        $logoPath = public_path('logo/logo_pas_basic.png');
        if (file_exists($logoPath)) {
            $type = pathinfo($logoPath, PATHINFO_EXTENSION);
            $imgData = file_get_contents($logoPath);
            $logoBase64 = 'data:image/' . $type . ';base64,' . base64_encode($imgData);
        }
    }

    // Cek apakah perlu menampilkan modal setelah print (dari parameter URL)
    $showModal = request()->query('show_modal', false);

    return view('calibrations.print-label', compact('data', 'successMessage', 'logoBase64', 'showModal'));
}

// app/Http/Controllers/CalibrationController.php

public function updateLabel(Request $request, $id)
{
    try {
        $request->validate([
            'no_label' => 'required|string|max:50'
        ]);
        
        $calibration = Calibration::findOrFail($id);
        $calibration->no_label = $request->no_label;
        $calibration->save();
        
        if ($request->ajax() || $request->wantsJson()) {
            return response()->json([
                'success' => true,
                'message' => 'No. Label berhasil disimpan',
                'data' => $calibration
            ]);
        }
        
        return redirect()->back()->with('success', 'No. Label berhasil disimpan');
        
    } catch (\Exception $e) {
        if ($request->ajax() || $request->wantsJson()) {
            return response()->json([
                'success' => false,
                'message' => $e->getMessage()
            ], 500);
        }
        
        return redirect()->back()->with('error', 'Gagal menyimpan No. Label: ' . $e->getMessage());
    }
}
  /**
 * Fetch calibration data by id (bisa id_alat atau id biasa)
 */
public function fetchDataById($id)
{
    try {
        \Log::info('🔍 ===== FETCH DATA BY ID =====', [
            'id' => $id,
            'timestamp' => now()->toDateTimeString(),
            'ip' => request()->ip()
        ]);
        
        // 🔥 PERBAIKAN: Cari berdasarkan ID KALIBRASI terlebih dahulu (karena yang di-scan adalah ID kalibrasi)
        \Log::info('📌 Mencari data berdasarkan id kalibrasi...', ['id' => $id]);
        $calibration = Calibration::find($id);
        
        if ($calibration) {
            \Log::info('✅ Data ditemukan berdasarkan id kalibrasi', [
                'id' => $calibration->id,
                'id_alat' => $calibration->id_alat,
                'namaAlat' => $calibration->namaAlat,
                'NoSeri' => $calibration->NoSeri,
                'form_type_database' => $calibration->form_type
            ]);
        }
        
        // Jika tidak ditemukan berdasarkan id, coba cari berdasarkan id_alat
        if (!$calibration) {
            \Log::info('📌 Data tidak ditemukan berdasarkan id, mencoba berdasarkan id_alat...', ['id_alat' => $id]);
            $calibration = Calibration::where('id_alat', $id)
                ->orderBy('tanggalKalibrasi', 'desc')
                ->orderBy('created_at', 'desc')
                ->first();
            
            if ($calibration) {
                \Log::info('✅ Data ditemukan berdasarkan id_alat', [
                    'id' => $calibration->id,
                    'id_alat' => $calibration->id_alat,
                    'namaAlat' => $calibration->namaAlat,
                    'NoSeri' => $calibration->NoSeri,
                    'form_type_database' => $calibration->form_type
                ]);
            }
        }
        
        if (!$calibration) {
            \Log::warning('❌ Data tidak ditemukan', ['id' => $id]);
            
            return response()->json([
                'success' => false,
                'message' => 'Data alat tidak ditemukan.'
            ], 404);
        }

        // 🔥 PERBAIKAN: Gunakan form_type dari DATABASE, bukan dari getAlatType()
        // Karena getAlatType() bisa mengembalikan 'general' jika tidak cocok
        $formType = $calibration->form_type;
        
        // 🔥 FALLBACK: Jika form_type di database masih kosong atau 'general', gunakan dari LK
        if (empty($formType) || $formType === 'general') {
            $lk = $calibration->LK ?? '';
            
            // Mapping LK ke form_type
            $lkMapping = [
                'PAS-FLK-01' => 'inside_micrometer',
                'PAS-FLK-02' => 'outside_micrometer',
                'PAS-FLK-06' => 'depth_micrometer',
                'PAS-FLK-30' => 'thermometer',
                'PAS-FLK-04' => 'dial_indicator',
                'PAS-FLK-07' => 'dial_test_indicator',
                'PAS-FLK-03' => 'caliper',
                'PAS-FLK-13' => 'torque_wrench',
                'PAS-FLK-13B' => 'torque_meter',
                'PAS-FLK-15' => 'timbangan',
                'PAS-FLK-62' => 'feeler_gauge',
                'PAS-FLK-29' => 'enclosure',
                'PAS-FLK-29B' => 'chamber',
                'PAS-FLK-17' => 'pressure_gauge',
                'PAS-FLK-17B' => 'differential_pressure_gauge',
            ];
            
            if (isset($lkMapping[$lk])) {
                $formType = $lkMapping[$lk];
                \Log::info('🔄 Form type ditentukan dari LK:', ['LK' => $lk, 'form_type' => $formType]);
            } else {
                // Fallback terakhir: dari nama alat
                $namaAlatLower = strtolower($calibration->namaAlat);
                if (str_contains($namaAlatLower, 'inside')) {
                    $formType = 'inside_micrometer';
                } elseif (str_contains($namaAlatLower, 'outside')) {
                    $formType = 'outside_micrometer';
                } elseif (str_contains($namaAlatLower, 'depth')) {
                    $formType = 'depth_micrometer';
                } else {
                    $formType = 'general';
                }
                \Log::info('🔄 Form type ditentukan dari nama alat:', ['namaAlat' => $namaAlatLower, 'form_type' => $formType]);
            }
            
            // Update database agar下次不 perlu deteksi ulang
            $calibration->update(['form_type' => $formType]);
            \Log::info('💾 Database diupdate dengan form_type yang benar:', ['form_type' => $formType]);
        }
        
        \Log::info('🎯 FORM TYPE FINAL:', [
            'form_type' => $formType,
            'sumber' => $formType === $calibration->form_type ? 'database' : 'deteksi'
        ]);

        // Ambil semua riwayat kalibrasi untuk alat ini
        \Log::info('📋 Mengambil riwayat kalibrasi...');
        $riwayat = Calibration::where('id_alat', $calibration->id_alat)
            ->orderBy('tanggalKalibrasi', 'desc')
            ->limit(5)
            ->get(['id', 'id_alat', 'LK', 'tanggalKalibrasi']);

        \Log::info('📊 Riwayat ditemukan', ['jumlah' => $riwayat->count()]);

        // ============================================================
        // AMBIL DATA REPETITION UNTUK ENCLOSURE
        // ============================================================
        $repetition = null;
        
        if ($formType === 'enclosure') {
            \Log::info('📊 Mengambil data repetition untuk enclosure...');
            $addEnclosures = \App\Models\AddEnclosure::where('calibration_id', $calibration->id)->get();
            if ($addEnclosures->isNotEmpty()) {
                $repetition = $addEnclosures->pluck('repetition_number')->unique()->count();
            }
        }
        
        // ============================================================
        // AMBIL DATA REPETITION UNTUK CHAMBER
        // ============================================================
        if ($formType === 'chamber') {
            \Log::info('📊 Mengambil data repetition untuk chamber...');
            $addChambers = \App\Models\AddChamber::where('calibration_id', $calibration->id)->get();
            if ($addChambers->isNotEmpty()) {
                $repetition = $addChambers->pluck('repetition_number')->unique()->count();
            }
        }

        // Helper function untuk format tanggal
        $formatDate = function($date) {
            if (!$date) return null;
            if (is_string($date) && preg_match('/^\d{4}-\d{2}-\d{2}$/', $date)) return $date;
            if ($date instanceof \Carbon\Carbon) return $date->format('Y-m-d');
            try {
                return date('Y-m-d', strtotime($date));
            } catch (\Exception $e) {
                return null;
            }
        };

        $tanggalMasuk = $formatDate($calibration->tanggalMasuk);
        $tanggalKalibrasi = $formatDate($calibration->tanggalKalibrasi);

        $riwayatFormatted = $riwayat->map(function($item) use ($formatDate) {
            return [
                'id' => $item->id,
                'id_alat' => $item->id_alat,
                'LK' => $item->LK,
                'tanggalKalibrasi' => $formatDate($item->tanggalKalibrasi)
            ];
        });

        // 🔥 RESPONSE DATA - LANGSUNG DARI DATABASE
        $responseData = [
            'id' => $calibration->id,
            'id_alat' => $calibration->id_alat ?? $calibration->id,
            'namaAlat' => $calibration->namaAlat,
            'brandAlat' => $calibration->brandAlat,
            'typeAlat' => $calibration->typeAlat,
            'NoSeri' => $calibration->NoSeri,
            'kodeAlat' => $calibration->kodeAlat,
            'kapasitas' => $calibration->kapasitas,
            'resolusi' => $calibration->resolusi,
            'rangeMin' => $calibration->rangeMin,
            'rangeMax' => $calibration->rangeMax,
            'posisiAlat' => $calibration->posisiAlat,
            'pemilikAlat' => $calibration->pemilikAlat,
            'lokasiPT' => $calibration->lokasiPT,
            'LK' => $calibration->LK,
            'tanggalMasuk' => $tanggalMasuk,
            'tanggalKalibrasi' => $tanggalKalibrasi,
            'tempatKalibrasi' => $calibration->tempatKalibrasi,
            'jenisPembacaan' => $calibration->jenisPembacaan,
            'kondisiAlat' => $calibration->kondisiAlat,
            'keterangan' => $calibration->keterangan,
            'RT_condition1' => $calibration->RT_condition1,
            'RT_condition2' => $calibration->RT_condition2,
            'RT_condition3' => $calibration->RT_condition3,
            'RH_condition1' => $calibration->RH_condition1,
            'RH_condition2' => $calibration->RH_condition2,
            'RH_condition3' => $calibration->RH_condition3,
            'form_type' => $formType, // 🔥 LANGSUNG DARI DATABASE ATAU HASIL DETEKSI
            'riwayatKalibrasi' => $riwayatFormatted,
            'capacity' => $calibration->capacity,
            'skala' => $calibration->skala,
            'type' => $calibration->type,
            'repetition' => $repetition,
            'jumlah_form' => $calibration->jumlah_form ?? 1,
        ];

        \Log::info('📤 RESPONSE YANG DIKIRIM:', [
            'form_type' => $responseData['form_type'],
            'jumlah_form' => $responseData['jumlah_form'],
            'capacity' => $responseData['capacity'],
            'namaAlat' => $responseData['namaAlat']
        ]);

        return response()->json([
            'success' => true,
            'data' => $responseData
        ]);
        
    } catch (\Exception $e) {
        \Log::error('❌ FETCH DATA ERROR:', [
            'id' => $id,
            'error_message' => $e->getMessage(),
            'error_file' => $e->getFile(),
            'error_line' => $e->getLine()
        ]);
        
        return response()->json([
            'success' => false,
            'message' => 'Terjadi kesalahan: ' . $e->getMessage()
        ], 500);
    }
}
    


