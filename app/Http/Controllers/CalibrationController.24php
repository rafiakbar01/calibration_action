   private function storeInsideMicrometer($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1)
{
    \Log::info('🚀 ===== START storeInsideMicrometer =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm
    ]);
    
    try {
        // ==================================================================
        // 1. KONFIGURASI MULTIPLE FORM
        // ==================================================================
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm
        ]);
        
        // ==================================================================
        // 2. FUNGSI BANTU UNTUK MENCARI NILAI (LOOPING SEMUA KEMUNGKINAN TAB)
        // ==================================================================
        
        /**
         * Mencari nilai dari request dengan berbagai kemungkinan format key (termasuk tab)
         */
        $findValue = function($baseKey, $formIndex, $additionalParams = []) use ($request) {
            $possibleKeys = [];
            $suffix = !empty($additionalParams) ? '_' . implode('_', $additionalParams) : '';
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan double formIndex dan tab
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tab}";
                
                // Format tanpa tab suffix
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "{$baseKey}{$suffix}";
            }
            
            // Hapus duplikasi
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai array (alat_standar) dengan berbagai format (termasuk tab) PER FORM
         */
        $findArrayValue = function($baseKey, $formIndex) use ($request) {
            $possibleKeys = [];
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan form index di dalam key
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                
                // Format tanpa tab suffix
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && !empty($value)) {
                    if (is_array($value)) {
                        return array_filter($value);
                    }
                    return [$value];
                }
            }
            
            return [];
        };
        
        /**
         * Mencari nilai satuan unit dengan berbagai format (termasuk tab)
         */
        $findSatuanUnit = function($formIndex) use ($request) {
            $possibleKeys = [];
            
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_tab{$tab}";
                $possibleKeys[] = "satuan_unit_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "satuan_unit_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit";
                $possibleKeys[] = "satuan_unit_{$formIndex}";
                $possibleKeys[] = "satuan_unit";
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found satuan_unit for form {$formIndex} using key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai rentang ukur min per form (disimpan di head)
         */
        $findRentangUkurMin = function($formIndex) use ($findValue) {
            $value = $findValue('rentang_ukur_min', $formIndex);
            if (empty($value)) {
                $value = $findValue('range_min', $formIndex);
            }
            return !empty($value) ? $value : '0';
        };
        
        /**
         * Mencari nilai rentang ukur max per form (disimpan di head)
         */
        $findRentangUkurMax = function($formIndex) use ($findValue) {
            $value = $findValue('rentang_ukur_max', $formIndex);
            if (empty($value)) {
                $value = $findValue('range_max', $formIndex);
            }
            return !empty($value) ? $value : '';
        };
        
        /**
         * Mencari nilai kapasitas per form (disimpan di head)
         */
        $findKapasitas = function($formIndex) use ($findValue) {
            $value = $findValue('kapasitas', $formIndex);
            if (empty($value)) {
                $value = $findValue('capacity', $formIndex);
            }
            return !empty($value) ? $value : '';
        };
        
        /**
         * Mencari nilai resolusi per form (disimpan di head)
         */
        $findResolusi = function($formIndex) use ($findValue) {
            $value = $findValue('resolusi', $formIndex);
            if (empty($value)) {
                $value = $findValue('resolution', $formIndex);
            }
            return !empty($value) ? $value : '';
        };
        
        // ==================================================================
        // 3. STORE HEADS UNTUK SETIAP FORM
        //    (Alat Standar, Rentang Ukur Min/Max, Kapasitas, Resolusi SEMUA per form)
        // ==================================================================
        $headsUpdated = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            // Ambil semua data per form
            $satuanUnit = $findSatuanUnit($formIndex);
            $rentangUkurMin = $findRentangUkurMin($formIndex);
            $rentangUkurMax = $findRentangUkurMax($formIndex);
            $kapasitas = $findKapasitas($formIndex);
            $resolusi = $findResolusi($formIndex);
            
            // Ambil alat standar PER FORM (tidak dari form 1)
            $alatStandar = $findArrayValue('alat_standar', $formIndex);
            $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
            
            \Log::info("📝 Creating/Updating head for form {$formIndex}", [
                'satuan_unit' => $satuanUnit,
                'rentang_ukur_min' => $rentangUkurMin,
                'rentang_ukur_max' => $rentangUkurMax,
                'kapasitas' => $kapasitas,
                'resolusi' => $resolusi,
                'standard' => $standardValue,
            ]);
            
            HeadInsideMicrometer::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'satuan_unit' => $satuanUnit,
                    'rentang_ukur_min' => $rentangUkurMin,
                    'rentang_ukur_max' => $rentangUkurMax,
                    'kapasitas' => $kapasitas,
                    'resolusi' => $resolusi,
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK1102-01 (JIS B 7502:2016 (JMA/JSA); SNSU PK.P-01:2020)',
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
            $headsUpdated++;
        }
        
        \Log::info("✅ Updated {$headsUpdated} head records");
        
        // ==================================================================
        // 4. HAPUS DATA LAMA UNTUK FORM YANG TIDAK ADA
        // ==================================================================
        HeadInsideMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
            
        DetailInsideMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 5. STORE DETAILS UNTUK SETIAP FORM
        // ==================================================================
        $totalDetailsSaved = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing details for form {$formIndex}");
            
            // Deteksi maksimum row dari yang ada di request
            $maxRow = 0;
            
            for ($row = 1; $row <= 20; $row++) {
                $titikUkur = $findValue('nominal', $formIndex, [$row]);
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('setting', $formIndex, [$row]);
                }
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('titik_ukur', $formIndex, [$row]);
                }
                
                if ($titikUkur !== null && $titikUkur !== '') {
                    $maxRow = $maxRow > 0 ? max($maxRow, $row) : $row;
                }
            }
            
            // Jika tidak ada nominal sama sekali, skip
            if ($maxRow === 0) {
                \Log::info("No nominal data found for form {$formIndex}, skipping details");
                continue;
            }
            
            // Set minimal row ke 14
            $maxRow = max($maxRow, 14);
            \Log::info("Processing up to row {$maxRow} for form {$formIndex}");
            
            for ($row = 1; $row <= $maxRow; $row++) {
                // Cari nilai nominal (titik ukur)
                $titikUkur = $findValue('nominal', $formIndex, [$row]);
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('setting', $formIndex, [$row]);
                }
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('titik_ukur', $formIndex, [$row]);
                }
                
                // Ambil 5 nilai penunjukan
                $penunjukan = [];
                for ($col = 1; $col <= 5; $col++) {
                    $value = $findValue('penunjukan', $formIndex, [$row, $col]);
                    if (empty($value)) {
                        $value = $findValue('nilai', $formIndex, [$row, $col]);
                    }
                    if (empty($value)) {
                        $value = $findValue('pembacaan', $formIndex, [$row, $col]);
                    }
                    $penunjukan[] = $value;
                }
                
                $hasTitikUkur = !empty(trim($titikUkur ?? ''));
                $hasAnyPenunjukan = !empty($penunjukan[0]) || !empty($penunjukan[1]) || 
                                    !empty($penunjukan[2]) || !empty($penunjukan[3]) || 
                                    !empty($penunjukan[4]);
                
                if ($hasTitikUkur || $hasAnyPenunjukan) {
                    if (empty($titikUkur)) {
                        $titikUkur = '0';
                    }
                    
                    $detailData = [
                        'ulangan01' => !empty($penunjukan[0]) ? str_replace(',', '.', $penunjukan[0]) : null,
                        'ulangan02' => !empty($penunjukan[1]) ? str_replace(',', '.', $penunjukan[1]) : null,
                        'ulangan03' => !empty($penunjukan[2]) ? str_replace(',', '.', $penunjukan[2]) : null,
                        'ulangan04' => !empty($penunjukan[3]) ? str_replace(',', '.', $penunjukan[3]) : null,
                        'ulangan05' => !empty($penunjukan[4]) ? str_replace(',', '.', $penunjukan[4]) : null,
                    ];
                    
                    DetailInsideMicrometer::updateOrCreate(
                        [
                            'calibration_id' => $calibration->id,
                            'form_index' => $formIndex,
                            'titikUkur' => $titikUkur
                        ],
                        $detailData
                    );
                    $totalDetailsSaved++;
                    \Log::debug("Detail saved for form {$formIndex}, row {$row}", [
                        'titikUkur' => $titikUkur,
                        'penunjukan' => $penunjukan
                    ]);
                }
            }
        }
        
        \Log::info("✅ Saved {$totalDetailsSaved} detail measurements for Inside Micrometer");
        
        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN JUMLAH FORM
        // ==================================================================
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        \Log::info('✅ storeInsideMicrometer completed successfully', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'heads_updated' => $headsUpdated,
            'total_details_saved' => $totalDetailsSaved
        ]);
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeInsideMicrometer FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function storeOutsideMicrometer($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1)
{
    \Log::info('🚀 ===== START storeOutsideMicrometer =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm
    ]);
    
    try {
        // ==================================================================
        // 1. KONFIGURASI MULTIPLE FORM
        // ==================================================================
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm
        ]);
        
        // ==================================================================
        // 2. FUNGSI BANTU UNTUK MENCARI NILAI (LOOPING SEMUA KEMUNGKINAN TAB)
        // ==================================================================
        
        /**
         * Mencari nilai dari request dengan berbagai kemungkinan format key (termasuk tab)
         */
        $findValue = function($baseKey, $formIndex, $additionalParams = []) use ($request) {
            $possibleKeys = [];
            $suffix = !empty($additionalParams) ? '_' . implode('_', $additionalParams) : '';
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan double formIndex dan tab
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tab}";
                
                // Format tanpa tab suffix
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "{$baseKey}{$suffix}";
            }
            
            // Hapus duplikasi
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai array (alat_standar) dengan berbagai format (termasuk tab)
         */
        $findArrayValue = function($baseKey, $formIndex) use ($request) {
            $possibleKeys = [];
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && !empty($value)) {
                    if (is_array($value)) {
                        return array_filter($value);
                    }
                    return [$value];
                }
            }
            
            return [];
        };
        
        /**
         * Mencari nilai satuan unit dengan berbagai format (termasuk tab)
         */
        $findSatuanUnit = function($formIndex) use ($request) {
            $possibleKeys = [];
            
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_tab{$tab}";
                $possibleKeys[] = "satuan_unit_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "satuan_unit_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit";
                $possibleKeys[] = "satuan_unit_{$formIndex}";
                $possibleKeys[] = "satuan_unit";
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found satuan_unit for form {$formIndex} using key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * 🔥 BARU: Mencari nilai rentang ukur min per form
         */
        $findRentangUkurMin = function($formIndex) use ($findValue) {
            $value = $findValue('rentang_ukur_min', $formIndex);
            if (empty($value)) {
                $value = $findValue('range_min', $formIndex);
            }
            if (empty($value)) {
                $value = $findValue('rentang_ukur_min', $formIndex, []);
            }
            return !empty($value) ? $value : '0';
        };
        
        /**
         * 🔥 BARU: Mencari nilai rentang ukur max per form
         */
        $findRentangUkurMax = function($formIndex) use ($findValue) {
            $value = $findValue('rentang_ukur_max', $formIndex);
            if (empty($value)) {
                $value = $findValue('range_max', $formIndex);
            }
            if (empty($value)) {
                $value = $findValue('rentang_ukur_max', $formIndex, []);
            }
            return !empty($value) ? $value : '';
        };
        
        /**
         * 🔥 BARU: Mencari nilai kapasitas per form
         */
        $findKapasitas = function($formIndex) use ($findValue) {
            $value = $findValue('kapasitas', $formIndex);
            if (empty($value)) {
                $value = $findValue('capacity', $formIndex);
            }
            if (empty($value)) {
                $value = $findValue('kapasitas', $formIndex, []);
            }
            return !empty($value) ? $value : '';
        };
        
        /**
         * 🔥 BARU: Mencari nilai resolusi per form
         */
        $findResolusi = function($formIndex) use ($findValue) {
            $value = $findValue('resolusi', $formIndex);
            if (empty($value)) {
                $value = $findValue('resolution', $formIndex);
            }
            if (empty($value)) {
                $value = $findValue('resolusi', $formIndex, []);
            }
            return !empty($value) ? $value : '';
        };
        
        // ==================================================================
        // 3. AMBIL ALAT STANDAR PER FORM (TIDAK DARI FORM 1)
        // ==================================================================
        
        // ==================================================================
        // 4. LOOP UNTUK SETIAP FORM
        // ==================================================================
        $headsUpdated = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("=========================================");
            \Log::info("📝 PROCESSING FORM {$formIndex}");
            \Log::info("=========================================");
            
            // 🔥 AMBIL DATA DARI REQUEST (PER FORM)
            $satuanUnit = $findSatuanUnit($formIndex);
            $rentangUkurMin = $findRentangUkurMin($formIndex);
            $rentangUkurMax = $findRentangUkurMax($formIndex);
            $kapasitas = $findKapasitas($formIndex);
            $resolusi = $findResolusi($formIndex);
            
            // 🔥 AMBIL ALAT STANDAR PER FORM (MASING-MASING FORM PUNYA SENDIRI)
            $alatStandar = $findArrayValue('alat_standar', $formIndex);
            
            // Jika masih kosong dan ini form 1, coba dari alat_standar biasa (backward compatibility)
            if (empty($alatStandar) && $formIndex == 1) {
                $alatStandar = $request->input('alat_standar', []);
                if (!is_array($alatStandar)) {
                    $alatStandar = [$alatStandar];
                }
            }
            
            // Pastikan dalam bentuk array
            if (!is_array($alatStandar)) {
                $alatStandar = [$alatStandar];
            }
            
            // Filter nilai kosong
            $alatStandar = array_filter($alatStandar);
            
            // Simpan ke database
            $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
            
            \Log::info("📝 Head data untuk form {$formIndex}:", [
                'satuan_unit' => $satuanUnit,
                'rentang_ukur_min' => $rentangUkurMin,
                'rentang_ukur_max' => $rentangUkurMax,
                'kapasitas' => $kapasitas,
                'resolusi' => $resolusi,
                'standard' => $standardValue,
            ]);
            
            // ==========================================================
            // SIMPAN HEAD OUTSIDE MICROMETER (DENGAN FIELD BARU)
            // ==========================================================
            HeadOutsideMicrometer::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'satuan_unit' => $satuanUnit,
                    'rentang_ukur_min' => $rentangUkurMin,
                    'rentang_ukur_max' => $rentangUkurMax,
                    'kapasitas' => $kapasitas,
                    'resolusi' => $resolusi,
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK1102-02 (JIS B 7502:2016 (JMA/JSA); SNSU PK.P-01:2020)',
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
            $headsUpdated++;
            
            // ==========================================================
            // SIMPAN DATA UJI KERATAAN (ADD OUTSIDE MICROMETER)
            // ==========================================================
            $ujiKerataanData = [
                'ukuranAnvil1' => $findValue('ukuranAnvil1', $formIndex, []),
                'jumlahAnvil1' => $findValue('jumlahAnvil1', $formIndex, []),
                'ukuranAnvil2' => $findValue('ukuranAnvil2', $formIndex, []),
                'jumlahAnvil2' => $findValue('jumlahAnvil2', $formIndex, []),
                'ukuranSpindle1' => $findValue('ukuranSpindle1', $formIndex, []),
                'jumlahSpindle1' => $findValue('jumlahSpindle1', $formIndex, []),
                'ukuranSpindle2' => $findValue('ukuranSpindle2', $formIndex, []),
                'jumlahSpindle2' => $findValue('jumlahSpindle2', $formIndex, []),
            ];
            
            \Log::info("📝 UJI KERATAAN DATA FOR FORM {$formIndex}:", $ujiKerataanData);
            
            AddOutsideMicrometer::updateOrCreate(
                [
                    'calibration_id' => $calibration->id,
                    'form_index' => $formIndex
                ],
                $ujiKerataanData
            );
            
            // ==========================================================
            // SIMPAN DETAIL MEASUREMENTS (UJI SKALA NOMINAL)
            // ==========================================================
            $detailCount = 0;
            for ($row = 1; $row <= 14; $row++) {
                // Cari nilai nominal (titik ukur)
                $titikUkur = $findValue('nominal', $formIndex, [$row]);
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('setting', $formIndex, [$row]);
                }
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('titik_ukur', $formIndex, [$row]);
                }
                
                // Ambil 5 nilai penunjukan
                $penunjukan = [];
                for ($col = 1; $col <= 5; $col++) {
                    $value = $findValue('penunjukan', $formIndex, [$row, $col]);
                    if (empty($value)) {
                        $value = $findValue('nilai', $formIndex, [$row, $col]);
                    }
                    if (empty($value)) {
                        $value = $findValue('pembacaan', $formIndex, [$row, $col]);
                    }
                    $penunjukan[] = $value;
                }
                
                $hasTitikUkur = !empty(trim($titikUkur ?? ''));
                $hasAnyPenunjukan = !empty($penunjukan[0]) || !empty($penunjukan[1]) || 
                                    !empty($penunjukan[2]) || !empty($penunjukan[3]) || 
                                    !empty($penunjukan[4]);
                
                if ($hasTitikUkur || $hasAnyPenunjukan) {
                    $detailData = [
                        'ulangan01' => !empty($penunjukan[0]) ? str_replace(',', '.', $penunjukan[0]) : null,
                        'ulangan02' => !empty($penunjukan[1]) ? str_replace(',', '.', $penunjukan[1]) : null,
                        'ulangan03' => !empty($penunjukan[2]) ? str_replace(',', '.', $penunjukan[2]) : null,
                        'ulangan04' => !empty($penunjukan[3]) ? str_replace(',', '.', $penunjukan[3]) : null,
                        'ulangan05' => !empty($penunjukan[4]) ? str_replace(',', '.', $penunjukan[4]) : null,
                    ];
                    
                    DetailOutsideMicrometer::updateOrCreate(
                        [
                            'calibration_id' => $calibration->id,
                            'form_index' => $formIndex,
                            'titikUkur' => $titikUkur
                        ],
                        $detailData
                    );
                    $detailCount++;
                    \Log::debug("Detail saved for form {$formIndex}, row {$row}", [
                        'titikUkur' => $titikUkur,
                        'penunjukan' => $penunjukan
                    ]);
                }
            }
            \Log::info("📊 DETAIL SAVED FOR FORM {$formIndex}: {$detailCount} records");
        }
        
        // ==================================================================
        // 5. HAPUS DATA LAMA UNTUK FORM YANG TIDAK ADA
        // ==================================================================
        HeadOutsideMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        AddOutsideMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        DetailOutsideMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN JUMLAH FORM
        // (JANGAN UPDATE RANGE, KAPASITAS, RESOLUSI DI CALIBRATION)
        // ==================================================================
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        // FINAL VERIFICATION
        $allHeads = HeadOutsideMicrometer::where('calibration_id', $calibration->id)->get();
        $allDetails = DetailOutsideMicrometer::where('calibration_id', $calibration->id)->get();
        $allAdd = AddOutsideMicrometer::where('calibration_id', $calibration->id)->get();
        
        \Log::info("🎯 FINAL SUMMARY:", [
            'total_head_records' => $allHeads->count(),
            'head_by_form' => $allHeads->groupBy('form_index')->map->count(),
            'total_detail_records' => $allDetails->count(),
            'detail_by_form' => $allDetails->groupBy('form_index')->map->count(),
            'total_add_records' => $allAdd->count(),
            'add_by_form' => $allAdd->groupBy('form_index')->map->count(),
            'jumlah_form' => $jumlahForm,
            'heads_updated' => $headsUpdated
        ]);
        
        \Log::info('✅ storeOutsideMicrometer completed successfully');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeOutsideMicrometer FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

  private function storeDepthMicrometer($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1)
{
    \Log::info('🚀 ===== START storeDepthMicrometer =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm
    ]);
    
    try {
        // ==================================================================
        // 1. KONFIGURASI MULTIPLE FORM
        // ==================================================================
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm
        ]);
        
        // ==================================================================
        // 2. FUNGSI BANTU UNTUK MENCARI NILAI (LOOPING SEMUA KEMUNGKINAN TAB)
        // ==================================================================
        
        /**
         * Mencari nilai dari request dengan berbagai kemungkinan format key (termasuk tab)
         */
        $findValue = function($baseKey, $formIndex, $additionalParams = []) use ($request) {
            $possibleKeys = [];
            $suffix = !empty($additionalParams) ? '_' . implode('_', $additionalParams) : '';
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan double formIndex dan tab
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tab}";
                
                // Format tanpa tab suffix
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "{$baseKey}{$suffix}";
            }
            
            // Hapus duplikasi
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai array (alat_standar) dengan berbagai format (termasuk tab)
         */
        $findArrayValue = function($baseKey, $formIndex) use ($request) {
            $possibleKeys = [];
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && !empty($value)) {
                    if (is_array($value)) {
                        return array_filter($value);
                    }
                    return [$value];
                }
            }
            
            return [];
        };
        
        /**
         * Mencari nilai satuan unit dengan berbagai format (termasuk tab)
         */
        $findSatuanUnit = function($formIndex) use ($request) {
            $possibleKeys = [];
            
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_tab{$tab}";
                $possibleKeys[] = "satuan_unit_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "satuan_unit_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_satuan_unit";
                $possibleKeys[] = "satuan_unit_{$formIndex}";
                $possibleKeys[] = "satuan_unit";
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found satuan_unit for form {$formIndex} using key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * 🔥 BARU: Mencari nilai rentang ukur min per form
         */
        $findRentangUkurMin = function($formIndex) use ($findValue) {
            $value = $findValue('rentang_ukur_min', $formIndex);
            if (empty($value)) {
                $value = $findValue('range_min', $formIndex);
            }
            return !empty($value) ? $value : '0';
        };
        
        /**
         * 🔥 BARU: Mencari nilai rentang ukur max per form
         */
        $findRentangUkurMax = function($formIndex) use ($findValue) {
            $value = $findValue('rentang_ukur_max', $formIndex);
            if (empty($value)) {
                $value = $findValue('range_max', $formIndex);
            }
            return !empty($value) ? $value : '';
        };
        
        /**
         * 🔥 BARU: Mencari nilai kapasitas per form
         */
        $findKapasitas = function($formIndex) use ($findValue) {
            $value = $findValue('kapasitas', $formIndex);
            if (empty($value)) {
                $value = $findValue('capacity', $formIndex);
            }
            return !empty($value) ? $value : '';
        };
        
        /**
         * 🔥 BARU: Mencari nilai resolusi per form
         */
        $findResolusi = function($formIndex) use ($findValue) {
            $value = $findValue('resolusi', $formIndex);
            if (empty($value)) {
                $value = $findValue('resolution', $formIndex);
            }
            return !empty($value) ? $value : '';
        };
        
        // ==================================================================
        // 3. STORE HEADS UNTUK SETIAP FORM (DENGAN FIELD BARU)
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $satuanUnit = $findSatuanUnit($formIndex);
            
            // 🔥 AMBIL DATA PER FORM
            $rentangUkurMin = $findRentangUkurMin($formIndex);
            $rentangUkurMax = $findRentangUkurMax($formIndex);
            $kapasitas = $findKapasitas($formIndex);
            $resolusi = $findResolusi($formIndex);
            
            // 🔥 AMBIL ALAT STANDAR PER FORM (MASING-MASING FORM PUNYA SENDIRI)
            $alatStandar = $findArrayValue('alat_standar', $formIndex);
            
            // Jika masih kosong dan ini form 1, coba dari alat_standar biasa (backward compatibility)
            if (empty($alatStandar) && $formIndex == 1) {
                $alatStandar = $request->input('alat_standar', []);
                if (!is_array($alatStandar)) {
                    $alatStandar = [$alatStandar];
                }
            }
            
            // Pastikan dalam bentuk array
            if (!is_array($alatStandar)) {
                $alatStandar = [$alatStandar];
            }
            
            // Filter nilai kosong
            $alatStandar = array_filter($alatStandar);
            
            // Simpan ke database
            $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
            
            \Log::info("📝 Creating/Updating head for form {$formIndex}", [
                'satuan_unit' => $satuanUnit,
                'rentang_ukur_min' => $rentangUkurMin,
                'rentang_ukur_max' => $rentangUkurMax,
                'kapasitas' => $kapasitas,
                'resolusi' => $resolusi,
                'standard' => $standardValue,
            ]);
            
            HeadDepthMicrometer::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'satuan_unit' => $satuanUnit,
                    'rentang_ukur_min' => $rentangUkurMin,
                    'rentang_ukur_max' => $rentangUkurMax,
                    'kapasitas' => $kapasitas,
                    'resolusi' => $resolusi,
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK1102-06 (JIS B 7544 : 1994)',
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
        }
        
        // ==================================================================
        // 4. HAPUS DATA LAMA UNTUK FORM YANG TIDAK ADA
        // ==================================================================
        HeadDepthMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        DetailDepthMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 5. STORE DETAILS UNTUK SETIAP FORM
        // ==================================================================
        $totalDetailsSaved = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing details for form {$formIndex}");
            
            // Deteksi maksimum row dari yang ada di request
            $maxRow = 0;
            
            for ($row = 1; $row <= 20; $row++) {
                $titikUkur = $findValue('nominal', $formIndex, [$row]);
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('setting', $formIndex, [$row]);
                }
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('titik_ukur', $formIndex, [$row]);
                }
                
                if ($titikUkur !== null && $titikUkur !== '') {
                    $maxRow = $maxRow > 0 ? max($maxRow, $row) : $row;
                }
            }
            
            // Jika tidak ada nominal sama sekali, skip
            if ($maxRow === 0) {
                \Log::info("No nominal data found for form {$formIndex}, skipping details");
                continue;
            }
            
            // Set minimal row ke 14
            $maxRow = max($maxRow, 14);
            \Log::info("Processing up to row {$maxRow} for form {$formIndex}");
            
            for ($row = 1; $row <= $maxRow; $row++) {
                // Cari nilai nominal (titik ukur)
                $titikUkur = $findValue('nominal', $formIndex, [$row]);
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('setting', $formIndex, [$row]);
                }
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('titik_ukur', $formIndex, [$row]);
                }
                
                // Ambil 5 nilai penunjukan
                $penunjukan = [];
                for ($col = 1; $col <= 5; $col++) {
                    $value = $findValue('penunjukan', $formIndex, [$row, $col]);
                    if (empty($value)) {
                        $value = $findValue('nilai', $formIndex, [$row, $col]);
                    }
                    if (empty($value)) {
                        $value = $findValue('pembacaan', $formIndex, [$row, $col]);
                    }
                    $penunjukan[] = $value;
                }
                
                $hasTitikUkur = !empty(trim($titikUkur ?? ''));
                $hasAnyPenunjukan = !empty($penunjukan[0]) || !empty($penunjukan[1]) || 
                                    !empty($penunjukan[2]) || !empty($penunjukan[3]) || 
                                    !empty($penunjukan[4]);
                
                if ($hasTitikUkur || $hasAnyPenunjukan) {
                    if (empty($titikUkur)) {
                        $titikUkur = '0';
                    }
                    
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $titikUkur,
                        'ulangan01' => !empty($penunjukan[0]) ? str_replace(',', '.', $penunjukan[0]) : null,
                        'ulangan02' => !empty($penunjukan[1]) ? str_replace(',', '.', $penunjukan[1]) : null,
                        'ulangan03' => !empty($penunjukan[2]) ? str_replace(',', '.', $penunjukan[2]) : null,
                        'ulangan04' => !empty($penunjukan[3]) ? str_replace(',', '.', $penunjukan[3]) : null,
                        'ulangan05' => !empty($penunjukan[4]) ? str_replace(',', '.', $penunjukan[4]) : null,
                    ];
                    
                    DetailDepthMicrometer::updateOrCreate(
                        [
                            'calibration_id' => $calibration->id,
                            'form_index' => $formIndex,
                            'titikUkur' => $titikUkur
                        ],
                        $detailData
                    );
                    $totalDetailsSaved++;
                    \Log::debug("Detail saved for form {$formIndex}, row {$row}", [
                        'titikUkur' => $titikUkur,
                        'penunjukan' => $penunjukan
                    ]);
                }
            }
        }
        
        \Log::info("✅ Saved {$totalDetailsSaved} detail measurements for Depth Micrometer");
        
        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN JUMLAH FORM
        // (JANGAN UPDATE RANGE, KAPASITAS, RESOLUSI DI CALIBRATION)
        // ==================================================================
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        // FINAL VERIFICATION
        $allHeads = HeadDepthMicrometer::where('calibration_id', $calibration->id)->get();
        $allDetails = DetailDepthMicrometer::where('calibration_id', $calibration->id)->get();
        
        \Log::info('🎯 FINAL SUMMARY:', [
            'total_head_records' => $allHeads->count(),
            'head_by_form' => $allHeads->groupBy('form_index')->map->count(),
            'total_detail_records' => $allDetails->count(),
            'detail_by_form' => $allDetails->groupBy('form_index')->map->count(),
            'jumlah_form' => $jumlahForm,
        ]);
        
        \Log::info('✅ storeDepthMicrometer completed successfully', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'total_details_saved' => $totalDetailsSaved
        ]);
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeDepthMicrometer FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

  private function updateDepthMicrometer($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateDepthMicrometer =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'namaAlat_di_calibration' => $calibration->namaAlat,
            'certificate_id_lama_di_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $calibration->namaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $calibration->namaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } elseif (empty($calibration->certificate_id) || strpos($calibration->certificate_id ?? '', 'MANUAL_INPUT') !== false) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong atau MANUAL_INPUT):', [
                'certificate_id_lama' => $calibration->certificate_id,
                'certificate_id_baru' => $certificateIdBaru
            ]);
        }
        
        // Update certificate_id di tabel calibration
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $calibration->update(['certificate_id' => $certificateIdBaru]);
            $calibration->refresh();
            
            \Log::info('📝 UPDATE CERTIFICATE ID DI CALIBRATION:', [
                'certificate_id_baru' => $certificateIdBaru,
                'current_certificate_id' => $calibration->certificate_id
            ]);
        }
        
        // Ambil jumlah form dari request
        $jumlahForm = (int) ($request->jumlah_form ?? $calibration->jumlah_form ?? 1);
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 UPDATE Depth Micrometer - Multiple Form', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
        ]);
        
        // ==================================================================
        // 1. UPDATE HEAD UNTUK SETIAP FORM (DENGAN FIELD BARU PER FORM)
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $head = HeadDepthMicrometer::where('calibration_id', $calibration->id)
                ->where('form_index', $formIndex)
                ->first();
            
            // 🔥 AMBIL DATA DARI REQUEST (PER FORM)
            // Satuan Unit
            $satuanUnit = $request->input("satuan_unit_{$formIndex}", 
                          $request->input("satuan_unit", 'mm'));
            
            // 🔥 RENTANG UKUR MIN & MAX (PER FORM)
            $rentangUkurMin = $request->input("rentang_ukur_min_{$formIndex}", 
                             $request->input("rentang_ukur_min", '0'));
            $rentangUkurMax = $request->input("rentang_ukur_max_{$formIndex}", 
                             $request->input("rentang_ukur_max", ''));
            
            // 🔥 KAPASITAS & RESOLUSI (PER FORM)
            $kapasitas = $request->input("kapasitas_{$formIndex}", 
                        $request->input("kapasitas", ''));
            $resolusi = $request->input("resolusi_{$formIndex}", 
                      $request->input("resolusi", ''));
            
            // 🔥 AMBIL ALAT STANDAR UNTUK FORM INI (MASING-MASING FORM PUNYA SENDIRI)
            $alatStandar = [];
            
            // Coba ambil dari alat_standar_{formIndex}[]
            $alatStandar = $request->input("alat_standar_{$formIndex}", []);
            
            // Jika masih kosong dan ini form 1, coba dari alat_standar biasa (backward compatibility)
            if (empty($alatStandar) && $formIndex == 1) {
                $alatStandar = $request->input('alat_standar', []);
            }
            
            // Pastikan dalam bentuk array
            if (!is_array($alatStandar)) {
                $alatStandar = [$alatStandar];
            }
            
            // Filter nilai kosong
            $alatStandar = array_filter($alatStandar);
            
            // Simpan ke database
            $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
            
            $headData = [
                'satuan_unit' => $satuanUnit,
                'rentang_ukur_min' => $rentangUkurMin,
                'rentang_ukur_max' => $rentangUkurMax,
                'kapasitas' => $kapasitas,
                'resolusi' => $resolusi,
                'standard' => $standardValue,
                'calibrationMethod' => 'PAS-IK1102-06 (JIS B 7544 : 1994)',
            ];
            
            \Log::info("📝 Head data untuk form {$formIndex}:", [
                'satuan_unit' => $satuanUnit,
                'rentang_ukur_min' => $rentangUkurMin,
                'rentang_ukur_max' => $rentangUkurMax,
                'kapasitas' => $kapasitas,
                'resolusi' => $resolusi,
                'standard' => $standardValue,
            ]);
            
            // 🔥 UPDATE CERTIFICATE ID UNTUK SEMUA HEAD (FORM 1-4)
            if ($certificateIdUpdated && !empty($certificateIdBaru)) {
                $headData['certificate_id'] = $certificateIdBaru;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex}: {$certificateIdBaru}");
            } elseif ($newCertificateId && !$certificateIdUpdated) {
                $headData['certificate_id'] = $newCertificateId;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex} dari parameter: {$newCertificateId}");
            } elseif ($head && $head->certificate_id) {
                // Pertahankan certificate_id yang sudah ada
                $headData['certificate_id'] = $head->certificate_id;
            } else {
                $headData['certificate_id'] = $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
            }
            
            if ($head) {
                $head->update($headData);
                \Log::info("✅ Head updated for form {$formIndex}", [
                    'head_id' => $head->id,
                    'satuan_unit' => $head->satuan_unit,
                    'rentang_ukur_min' => $head->rentang_ukur_min,
                    'rentang_ukur_max' => $head->rentang_ukur_max,
                    'kapasitas' => $head->kapasitas,
                    'resolusi' => $head->resolusi,
                    'standard' => $head->standard,
                    'certificate_id' => $head->certificate_id ?? 'not_set'
                ]);
            } else {
                $headData['calibration_id'] = $calibration->id;
                $headData['form_index'] = $formIndex;
                $head = HeadDepthMicrometer::create($headData);
                \Log::info("➕ New head created for form {$formIndex}");
            }
        }
        
        // Hapus head untuk form yang tidak digunakan
        HeadDepthMicrometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS (UJI SKALA NOMINAL) PER FORM
        // ==================================================================
        DetailDepthMicrometer::where('calibration_id', $calibration->id)->delete();
        
        $totalDetailCount = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing details for form {$formIndex}");
            
            // Coba ambil data dengan berbagai format (dengan prefix form index)
            $titikUkurArray = $request->input("titikUkur_{$formIndex}", []);
            $ulangan01Array = $request->input("ulangan01_{$formIndex}", []);
            $ulangan02Array = $request->input("ulangan02_{$formIndex}", []);
            $ulangan03Array = $request->input("ulangan03_{$formIndex}", []);
            $ulangan04Array = $request->input("ulangan04_{$formIndex}", []);
            $ulangan05Array = $request->input("ulangan05_{$formIndex}", []);
            
            // Jika tidak ada data dengan format per form, coba ambil dari format array biasa
            if (empty($titikUkurArray)) {
                $titikUkurArray = $request->input("titikUkur", []);
                $ulangan01Array = $request->input("ulangan01", []);
                $ulangan02Array = $request->input("ulangan02", []);
                $ulangan03Array = $request->input("ulangan03", []);
                $ulangan04Array = $request->input("ulangan04", []);
                $ulangan05Array = $request->input("ulangan05", []);
                \Log::info("Using fallback array format for form {$formIndex}");
            }
            
            for ($i = 0; $i < 14; $i++) {
                $titikUkur = $titikUkurArray[$i] ?? '';
                $ulangan01 = $ulangan01Array[$i] ?? '';
                $ulangan02 = $ulangan02Array[$i] ?? '';
                $ulangan03 = $ulangan03Array[$i] ?? '';
                $ulangan04 = $ulangan04Array[$i] ?? '';
                $ulangan05 = $ulangan05Array[$i] ?? '';
                
                $hasData = !empty(trim($titikUkur)) || 
                          !empty(trim($ulangan01)) || 
                          !empty(trim($ulangan02)) || 
                          !empty(trim($ulangan03)) || 
                          !empty(trim($ulangan04)) || 
                          !empty(trim($ulangan05));
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $titikUkur,
                        'ulangan01' => !empty($ulangan01) ? str_replace(',', '.', $ulangan01) : null,
                        'ulangan02' => !empty($ulangan02) ? str_replace(',', '.', $ulangan02) : null,
                        'ulangan03' => !empty($ulangan03) ? str_replace(',', '.', $ulangan03) : null,
                        'ulangan04' => !empty($ulangan04) ? str_replace(',', '.', $ulangan04) : null,
                        'ulangan05' => !empty($ulangan05) ? str_replace(',', '.', $ulangan05) : null,
                    ];
                    
                    DetailDepthMicrometer::create($detailData);
                    $totalDetailCount++;
                }
            }
        }
        
        \Log::info("✅ DETAIL DATA PROCESSED:", [
            'total_records' => $totalDetailCount,
            'forms_processed' => $jumlahForm
        ]);
        
        // ==================================================================
        // 3. UPDATE FIELD LAINNYA DI CALIBRATION
        // ⚠️ JANGAN UPDATE RANGE MIN/MAX, KAPASITAS, RESOLUSI!
        // ==================================================================
        $updateData = [
            'namaAlat' => $namaAlatDariRequest,
            'brandAlat' => $request->brandAlat ?? $calibration->brandAlat,
            'kodeAlat' => $request->kodeAlat ?? $calibration->kodeAlat,
            'typeAlat' => $request->typeAlat ?? $calibration->typeAlat,
            'NoSeri' => $request->NoSeri ?? $calibration->NoSeri,
            'pemilikAlat' => $request->pemilikAlat ?? $calibration->pemilikAlat,
            'tanggalMasuk' => $request->tanggalMasuk ?? $calibration->tanggalMasuk,
            'tanggalKalibrasi' => $request->tanggalKalibrasi ?? $calibration->tanggalKalibrasi,
            'tempatKalibrasi' => $request->tempatKalibrasi ?? $calibration->tempatKalibrasi,
            'jenisPembacaan' => $request->jenisPembacaan ?? $calibration->jenisPembacaan,
            'lokasiPT' => $request->lokasiPT ?? $calibration->lokasiPT,
            'kode_th' => $request->kode_th ?? $calibration->kode_th,
            'kondisiAlat' => $request->kondisiAlat ?? $calibration->kondisiAlat,
            'keterangan' => $request->keterangan ?? $calibration->keterangan,
            'RT_condition1' => $request->RT_condition1 ?? $calibration->RT_condition1,
            'RT_condition2' => $request->RT_condition2 ?? $calibration->RT_condition2,
            'RT_condition3' => $request->RT_condition3 ?? $calibration->RT_condition3,
            'RH_condition1' => $request->RH_condition1 ?? $calibration->RH_condition1,
            'RH_condition2' => $request->RH_condition2 ?? $calibration->RH_condition2,
            'RH_condition3' => $request->RH_condition3 ?? $calibration->RH_condition3,
            'calibratedBy' => $request->calibratedBy ?? $calibration->calibratedBy,
            'verifiedBy' => $request->verifiedBy ?? $calibration->verifiedBy,
            'jumlah_form' => $jumlahForm,
        ];
        
        // ⚠️ HAPUS FIELD YANG SUDAH DIPINDAHKAN KE HEAD
        unset($updateData['rangeMin']);
        unset($updateData['rangeMax']);
        unset($updateData['kapasitas']);
        unset($updateData['resolusi']);
        
        $calibration->update($updateData);
        $calibration->refresh();
        
        // ==================================================================
        // 4. FINAL SUMMARY
        // ==================================================================
        $finalHeadCount = HeadDepthMicrometer::where('calibration_id', $calibration->id)->count();
        $finalDetailCount = DetailDepthMicrometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('🎯 FINAL SUMMARY AFTER UPDATE:', [
            'total_heads' => $finalHeadCount,
            'heads_by_form' => HeadDepthMicrometer::where('calibration_id', $calibration->id)
                ->get()->groupBy('form_index')->map->count(),
            'total_details' => $finalDetailCount,
            'details_by_form' => DetailDepthMicrometer::where('calibration_id', $calibration->id)
                ->get()->groupBy('form_index')->map->count(),
            'jumlah_form' => $jumlahForm,
            'certificate_id_final' => $certificateIdBaru ?? $calibration->certificate_id
        ]);
        
        \Log::info('🎉 updateDepthMicrometer COMPLETED SUCCESSFULLY', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateIdBaru ?? $calibration->certificate_id,
            'detail_records' => $finalDetailCount,
            'jumlah_form' => $jumlahForm,
            'certificate_id_updated' => $certificateIdUpdated,
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateDepthMicrometer FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'unknown'
        ]);
        throw $e;
    }
}
    

    private function storeThermometer($request, $calibration, $certificateId, $isMultipleSubmit = false, $jumlahForm = 1)
{
    \Log::info('🚀 ===== START storeThermometer =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm
    ]);
    
    try {
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        // ==================================================================
        // FUNGSI BANTU UNTUK MENCARI NILAI DENGAN LOOPING SEMUA TAB (1-10)
        // ==================================================================
        
        /**
         * Mencari nilai dari request dengan berbagai kemungkinan format key
         */
        $findValue = function($baseKey, $formIndex, $additionalParams = []) use ($request) {
            $possibleKeys = [];
            $suffix = !empty($additionalParams) ? '_' . implode('_', $additionalParams) : '';
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan suffix tab
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                
                // Format tanpa suffix tab
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "{$baseKey}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}";
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai array (alat_standar, metode_kalibrasi) PER FORM
         * Dan menggabungkan dengan SPASI (bukan koma)
         */
        $findArrayValuePerForm = function($baseKey, $formIndex) use ($request) {
            $possibleKeys = [];
            
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan suffix formIndex dan tab
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                $possibleKeys[] = $baseKey;
                
                // Format dengan nama array
                $possibleKeys[] = "{$baseKey}[{$formIndex}]";
                $possibleKeys[] = "{$baseKey}.{$formIndex}";
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && !empty($value)) {
                    if (is_array($value)) {
                        // GABUNGKAN DENGAN SPASI (bukan koma)
                        // Contoh: ['TD.001', 'Microbath'] -> 'TD.001 Microbath'
                        return implode(' ', array_filter($value));
                    }
                    // Jika value berupa string, langsung return
                    if (is_string($value)) {
                        return trim($value);
                    }
                    return $value;
                }
            }
            
            return '';
        };
        
        /**
         * Mencari nilai numerik (range min, range max, kapasitas, resolusi)
         */
        $findNumericValue = function($baseKey, $formIndex) use ($request) {
            $possibleKeys = [];
            
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found numeric value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai satuan suhu dengan looping tab 1-10 (TANPA DEFAULT)
         */
        $findSatuanSuhu = function($baseKey, $formIndex) use ($request) {
            $possibleKeys = [];
            
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "form_{$formIndex}_form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found {$baseKey} for form {$formIndex} using key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        // ==================================================================
        // SIMPAN HEAD untuk SETIAP FORM (masing-masing form punya data sendiri)
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            
            // ==============================================================
            // AMBIL ALAT STANDAR PER FORM
            // SEKARANG LANGSUNG STRING (contoh: "TD.001 Microbath")
            // ==============================================================
            $standardValue = $findArrayValuePerForm('alat_standar', $formIndex);
            
            // ==============================================================
            // AMBIL METODE KALIBRASI PER FORM
            // ==============================================================
            $metodeKalibrasiValue = $findArrayValuePerForm('metode_kalibrasi', $formIndex);
            
            // ==============================================================
            // AMBIL RENTANG UKUR MIN, MAX, KAPASITAS, RESOLUSI PER FORM
            // ==============================================================
            $rangeMin = $findNumericValue('rentang_ukur_min', $formIndex);
            if (empty($rangeMin)) {
                $rangeMin = $findNumericValue('range_min', $formIndex);
            }
            
            $rangeMax = $findNumericValue('rentang_ukur_max', $formIndex);
            if (empty($rangeMax)) {
                $rangeMax = $findNumericValue('range_max', $formIndex);
            }
            
            $kapasitas = $findNumericValue('kapasitas', $formIndex);
            if (empty($kapasitas)) {
                $kapasitas = $findNumericValue('kapasitas_ukur', $formIndex);
            }
            
            $resolusi = $findNumericValue('resolusi', $formIndex);
            if (empty($resolusi)) {
                $resolusi = $findNumericValue('resolusi_ukur', $formIndex);
            }
            
            // ==============================================================
            // AMBIL KETERANGAN FUNGSI KOMPONEN PER FORM
            // ==============================================================
            $keteranganFungsiKomponen = $request->input("keterangan_fungsi_komponen_{$formIndex}");
            if (empty($keteranganFungsiKomponen)) {
                $keteranganFungsiKomponen = $request->input("keterangan_fungsi_komponen.{$formIndex}");
            }
            
            // ==============================================================
            // AMBIL SATUAN SUHU PER FORM
            // ==============================================================
            $satuanSuhuKiri = $findSatuanSuhu('satuan_suhu_kiri', $formIndex);
            if (empty($satuanSuhuKiri)) {
                $satuanSuhuKiri = $findSatuanSuhu('satuan_suhu', $formIndex);
            }
            
            $satuanSuhuKanan = $findSatuanSuhu('satuan_suhu_kanan', $formIndex);
            if (empty($satuanSuhuKanan)) {
                $satuanSuhuKanan = $findSatuanSuhu('satuan_suhu', $formIndex);
            }
            
            // ==============================================================
            // LOG UNTUK DEBUG
            // ==============================================================
            \Log::info("📝 Saving head for form {$formIndex}", [
                'standard' => $standardValue,
                'calibrationMethod' => $metodeKalibrasiValue,
                'range_min' => $rangeMin,
                'range_max' => $rangeMax,
                'kapasitas' => $kapasitas,
                'resolusi' => $resolusi,
                'keterangan_fungsi_komponen' => $keteranganFungsiKomponen,
                'satuan_suhu_kiri' => $satuanSuhuKiri,
                'satuan_suhu_kanan' => $satuanSuhuKanan,
                'certificate_id' => $certificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
            ]);
            
            // ==============================================================
            // SIMPAN HEAD KE DATABASE
            // ==============================================================
            HeadThermometer::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'standard' => $standardValue,
                    'calibrationMethod' => $metodeKalibrasiValue,
                    'range_min' => $rangeMin,
                    'range_max' => $rangeMax,
                    'kapasitas' => $kapasitas,
                    'resolusi' => $resolusi,
                    'keterangan_fungsi_komponen' => $keteranganFungsiKomponen,
                    'satuan_suhu_kiri' => $satuanSuhuKiri,
                    'satuan_suhu_kanan' => $satuanSuhuKanan,
                    'certificate_id' => $certificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
        }
        
        // ==================================================================
        // SIMPAN DETAIL UNTUK SETIAP FORM
        // ==================================================================
        $totalDetailsSaved = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing details for form {$formIndex}");
            
            // Data kalibrasi memiliki 36 baris (1-36), diproses per 3 baris
            for ($row = 1; $row <= 36; $row += 3) {
                // Cari nilai setting suhu (titik ukur)
                $titikUkur = $findValue('setting_suhu', $formIndex, [$row]);
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('titik_ukur', $formIndex, [$row]);
                }
                if (empty($titikUkur)) {
                    $titikUkur = $findValue('suhu', $formIndex, [$row]);
                }
                
                \Log::debug("Checking setting suhu for form {$formIndex}, row {$row}: {$titikUkur}");
                
                // Jika tidak ada setting suhu, skip kelompok ini
                if (empty($titikUkur) && $titikUkur !== '0') {
                    continue;
                }
                
                // Ambil 3 nilai STD dan 3 nilai UUT
                $stdValues = [];
                $uutValues = [];
                
                for ($offset = 0; $offset < 3; $offset++) {
                    $currentRow = $row + $offset;
                    
                    // Cari nilai STD
                    $stdValue = $findValue('std', $formIndex, [$currentRow]);
                    if (empty($stdValue)) {
                        $stdValue = $findValue('standard', $formIndex, [$currentRow]);
                    }
                    
                    // Cari nilai UUT
                    $uutValue = $findValue('uut', $formIndex, [$currentRow]);
                    if (empty($uutValue)) {
                        $uutValue = $findValue('unit', $formIndex, [$currentRow]);
                    }
                    
                    $stdValues[] = ($stdValue !== null && $stdValue !== '') ? $stdValue : null;
                    $uutValues[] = ($uutValue !== null && $uutValue !== '') ? $uutValue : null;
                }
                
                $detailData = [
                    'STD01' => $stdValues[0],
                    'STD02' => $stdValues[1],
                    'STD03' => $stdValues[2],
                    'UUT01' => $uutValues[0],
                    'UUT02' => $uutValues[1],
                    'UUT03' => $uutValues[2],
                ];
                
                \Log::debug("Saving detail for form {$formIndex}, row {$row}", [
                    'titikUkur' => $titikUkur,
                    'STD01' => $stdValues[0],
                    'STD02' => $stdValues[1],
                    'STD03' => $stdValues[2],
                    'UUT01' => $uutValues[0],
                    'UUT02' => $uutValues[1],
                    'UUT03' => $uutValues[2],
                ]);
                
                DetailThermometer::updateOrCreate(
                    [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => (string) $titikUkur
                    ],
                    $detailData
                );
                $totalDetailsSaved++;
            }
        }
        
        \Log::info("✅ Saved {$totalDetailsSaved} detail measurements for Thermometer");
        
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        \Log::info('✅ storeThermometer completed successfully');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeThermometer FAILED:', [
            'message' => $e->getMessage(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}
 /**
 * Update Thermometer data (Multiple Form Support)
 */
private function updateThermometer($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateThermometer =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head form 1 untuk cek certificate_id
        $form1Head = HeadThermometer::where('calibration_id', $calibration->id)
            ->where('form_index', 1)
            ->first();
        
        $currentCertificateId = $form1Head->certificate_id ?? null;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'namaAlat_di_calibration' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $calibration->namaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $calibration->namaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // Ambil jumlah form dari request
        $jumlahForm = (int) ($request->jumlah_form ?? $calibration->jumlah_form ?? 1);
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 UPDATE Thermometer - Multiple Form', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'certificate_id_akan_dipakai' => $certificateIdBaru ?? $currentCertificateId
        ]);
        
        // ==================================================================
        // 1. UPDATE HEAD UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $head = HeadThermometer::where('calibration_id', $calibration->id)
                ->where('form_index', $formIndex)
                ->first();
            
            // ==============================================================
            // AMBIL RENTANG UKUR MIN, MAX, KAPASITAS, RESOLUSI PER FORM
            // ==============================================================
            $rangeMin = $request->input("range_min_{$formIndex}");
            if (empty($rangeMin)) {
                $rangeMin = $request->input("rentang_ukur_min_{$formIndex}");
                if (empty($rangeMin)) {
                    $rangeMin = $request->input("rangeMin_{$formIndex}");
                }
            }
            
            $rangeMax = $request->input("range_max_{$formIndex}");
            if (empty($rangeMax)) {
                $rangeMax = $request->input("rentang_ukur_max_{$formIndex}");
                if (empty($rangeMax)) {
                    $rangeMax = $request->input("rangeMax_{$formIndex}");
                }
            }
            
            $kapasitas = $request->input("kapasitas_{$formIndex}");
            if (empty($kapasitas)) {
                $kapasitas = $request->input("kapasitas_ukur_{$formIndex}");
            }
            
            $resolusi = $request->input("resolusi_{$formIndex}");
            if (empty($resolusi)) {
                $resolusi = $request->input("resolusi_ukur_{$formIndex}");
            }
            
           // Di dalam loop for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++)
            // AMBIL KETERANGAN FUNGSI KOMPONEN - Coba semua kemungkinan format
            $keteranganFungsiKomponen = $request->input("keterangan_fungsi_komponen_{$formIndex}");
            if (empty($keteranganFungsiKomponen)) {
                $keteranganFungsiKomponen = $request->input("keterangan_fungsi_komponen.{$formIndex}");
            }
            if (empty($keteranganFungsiKomponen) && $formIndex == 1) {
                // Form 1 bisa juga menggunakan name tanpa suffix
                $keteranganFungsiKomponen = $request->input("keterangan_fungsi_komponen");
            }

            
            $satuanSuhuKiri = $request->input("satuan_suhu_kiri_{$formIndex}", '°C');
            $satuanSuhuKanan = $request->input("satuan_suhu_kanan_{$formIndex}", '°C');
            
            $headData = [
                'range_min' => $rangeMin,
                'range_max' => $rangeMax,
                'kapasitas' => $kapasitas,
                'resolusi' => $resolusi,
                'satuan_suhu_kiri' => $satuanSuhuKiri,
                'satuan_suhu_kanan' => $satuanSuhuKanan,
                'keterangan_fungsi_komponen' => $keteranganFungsiKomponen, 
            ];
            
            // Alat standar dan metode kalibrasi untuk form 1   
            if ($formIndex == 1) {
                $alatStandar = $request->input('alat_standar', []);
                if (is_array($alatStandar)) {
                    $headData['standard'] = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
                } else {
                    $headData['standard'] = $alatStandar ?? '';
                }
                
                $metodeKalibrasi = $request->input('metode_kalibrasi', []);
                if (is_array($metodeKalibrasi)) {
                    $headData['calibrationMethod'] = !empty($metodeKalibrasi) ? implode(', ', $metodeKalibrasi) : '';
                } else {
                    $headData['calibrationMethod'] = $metodeKalibrasi ?? '';
                }
            }
            
            // UPDATE CERTIFICATE ID DI HEAD (bukan di calibration)
            if ($certificateIdUpdated && !empty($certificateIdBaru)) {
                $headData['certificate_id'] = $certificateIdBaru;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex}: {$certificateIdBaru}");
            } elseif ($newCertificateId && !$certificateIdUpdated) {
                $headData['certificate_id'] = $newCertificateId;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex} dari parameter: {$newCertificateId}");
            }
            
            if ($head) {
                $head->update($headData);
                \Log::info("✅ Head updated for form {$formIndex}", [
                    'head_id' => $head->id,
                    'range_min' => $rangeMin,
                    'range_max' => $rangeMax,
                    'kapasitas' => $kapasitas,
                    'resolusi' => $resolusi,
                    'certificate_id' => $head->certificate_id,
                    'satuan_suhu_kiri' => $satuanSuhuKiri,
                    'satuan_suhu_kanan' => $satuanSuhuKanan,
                    'keterangan_fungsi_komponen' => $keteranganFungsiKomponen, 
                ]);
            } else {
                $headData['calibration_id'] = $calibration->id;
                $headData['form_index'] = $formIndex;
                if (empty($headData['certificate_id'])) {
                    $headData['certificate_id'] = $certificateIdBaru ?? $currentCertificateId ?? 'NEW-' . time();
                }
                $head = HeadThermometer::create($headData);
                \Log::info("➕ New head created for form {$formIndex}", [
                    'head_id' => $head->id,
                    'range_min' => $rangeMin,
                    'range_max' => $rangeMax,
                    'kapasitas' => $kapasitas,
                    'resolusi' => $resolusi,
                    'keterangan_fungsi_komponen' => $keteranganFungsiKomponen, 
                    'certificate_id' => $head->certificate_id
                ]);
            }
        }
        
        // Hapus head untuk form yang tidak digunakan
        HeadThermometer::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS
        // ==================================================================
        // Hapus detail lama untuk calibration ini
        DetailThermometer::where('calibration_id', $calibration->id)->delete();
        
        $totalDetailCount = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing details for form {$formIndex}");
            
            $detailRecords = [];
            
            // Loop untuk 36 baris
            for ($row = 1; $row <= 36; $row++) {
                // Ambil nilai std dan uut
                $stdValue = $request->input("std_{$formIndex}_{$row}");
                $uutValue = $request->input("uut_{$formIndex}_{$row}");
                
                // Ambil setting suhu (hanya pada baris 1,4,7,10,...)
                $titikUkur = null;
                if (($row - 1) % 3 == 0) {
                    $titikUkur = $request->input("setting_suhu_{$formIndex}_{$row}");
                }
                
                // Skip jika semua kosong
                if (empty($titikUkur) && empty($stdValue) && empty($uutValue)) {
                    continue;
                }
                
                // Kelompokkan per 3 baris
                $groupIndex = floor(($row - 1) / 3);
                $offset = ($row - 1) % 3;
                
                if (!isset($detailRecords[$groupIndex])) {
                    $detailRecords[$groupIndex] = [
                        'titikUkur' => $titikUkur,
                        'STD01' => null,
                        'STD02' => null,
                        'STD03' => null,
                        'UUT01' => null,
                        'UUT02' => null,
                        'UUT03' => null,
                    ];
                }
                
                $stdField = "STD0" . ($offset + 1);
                $uutField = "UUT0" . ($offset + 1);
                $detailRecords[$groupIndex][$stdField] = !empty($stdValue) ? $stdValue : null;
                $detailRecords[$groupIndex][$uutField] = !empty($uutValue) ? $uutValue : null;
            }
            
            // Simpan detail records
            foreach ($detailRecords as $record) {
                $hasData = !empty($record['titikUkur']) || 
                          !empty($record['STD01']) || !empty($record['STD02']) || !empty($record['STD03']) ||
                          !empty($record['UUT01']) || !empty($record['UUT02']) || !empty($record['UUT03']);
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $record['titikUkur'] ?? null,
                        'STD01' => $record['STD01'] ?? null,
                        'STD02' => $record['STD02'] ?? null,
                        'STD03' => $record['STD03'] ?? null,
                        'UUT01' => $record['UUT01'] ?? null,
                        'UUT02' => $record['UUT02'] ?? null,
                        'UUT03' => $record['UUT03'] ?? null,
                    ];
                    
                    DetailThermometer::create($detailData);
                    $totalDetailCount++;
                }
            }
        }
        
        // ==================================================================
        // 3. UPDATE CALIBRATION BASIC DATA (TANPA CERTIFICATE ID)
        // ==================================================================
        $calibrationUpdate = [];
        
        if ($request->filled('namaAlat')) {
            $calibrationUpdate['namaAlat'] = $request->namaAlat;
        }
        
        if ($request->filled('brandAlat')) {
            $calibrationUpdate['brandAlat'] = $request->brandAlat;
        }
        
        if ($request->filled('kodeAlat')) {
            $calibrationUpdate['kodeAlat'] = $request->kodeAlat;
        }
        
        if ($request->filled('typeAlat')) {
            $calibrationUpdate['typeAlat'] = $request->typeAlat;
        }
        
        if ($request->filled('NoSeri')) {
            $calibrationUpdate['NoSeri'] = $request->NoSeri;
        }
        
        if ($request->filled('pemilikAlat')) {
            $calibrationUpdate['pemilikAlat'] = $request->pemilikAlat;
        }
        
        if ($request->filled('tanggalMasuk')) {
            $calibrationUpdate['tanggalMasuk'] = $request->tanggalMasuk;
        }
        
        if ($request->filled('tanggalKalibrasi')) {
            $calibrationUpdate['tanggalKalibrasi'] = $request->tanggalKalibrasi;
        }
        
        if ($request->filled('jenisPembacaan')) {
            $calibrationUpdate['jenisPembacaan'] = $request->jenisPembacaan;
        }
        
        if ($request->filled('tempatKalibrasi')) {
            $calibrationUpdate['tempatKalibrasi'] = $request->tempatKalibrasi;
        }
        
        if ($request->filled('lokasiPT')) {
            $calibrationUpdate['lokasiPT'] = $request->lokasiPT;
        }
        
        if ($request->filled('kondisiAlat')) {
            $calibrationUpdate['kondisiAlat'] = $request->kondisiAlat;
        }
        
        if ($request->filled('keterangan')) {
            $calibrationUpdate['keterangan'] = $request->keterangan;
        }
        
        if ($request->filled('RT_condition1')) {
            $calibrationUpdate['RT_condition1'] = $request->RT_condition1;
            $calibrationUpdate['RT_condition2'] = $request->RT_condition2;
            $calibrationUpdate['RT_condition3'] = $request->RT_condition3;
        }
        
        if ($request->filled('RH_condition1')) {
            $calibrationUpdate['RH_condition1'] = $request->RH_condition1;
            $calibrationUpdate['RH_condition2'] = $request->RH_condition2;
            $calibrationUpdate['RH_condition3'] = $request->RH_condition3;
        }
        
        if ($request->filled('verifiedBy')) {
            $calibrationUpdate['verified_by'] = $request->verifiedBy;
        }
        
        // NOTE: rangeMin, rangeMax, kapasitas, resolusi TIDAK disimpan di calibration
        // karena sudah disimpan di HeadThermometer per form
        
        // KOSONGKAN certificate_id di calibration (biar null, tidak dipakai)
        // Certificate ID hanya disimpan di HEAD saja
        $calibrationUpdate['certificate_id'] = null;
        $calibrationUpdate['jumlah_form'] = $jumlahForm;
        
        if (!empty($calibrationUpdate)) {
            $calibration->update($calibrationUpdate);
            $calibration->refresh();
            \Log::info('✅ CALIBRATION DATA UPDATED (tanpa certificate_id, tanpa range/resolusi)', $calibrationUpdate);
        }
        
        // ==================================================================
        // 4. FINAL VERIFICATION
        // ==================================================================
        $finalDetails = DetailThermometer::where('calibration_id', $calibration->id)
            ->orderBy('id')
            ->get();
        
        $finalHeads = HeadThermometer::where('calibration_id', $calibration->id)
            ->orderBy('form_index')
            ->get();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'heads_count' => $finalHeads->count(),
            'details_count' => $finalDetails->count(),
            'certificate_id_calibration' => $calibration->certificate_id, // Harusnya null
            'certificate_id_heads' => $finalHeads->pluck('certificate_id')->toArray(),
            'range_data_heads' => $finalHeads->map(function($head) {
                return [
                    'form_index' => $head->form_index,
                    'range_min' => $head->range_min,
                    'range_max' => $head->range_max,
                    'kapasitas' => $head->kapasitas,
                    'resolusi' => $head->resolusi,
                ];
            })->toArray()
        ]);
        
        \Log::info('🎉 updateThermometer COMPLETED', [
            'calibration_id' => $calibration->id,
            'details_saved' => $totalDetailCount,
            'jumlah_form' => $jumlahForm,
            'certificate_id_head_form1' => $finalHeads->where('form_index', 1)->first()->certificate_id ?? 'TIDAK ADA'
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateThermometer FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}
    
    // Helper function untuk clean value
    private function cleanValue($value)
    {
        if (is_null($value) || $value === '' || $value === 'null') {
            return null;
        }
        return $value;
    }

      private function storeDialIndicator($request, $calibration, $certificateId)
{
    try {
        \Log::info('START storeDialIndicator');
        
        // ==================================================================
        // DEBUG DETAILED
        // ==================================================================
        \Log::info('📋 ALL REQUEST DATA for dial indicator:', [
            'alat_standar' => $request->alat_standar,
            'alat_standar_tambahan' => $request->alat_standar_tambahan,
            'alat_standar_count' => is_array($request->alat_standar) ? count($request->alat_standar) : 0,
            'skala' => $request->skala,
            'repeability' => $request->repeability,
            'penunjukanAlat_count' => is_array($request->penunjukanAlat) ? count($request->penunjukanAlat) : 0
        ]);

        // ==================================================================
        // 1. AMBIL & SIMPAN SKALAf
        // ==================================================================
        $skala = $request->skala;
        if (!$skala || !in_array($skala, ['0.001', '0.01'])) {
            $skala = '0.01';
        }
        $calibration->update(['skala' => $skala]);
        $is001 = $skala === '0.001';
        \Log::info('Skala tersimpan', ['skala' => $skala, 'is001' => $is001]);

        // ==================================================================
        // 2. PROSES ALAT STANDAR - DENGAN FILTER YANG BENAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarTambahan = $request->alat_standar_tambahan ?? '';

        \Log::info('🔧 Processing alat standar:', [
            'alatStandar_raw' => $alatStandar,
            'alatStandarTambahan' => $alatStandarTambahan
        ]);

        $standardParts = [];
        
        if (is_array($alatStandar)) {
            foreach ($alatStandar as $index => $alat) {
                \Log::info("   - Item {$index}: '{$alat}' (length: " . strlen($alat) . ")");
                
                // FILTER 1: Skip jika kosong atau hanya whitespace
                if (trim($alat) === '') {
                    \Log::info("     -> SKIP: Empty string");
                    continue;
                }
                
                // FILTER 2: Untuk 'alat_standar_lainnya', gunakan value dari input tambahan
                if ($alat === 'alat_standar_lainnya') {
                    if (!empty(trim($alatStandarTambahan))) {
                        \Log::info("     -> ADD: 'alat_standar_lainnya' -> '{$alatStandarTambahan}'");
                        $standardParts[] = trim($alatStandarTambahan);
                    } else {
                        \Log::info("     -> SKIP: 'alat_standar_lainnya' but alat_standar_tambahan is empty");
                    }
                } 
                // FILTER 3: Untuk value lainnya, langsung tambahkan
                else {
                    \Log::info("     -> ADD: '{$alat}'");
                    $standardParts[] = trim($alat);
                }
            }
        }
        
        // FILTER 4: Jika ada input tambahan yang belum masuk
        if (!empty(trim($alatStandarTambahan))) {
            $alreadyExists = false;
            foreach ($standardParts as $part) {
                if ($part === trim($alatStandarTambahan)) {
                    $alreadyExists = true;
                    break;
                }
            }
            if (!$alreadyExists) {
                \Log::info("   - Adding alat_standar_tambahan yang belum terdaftar: '{$alatStandarTambahan}'");
                $standardParts[] = trim($alatStandarTambahan);
            }
        }

        // Pastikan tidak ada duplikat
        $standardParts = array_unique($standardParts);
        $standardValue = !empty($standardParts) ? implode(', ', $standardParts) : 'Tidak ada alat standar';
        
        \Log::info('📝 Standard value final:', ['standardValue' => $standardValue]);

        HeadDialIndicator::create([
            'calibration_id'    => $calibration->id,
            'certificate_id'    => $certificateId,
            'standard'          => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-03 (JIS B 7503:2017 (JMA/JSA); SNSU PK.P-03:2020).',
            'satuan_alat_kiri'          => $request->satuan_alat_kiri ?? null,
            'satuan_alat_kanan'          => $request->satuan_alat_kanan ?? null,
        ]);

        \Log::info('✅ HeadDialIndicator created');

        // ==================================================================
        // 3. SIMPAN REPEATABILITY
        // ==================================================================
        AddDialIndicator::create([
            'calibration_id' => $calibration->id,
            'repeatability'    => $request->repeatability ?? null,
            'ulangan01'      => $request->ulangan01 ?? null,
            'ulangan02'      => $request->ulangan02 ?? null,
            'ulangan03'      => $request->ulangan03 ?? null,
            'ulangan04'      => $request->ulangan04 ?? null,
            'ulangan05'      => $request->ulangan05 ?? null,
            'ulangan06'      => $request->ulangan06 ?? null,
            'ulangan07'      => $request->ulangan07 ?? null,
            'ulangan08'      => $request->ulangan08 ?? null,
            'ulangan09'      => $request->ulangan09 ?? null,
            'ulangan10'      => $request->ulangan10 ?? null,
        ]);

        \Log::info('✅ AddDialIndicator created');

        // ==================================================================
        // 4. SIMPAN DETAIL KALIBRASI
        // ==================================================================
        $penunjukanAlat = $request->penunjukanAlat ?? [];
        $pembacaanNaik  = $request->pembacaanNaik ?? [];
        $pembacaanTurun = $request->pembacaanTurun ?? [];

        \Log::info('📊 Jumlah baris diterima', [
            'penunjukanAlat' => count($penunjukanAlat),
            'pembacaanNaik'  => count($pembacaanNaik),
            'pembacaanTurun' => count($pembacaanTurun),
        ]);

        $detailCount = 0;
        $savedDetails = [];

        foreach ($penunjukanAlat as $i => $titikRaw) {
            $titik = trim($titikRaw ?? '');
            $naik = $pembacaanNaik[$i] ?? '';
            $turun = $pembacaanTurun[$i] ?? '';
            
            // Skip jika semua kolom kosong
            if ($titik === '' && $naik === '' && $turun === '') {
                continue;
            }
        
            $detail = DetailDialIndicator::create([
                'calibration_id' => $calibration->id,
                'titikUkur'      => $titik !== '' ? $titik : null,
                'ulanganNaik'    => $naik !== '' ? $naik : null,
                'ulanganTurun'   => $turun !== '' ? $turun : null,
            ]);
            
            $detailCount++;
            $savedDetails[] = [
                'titik' => $titik,
                'naik' => $naik,
                'turun' => $turun
            ];
        }

        \Log::info('✅ DetailDialIndicator berhasil disimpan', [
            'total_records' => $detailCount,
            'skala'         => $skala,
            'first_5_records' => array_slice($savedDetails, 0, 5)
        ]);

        \Log::info('🎯 storeDialIndicator SELESAI');

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeDialIndicator', [
            'message' => $e->getMessage(),
            'file'    => $e->getFile(),
            'line'    => $e->getLine(),
            'trace'   => $e->getTraceAsString()
        ]);
        throw $e;
    }
}


    /**
 * Update Thermometer data (Multiple Form Support)
 */
private function updateDialIndicator($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateDialIndicator =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head dial indicator untuk cek certificate_id
        $headDialIndicator = $calibration->headDialIndicator;
        
        // Jika head tidak ada, buat baru
        if (!$headDialIndicator) {
            $headDialIndicator = HeadDialIndicator::create([
                'calibration_id' => $calibration->id,
            ]);
            \Log::info('➕ New HeadDialIndicator created for certificate update');
        }
        
        $currentCertificateId = $headDialIndicator->certificate_id ?? null;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'namaAlat_di_calibration' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah (gunakan nama asli dari database sebelum diupdate)
        // Kita perlu ambil nama alat asli dari database karena $calibration->namaAlat sudah berubah
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ASLI DARI DATABASE:', [
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'request_nama_alat' => $namaAlatDariRequest
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE ALAT STANDAR (HEAD DIAL INDICATOR)
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = '';
        
        \Log::info('🔧 Update data:', [
            'alat_standar' => $alatStandar,
            'alat_standar_tambahan' => $request->alat_standar_tambahan
        ]);
        
        // Process alat standar
        $processedAlat = [];
        foreach ($alatStandar as $alat) {
            if ($alat === 'dial_gauge_tester_0_25mm') {
                $processedAlat[] = 'Dial Gauge Tester 0~25 mm';
            } 
            elseif ($alat === 'dial_calibration_tester_0_1mm') {
                $processedAlat[] = 'Dial Calibration Tester 0~1 mm';
            }
            elseif ($alat === 'electronic_gauge_tester_0_50mm') {
                $processedAlat[] = 'Electronic Gauge Tester 0~50 mm';
            }
            elseif ($alat === 'alat_standar_lainnya' && $request->filled('alat_standar_tambahan')) {
                $processedAlat[] = $request->alat_standar_tambahan;
            }
        }
        
        $alatStandarString = !empty($processedAlat) ? implode(', ', $processedAlat) : '';
        
        // Prepare update data
        $updateData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-03 (JIS B 7503:2017 (JMA/JSA); SNSU PK.P-03:2020)',
        ];
        
        // Tambahkan satuan kiri dan kanan jika ada
        if ($request->has('satuan_alat_kiri')) {
            $updateData['satuan_alat_kiri'] = $request->satuan_alat_kiri;
        }
        
        if ($request->has('satuan_alat_kanan')) {
            $updateData['satuan_alat_kanan'] = $request->satuan_alat_kanan;
        }
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $updateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        // Update head
        $headDialIndicator->update($updateData);
        
        // Refresh untuk mendapatkan data terbaru
        $headDialIndicator->refresh();
        
        \Log::info('✅ HeadDialIndicator updated:', [
            'certificate_id' => $headDialIndicator->certificate_id,
            'standard' => $alatStandarString
        ]);
        
        // ==================================================================
        // 2. UPDATE ADD DIAL INDICATOR (untuk repeatability dan ulangan 01-10)
        // ==================================================================
        // Cek apakah AddDialIndicator sudah ada
        if ($add = $calibration->addDialIndicator) {
            // Update existing
            $addUpdateData = [];
            
            // Update repeatability jika ada
            if ($request->filled('repeatability')) {
                $repeatValue = $this->formatRepeatability($request->repeatability);
                if (!is_null($repeatValue)) {
                    $addUpdateData['repeatability'] = $repeatValue;
                    \Log::info('✅ Repeatability formatted:', [
                        'original' => $request->repeatability,
                        'formatted' => $repeatValue
                    ]);
                }
            }
            
            // Update ulangan 01-10 jika ada
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = ($i < 10) ? 'ulangan0' . $i : 'ulangan' . $i;
                if ($request->filled($fieldName)) {
                    $addUpdateData[$fieldName] = $this->formatNumericValue($request->$fieldName);
                    \Log::debug("📝 {$fieldName} to update:", ['value' => $addUpdateData[$fieldName]]);
                }
            }
            
            // Update jika ada data
            if (!empty($addUpdateData)) {
                $add->update($addUpdateData);
                \Log::info('✅ AddDialIndicator updated. Fields:', array_keys($addUpdateData));
            } else {
                \Log::info('ℹ️ No data to update in AddDialIndicator');
            }
            
        } else {
            // Create new AddDialIndicator jika belum ada
            $addData = [
                'calibration_id' => $calibration->id,
            ];
            
            // Tambahkan repeatability jika ada
            if ($request->filled('repeatability')) {
                $addData['repeatability'] = $this->formatNumericValue($request->repeatability);
                \Log::info('📝 Repeatability to create:', ['value' => $addData['repeatability']]);
            }
            
            // Tambahkan ulangan 01-10 jika ada
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = ($i < 10) ? 'ulangan0' . $i : 'ulangan' . $i;
                if ($request->filled($fieldName)) {
                    $addData[$fieldName] = $this->formatNumericValue($request->$fieldName);
                    \Log::debug("📝 {$fieldName} to create:", ['value' => $addData[$fieldName]]);
                }
            }
            
            // Hanya create jika ada data (tidak hanya calibration_id)
            if (count($addData) > 1) {
                $add = AddDialIndicator::create($addData);
                \Log::info('➕ NEW AddDialIndicator created:', [
                    'add_id' => $add->id,
                    'fields_saved' => array_keys($addData)
                ]);
            } else {
                \Log::info('ℹ️ No AddDialIndicator data to create');
            }
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL MEASUREMENTS (titikUkur, ulanganNaik, ulanganTurun)
        // ==================================================================
        // Hapus data detail lama
        $deletedCount = DetailDialIndicator::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Old DetailDialIndicator deleted:', ['deleted_count' => $deletedCount]);
        
        // **LOG DATA REQUEST**
        \Log::info('📊 Request data count:', [
            'titikUkur_kiri' => count($request->titikUkur_kiri ?? []),
            'ulanganNaik_kiri' => count($request->ulanganNaik_kiri ?? []),
            'ulanganTurun_kiri' => count($request->ulanganTurun_kiri ?? []),
            'titikUkur_kanan' => count($request->titikUkur_kanan ?? []),
            'ulanganNaik_kanan' => count($request->ulanganNaik_kanan ?? []),
            'ulanganTurun_kanan' => count($request->ulanganTurun_kanan ?? []),
        ]);
        
        $detailCount = 0;
        $savedData = [];
        
        // 1. Simpan data KIRI dulu
        if (is_array($request->titikUkur_kiri) && count($request->titikUkur_kiri) > 0) {
            foreach ($request->titikUkur_kiri as $index => $titikUkur) {
                // Skip jika null atau empty string (kecuali '0')
                if (($titikUkur === null || $titikUkur === '') && $titikUkur !== '0') {
                    \Log::debug("⏭️ Skipping KIRI index {$index}: titikUkur is empty");
                    continue;
                }
                
                $ulanganNaik = $request->ulanganNaik_kiri[$index] ?? null;
                $ulanganTurun = $request->ulanganTurun_kiri[$index] ?? null;
                
                // Format nilai
                $formattedTitikUkur = $this->formatNumericValue($titikUkur);
                $formattedNaik = $this->formatNumericValue($ulanganNaik);
                $formattedTurun = $this->formatNumericValue($ulanganTurun);
                
                // Simpan data kiri
                try {
                    DetailDialIndicator::create([
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ]);
                    
                    $detailCount++;
                    $savedData[] = [
                        'type' => 'kiri',
                        'index' => $index,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ];
                    
                    \Log::debug("✅ Saved KIRI index {$index}", [
                        'titikUkur' => $formattedTitikUkur,
                        'naik' => $formattedNaik,
                        'turun' => $formattedTurun
                    ]);
                    
                } catch (\Exception $e) {
                    \Log::error("❌ Error saving KIRI index {$index}: " . $e->getMessage());
                }
            }
        }
        
        // 2. Simpan data KANAN setelah kiri
        if (is_array($request->titikUkur_kanan) && count($request->titikUkur_kanan) > 0) {
            foreach ($request->titikUkur_kanan as $index => $titikUkur) {
                // Skip jika null atau empty string (kecuali '0')
                if (($titikUkur === null || $titikUkur === '') && $titikUkur !== '0') {
                    \Log::debug("⏭️ Skipping KANAN index {$index}: titikUkur is empty");
                    continue;
                }
                
                $ulanganNaik = $request->ulanganNaik_kanan[$index] ?? null;
                $ulanganTurun = $request->ulanganTurun_kanan[$index] ?? null;
                
                // Format nilai
                $formattedTitikUkur = $this->formatNumericValue($titikUkur);
                $formattedNaik = $this->formatNumericValue($ulanganNaik);
                $formattedTurun = $this->formatNumericValue($ulanganTurun);
                
                // Simpan data kanan
                try {
                    DetailDialIndicator::create([
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ]);
                    
                    $detailCount++;
                    $savedData[] = [
                        'type' => 'kanan',
                        'index' => $index,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ];
                    
                    \Log::debug("✅ Saved KANAN index {$index}", [
                        'titikUkur' => $formattedTitikUkur,
                        'naik' => $formattedNaik,
                        'turun' => $formattedTurun
                    ]);
                    
                } catch (\Exception $e) {
                    \Log::error("❌ Error saving KANAN index {$index}: " . $e->getMessage());
                }
            }
        }
        
        \Log::info('✅ DetailDialIndicator updated:', [
            'total_records' => $detailCount,
            'saved_data_summary' => $savedData
        ]);
        
        // ==================================================================
        // 4. FINAL VERIFICATION
        // ==================================================================
        $finalHead = HeadDialIndicator::where('calibration_id', $calibration->id)->first();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'details_count' => $detailCount,
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru
        ]);
        
        \Log::info('🎉 updateDialIndicator COMPLETED', [
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA'
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateDialIndicator FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'unknown'
        ]);
        throw $e;
    }
}
       private function formatRepeatability($value)
    {
        \Log::debug("🔢 formatRepeatability INPUT:", ['value' => $value, 'type' => gettype($value)]);
        
        if (is_null($value) || $value === '' || $value === 'null') {
            return null;
        }
        
     
        return (string) $value; // Simpan sebagai string
        
 
    }

     private function storeDialTestIndicator($request, $calibration, $certificateId)
    {
        try {
            \Log::info('START storeDialTestIndicator');
    
            // ==================================================================
            // 1. AMBIL & SIMPAN SKALA (WAJIB!)
            // ==================================================================
            $skala = $request->skala; // '0.001' atau '0.01' dari hidden input
            if (!$skala || !in_array($skala, ['0.001', '0.01'])) {
                $skala = '0.01'; // fallback kalau kosong
            }
    
            $calibration->update(['skala' => $skala]);
            $is001 = $skala === '0.001';
    
            \Log::info('Skala tersimpan', ['skala' => $skala, 'is001' => $is001]);
    
            // ==================================================================
            // 2. PROSES ALAT STANDAR (tetap sama)
            // ==================================================================
            $alatStandar         = $request->alat_standar ?? [];
            $alatStandarTambahan  = $request->alat_standar_tambahan ?? '';
    
            $standardParts = [];
            foreach ($alatStandar as $alat) {
                if ($alat !== 'alat_standar_lainnya') {
                    $standardParts[] = $alat;
                }
            }
            if (!empty($alatStandarTambahan)) {
                $standardParts[] = $alatStandarTambahan;
            }
            $standardValue = implode(', ', $standardParts);
    
            HeadDialTestIndicator::create([
                'calibration_id'    => $calibration->id,
                'certificate_id'    => $certificateId,
                'standard'          => $standardValue,
                'calibrationMethod' => 'PAS-IK1102-07 (JIS B 7533 : 2015)',
                'satuan_alat_kiri'          => $request->satuan_alat_kiri ?? null,
                'satuan_alat_kanan'          => $request->satuan_alat_kanan ?? null,
            ]);
    
            // ==================================================================
            // 3. SIMPAN REPEATABILITY (tetap sama)
            // ==================================================================
            AddDialTestIndicator::create([
                'calibration_id' => $calibration->id,
                'repeatability'    => $request->repeatability ?? null,
                'ulangan01'      => $request->ulangan01 ?? null,
                'ulangan02'      => $request->ulangan02 ?? null,
                'ulangan03'      => $request->ulangan03 ?? null,
                'ulangan04'      => $request->ulangan04 ?? null,
                'ulangan05'      => $request->ulangan05 ?? null,
                'ulangan06'      => $request->ulangan06 ?? null,
                'ulangan07'      => $request->ulangan07 ?? null,
                'ulangan08'      => $request->ulangan08 ?? null,
                'ulangan09'      => $request->ulangan09 ?? null,
                'ulangan10'      => $request->ulangan10 ?? null,
            ]);
    
            // ==================================================================
            // 4. SIMPAN DETAIL KALIBRASI + FILTER BERDASARKAN SKALA
            // ==================================================================
            $penunjukanAlat = $request->penunjukanAlat ?? [];
            $pembacaanNaik  = $request->pembacaanNaik ?? [];
            $pembacaanTurun = $request->pembacaanTurun ?? [];
            
            \Log::info('📊 Jumlah baris diterima', [
                'penunjukanAlat' => count($penunjukanAlat),
                'pembacaanNaik'  => count($pembacaanNaik),
                'pembacaanTurun' => count($pembacaanTurun),
                'semua_penunjukan' => $penunjukanAlat, // LOG SEMUA DATA
                'semua_pembacaan_naik' => $pembacaanNaik,
                'semua_pembacaan_turun' => $pembacaanTurun,
            ]);
    
            $detailCount = 0;
    
                
            foreach ($penunjukanAlat as $i => $titikRaw) {
                $titik = trim($titikRaw ?? '');
                
                // AMBIL DATA PEMBACAAN
                $naik = $pembacaanNaik[$i] ?? '';
                $turun = $pembacaanTurun[$i] ?? '';
                
                // SKIP HANYA JIKA SEMUA KOLOM KOSONG
                if ($titik === '' && $naik === '' && $turun === '') {
                    continue;
                }
            
                // SIMPAN SEMUA DATA TANPA FILTER SKALA
                // (Dial Test Indicator mungkin butuh range yang lebih besar)
                DetailDialTestIndicator::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur'      => $titik !== '' ? $titik : null,
                    'ulanganNaik'    => $naik !== '' ? $naik : null,
                    'ulanganTurun'   => $turun !== '' ? $turun : null,
                ]);
            
                $detailCount++;
            }
            
    
            \Log::info('DetailDialTestIndicator berhasil disimpan', [
                'total_records' => $detailCount,
                'skala'         => $skala
            ]);
    
            \Log::info('storeDialTestIndicator SELESAI');
    
        } catch (\Exception $e) {
            \Log::error('ERROR storeDialTestIndicator', [
                'message' => $e->getMessage(),
                'file'    => $e->getFile(),
                'line'    => $e->getLine(),
            ]);
            throw $e;
        }
    }
    
    private function updateDialTestIndicator($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateDialTestIndicator =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head dial test indicator untuk cek certificate_id
        $headDialTestIndicator = $calibration->headDialTestIndicator;
        
        // Jika head tidak ada, buat baru
        if (!$headDialTestIndicator) {
            $headDialTestIndicator = HeadDialTestIndicator::create([
                'calibration_id' => $calibration->id,
            ]);
            \Log::info('➕ New HeadDialTestIndicator created for certificate update');
        }
        
        $currentCertificateId = $headDialTestIndicator->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE ALAT STANDAR (HEAD DIAL TEST INDICATOR)
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = '';
        
        \Log::info('🔧 Alat standar RAW data:', [
            'alat_standar' => $alatStandar,
            'alat_standar_type' => gettype($alatStandar),
            'alat_standar_count' => is_array($alatStandar) ? count($alatStandar) : 'N/A',
            'alat_standar_tambahan' => $request->alat_standar_tambahan ?? ''
        ]);
        
        // Process alat standar
        $processedAlat = [];
        
        if (is_array($alatStandar) && count($alatStandar) > 0) {
            foreach ($alatStandar as $alat) {
                $alat = trim($alat);
                
                if ($alat === 'alat_standar_lainnya') {
                    if ($request->filled('alat_standar_tambahan')) {
                        $processedAlat[] = trim($request->alat_standar_tambahan);
                    }
                } else {
                    $processedAlat[] = $alat;
                }
            }
        }
        
        // Juga tambahkan alat_standar_tambahan jika diisi manual tanpa checkbox
        if ($request->filled('alat_standar_tambahan')) {
            $tambahan = trim($request->alat_standar_tambahan);
            if (!empty($tambahan) && !in_array($tambahan, $processedAlat)) {
                $processedAlat[] = $tambahan;
            }
        }
        
        // Hapus duplikat dan empty values
        $processedAlat = array_filter(array_unique($processedAlat));
        
        $alatStandarString = !empty($processedAlat) ? implode(', ', $processedAlat) : '';
        
        \Log::info('🔧 Alat standar processed:', [
            'processedAlat' => $processedAlat,
            'alatStandarString' => $alatStandarString
        ]);
        
        // Prepare update data
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-07 (JIS B 7533 : 2015)',
        ];
        
        // Tambahkan satuan kiri dan kanan jika ada
        if ($request->has('satuan_alat_kiri') && $request->satuan_alat_kiri !== null) {
            $headData['satuan_alat_kiri'] = $request->satuan_alat_kiri;
        }
        
        if ($request->has('satuan_alat_kanan') && $request->satuan_alat_kanan !== null) {
            $headData['satuan_alat_kanan'] = $request->satuan_alat_kanan;
        }
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        \Log::info('📝 Head data to save:', $headData);
        
        // Update head
        $headDialTestIndicator->update($headData);
        
        // Refresh untuk mendapatkan data terbaru
        $headDialTestIndicator->refresh();
        
        \Log::info('✅ HeadDialTestIndicator updated:', [
            'head_id' => $headDialTestIndicator->id,
            'certificate_id' => $headDialTestIndicator->certificate_id,
            'standard' => $headDialTestIndicator->standard,
            'satuan_alat_kiri' => $headDialTestIndicator->satuan_alat_kiri,
            'satuan_alat_kanan' => $headDialTestIndicator->satuan_alat_kanan,
        ]);
        
        // ==================================================================
        // 2. UPDATE ADD DIAL TEST INDICATOR (untuk repeatability dan ulangan 01-10)
        // ==================================================================
        if ($add = $calibration->addDialTestIndicator) {
            $updateData = [];
            
            if ($request->filled('repeatability')) {
                $repeatValue = $this->formatRepeatability($request->repeatability);
                if (!is_null($repeatValue)) {
                    $updateData['repeatability'] = $repeatValue;
                    \Log::info('✅ Repeatability formatted:', [
                        'original' => $request->repeatability,
                        'formatted' => $repeatValue
                    ]);
                }
            }
            
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = ($i < 10) ? 'ulangan0' . $i : 'ulangan' . $i;
                if ($request->filled($fieldName)) {
                    $updateData[$fieldName] = $this->formatNumericValue($request->$fieldName);
                    \Log::debug("📝 {$fieldName} to update:", ['value' => $updateData[$fieldName]]);
                }
            }
            
            if (!empty($updateData)) {
                $add->update($updateData);
                \Log::info('✅ AddDialTestIndicator updated. Fields:', array_keys($updateData));
            } else {
                \Log::info('ℹ️ No data to update in AddDialTestIndicator');
            }
            
        } else {
            $addData = ['calibration_id' => $calibration->id];
            
            if ($request->filled('repeatability')) {
                $addData['repeatability'] = $this->formatNumericValue($request->repeatability);
                \Log::info('📝 Repeatability to create:', ['value' => $addData['repeatability']]);
            }
            
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = ($i < 10) ? 'ulangan0' . $i : 'ulangan' . $i;
                if ($request->filled($fieldName)) {
                    $addData[$fieldName] = $this->formatNumericValue($request->$fieldName);
                    \Log::debug("📝 {$fieldName} to create:", ['value' => $addData[$fieldName]]);
                }
            }
            
            if (count($addData) > 1) {
                $add = AddDialTestIndicator::create($addData);
                \Log::info('➕ NEW AddDialTestIndicator created:', [
                    'add_id' => $add->id,
                    'fields_saved' => array_keys($addData)
                ]);
            } else {
                \Log::info('ℹ️ No AddDialTestIndicator data to create');
            }
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL MEASUREMENTS (titikUkur, ulanganNaik, ulanganTurun)
        // ==================================================================
        $deletedCount = DetailDialTestIndicator::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Old DetailDialTestIndicator deleted:', ['deleted_count' => $deletedCount]);
        
        \Log::info('📊 Request data count:', [
            'titikUkur_kiri' => count($request->titikUkur_kiri ?? []),
            'ulanganNaik_kiri' => count($request->ulanganNaik_kiri ?? []),
            'ulanganTurun_kiri' => count($request->ulanganTurun_kiri ?? []),
            'titikUkur_kanan' => count($request->titikUkur_kanan ?? []),
            'ulanganNaik_kanan' => count($request->ulanganNaik_kanan ?? []),
            'ulanganTurun_kanan' => count($request->ulanganTurun_kanan ?? []),
        ]);
        
        $detailCount = 0;
        $savedData = [];
        
        // Simpan data KIRI
        if (is_array($request->titikUkur_kiri) && count($request->titikUkur_kiri) > 0) {
            foreach ($request->titikUkur_kiri as $index => $titikUkur) {
                if (($titikUkur === null || $titikUkur === '') && $titikUkur !== '0') {
                    \Log::debug("⏭️ Skipping KIRI index {$index}: titikUkur is empty");
                    continue;
                }
                
                $ulanganNaik = $request->ulanganNaik_kiri[$index] ?? null;
                $ulanganTurun = $request->ulanganTurun_kiri[$index] ?? null;
                
                $formattedTitikUkur = $this->formatNumericValue($titikUkur);
                $formattedNaik = $this->formatNumericValue($ulanganNaik);
                $formattedTurun = $this->formatNumericValue($ulanganTurun);
                
                try {
                    DetailDialTestIndicator::create([
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ]);
                    
                    $detailCount++;
                    $savedData[] = [
                        'type' => 'kiri',
                        'index' => $index,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ];
                    
                    \Log::debug("✅ Saved KIRI index {$index}");
                    
                } catch (\Exception $e) {
                    \Log::error("❌ Error saving KIRI index {$index}: " . $e->getMessage());
                }
            }
        }
        
        // Simpan data KANAN
        if (is_array($request->titikUkur_kanan) && count($request->titikUkur_kanan) > 0) {
            foreach ($request->titikUkur_kanan as $index => $titikUkur) {
                if (($titikUkur === null || $titikUkur === '') && $titikUkur !== '0') {
                    \Log::debug("⏭️ Skipping KANAN index {$index}: titikUkur is empty");
                    continue;
                }
                
                $ulanganNaik = $request->ulanganNaik_kanan[$index] ?? null;
                $ulanganTurun = $request->ulanganTurun_kanan[$index] ?? null;
                
                $formattedTitikUkur = $this->formatNumericValue($titikUkur);
                $formattedNaik = $this->formatNumericValue($ulanganNaik);
                $formattedTurun = $this->formatNumericValue($ulanganTurun);
                
                try {
                    DetailDialTestIndicator::create([
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ]);
                    
                    $detailCount++;
                    $savedData[] = [
                        'type' => 'kanan',
                        'index' => $index,
                        'titikUkur' => $formattedTitikUkur,
                        'ulanganNaik' => $formattedNaik,
                        'ulanganTurun' => $formattedTurun,
                    ];
                    
                    \Log::debug("✅ Saved KANAN index {$index}");
                    
                } catch (\Exception $e) {
                    \Log::error("❌ Error saving KANAN index {$index}: " . $e->getMessage());
                }
            }
        }
        
        \Log::info('✅ DetailDialTestIndicator updated:', [
            'total_records' => $detailCount
        ]);
        
        // ==================================================================
        // 4. FINAL VERIFICATION
        // ==================================================================
        $finalHead = HeadDialTestIndicator::where('calibration_id', $calibration->id)->first();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'details_count' => $detailCount,
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru
        ]);
        
        \Log::info('🎉 updateDialTestIndicator COMPLETED', [
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA'
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateDialTestIndicator FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'unknown'
        ]);
        throw $e;
    }
}

            private function storeDepthCaliper($request, $calibration, $certificateId)
        {
            try {
                \Log::info('🚀 START storeDepthCaliper');
        
                // ==================================================================
                // 1. PROSES & SIMPAN ALAT STANDAR KE HEAD
                // ==================================================================
                $alatStandar = $request->alat_standar ?? [];
                $alatStandarTambahan = $request->alat_standar_tambahan ?? '';
        
                \Log::info('🔧 Data alat standar:', [
                    'alat_standar' => $alatStandar,
                    'alat_standar_tambahan' => $alatStandarTambahan
                ]);
        
                $standardParts = [];
                foreach ($alatStandar as $alat) {
                    if ($alat !== 'alat_standar_lainnya') {
                        $standardParts[] = $alat;
                    }
                }
                
                if (!empty($alatStandarTambahan)) {
                    $standardParts[] = $alatStandarTambahan;
                }
                
                $standardValue = !empty($standardParts) ? implode(', ', $standardParts) : '';
        
                // SIMPAN KE HEAD DEPTH CALIPER
                $headData = HeadDepthCaliper::create([
                    'calibration_id' => $calibration->id,
                    'certificate_id' => $certificateId,
                    'standard' => $standardValue,
                    'calibrationMethod' => ' PAS-IK1102-11 (JIS B 7518:2023 (JMA/JSA); SNSU PK.P-02:2020)',
                    'satuan_unit' => $request->satuan_unit ?? null,
                   
                ]);
        
                \Log::info('✅ HeadDepthCaliper berhasil disimpan', [
                    'id' => $headData->id,
                    'standard' => $standardValue,
                    'calibration_id' => $calibration->id
                ]);
        
                // ==================================================================
                // 2. SIMPAN DETAIL DEPTH CALIPER
                // ==================================================================
                $titikUkur = $request->titikUkur ?? [];
                $ulangan01 = $request->ulangan01 ?? [];
                $ulangan02 = $request->ulangan02 ?? [];
                $ulangan03 = $request->ulangan03 ?? [];
                $ulangan04 = $request->ulangan04 ?? [];
                $ulangan05 = $request->ulangan05 ?? [];
                $kodeStandardKiri = $request->kodeStandardKiri ?? [];
                $kodeStandardKanan = $request->kodeStandardKanan ?? [];
        
                \Log::info('📊 Data detail diterima', [
                    'titikUkur_count' => count($titikUkur),
                    'ulangan01_count' => count($ulangan01),
                    'ulangan02_count' => count($ulangan02),
                    'ulangan03_count' => count($ulangan03),
                    'ulangan04_count' => count($ulangan04),
                    'ulangan05_count' => count($ulangan05),
                    'kodeStandardKiri_count' => count($kodeStandardKiri),
                    'kodeStandardKanan_count' => count($kodeStandardKanan),
                ]);
        
                $detailCount = 0;
                $errors = [];
        
                // Proses 12 baris data (sesuai dengan form yang memiliki 12 baris)
                $totalRows = min(12, count($titikUkur), count($ulangan01), count($ulangan02), 
                               count($ulangan03), count($ulangan04), count($ulangan05),
                               count($kodeStandardKiri), count($kodeStandardKanan));
        
                for ($i = 0; $i < $totalRows; $i++) {
                    $titikValue = trim($titikUkur[$i] ?? '');
                    $ulangan01Value = $ulangan01[$i] ?? null;
                    $ulangan02Value = $ulangan02[$i] ?? null;
                    $ulangan03Value = $ulangan03[$i] ?? null;
                    $ulangan04Value = $ulangan04[$i] ?? null;
                    $ulangan05Value = $ulangan05[$i] ?? null;
                    $kodeKiriValue = $kodeStandardKiri[$i] ?? null;
                    $kodeKananValue = $kodeStandardKanan[$i] ?? null;
        
                    // SKIP jika semua kolom kosong
                    if (empty($titikValue) && 
                        empty($ulangan01Value) && 
                        empty($ulangan02Value) && 
                        empty($ulangan03Value) && 
                        empty($ulangan04Value) && 
                        empty($ulangan05Value) && 
                        empty($kodeKiriValue) && 
                        empty($kodeKananValue)) {
                        \Log::debug('Baris ' . ($i + 1) . ' kosong, dilewati');
                        continue;
                    }
        
                    // VALIDASI: Jika ada titikUkur, minimal harus ada 1 ulangan
                    if (!empty($titikValue)) {
                        $hasUlangan = !empty($ulangan01Value) || !empty($ulangan02Value) || 
                                     !empty($ulangan03Value) || !empty($ulangan04Value) || 
                                     !empty($ulangan05Value);
                        
                        if (!$hasUlangan) {
                            $errors[] = "Baris " . ($i + 1) . ": Titik Ukur '{$titikValue}' harus memiliki minimal 1 data ulangan";
                            \Log::warning('Validasi gagal: ' . end($errors));
                            continue;
                        }
                    }
        
                    // Validasi: Jika ada ulangan, harus ada titikUkur
                    $hasAnyUlangan = !empty($ulangan01Value) || !empty($ulangan02Value) || 
                                   !empty($ulangan03Value) || !empty($ulangan04Value) || 
                                   !empty($ulangan05Value);
                    
                    if ($hasAnyUlangan && empty($titikValue)) {
                        $errors[] = "Baris " . ($i + 1) . ": Data ulangan harus memiliki Titik Ukur";
                        \Log::warning('Validasi gagal: ' . end($errors));
                        continue;
                    }
        
                    // Validasi: Jika ada kode standard, harus ada titikUkur
                    if ((!empty($kodeKiriValue) || !empty($kodeKananValue)) && empty($titikValue)) {
                        $errors[] = "Baris " . ($i + 1) . ": Kode Standard harus memiliki Titik Ukur";
                        \Log::warning('Validasi gagal: ' . end($errors));
                        continue;
                    }
        
                    // Format nilai ulangan ke float jika ada
                    $formatUlangan = function($value) {
                        if (empty($value)) return null;
                        $value = str_replace(',', '.', $value);
                        return is_numeric($value) ? (float) $value : null;
                    };
        
                    // SIMPAN DATA DETAIL
                    try {
                        DetailDepthCaliper::create([
                            'calibration_id' => $calibration->id,
                            'titikUkur' => !empty($titikValue) ? $titikValue : null,
                            'ulangan01' => $formatUlangan($ulangan01Value),
                            'ulangan02' => $formatUlangan($ulangan02Value),
                            'ulangan03' => $formatUlangan($ulangan03Value),
                            'ulangan04' => $formatUlangan($ulangan04Value),
                            'ulangan05' => $formatUlangan($ulangan05Value),
                            'kodeStandardKiri' => !empty($kodeKiriValue) ? $kodeKiriValue : null,
                            'kodeStandardKanan' => !empty($kodeKananValue) ? $kodeKananValue : null,
                        ]);
        
                        $detailCount++;
        
                        \Log::debug('📝 Detail baris ' . ($i + 1) . ' disimpan', [
                            'titikUkur' => $titikValue,
                            'ulangan01' => $ulangan01Value,
                            'ulangan02' => $ulangan02Value,
                        ]);
        
                    } catch (\Exception $e) {
                        $errors[] = "Baris " . ($i + 1) . ": Gagal menyimpan - " . $e->getMessage();
                        \Log::error('❌ Gagal simpan detail baris ' . ($i + 1), [
                            'error' => $e->getMessage(),
                            'data' => compact('titikValue', 'ulangan01Value', 'ulangan02Value')
                        ]);
                    }
                }
        
                // LOG HASIL AKHIR
                \Log::info('✅ DetailDepthCaliper berhasil disimpan', [
                    'total_records' => $detailCount,
                    'total_rows' => $totalRows,
                    'calibration_id' => $calibration->id,
                    'errors_count' => count($errors),
                    'errors' => $errors
                ]);
        
                if (!empty($errors)) {
                    \Log::warning('⚠️ Ada error dalam penyimpanan detail', ['errors' => $errors]);
                    // Tidak throw error agar proses bisa lanjut, hanya log warning
                }
        
                // ==================================================================
                // 3. SIMPAN TTD DAN INFORMASI TAMBAHAN
                // ==================================================================
                // Data TTD sudah disimpan di calibration table melalui store method utama
                // Simpan informasi tambahan jika ada
                if ($request->has('additional_info') && !empty($request->additional_info)) {
                    $calibration->update([
                        'keterangan' => $request->additional_info
                    ]);
                    \Log::info('📝 Additional info saved to calibration');
                }
        
                \Log::info('🎉 storeDepthCaliper SELESAI');
        
            } catch (\Exception $e) {
                \Log::error('💥 ERROR storeDepthCaliper', [
                    'message' => $e->getMessage(),
                    'file' => $e->getFile(),
                    'line' => $e->getLine(),
                    'trace' => $e->getTraceAsString()
                ]);
                throw $e;
            }
        }
        
        /**
         * Update Depth Caliper data
         */
          private function updateDepthCaliper($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateDepthCaliper =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head depth caliper untuk cek certificate_id
        $headDepthCaliper = $calibration->headDepthCaliper;
        $currentCertificateId = $headDepthCaliper->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = '';
        
        \Log::info('🔧 Update data:', [
            'alat_standar' => $alatStandar,
            'alat_standar_tambahan' => $request->alat_standar_tambahan ?? ''
        ]);
        
        // Process alat standar
        $processedAlat = [];
        foreach ($alatStandar as $alat) {
            if ($alat === 'dial_gauge_tester_0_25mm') {
                $processedAlat[] = 'Dial Gauge Tester 0~25 mm';
            } 
            elseif ($alat === 'dial_calibration_tester_0_1mm') {
                $processedAlat[] = 'Dial Calibration Tester 0~1 mm';
            }
            elseif ($alat === 'electronic_gauge_tester_0_50mm') {
                $processedAlat[] = 'Electronic Gauge Tester 0~50 mm';
            }
            elseif ($alat === 'alat_standar_lainnya' && $request->filled('alat_standar_tambahan')) {
                $processedAlat[] = $request->alat_standar_tambahan;
            } else {
                $processedAlat[] = $alat;
            }
        }
        
        $alatStandarString = !empty($processedAlat) ? implode(', ', $processedAlat) : '';
        
        // Prepare update data untuk HEAD
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-05 (JIS B 7507 : 1993)',
            'satuan_unit' => $request->satuan_unit,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        // Update atau create HEAD
        if ($headDepthCaliper) {
            $headDepthCaliper->update($headData);
            \Log::info('✅ HeadDepthCaliper updated:', [
                'standard' => $alatStandarString,
                'certificate_id' => $headDepthCaliper->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $headData['certificate_id'] = $headData['certificate_id'] ?? $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
            $headDepthCaliper = HeadDepthCaliper::create($headData);
            \Log::info('➕ NEW HeadDepthCaliper created:', [
                'head_id' => $headDepthCaliper->id,
                'certificate_id' => $headDepthCaliper->certificate_id
            ]);
        }
        
        // ==================================================================
        // 2. DEBUG: CEK STRUKTUR DATA DETAIL
        // ==================================================================
        \Log::info('🔍 DEBUG DETAIL DATA STRUCTURE:', [
            'has_detail' => $request->has('detail'),
            'detail_is_array' => is_array($request->detail),
            'detail_count' => is_array($request->detail) ? count($request->detail) : 0,
            'detail_sample' => is_array($request->detail) ? array_slice($request->detail, 0, 2) : [],
            'all_detail_keys' => is_array($request->detail) ? array_keys($request->detail) : [],
        ]);
        
        // ==================================================================
        // 3. UPDATE DETAIL MEASUREMENTS - MULTIDIMENSIONAL ARRAY
        // ==================================================================
        // Hapus data detail lama
        $deletedCount = DetailDepthCaliper::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Old DetailDepthCaliper deleted:', ['deleted_count' => $deletedCount]);
        
        // Simpan data detail baru
        $detailCount = 0;
        
        if (is_array($request->detail) && count($request->detail) > 0) {
            foreach ($request->detail as $index => $rowData) {
                // Debug setiap row
                \Log::debug("🔍 Processing detail row {$index}:", $rowData);
                
                // Skip jika semua field kosong
                $isEmpty = true;
                foreach ($rowData as $value) {
                    if (!empty(trim($value ?? ''))) {
                        $isEmpty = false;
                        break;
                    }
                }
                
                if ($isEmpty) {
                    \Log::debug("⏭️ Skipping empty row {$index}");
                    continue;
                }
                
                try {
                    // Prepare data untuk detail
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $this->formatNumericValue($rowData['titikUkur'] ?? null),
                        'kodeStandardKiri' => $rowData['kodeStandardKiri'] ?? null,
                        'kodeStandardKanan' => $rowData['kodeStandardKanan'] ?? null,
                    ];
                    
                    // Tambahkan ulangan01 sampai ulangan05
                    for ($u = 1; $u <= 5; $u++) {
                        $fieldName = 'ulangan0' . $u;
                        $detailData[$fieldName] = $this->formatNumericValue($rowData[$fieldName] ?? null);
                    }
                    
                    // Jika ada kolom tambahan (col1-col8 untuk baris kosong)
                    for ($c = 1; $c <= 8; $c++) {
                        $colName = 'col' . $c;
                        if (isset($rowData[$colName])) {
                            // Untuk kolom umum, simpan sesuai mapping
                            if ($c == 1) {
                                $detailData['titikUkur'] = $this->formatNumericValue($rowData[$colName]);
                            } elseif ($c == 2) {
                                $detailData['kodeStandardKiri'] = $rowData[$colName];
                            } elseif ($c == 3) {
                                $detailData['kodeStandardKanan'] = $rowData[$colName];
                            } elseif ($c >= 4 && $c <= 8) {
                                $ulanganNum = $c - 3; // col4 -> ulangan01, col5 -> ulangan02, dst
                                $ulanganField = 'ulangan0' . $ulanganNum;
                                $detailData[$ulanganField] = $this->formatNumericValue($rowData[$colName]);
                            }
                        }
                    }
                    
                    \Log::debug("💾 Saving detail row {$index}:", $detailData);
                    
                    DetailDepthCaliper::create($detailData);
                    $detailCount++;
                    
                } catch (\Exception $rowError) {
                    \Log::error("❌ DetailDepthCaliper row {$index} error:", [
                        'error' => $rowError->getMessage(),
                        'data' => $rowData
                    ]);
                }
            }
        } else {
            \Log::warning('⚠️ No detail data found or detail is not an array');
        }
        
        \Log::info('✅ DetailDepthCaliper updated:', ['total_records' => $detailCount]);
        
        // ==================================================================
        // 4. UPDATE ADDITIONAL DATA (jika ada)
        // ==================================================================
        if ($add = $calibration->addDepthCaliper) {
            $updateData = [];
            
            // Handle repeatability jika ada
            if ($request->filled('repeatability')) {
                $updateData['repeatability'] = trim($request->repeatability);
            }
            
            // Handle ulangan tambahan jika ada
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = ($i < 10) ? 'ulangan0' . $i : 'ulangan' . $i;
                if ($request->filled($fieldName)) {
                    $fieldValue = $this->formatNumericValue($request->$fieldName);
                    if (!is_null($fieldValue)) {
                        $updateData[$fieldName] = $fieldValue;
                    }
                }
            }
            
            if (!empty($updateData)) {
                $add->update($updateData);
                \Log::info('✅ AddDepthCaliper updated');
            }
        }
        
        // ==================================================================
        // 5. FINAL VERIFICATION
        // ==================================================================
        $finalHead = HeadDepthCaliper::where('calibration_id', $calibration->id)->first();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'details_count' => $detailCount
        ]);
        
        \Log::info('🎉 updateDepthCaliper COMPLETED', [
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA'
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateDepthCaliper FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'unknown'
        ]);
        throw $e;
    }
}
     private function storeCaliper($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1, $tabId = null)
{
    \Log::info('🚀 ===== START storeCaliper =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm,
        'tab_id' => $tabId
    ]);
    
    try {
        // Jika tabId tidak dikirim, coba ambil dari request
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        // Jika tidak dikirim dari parameter, ambil dari request
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        // ==================================================================
        // LOG RAW REQUEST DATA UNTUK ALAT STANDAR
        // ==================================================================
        \Log::info('🔍 RAW REQUEST - semua input alat standar:');
        for ($i = 1; $i <= $jumlahForm; $i++) {
            $key = "alat_standar_{$i}";
            $value = $request->input($key, []);
            \Log::info("  {$key}:", [
                'value' => $value,
                'type' => gettype($value),
                'count' => is_array($value) ? count($value) : 1
            ]);
        }
        
        // ==================================================================
        // AMBIL CAPACITY DARI FORM 1
        // ==================================================================
        $capacity = $request->capacity ?? '300';
        if (!in_array($capacity, ['300', '450', '600', '1000'])) {
            $capacity = '300';
        }
        
        $calibration->update([
            'capacity' => $capacity,
        ]);
        
        \Log::info('Capacity tersimpan', ['capacity' => $capacity]);
        
        // ==================================================================
        // EKSTRAK DATA DARI SEMUA FORM JIKA MULTIPLE SUBMIT
        // ==================================================================
        $allFormsData = [];
        
        if ($isMultipleSubmit) {
            for ($i = 1; $i <= $jumlahForm; $i++) {
                $formData = [];
                foreach ($request->all() as $key => $value) {
                    if (strpos($key, "form_{$i}_") === 0) {
                        $originalKey = substr($key, strlen("form_{$i}_"));
                        
                        // Handle array fields untuk alat_standar
                        if (strpos($originalKey, 'alat_standar') !== false) {
                            if (!isset($formData['alat_standar'])) {
                                $formData['alat_standar'] = [];
                            }
                            if (!is_array($value)) {
                                $formData['alat_standar'][] = $value;
                            } else {
                                $formData['alat_standar'] = array_merge($formData['alat_standar'], $value);
                            }
                        } else {
                            if (!is_array($value)) {
                                $formData[$originalKey] = $value;
                            } else {
                                $formData[$originalKey] = json_encode($value);
                            }
                        }
                    }
                }
                
                if (!empty($formData)) {
                    $formData['form_index'] = $i;
                    $allFormsData[$i] = $formData;
                    \Log::info("📊 Form {$i} data extracted:", array_keys($formData));
                } else {
                    \Log::warning("⚠️ No data found for form {$i}, creating empty");
                    $allFormsData[$i] = ['form_index' => $i];
                }
            }
        } else {
            $allFormsData[1] = $request->all();
        }
        
        // Pastikan semua form yang diharapkan ada
        for ($i = 1; $i <= $jumlahForm; $i++) {
            if (!isset($allFormsData[$i])) {
                $allFormsData[$i] = ['form_index' => $i];
            }
        }
        
        // ==================================================================
        // LOG ALAT STANDAR SETELAH EKSTRAK
        // ==================================================================
        \Log::info('🔍 ALAT STANDAR SETELAH EKSTRAK:');
        for ($i = 1; $i <= $jumlahForm; $i++) {
            $formData = $allFormsData[$i] ?? [];
            $alatStandar = $formData['alat_standar'] ?? [];
            \Log::info("  Form {$i} alat_standar:", [
                'value' => $alatStandar,
                'type' => gettype($alatStandar)
            ]);
        }
        
        // ==================================================================
        // AMBIL ALAT STANDAR DARI FORM 1 (UNTUK DISINKRONKAN KE FORM LAIN)
        // ==================================================================
        $form1Data = $allFormsData[1] ?? [];
        $alatStandar = $form1Data['alat_standar'] ?? [];
        if (is_string($alatStandar)) {
            $alatStandar = json_decode($alatStandar, true) ?? [$alatStandar];
        }
        if (!is_array($alatStandar)) {
            $alatStandar = [];
        }
        // FILTER: Hanya ambil yang tidak kosong
        $alatStandar = array_filter($alatStandar, function($value) {
            return !empty(trim($value));
        });
        $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('📋 Alat Standar dari FORM 1 (akan digunakan untuk SEMUA form):', [
            'raw_array' => $alatStandar,
            'imploded' => $standardValue,
            'count' => count($alatStandar)
        ]);
        
        // ==================================================================
        // STORE HEADS UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $formData = $allFormsData[$formIndex] ?? [];
            
          // Ambil satuan unit dengan memperhatikan tabId
            $satuanUnitInside = null;
            $possibleKeysInside = [
                "form_{$formIndex}_satuan_unit_inside_{$formIndex}_tab{$tabId}",
                "form_{$formIndex}_satuan_unit_inside_{$formIndex}",
                "satuan_unit_inside_{$formIndex}_tab{$tabId}",
                "satuan_unit_inside_{$formIndex}",
                "satuan_unit_inside"
            ];
            
            foreach ($possibleKeysInside as $key) {
                if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                    $satuanUnitInside = $formData[$key];
                    break;
                }
                if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                    $satuanUnitInside = $request->input($key);
                    break;
                }
            }
            
            $satuanUnitOutside = null;
            $possibleKeysOutside = [
                "form_{$formIndex}_satuan_unit_outside_{$formIndex}_tab{$tabId}",
                "form_{$formIndex}_satuan_unit_outside_{$formIndex}",
                "satuan_unit_outside_{$formIndex}_tab{$tabId}",
                "satuan_unit_outside_{$formIndex}",
                "satuan_unit_outside"
            ];
            
            foreach ($possibleKeysOutside as $key) {
                if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                    $satuanUnitOutside = $formData[$key];
                    break;
                }
                if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                    $satuanUnitOutside = $request->input($key);
                    break;
                }
            }
            
            // 🔥 TAMBAHKAN LOG UNTUK DEBUG
            \Log::info("🔍 Raw satuan values for form {$formIndex}:", [
                'inside_raw' => $satuanUnitInside,
                'outside_raw' => $satuanUnitOutside,
                'from_request_inside' => $request->input("satuan_unit_inside_{$formIndex}"),
                'from_request_outside' => $request->input("satuan_unit_outside_{$formIndex}"),
            ]);
            
            // Jika masih array, ambil nilai pertama
            if (is_array($satuanUnitInside)) {
                $satuanUnitInside = !empty($satuanUnitInside) ? $satuanUnitInside[0] : ' ';
            }
            if (is_array($satuanUnitOutside)) {
                $satuanUnitOutside = !empty($satuanUnitOutside) ? $satuanUnitOutside[0] : ' ';
            }
            
            // 🔥 HANYA SET DEFAULT JIKA BENAR-BENAR KOSONG
            if (empty($satuanUnitInside) || $satuanUnitInside === null || trim($satuanUnitInside) === '') {
                $satuanUnitInside = ' ';
            }
            if (empty($satuanUnitOutside) || $satuanUnitOutside === null || trim($satuanUnitOutside) === '') {
                $satuanUnitOutside = ' ';
            }
            
            \Log::info("📝 Final satuan values for form {$formIndex}:", [
                'satuan_unit_inside' => $satuanUnitInside,
                'satuan_unit_outside' => $satuanUnitOutside,
            ]);

            
            HeadCaliper::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'satuan_unit_inside' => $satuanUnitInside,
                    'satuan_unit_outside' => $satuanUnitOutside,
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK1102-03 (JIS B 7507:2022 (JMA/JSA); SNSU PK.P-02:2020).',
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
        }
        
        // Hapus head untuk form yang tidak digunakan
        HeadCaliper::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // STORE DETAILS UNTUK SETIAP FORM
        // ==================================================================
        // Hapus detail lama untuk calibration ini
        DetailCaliper::where('calibration_id', $calibration->id)->delete();
        AddCaliper::where('calibration_id', $calibration->id)->delete();
        
        $totalDetailCount = 0;
        $totalAddCount = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $formData = $allFormsData[$formIndex] ?? [];
            \Log::info("📊 Processing details for form {$formIndex}");
            
              // ==============================================================
        // 1. SIMPAN DATA ADD CALIPER (KESEJAJARAN & PENGUKURAN DALAM)
        // ==============================================================
        $titikUkurKesejajaran = null;
        $possibleKeys = [
            "form_{$formIndex}_titikUkurKesejajaran_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_titikUkurKesejajaran_{$formIndex}",
            "titikUkurKesejajaran_{$formIndex}_tab{$tabId}",
            "titikUkurKesejajaran_{$formIndex}",
            "titikUkurKesejajaran"
        ];
        
        foreach ($possibleKeys as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $titikUkurKesejajaran = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $titikUkurKesejajaran = $request->input($key);
                break;
            }
        }
        
        if (is_array($titikUkurKesejajaran)) {
            $titikUkurKesejajaran = !empty($titikUkurKesejajaran) ? $titikUkurKesejajaran[0] : null;
        }
        
        // KESEJAJARAN AWAL
        $kesejajaranAwal = null;
        $possibleKeysAwal = [
            "form_{$formIndex}_kesejajaranAwal_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_kesejajaranAwal_{$formIndex}",
            "kesejajaranAwal_{$formIndex}_tab{$tabId}",
            "kesejajaranAwal_{$formIndex}",
            "kesejajaranAwal"
        ];
        foreach ($possibleKeysAwal as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $kesejajaranAwal = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $kesejajaranAwal = $request->input($key);
                break;
            }
        }
        if (is_array($kesejajaranAwal)) {
            $kesejajaranAwal = !empty($kesejajaranAwal) ? $kesejajaranAwal[0] : null;
        }
        
        // KESEJAJARAN TENGAH
        $kesejajaranTengah = null;
        $possibleKeysTengah = [
            "form_{$formIndex}_kesejajaranTengah_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_kesejajaranTengah_{$formIndex}",
            "kesejajaranTengah_{$formIndex}_tab{$tabId}",
            "kesejajaranTengah_{$formIndex}",
            "kesejajaranTengah"
        ];
        foreach ($possibleKeysTengah as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $kesejajaranTengah = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $kesejajaranTengah = $request->input($key);
                break;
            }
        }
        if (is_array($kesejajaranTengah)) {
            $kesejajaranTengah = !empty($kesejajaranTengah) ? $kesejajaranTengah[0] : null;
        }
        
        // KESEJAJARAN AKHIR
        $kesejajaranAkhir = null;
        $possibleKeysAkhir = [
            "form_{$formIndex}_kesejajaranAkhir_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_kesejajaranAkhir_{$formIndex}",
            "kesejajaranAkhir_{$formIndex}_tab{$tabId}",
            "kesejajaranAkhir_{$formIndex}",
            "kesejajaranAkhir"
        ];
        foreach ($possibleKeysAkhir as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $kesejajaranAkhir = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $kesejajaranAkhir = $request->input($key);
                break;
            }
        }
        if (is_array($kesejajaranAkhir)) {
            $kesejajaranAkhir = !empty($kesejajaranAkhir) ? $kesejajaranAkhir[0] : null;
        }
        
        // PENGUKURAN DALAM PISAU BERSILANG
        $pengukuranDalamPisauBersilang = null;
        $possibleKeysDalam = [
            "form_{$formIndex}_pengukuranDalamPisauBersilang_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_pengukuranDalamPisauBersilang_{$formIndex}",
            "pengukuranDalamPisauBersilang_{$formIndex}_tab{$tabId}",
            "pengukuranDalamPisauBersilang_{$formIndex}",
            "pengukuranDalamPisauBersilang"
        ];
        foreach ($possibleKeysDalam as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $pengukuranDalamPisauBersilang = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $pengukuranDalamPisauBersilang = $request->input($key);
                break;
            }
        }
        if (is_array($pengukuranDalamPisauBersilang)) {
            $pengukuranDalamPisauBersilang = !empty($pengukuranDalamPisauBersilang) ? $pengukuranDalamPisauBersilang[0] : null;
        }
        
        // PEMBACAAN 1
        $pembacaan1 = null;
        $possibleKeysP1 = [
            "form_{$formIndex}_pembacaan1_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_pembacaan1_{$formIndex}",
            "pembacaan1_{$formIndex}_tab{$tabId}",
            "pembacaan1_{$formIndex}",
            "pembacaan1"
        ];
        foreach ($possibleKeysP1 as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $pembacaan1 = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $pembacaan1 = $request->input($key);
                break;
            }
        }
        if (is_array($pembacaan1)) {
            $pembacaan1 = !empty($pembacaan1) ? $pembacaan1[0] : null;
        }
        
        // PEMBACAAN 2
        $pembacaan2 = null;
        $possibleKeysP2 = [
            "form_{$formIndex}_pembacaan2_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_pembacaan2_{$formIndex}",
            "pembacaan2_{$formIndex}_tab{$tabId}",
            "pembacaan2_{$formIndex}",
            "pembacaan2"
        ];
        foreach ($possibleKeysP2 as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $pembacaan2 = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $pembacaan2 = $request->input($key);
                break;
            }
        }
        if (is_array($pembacaan2)) {
            $pembacaan2 = !empty($pembacaan2) ? $pembacaan2[0] : null;
        }
        
        // PEMBACAAN 3
        $pembacaan3 = null;
        $possibleKeysP3 = [
            "form_{$formIndex}_pembacaan3_{$formIndex}_tab{$tabId}",
            "form_{$formIndex}_pembacaan3_{$formIndex}",
            "pembacaan3_{$formIndex}_tab{$tabId}",
            "pembacaan3_{$formIndex}",
            "pembacaan3"
        ];
        foreach ($possibleKeysP3 as $key) {
            if (isset($formData[$key]) && $formData[$key] !== '' && $formData[$key] !== null) {
                $pembacaan3 = $formData[$key];
                break;
            }
            if ($request->has($key) && $request->input($key) !== '' && $request->input($key) !== null) {
                $pembacaan3 = $request->input($key);
                break;
            }
        }
        if (is_array($pembacaan3)) {
            $pembacaan3 = !empty($pembacaan3) ? $pembacaan3[0] : null;
        }
        
        $addData = [
            'calibration_id' => $calibration->id,
            'form_index' => $formIndex,
            'titikUkurKesajajaran' => $titikUkurKesejajaran,
            'kesejajaranAwal' => $kesejajaranAwal,
            'kesejajaranTengah' => $kesejajaranTengah,
            'kesejajaranAkhir' => $kesejajaranAkhir,
            'pengukuranDalamPisauBersilang' => $pengukuranDalamPisauBersilang,
            'pembacaan1' => $pembacaan1,
            'pembacaan2' => $pembacaan2,
            'pembacaan3' => $pembacaan3,
        ];
        
        \Log::info("📝 AddCaliper data for form {$formIndex}:", $addData);
        
        // Cek apakah ada data yang diisi
        $hasAddData = !empty($addData['titikUkurKesejajaran']) || 
                      !empty($addData['kesejajaranAwal']) || 
                      !empty($addData['kesejajaranTengah']) || 
                      !empty($addData['kesejajaranAkhir']) ||
                      !empty($addData['pengukuranDalamPisauBersilang']) ||
                      !empty($addData['pembacaan1']) ||
                      !empty($addData['pembacaan2']) ||
                      !empty($addData['pembacaan3']);
        
        if ($hasAddData) {
            AddCaliper::create($addData);
            $totalAddCount++;
            \Log::info("✅ AddCaliper saved for form {$formIndex}");
        } else {
            \Log::info("ℹ️ No AddCaliper data for form {$formIndex}");
        }
        
            
            // ==============================================================
            // 2. SIMPAN DATA PENGUKURAN OUTSIDE & INSIDE
            // ==============================================================
            $outsideTitikUkur = $formData["outside_titik_ukur_{$formIndex}"] ?? [];
            $insideTitikUkur = $formData["inside_titik_ukur_{$formIndex}"] ?? [];
            
            if (is_string($outsideTitikUkur)) {
                $outsideTitikUkur = json_decode($outsideTitikUkur, true) ?: [];
            }
            if (is_string($insideTitikUkur)) {
                $insideTitikUkur = json_decode($insideTitikUkur, true) ?: [];
            }
            if (!is_array($outsideTitikUkur)) {
                $outsideTitikUkur = [];
            }
            if (!is_array($insideTitikUkur)) {
                $insideTitikUkur = [];
            }
            
            $outside01 = $formData["outside_ulangan01_{$formIndex}"] ?? [];
            $outside02 = $formData["outside_ulangan02_{$formIndex}"] ?? [];
            $outside03 = $formData["outside_ulangan03_{$formIndex}"] ?? [];
            $outside04 = $formData["outside_ulangan04_{$formIndex}"] ?? [];
            $outside05 = $formData["outside_ulangan05_{$formIndex}"] ?? [];
            
            $inside01 = $formData["inside_ulangan01_{$formIndex}"] ?? [];
            $inside02 = $formData["inside_ulangan02_{$formIndex}"] ?? [];
            $inside03 = $formData["inside_ulangan03_{$formIndex}"] ?? [];
            $inside04 = $formData["inside_ulangan04_{$formIndex}"] ?? [];
            $inside05 = $formData["inside_ulangan05_{$formIndex}"] ?? [];
            
            $outside01 = is_array($outside01) ? $outside01 : (is_string($outside01) ? json_decode($outside01, true) ?: [] : []);
            $outside02 = is_array($outside02) ? $outside02 : (is_string($outside02) ? json_decode($outside02, true) ?: [] : []);
            $outside03 = is_array($outside03) ? $outside03 : (is_string($outside03) ? json_decode($outside03, true) ?: [] : []);
            $outside04 = is_array($outside04) ? $outside04 : (is_string($outside04) ? json_decode($outside04, true) ?: [] : []);
            $outside05 = is_array($outside05) ? $outside05 : (is_string($outside05) ? json_decode($outside05, true) ?: [] : []);
            $inside01 = is_array($inside01) ? $inside01 : (is_string($inside01) ? json_decode($inside01, true) ?: [] : []);
            $inside02 = is_array($inside02) ? $inside02 : (is_string($inside02) ? json_decode($inside02, true) ?: [] : []);
            $inside03 = is_array($inside03) ? $inside03 : (is_string($inside03) ? json_decode($inside03, true) ?: [] : []);
            $inside04 = is_array($inside04) ? $inside04 : (is_string($inside04) ? json_decode($inside04, true) ?: [] : []);
            $inside05 = is_array($inside05) ? $inside05 : (is_string($inside05) ? json_decode($inside05, true) ?: [] : []);
            
            \Log::info("📊 Detail data counts for form {$formIndex}:", [
                'outside_titik' => count($outsideTitikUkur),
                'inside_titik' => count($insideTitikUkur),
            ]);
            
            for ($i = 0; $i < count($outsideTitikUkur); $i++) {
                $titikUkur = $outsideTitikUkur[$i] ?? null;
                
                if ($titikUkur !== null && $titikUkur !== '') {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $titikUkur,
                        'outside01' => $outside01[$i] ?? null,
                        'outside02' => $outside02[$i] ?? null,
                        'outside03' => $outside03[$i] ?? null,
                        'outside04' => $outside04[$i] ?? null,
                        'outside05' => $outside05[$i] ?? null,
                        'inside01' => null,
                        'inside02' => null,
                        'inside03' => null,
                        'inside04' => null,
                        'inside05' => null,
                    ];
                    
                    DetailCaliper::create($detailData);
                    $totalDetailCount++;
                }
            }
            
            for ($i = 0; $i < count($insideTitikUkur); $i++) {
                $titikUkur = $insideTitikUkur[$i] ?? null;
                
                if ($titikUkur !== null && $titikUkur !== '') {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $titikUkur,
                        'outside01' => null,
                        'outside02' => null,
                        'outside03' => null,
                        'outside04' => null,
                        'outside05' => null,
                        'inside01' => $inside01[$i] ?? null,
                        'inside02' => $inside02[$i] ?? null,
                        'inside03' => $inside03[$i] ?? null,
                        'inside04' => $inside04[$i] ?? null,
                        'inside05' => $inside05[$i] ?? null,
                    ];
                    
                    DetailCaliper::create($detailData);
                    $totalDetailCount++;
                }
            }
        }
        
        // ==================================================================
        // UPDATE CALIBRATION DENGAN JUMLAH FORM
        // ==================================================================
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        $totalRecords = DetailCaliper::where('calibration_id', $calibration->id)->count();
        $totalAddRecords = AddCaliper::where('calibration_id', $calibration->id)->count();
        
        \Log::info('✅ storeCaliper completed successfully', [
            'calibration_id' => $calibration->id,
            'total_details' => $totalRecords,
            'total_add' => $totalAddRecords,
            'jumlah_form' => $jumlahForm,
            'capacity' => $capacity,
            'standard_yang_tersimpan' => $standardValue
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeCaliper FAILED:', [
            'message' => $e->getMessage(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}
       /**
 * Method update untuk Caliper - Multiple Form Support
 */
private function updateCaliper($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateCaliper =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head form 1 untuk cek certificate_id
        $form1Head = HeadCaliper::where('calibration_id', $calibration->id)
            ->where('form_index', 1)
            ->first();
        
        $currentCertificateId = $form1Head->certificate_id ?? null;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'namaAlat_di_calibration' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $calibration->namaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $calibration->namaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // AMBIL CAPACITY & JUMLAH FORM
        // ==================================================================
        $capacity = $request->capacity ?? ($calibration->capacity ?? '300');
        if (!in_array($capacity, ['300', '450', '600', '1000'])) {
            $capacity = '300';
        }
        
        $calibration->update(['capacity' => $capacity]);
        \Log::info('Capacity diupdate', ['capacity' => $capacity]);
        
        // Ambil jumlah form dari request
        $jumlahForm = (int) ($request->jumlah_form ?? $calibration->jumlah_form ?? 1);
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 UPDATE Caliper - Multiple Form', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
        ]);
        
        // ==================================================================
        // 1. UPDATE HEAD UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $head = HeadCaliper::where('calibration_id', $calibration->id)
                ->where('form_index', $formIndex)
                ->first();
            
            // Ambil satuan unit
            $satuanUnitInside = $request->input("satuan_unit_inside_{$formIndex}", 'mm');
            $satuanUnitOutside = $request->input("satuan_unit_outside_{$formIndex}", 'mm');
            
            $headData = [
                'satuan_unit_inside' => $satuanUnitInside,
                'satuan_unit_outside' => $satuanUnitOutside,
            ];
            
            // Alat standar untuk form 1
            if ($formIndex == 1) {
                $alatStandar = $request->alat_standar ?? [];
                $headData['standard'] = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
                $headData['calibrationMethod'] = 'PAS-IK1102-03 (JIS B 7507:2022 (JMA/JSA); SNSU PK.P-02:2020).';
            }
            
            // UPDATE CERTIFICATE ID DI HEAD
            if ($certificateIdUpdated && !empty($certificateIdBaru)) {
                $headData['certificate_id'] = $certificateIdBaru;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex}: {$certificateIdBaru}");
            } elseif ($newCertificateId && !$certificateIdUpdated) {
                $headData['certificate_id'] = $newCertificateId;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex} dari parameter: {$newCertificateId}");
            }
            
            if ($head) {
                $head->update($headData);
                \Log::info("✅ Head updated for form {$formIndex}", [
                    'head_id' => $head->id,
                    'satuan_unit_inside' => $head->satuan_unit_inside,
                    'satuan_unit_outside' => $head->satuan_unit_outside,
                    'certificate_id' => $head->certificate_id ?? 'not_set'
                ]);
            } else {
                $headData['calibration_id'] = $calibration->id;
                $headData['form_index'] = $formIndex;
                $headData['certificate_id'] = $headData['certificate_id'] ?? $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
                $head = HeadCaliper::create($headData);
                \Log::info("➕ New head created for form {$formIndex}");
            }
        }
        
        // Hapus head untuk form yang tidak digunakan
        HeadCaliper::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS (OUTSIDE & INSIDE)
        // ==================================================================
        // Hapus detail lama
        DetailCaliper::where('calibration_id', $calibration->id)->delete();
        
        $totalDetailCount = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing details for form {$formIndex}");
            
            // Ambil data outside
            $outsideTitikUkur = $request->input("outside_titik_ukur_{$formIndex}", []);
            $outside01 = $request->input("outside_ulangan01_{$formIndex}", []);
            $outside02 = $request->input("outside_ulangan02_{$formIndex}", []);
            $outside03 = $request->input("outside_ulangan03_{$formIndex}", []);
            $outside04 = $request->input("outside_ulangan04_{$formIndex}", []);
            $outside05 = $request->input("outside_ulangan05_{$formIndex}", []);
            
            // Ambil data inside
            $insideTitikUkur = $request->input("inside_titik_ukur_{$formIndex}", []);
            $inside01 = $request->input("inside_ulangan01_{$formIndex}", []);
            $inside02 = $request->input("inside_ulangan02_{$formIndex}", []);
            $inside03 = $request->input("inside_ulangan03_{$formIndex}", []);
            $inside04 = $request->input("inside_ulangan04_{$formIndex}", []);
            $inside05 = $request->input("inside_ulangan05_{$formIndex}", []);
            
            // Simpan data outside (8 baris)
            for ($i = 0; $i < count($outsideTitikUkur); $i++) {
                $titikUkur = $outsideTitikUkur[$i] ?? '';
                $hasData = !empty(trim($titikUkur)) || 
                          !empty(trim($outside01[$i] ?? '')) || 
                          !empty(trim($outside02[$i] ?? '')) || 
                          !empty(trim($outside03[$i] ?? '')) || 
                          !empty(trim($outside04[$i] ?? '')) || 
                          !empty(trim($outside05[$i] ?? ''));
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $titikUkur,
                        'outside01' => !empty($outside01[$i]) ? $outside01[$i] : null,
                        'outside02' => !empty($outside02[$i]) ? $outside02[$i] : null,
                        'outside03' => !empty($outside03[$i]) ? $outside03[$i] : null,
                        'outside04' => !empty($outside04[$i]) ? $outside04[$i] : null,
                        'outside05' => !empty($outside05[$i]) ? $outside05[$i] : null,
                        'inside01' => null,
                        'inside02' => null,
                        'inside03' => null,
                        'inside04' => null,
                        'inside05' => null,
                    ];
                    
                    DetailCaliper::create($detailData);
                    $totalDetailCount++;
                }
            }
            
            // Simpan data inside (7 baris)
            for ($i = 0; $i < count($insideTitikUkur); $i++) {
                $titikUkur = $insideTitikUkur[$i] ?? '';
                $hasData = !empty(trim($titikUkur)) || 
                          !empty(trim($inside01[$i] ?? '')) || 
                          !empty(trim($inside02[$i] ?? '')) || 
                          !empty(trim($inside03[$i] ?? '')) || 
                          !empty(trim($inside04[$i] ?? '')) || 
                          !empty(trim($inside05[$i] ?? ''));
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $titikUkur,
                        'outside01' => null,
                        'outside02' => null,
                        'outside03' => null,
                        'outside04' => null,
                        'outside05' => null,
                        'inside01' => !empty($inside01[$i]) ? $inside01[$i] : null,
                        'inside02' => !empty($inside02[$i]) ? $inside02[$i] : null,
                        'inside03' => !empty($inside03[$i]) ? $inside03[$i] : null,
                        'inside04' => !empty($inside04[$i]) ? $inside04[$i] : null,
                        'inside05' => !empty($inside05[$i]) ? $inside05[$i] : null,
                    ];
                    
                    DetailCaliper::create($detailData);
                    $totalDetailCount++;
                }
            }
        }
        
        // ==================================================================
        // 3. UPDATE ADD CALIPER (KESEJAJARAN & PENGUKURAN DALAM)
        // ==================================================================
        // Hapus add caliper lama
        AddCaliper::where('calibration_id', $calibration->id)->delete();
        
        $totalAddCount = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            // Ambil data add caliper
            $titikUkurKesejajaran = $request->input("titikUkurKesejajaran_{$formIndex}");
            $kesejajaranAwal = $request->input("kesejajaranAwal_{$formIndex}");
            $kesejajaranTengah = $request->input("kesejajaranTengah_{$formIndex}");
            $kesejajaranAkhir = $request->input("kesejajaranAkhir_{$formIndex}");
            $pengukuranDalamPisauBersilang = $request->input("pengukuranDalamPisauBersilang_{$formIndex}");
            $pembacaan1 = $request->input("pembacaan1_{$formIndex}");
            $pembacaan2 = $request->input("pembacaan2_{$formIndex}");
            $pembacaan3 = $request->input("pembacaan3_{$formIndex}");
            
            $hasData = !empty($titikUkurKesejajaran) || 
                      !empty($kesejajaranAwal) || 
                      !empty($kesejajaranTengah) || 
                      !empty($kesejajaranAkhir) ||
                      !empty($pengukuranDalamPisauBersilang) ||
                      !empty($pembacaan1) ||
                      !empty($pembacaan2) ||
                      !empty($pembacaan3);
            
            if ($hasData) {
                $addData = [
                    'calibration_id' => $calibration->id,
                    'form_index' => $formIndex,
                    'titikUkurKesajajaran' => $titikUkurKesejajaran,
                    'kesejajaranAwal' => $kesejajaranAwal,
                    'kesejajaranTengah' => $kesejajaranTengah,
                    'kesejajaranAkhir' => $kesejajaranAkhir,
                    'pengukuranDalamPisauBersilang' => $pengukuranDalamPisauBersilang,
                    'pembacaan1' => $pembacaan1,
                    'pembacaan2' => $pembacaan2,
                    'pembacaan3' => $pembacaan3,
                ];
                
                AddCaliper::create($addData);
                $totalAddCount++;
                \Log::info("✅ AddCaliper saved for form {$formIndex}");
            }
        }
        
        // ==================================================================
        // 4. FINAL VERIFICATION
        // ==================================================================
        $finalDetails = DetailCaliper::where('calibration_id', $calibration->id)->orderBy('id')->get();
        $finalHeads = HeadCaliper::where('calibration_id', $calibration->id)->orderBy('form_index')->get();
        $finalAdds = AddCaliper::where('calibration_id', $calibration->id)->orderBy('form_index')->get();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'heads_count' => $finalHeads->count(),
            'details_count' => $finalDetails->count(),
            'adds_count' => $finalAdds->count(),
            'certificate_id_calibration' => $calibration->certificate_id,
            'certificate_id_heads' => $finalHeads->pluck('certificate_id')->toArray()
        ]);
        
        \Log::info('🎉 updateCaliper COMPLETED', [
            'calibration_id' => $calibration->id,
            'details_saved' => $totalDetailCount,
            'add_saved' => $totalAddCount,
            'jumlah_form' => $jumlahForm,
            'capacity' => $capacity,
            'certificate_id_head_form1' => $finalHeads->where('form_index', 1)->first()->certificate_id ?? 'TIDAK ADA'
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateCaliper FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}
    
        private function sanitizeMeasurement($value)
        {
            if (is_null($value) || $value === '') {
                return null;
            }
            
            // Hapus spasi dan karakter non-numerik kecuali titik dan minus
            $cleaned = preg_replace('/[^\d\.\-]/', '', (string) $value);
            
            // Cek jika hasilnya kosong
            if ($cleaned === '' || $cleaned === null) {
                return null;
            }
            
            // Pastikan format angka yang valid
            if (!is_numeric($cleaned)) {
                return null;
            }
            
            // Konversi ke float dan format dengan 2 digit desimal
            return number_format((float) $cleaned, 2, '.', '');
        }



        private function storeTorqueWrench($request, $calibration, $certificateId)
        {
            try {
                \Log::info('🚀 START storeTorqueWrench - Simple Version');
        
                // ==================================================================
                // 1. PROSES ALAT STANDAR
                // ==================================================================
                $alatStandar = $request->alat_standar ?? [];
                $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
                \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandarString]);
        
                // ==================================================================
                // 2. SIMPAN KE HEAD TORQUE WRENCH
                // ==================================================================
                $head = HeadTorqueWrench::create([
                    'calibration_id' => $calibration->id,
                    'certificate_id' => $certificateId,
                    'standard' => $alatStandarString,
                    'calibrationMethod' => 'PAS-IK1102-13 (JIS B 4652:2008)',
                    'satuan_setting_alat' => $request->satuan_setting_alat ?? null,
                    'satuan_cw' => $request->satuan_cw ?? null ,
                    'satuan_ccw' => $request->satuan_ccw ?? null,
                         
                ]);
        
                \Log::info('✅ HeadTorqueWrench saved:', ['head_id' => $head->id]);
        
                // ==================================================================
                // 3. SIMPAN DETAIL KALIBRASI (13 BARIS)
                // ==================================================================
                \Log::info('📊 Saving detail measurements...');
                $detailCount = 0;
        
                for ($i = 1; $i <= 13; $i++) {
                    $titikUkur = $request->{"row{$i}_col0"} ?? null;
                    $cw1 = $request->{"row{$i}_col1"} ?? null;
                    $cw2 = $request->{"row{$i}_col2"} ?? null;
                    $cw3 = $request->{"row{$i}_col3"} ?? null;
                    $ccw1 = $request->{"row{$i}_col4"} ?? null;
                    $ccw2 = $request->{"row{$i}_col5"} ?? null;
                    $ccw3 = $request->{"row{$i}_col6"} ?? null;
        
                    // Simpan hanya jika ada data (minimal satu kolom terisi)
                    if ($titikUkur !== null || $cw1 !== null || $cw2 !== null || $cw3 !== null || 
                        $ccw1 !== null || $ccw2 !== null || $ccw3 !== null) {
                        
                        DetailTorqueWrench::create([
                            'calibration_id' => $calibration->id,
                            'titikUkur' => $titikUkur,
                            'cw1' => $cw1,
                            'cw2' => $cw2,
                            'cw3' => $cw3,
                            'ccw1' => $ccw1,
                            'ccw2' => $ccw2,
                            'ccw3' => $ccw3,
                        ]);
                        
                        $detailCount++;
                    }
                }
        
                \Log::info("✅ Saved {$detailCount} detail records");
        
                // ==================================================================
                // 4. SIMPAN ADD TORQUE WRENCH (SEMUA 10 FIELD)
                // ==================================================================
                \Log::info('🔄 Saving AddTorqueWrench data...');
                
                // Data untuk AddTorqueWrench - semua 10 field
                $addData = [
                    'calibration_id' => $calibration->id,
                    
                    // Clockwise 1-10
                    'repCw01' => $request->repeat_cw_1 ?? null,
                    'repCw02' => $request->repeat_cw_2 ?? null,
                    'repCw03' => $request->repeat_cw_3 ?? null,
                    'repCw04' => $request->repeat_cw_4 ?? null,
                    'repCw05' => $request->repeat_cw_5 ?? null,
                    'repCw06' => $request->repeat_cw_6 ?? null,
                    'repCw07' => $request->repeat_cw_7 ?? null,
                    'repCw08' => $request->repeat_cw_8 ?? null,
                    'repCw09' => $request->repeat_cw_9 ?? null,
                    'repCw10' => $request->repeat_cw_10 ?? null,
                    
                    // Counter Clockwise 1-10
                    'repCcw01' => $request->repeat_ccw_1 ?? null,
                    'repCcw02' => $request->repeat_ccw_2 ?? null,
                    'repCcw03' => $request->repeat_ccw_3 ?? null,
                    'repCcw04' => $request->repeat_ccw_4 ?? null,
                    'repCcw05' => $request->repeat_ccw_5 ?? null,
                    'repCcw06' => $request->repeat_ccw_6 ?? null,
                    'repCcw07' => $request->repeat_ccw_7 ?? null,
                    'repCcw08' => $request->repeat_ccw_8 ?? null,
                    'repCcw09' => $request->repeat_ccw_9 ?? null,
                    'repCcw10' => $request->repeat_ccw_10 ?? null,
                ];
        
                // Cek apakah ada data yang perlu disimpan (minimal satu field terisi)
                $hasData = false;
                foreach ($addData as $key => $value) {
                    if ($key !== 'calibration_id' && $value !== null) {
                        $hasData = true;
                        break;
                    }
                }
        
                if ($hasData) {
                    $addRecord = AddTorqueWrench::create($addData);
                    \Log::info('✅ AddTorqueWrench saved:', ['add_id' => $addRecord->id]);
                } else {
                    \Log::info('⚠️ No AddTorqueWrench data to save');
                }
        
                // ==================================================================
                // 5. UPDATE CALIBRATION JIKA ADA DATA TAMBAHAN
                // ==================================================================
                if ($request->has('uncertainty') && $request->uncertainty !== null) {
                    $calibration->update([
                        'uncertainty' => $request->uncertainty,
                        'keterangan' => $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi',
                    ]);
                    \Log::info('📝 Calibration updated with uncertainty data');
                }
        
                // ==================================================================
                // 6. LOG HASIL
                // ==================================================================
                $savedDetailCount = DetailTorqueWrench::where('calibration_id', $calibration->id)->count();
                $savedAddCount = AddTorqueWrench::where('calibration_id', $calibration->id)->count();
        
                \Log::info('📋 STORE SUMMARY:', [
                    'calibration_id' => $calibration->id,
                    'detail_records' => $savedDetailCount,
                    'add_records' => $savedAddCount,
                    'certificate_id' => $certificateId,
                ]);
        
                \Log::info('🎉 storeTorqueWrench COMPLETED');
                return true;
        
            } catch (\Exception $e) {
                \Log::error('💥 ERROR storeTorqueWrench:', [
                    'message' => $e->getMessage(),
                    'file' => $e->getFile(),
                    'line' => $e->getLine(),
                    'calibration_id' => $calibration->id ?? 'N/A',
                ]);
                
                // Rollback sederhana
                if (isset($head) && $head->id) {
                    try {
                        DetailTorqueWrench::where('calibration_id', $calibration->id)->delete();
                        AddTorqueWrench::where('calibration_id', $calibration->id)->delete();
                        $head->delete();
                    } catch (\Exception $rollbackError) {
                        \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
                    }
                }
                
                throw new \Exception("Gagal menyimpan data Torque Wrench: " . $e->getMessage());
            }
        }
        
      private function updateTorqueWrench($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateTorqueWrench =====', [
        'calibration_id' => $calibration->id,
        'certificate_id' => $calibration->headTorqueWrench->certificate_id ?? 'N/A',
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head torque wrench untuk cek certificate_id
        $headTorqueWrench = $calibration->headTorqueWrench;
        $currentCertificateId = $headTorqueWrench->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE ALAT STANDAR & HEAD DATA
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 ALAT STANDAR UPDATE:', [
            'count' => count($alatStandar),
            'items' => $alatStandar,
            'string_value' => $alatStandarString,
            'old_value' => $calibration->headTorqueWrench->standard ?? 'null'
        ]);

        // Prepare update data untuk HEAD
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-13 (JIS B 4652:2008)',
            'satuan_setting_alat' => $request->satuan_setting_alat ?? null,
            'satuan_cw' => $request->satuan_cw ?? null,
            'satuan_ccw' => $request->satuan_ccw ?? null,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }

        // Update atau create head data
        if ($headTorqueWrench) {
            $headTorqueWrench->update($headData);
            \Log::info('✅ HEAD DATA UPDATED:', [
                'head_id' => $headTorqueWrench->id,
                'standard_updated' => true,
                'certificate_id' => $headTorqueWrench->certificate_id,
                'satuan_setting_alat' => $request->satuan_setting_alat ?? null,
                'satuan_cw' => $request->satuan_cw ?? null,
                'satuan_ccw' => $request->satuan_ccw ?? null,
            ]);
        } else {
            \Log::warning('⚠️ NO HEAD DATA FOUND, creating new...');
            
            $headData['calibration_id'] = $calibration->id;
            $headData['certificate_id'] = $headData['certificate_id'] ?? $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
            
            $headTorqueWrench = HeadTorqueWrench::create($headData);
            \Log::info('➕ NEW HEAD CREATED:', [
                'head_id' => $headTorqueWrench->id,
                'certificate_id' => $headTorqueWrench->certificate_id
            ]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS (13 baris)
        // ==================================================================
        \Log::info('📊 DETAIL MEASUREMENTS UPDATE:', [
            'old_records_count' => DetailTorqueWrench::where('calibration_id', $calibration->id)->count(),
            'detail_data_count' => is_array($request->detail) ? count($request->detail) : 0
        ]);
        
        // Log sample of incoming data
        if (is_array($request->detail) && count($request->detail) > 0) {
            \Log::debug('📝 INCOMING DETAIL DATA SAMPLE (first 3 rows):', [
                'row_0' => $request->detail[0] ?? [],
                'row_1' => $request->detail[1] ?? [],
                'row_2' => $request->detail[2] ?? [],
            ]);
        }
        
        // Hapus data detail lama
        $deletedCount = DetailTorqueWrench::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ OLD DETAIL DATA DELETED:', ['deleted_count' => $deletedCount]);
        
        // Simpan data detail baru - 13 BARIS (sesuai dengan input HTML)
        $detailCount = 0;
        $errors = [];
        
        for ($i = 0; $i < 13; $i++) {
            $detailData = $request->detail[$i] ?? [];
            
            // Check if row has data
            $hasData = !empty($detailData) && (
                !empty(trim($detailData['titikUkur'] ?? '')) || 
                !empty(trim($detailData['cw1'] ?? '')) || 
                !empty(trim($detailData['cw2'] ?? '')) || 
                !empty(trim($detailData['cw3'] ?? '')) || 
                !empty(trim($detailData['ccw1'] ?? '')) || 
                !empty(trim($detailData['ccw2'] ?? '')) || 
                !empty(trim($detailData['ccw3'] ?? ''))
            );
            
            if ($hasData) {
                try {
                    $dataToSave = [
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $detailData['titikUkur'] ?? null,
                        'cw1' => $detailData['cw1'] ?? null,
                        'cw2' => $detailData['cw2'] ?? null,
                        'cw3' => $detailData['cw3'] ?? null,
                        'ccw1' => $detailData['ccw1'] ?? null,
                        'ccw2' => $detailData['ccw2'] ?? null,
                        'ccw3' => $detailData['ccw3'] ?? null,
                    ];
                    
                    \Log::debug("💾 SAVING DETAIL ROW {$i}:", [
                        'row' => $i,
                        'data' => $dataToSave
                    ]);
                    
                    DetailTorqueWrench::create($dataToSave);
                    $detailCount++;
                    
                } catch (\Exception $rowError) {
                    $errors[] = "Row {$i}: " . $rowError->getMessage();
                    \Log::error("❌ DETAIL ROW {$i} SAVE ERROR:", [
                        'error' => $rowError->getMessage(),
                        'data' => $detailData
                    ]);
                }
            } else {
                \Log::debug("⏭️ SKIPPING EMPTY DETAIL ROW {$i}");
            }
        }
        
        \Log::info("✅ DETAIL DATA SAVED:", [
            'total_records' => $detailCount,
            'errors_count' => count($errors),
            'errors' => $errors
        ]);

        // ==================================================================
        // 3. UPDATE ADDITIONAL DATA (AddTorqueWrench)
        // ==================================================================
        \Log::info('📊 ADDITIONAL DATA UPDATE:');
        
        // Hapus data additional lama
        $deletedAddCount = AddTorqueWrench::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ OLD ADDITIONAL DATA DELETED:', ['deleted_count' => $deletedAddCount]);
        
        // Simpan data additional baru
        $addData = [
            'calibration_id' => $calibration->id,
        ];
        
        // Data Repeatability Clockwise (repCw01 - repCw10)
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = 'repCw' . str_pad($i, 2, '0', STR_PAD_LEFT);
            $addData[$fieldName] = $request->{$fieldName} ?? null;
        }
        
        // Data Repeatability Counter Clockwise (repCcw01 - repCcw10)
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = 'repCcw' . str_pad($i, 2, '0', STR_PAD_LEFT);
            $addData[$fieldName] = $request->{$fieldName} ?? null;
        }
        
        // Filter hanya field yang ada di fillable model
        $fillable = (new AddTorqueWrench())->getFillable();
        $filteredData = ['calibration_id' => $calibration->id];
        
        foreach ($addData as $key => $value) {
            if (in_array($key, $fillable) || $key === 'calibration_id') {
                $filteredData[$key] = $value;
            }
        }
        
        try {
            AddTorqueWrench::create($filteredData);
            \Log::info('✅ ADDITIONAL DATA SAVED:', [
                'total_fields' => count($filteredData),
                'sample_cw' => [
                    'repCw01' => $filteredData['repCw01'] ?? null, 
                    'repCw02' => $filteredData['repCw02'] ?? null
                ],
                'sample_ccw' => [
                    'repCcw01' => $filteredData['repCcw01'] ?? null, 
                    'repCcw02' => $filteredData['repCcw02'] ?? null
                ]
            ]);
        } catch (\Exception $addError) {
            \Log::error('❌ ADDITIONAL DATA SAVE ERROR:', [
                'error' => $addError->getMessage(),
                'data_sample' => array_slice($filteredData, 0, 5)
            ]);
            throw $addError;
        }

        // ==================================================================
        // 4. VERIFY SAVED DATA
        // ==================================================================
        $savedDetails = DetailTorqueWrench::where('calibration_id', $calibration->id)
            ->orderBy('id')
            ->get();
            
        \Log::info('🔍 VERIFY SAVED DETAIL DATA:', [
            'total_saved' => $savedDetails->count(),
            'first_3_rows_sample' => $savedDetails->take(3)->map(function($item) {
                return [
                    'id' => $item->id,
                    'titikUkur' => $item->titikUkur,
                    'cw1' => $item->cw1,
                    'cw2' => $item->cw2,
                    'cw3' => $item->cw3,
                    'ccw1' => $item->ccw1,
                    'created_at' => $item->created_at
                ];
            })->toArray()
        ]);

        // ==================================================================
        // 5. UPDATE CALIBRATION ADDITIONAL DATA (TANPA CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Tambahan khusus untuk Torque Wrench
        if ($request->filled('unit')) {
            $updateData['unit'] = $request->unit;
        }
        
        if ($request->filled('temperature')) {
            $updateData['temperature'] = $request->temperature;
        }
        
        if ($request->filled('humidity')) {
            $updateData['humidity'] = $request->humidity;
        }
        
        // Kosongkan certificate_id di calibration (biar null, tidak dipakai)
        // Certificate ID hanya disimpan di HEAD saja
        $updateData['certificate_id'] = null;
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 CALIBRATION ADDITIONAL DATA UPDATED:', $updateData);
        }

        // ==================================================================
        // 6. FINAL SUMMARY
        // ==================================================================
        $finalDetailCount = DetailTorqueWrench::where('calibration_id', $calibration->id)->count();
        $finalAddCount = AddTorqueWrench::where('calibration_id', $calibration->id)->count();
        $finalHead = HeadTorqueWrench::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📋 UPDATE SUMMARY:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'detail_records' => $finalDetailCount,
            'additional_records' => $finalAddCount,
            'alat_standar' => $alatStandarString,
            'satuan_setting_alat' => $headTorqueWrench->satuan_setting_alat,
            'satuan_cw' => $headTorqueWrench->satuan_cw,
            'satuan_ccw' => $headTorqueWrench->satuan_ccw,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
            'unit' => $calibration->unit,
            'temperature' => $calibration->temperature,
            'humidity' => $calibration->humidity,
            'execution_time' => microtime(true) - LARAVEL_START,
            'memory_peak' => round(memory_get_peak_usage() / 1024 / 1024, 2) . ' MB'
        ]);

        \Log::info('🎉 updateTorqueWrench COMPLETED SUCCESSFULLY');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 updateTorqueWrench FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'unknown'
        ]);
        throw $e;
    }
}

        private function storeTorqueMeter($request, $calibration, $certificateId,$tabId = null)
{
    try {
       // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        \Log::info('START storeTorqueMeter - Updated Version');
        
        // Debug: log semua data yang diterima
        \Log::info('📥 ALL REQUEST DATA:', $request->all());

        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $certificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'namaAlat_di_calibration' => $calibration->namaAlat,
            'certificate_id_dari_parameter' => $certificateId
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        $textValue  = trim($request->alat_standar_text ?? '');
        $arrayValue = $request->input('alat_standar', []);

        if (!empty($textValue)) {
            $standardValue = $textValue;
        } elseif (is_array($arrayValue) && count($arrayValue) > 0) {
            $standardValue = implode("\n", $arrayValue);
        } else {
            $standardValue = '';
        }

        \Log::info('Alat Standar Final:', [
            'textarea' => $textValue,
            'checkbox_array' => $arrayValue,
            'saved_to_db' => $standardValue
        ]);

        // ==================================================================
        // 2. SIMPAN KE HEAD TORQUE METER
        // ==================================================================
        $headData = [
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateIdBaru,
            'standard'       => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-13B (ASTM D 3474-90 : 2018)',
            'satuan_titikUkur' => $request->satuan_titikUkur ?? null,
            'satuan_cw' => $request->satuan_cw ?? null,
            'satuan_ccw' => $request->satuan_ccw ?? null,
        ];
        
        $head = HeadTorqueMeter::create($headData);

        \Log::info('HeadTorqueMeter saved:', [
            'head_id' => $head->id,
            'certificate_id' => $head->certificate_id
        ]);

        // ==================================================================
        // 3. SIMPAN DETAIL KALIBRASI (13 BARIS) - TANPA SANITIZE
        // ==================================================================
        $detailCount = 0;
        $errors = [];
        
        // Log detail input yang diterima
        \Log::info('📊 DETAIL INPUT DATA:', [
            'detail_exists' => $request->has('detail'),
            'detail_count' => $request->detail ? count($request->detail) : 0,
            'sample_row_0' => $request->detail[0] ?? 'No data',
            'sample_row_1' => $request->detail[1] ?? 'No data',
        ]);
        
        for ($i = 0; $i < 13; $i++) {
            $detailData = $request->input("detail.{$i}", []);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($detailData) && (
                !empty(trim($detailData['titikUkur'] ?? '')) || 
                !empty(trim($detailData['kode_anak_timbang'] ?? '')) || 
                !empty(trim($detailData['cw1'] ?? '')) || 
                !empty(trim($detailData['cw2'] ?? '')) || 
                !empty(trim($detailData['cw3'] ?? '')) || 
                !empty(trim($detailData['ccw1'] ?? '')) || 
                !empty(trim($detailData['ccw2'] ?? '')) || 
                !empty(trim($detailData['ccw3'] ?? ''))
            );
            
            if ($hasData) {
                try {
                    \Log::debug("💾 Processing detail row {$i}:", $detailData);
                    
                    DetailTorqueMeter::create([
                        'calibration_id' => $calibration->id,
                        'titikUkurBeban' => $detailData['titikUkur'] ?? null,
                        'kodeStandard'   => $detailData['kode_anak_timbang'] ?? null,
                        'cw1' => $detailData['cw1'] ?? null,
                        'cw2' => $detailData['cw2'] ?? null,
                        'cw3' => $detailData['cw3'] ?? null,
                        'ccw1' => $detailData['ccw1'] ?? null,
                        'ccw2' => $detailData['ccw2'] ?? null,
                        'ccw3' => $detailData['ccw3'] ?? null,
                    ]);
                    $detailCount++;
                    
                    \Log::debug("✅ Row {$i} saved successfully");
                    
                } catch (\Exception $e) {
                    $errors[] = "Row {$i}: " . $e->getMessage();
                    \Log::error("❌ Row {$i} error: " . $e->getMessage());
                }
            } else {
                \Log::debug("⏭️ Skipping empty row {$i}");
            }
        }

        \Log::info("📋 Detail records saved:", [
            'total_saved' => $detailCount,
            'errors' => $errors,
            'errors_count' => count($errors)
        ]);

        // ==================================================================
        // 4. SIMPAN ADD TORQUE METER - DENGAN PENCARIAN FLEXIBLE
        // ==================================================================
        $repeatCwValues = [];
        $repeatCcwValues = [];
        
        // Cari repeat_cw_1 sampai repeat_cw_10 (dengan atau tanpa _tab)
        for ($i = 1; $i <= 10; $i++) {
            // Coba dengan berbagai kemungkinan nama field
            $value = $request->input("repeat_cw_{$i}_tab{$tabId}");
            if ($value === null) {
                $value = $request->input("repeat_cw_{$i}");
            }
            $repeatCwValues[$i] = $value;
            
            $valueCcw = $request->input("repeat_ccw_{$i}_tab{$tabId}");
            if ($valueCcw === null) {
                $valueCcw = $request->input("repeat_ccw_{$i}");
            }
            $repeatCcwValues[$i] = $valueCcw;
        }
        
        \Log::info('📊 Repeatability values found:', [
            'cw_values' => $repeatCwValues,
            'ccw_values' => $repeatCcwValues,
        ]);
        
        $addData = [
            'calibration_id' => $calibration->id,
            'repCw01' => $repeatCwValues[1] ?? null,
            'repCw02' => $repeatCwValues[2] ?? null,
            'repCw03' => $repeatCwValues[3] ?? null,
            'repCw04' => $repeatCwValues[4] ?? null,
            'repCw05' => $repeatCwValues[5] ?? null,
            'repCw06' => $repeatCwValues[6] ?? null,
            'repCw07' => $repeatCwValues[7] ?? null,
            'repCw08' => $repeatCwValues[8] ?? null,
            'repCw09' => $repeatCwValues[9] ?? null,
            'repCw10' => $repeatCwValues[10] ?? null,
            'repCcw01' => $repeatCcwValues[1] ?? null,
            'repCcw02' => $repeatCcwValues[2] ?? null,
            'repCcw03' => $repeatCcwValues[3] ?? null,
            'repCcw04' => $repeatCcwValues[4] ?? null,
            'repCcw05' => $repeatCcwValues[5] ?? null,
            'repCcw06' => $repeatCcwValues[6] ?? null,
            'repCcw07' => $repeatCcwValues[7] ?? null,
            'repCcw08' => $repeatCcwValues[8] ?? null,
            'repCcw09' => $repeatCcwValues[9] ?? null,
            'repCcw10' => $repeatCcwValues[10] ?? null,
            'radiusAlatBantuSTD' => $request->input('radius_value') ?? $request->input('radius_value_tab' . $tabId),
            'kodeAlatBantuSTD'   => $request->input('radius_unit') ?? $request->input('radius_unit_tab' . $tabId),
        ];

        $hasData = collect($addData)->except('calibration_id')->filter(function($value) {
            return $value !== null && $value !== '';
        })->isNotEmpty();
        
        if ($hasData) {
            AddTorqueMeter::create($addData);
            \Log::info('✅ Additional data saved');
        } else {
            \Log::info('⏭️ No additional data to save');
        }

        // ==================================================================
        // 5. UPDATE CALIBRATION (TANPA CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima';
        }
        
        // Kosongkan certificate_id di calibration (biar null, tidak dipakai)
        // Certificate ID hanya disimpan di HEAD saja
        $updateData['certificate_id'] = null;

        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated:', $updateData);
        }

        // ==================================================================
        // 6. VERIFY FINAL DATA
        // ==================================================================
        $finalDetailCount = DetailTorqueMeter::where('calibration_id', $calibration->id)->count();
        $finalAddCount = AddTorqueMeter::where('calibration_id', $calibration->id)->count();
        $finalHead = HeadTorqueMeter::where('calibration_id', $calibration->id)->first();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'detail_records' => $finalDetailCount,
            'additional_records' => $finalAddCount,
            'head_record' => $head ? 'Exists' : 'Missing',
        ]);

        \Log::info('🎉 storeTorqueMeter COMPLETED SUCCESSFULLY');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeTorqueMeter:', [
            'message' => $e->getMessage(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);

        // Cleanup jika ada error
        if (isset($head)) {
            try {
                DetailTorqueMeter::where('calibration_id', $calibration->id)->delete();
                AddTorqueMeter::where('calibration_id', $calibration->id)->delete();
                $head->delete();
                \Log::warning('🧹 Cleaned up partially saved data due to error');
            } catch (\Exception $cleanupError) {
                \Log::error('❌ Cleanup failed:', ['error' => $cleanupError->getMessage()]);
            }
        }

        throw $e;
    }
}


        
     private function updateTorqueMeter($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 ===== START updateTorqueMeter =====', [
            'calibration_id' => $calibration->id,
            'timestamp' => now()->toDateTimeString()
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head torque meter untuk cek certificate_id
        $headTorqueMeter = $calibration->headTorqueMeter;
        $currentCertificateId = $headTorqueMeter->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // Debug: log semua data radius yang diterima
        \Log::info('📥 RADIUS DATA FROM REQUEST:', [
            'radiusAlatBantuSTD' => $request->radiusAlatBantuSTD ?? 'Not set',
            'kodeAlatBantuSTD' => $request->kodeAlatBantuSTD ?? 'Not set',
        ]);

        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        $textValue  = trim($request->alat_standar_text ?? '');
        $arrayValue = $request->input('alat_standar', []);

        if (!empty($textValue)) {
            $standardValue = $textValue;
        } elseif (is_array($arrayValue) && count($arrayValue) > 0) {
            $standardValue = implode("\n", $arrayValue);
        } else {
            $standardValue = '';
        }

        \Log::info('Alat Standar Final:', ['saved_to_db' => $standardValue]);

        // ==================================================================
        // 2. UPDATE/CREATE HEAD TORQUE METER
        // ==================================================================
        $head = $calibration->headTorqueMeter ?? null;
        
        $headData = [
            'standard' => $standardValue,
            'satuan_titikUkur' => $request->satuan_titikUkur ?? ($head->satuan_titikUkur ?? null),
            'satuan_cw' => $request->satuan_cw ?? ($head->satuan_cw ?? null),
            'satuan_ccw' => $request->satuan_ccw ?? ($head->satuan_ccw ?? null),
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadTorqueMeter updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id,
                'satuan_cw' => $request->satuan_cw ?? 'kept old value',
                'satuan_ccw' => $request->satuan_ccw ?? 'kept old value',
                'satuan_titikUkur' => $request->satuan_titikUkur ?? 'kept old value',
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $headData['calibrationMethod'] = 'PAS-IK1102-13B (ASTM D 3474-90 : 2018)';
            $headData['certificate_id'] = $headData['certificate_id'] ?? $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
            
            $head = HeadTorqueMeter::create($headData);
            \Log::info('➕ HeadTorqueMeter created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        }

        // ==================================================================
        // 3. UPDATE DETAIL MEASUREMENTS (13 baris) - TANPA SANITIZE
        // ==================================================================
        \Log::info('🔄 Processing detail measurements (update per row)...');
        
        $detailCount = 0;
        $updatedDetailCount = 0;
        $createdDetailCount = 0;
        
        for ($i = 0; $i < 13; $i++) {
            $detailData = $request->input("detail.{$i}", []);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($detailData) && (
                isset($detailData['titikUkurBeban']) || 
                isset($detailData['kodeStandard']) || 
                isset($detailData['cw1']) || 
                isset($detailData['cw2']) || 
                isset($detailData['cw3']) || 
                isset($detailData['ccw1']) || 
                isset($detailData['ccw2']) || 
                isset($detailData['ccw3'])
            );
            
            if ($hasData) {
                // Cari data existing berdasarkan calibration_id dan row_index
                $existingDetail = null;
                if (isset($detailData['id'])) {
                    $existingDetail = DetailTorqueMeter::where('id', $detailData['id'])
                        ->where('calibration_id', $calibration->id)
                        ->first();
                }
                
                if ($existingDetail) {
                    // UPDATE existing record - TANPA SANITIZE
                    $existingDetail->update([
                        'titikUkurBeban' => $detailData['titikUkurBeban'] ?? $existingDetail->titikUkurBeban,
                        'kodeStandard' => $detailData['kodeStandard'] ?? $existingDetail->kodeStandard,
                        'cw1' => $detailData['cw1'] ?? $existingDetail->cw1,
                        'cw2' => $detailData['cw2'] ?? $existingDetail->cw2,
                        'cw3' => $detailData['cw3'] ?? $existingDetail->cw3,
                        'ccw1' => $detailData['ccw1'] ?? $existingDetail->ccw1,
                        'ccw2' => $detailData['ccw2'] ?? $existingDetail->ccw2,
                        'ccw3' => $detailData['ccw3'] ?? $existingDetail->ccw3,
                    ]);
                    $updatedDetailCount++;
                    \Log::debug("📝 Updated detail row {$i} (ID: {$existingDetail->id})");
                } else {
                    // CREATE new record jika tidak ada - TANPA SANITIZE
                    DetailTorqueMeter::create([
                        'calibration_id' => $calibration->id,
                        'titikUkurBeban' => $detailData['titikUkurBeban'] ?? null,
                        'kodeStandard' => $detailData['kodeStandard'] ?? null,
                        'cw1' => $detailData['cw1'] ?? null,
                        'cw2' => $detailData['cw2'] ?? null,
                        'cw3' => $detailData['cw3'] ?? null,
                        'ccw1' => $detailData['ccw1'] ?? null,
                        'ccw2' => $detailData['ccw2'] ?? null,
                        'ccw3' => $detailData['ccw3'] ?? null,
                    ]);
                    $createdDetailCount++;
                    \Log::debug("➕ Created new detail row {$i}");
                }
                $detailCount++;
            }
        }

        \Log::info("✅ Detail data processed:", [
            'total_rows_processed' => $detailCount,
            'updated' => $updatedDetailCount,
            'created' => $createdDetailCount,
        ]);

        // ==================================================================
        // 4. UPDATE ADDITIONAL DATA (AddTorqueMeter) - TANPA SANITIZE
        // ==================================================================
        \Log::info('🔄 Processing additional data (update only)...');
        
        // Cari data additional yang sudah ada
        $addDataRecord = AddTorqueMeter::where('calibration_id', $calibration->id)->first();
        
        if ($addDataRecord) {
            // UPDATE existing additional data - TANPA SANITIZE
            $updateData = [];
            
            // Repeatability Clockwise
            if ($request->has('repCw01')) $updateData['repCw01'] = $request->repCw01;
            if ($request->has('repCw02')) $updateData['repCw02'] = $request->repCw02;
            if ($request->has('repCw03')) $updateData['repCw03'] = $request->repCw03;
            if ($request->has('repCw04')) $updateData['repCw04'] = $request->repCw04;
            if ($request->has('repCw05')) $updateData['repCw05'] = $request->repCw05;
            if ($request->has('repCw06')) $updateData['repCw06'] = $request->repCw06;
            if ($request->has('repCw07')) $updateData['repCw07'] = $request->repCw07;
            if ($request->has('repCw08')) $updateData['repCw08'] = $request->repCw08;
            if ($request->has('repCw09')) $updateData['repCw09'] = $request->repCw09;
            if ($request->has('repCw10')) $updateData['repCw10'] = $request->repCw10;
            
            // Repeatability Counter Clockwise
            if ($request->has('repCcw01')) $updateData['repCcw01'] = $request->repCcw01;
            if ($request->has('repCcw02')) $updateData['repCcw02'] = $request->repCcw02;
            if ($request->has('repCcw03')) $updateData['repCcw03'] = $request->repCcw03;
            if ($request->has('repCcw04')) $updateData['repCcw04'] = $request->repCcw04;
            if ($request->has('repCcw05')) $updateData['repCcw05'] = $request->repCcw05;
            if ($request->has('repCcw06')) $updateData['repCcw06'] = $request->repCcw06;
            if ($request->has('repCcw07')) $updateData['repCcw07'] = $request->repCcw07;
            if ($request->has('repCcw08')) $updateData['repCcw08'] = $request->repCcw08;
            if ($request->has('repCcw09')) $updateData['repCcw09'] = $request->repCcw09;
            if ($request->has('repCcw10')) $updateData['repCcw10'] = $request->repCcw10;
            
            // Radius
            if ($request->has('radiusAlatBantuSTD')) {
                $updateData['radiusAlatBantuSTD'] = $request->radiusAlatBantuSTD;
                \Log::info('📝 Updating radiusAlatBantuSTD:', ['value' => $request->radiusAlatBantuSTD]);
            }
            
            if ($request->has('kodeAlatBantuSTD')) {
                $updateData['kodeAlatBantuSTD'] = $request->kodeAlatBantuSTD;
                \Log::info('📝 Updating kodeAlatBantuSTD:', ['value' => $request->kodeAlatBantuSTD]);
            }
            
            if (!empty($updateData)) {
                $addDataRecord->update($updateData);
                \Log::info('✅ Additional data UPDATED:', [
                    'record_id' => $addDataRecord->id,
                    'updated_fields' => array_keys($updateData),
                    'radiusAlatBantuSTD_new' => $updateData['radiusAlatBantuSTD'] ?? 'not changed',
                    'kodeAlatBantuSTD_new' => $updateData['kodeAlatBantuSTD'] ?? 'not changed',
                ]);
            } else {
                \Log::info('⏭️ No changes to additional data');
            }
        } else {
            // CREATE new additional data jika tidak ada - TANPA SANITIZE
            $addData = [
                'calibration_id' => $calibration->id,
                'repCw01' => $request->repCw01 ?? null,
                'repCw02' => $request->repCw02 ?? null,
                'repCw03' => $request->repCw03 ?? null,
                'repCw04' => $request->repCw04 ?? null,
                'repCw05' => $request->repCw05 ?? null,
                'repCw06' => $request->repCw06 ?? null,
                'repCw07' => $request->repCw07 ?? null,
                'repCw08' => $request->repCw08 ?? null,
                'repCw09' => $request->repCw09 ?? null,
                'repCw10' => $request->repCw10 ?? null,
                'repCcw01' => $request->repCcw01 ?? null,
                'repCcw02' => $request->repCcw02 ?? null,
                'repCcw03' => $request->repCcw03 ?? null,
                'repCcw04' => $request->repCcw04 ?? null,
                'repCcw05' => $request->repCcw05 ?? null,
                'repCcw06' => $request->repCcw06 ?? null,
                'repCcw07' => $request->repCcw07 ?? null,
                'repCcw08' => $request->repCcw08 ?? null,
                'repCcw09' => $request->repCcw09 ?? null,
                'repCcw10' => $request->repCcw10 ?? null,
                'radiusAlatBantuSTD' => $request->radiusAlatBantuSTD ?? null,
                'kodeAlatBantuSTD' => $request->kodeAlatBantuSTD ?? null,
            ];
            
            $addDataRecord = AddTorqueMeter::create($addData);
            \Log::info('➕ Additional data CREATED:', [
                'record_id' => $addDataRecord->id,
                'radiusAlatBantuSTD' => $addData['radiusAlatBantuSTD'],
                'kodeAlatBantuSTD' => $addData['kodeAlatBantuSTD'],
            ]);
        }

        // ==================================================================
        // 5. UPDATE CALIBRATION ADDITIONAL DATA (TANPA CERTIFICATE ID)
        // ==================================================================
        $updateCalibrationData = [];
        
        if ($request->filled('calibratedBy')) {
            $updateCalibrationData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateCalibrationData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateCalibrationData['uncertainty'] = $request->uncertainty;
            $updateCalibrationData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if ($request->filled('unit')) {
            $updateCalibrationData['unit'] = $request->unit;
        }
        
        if ($request->filled('temperature')) {
            $updateCalibrationData['temperature'] = $request->temperature;
        }
        
        if ($request->filled('humidity')) {
            $updateCalibrationData['humidity'] = $request->humidity;
        }
        
        // Kosongkan certificate_id di calibration (biar null, tidak dipakai)
        // Certificate ID hanya disimpan di HEAD saja
        $updateCalibrationData['certificate_id'] = null;
        
        if (!empty($updateCalibrationData)) {
            $calibration->update($updateCalibrationData);
            \Log::info('📝 Calibration additional data updated:', $updateCalibrationData);
        }

        // ==================================================================
        // 6. FINAL VERIFICATION
        // ==================================================================
        $finalDetailCount = DetailTorqueMeter::where('calibration_id', $calibration->id)->count();
        $finalAddCount = AddTorqueMeter::where('calibration_id', $calibration->id)->count();
        $finalAddData = AddTorqueMeter::where('calibration_id', $calibration->id)->first();
        $finalHead = HeadTorqueMeter::where('calibration_id', $calibration->id)->first();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'detail_records' => $finalDetailCount,
            'additional_records' => $finalAddCount,
            'head_record' => $finalHead ? 'Exists (ID: ' . $finalHead->id . ')' : 'Missing',
            'radiusAlatBantuSTD' => $finalAddData->radiusAlatBantuSTD ?? 'null',
            'kodeAlatBantuSTD' => $finalAddData->kodeAlatBantuSTD ?? 'null',
            'satuan_cw' => $finalHead->satuan_cw ?? 'null',
            'satuan_ccw' => $finalHead->satuan_ccw ?? 'null',
            'satuan_titikUkur' => $finalHead->satuan_titikUkur ?? 'null',
        ]);

        \Log::info('🎉 updateTorqueMeter COMPLETED SUCCESSFULLY');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTorqueMeter:', [
            'message' => $e->getMessage(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

        
        private function storeThicknessGauge($request, $calibration, $certificateId, $tabId = null)
{
    try {
        \Log::info('🚀 START storeThicknessGauge');
        \Log::info('📋 Request data keys:', array_keys($request->all()));
        
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        // ==================================================================
        // 1. ALAT STANDAR - NILAI TETAP (TIDAK ADA INPUT DARI FORM)
        // ==================================================================
        $alatStandarValue = 'Gauge Block Set Grade 0';
        
        \Log::info('🔧 Alat standar (fixed value):', ['alat_standar' => $alatStandarValue, 'tab_id' => $tabId]);

        // ==================================================================
        // 2. SIMPAN KE HEAD THICKNESS GAUGE
        // ==================================================================
        $head = HeadThicknessGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarValue,
            'calibrationMethod' => 'PAS-IK1102-21',
            'satuan_unit' => $request->satuan_unit ?? null,
        ]);

        \Log::info('✅ HeadThicknessGauge saved:', ['head_id' => $head->id, 'standard' => $alatStandarValue]);

        // ==================================================================
        // 3. SIMPAN DETAIL MEASUREMENTS (17 NILAI: 0.0 - 50.0)
        // ==================================================================
        \Log::info('📊 Saving Thickness Gauge detail measurements...');
        $detailCount = 0;
        
        // Array mapping: nilai nominal asli => format field name di form
        $nominalMapping = [
            ['0.0', '0'],
            ['0.5', '0_5'],
            ['1.0', '1_0'],
            ['2.0', '2_0'],
            ['3.0', '3_0'],
            ['4.0', '4_0'],
            ['5.0', '5_0'],
            ['6.0', '6_0'],
            ['7.0', '7_0'],
            ['8.0', '8_0'],
            ['9.0', '9_0'],
            ['10.0', '10_0'],
            ['15.0', '15_0'],
            ['20.0', '20_0'],
            ['30.0', '30_0'],
            ['40.0', '40_0'],
            ['50.0', '50_0'],
        ];
        
        // Loop melalui semua nominal
        foreach ($nominalMapping as $mapping) {
            $nominal = $mapping[0];
            $fieldSuffix = $mapping[1];
            
            // 🔥 CARI DATA ULANGAN DENGAN ATAU TANPA _tab
            $ulangan01 = $this->getRequestValue($request, "ulangan_{$fieldSuffix}_1", $tabId);
            $ulangan02 = $this->getRequestValue($request, "ulangan_{$fieldSuffix}_2", $tabId);
            $ulangan03 = $this->getRequestValue($request, "ulangan_{$fieldSuffix}_3", $tabId);
            $ulangan04 = $this->getRequestValue($request, "ulangan_{$fieldSuffix}_4", $tabId);
            $ulangan05 = $this->getRequestValue($request, "ulangan_{$fieldSuffix}_5", $tabId);
            
            \Log::debug("📝 Data ulangan untuk nominal {$nominal} (field suffix: {$fieldSuffix}):", [
                'ulangan_1' => $ulangan01,
                'ulangan_2' => $ulangan02,
                'ulangan_3' => $ulangan03,
                'ulangan_4' => $ulangan04,
                'ulangan_5' => $ulangan05,
            ]);
            
            // Validasi: Simpan hanya jika ada minimal satu data ulangan
            $hasUlangan = !empty($ulangan01) || !empty($ulangan02) || !empty($ulangan03) || 
                         !empty($ulangan04) || !empty($ulangan05);
            
            if ($hasUlangan) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $nominal,
                    'ulangan01' => $ulangan01,
                    'ulangan02' => $ulangan02,
                    'ulangan03' => $ulangan03,
                    'ulangan04' => $ulangan04,
                    'ulangan05' => $ulangan05,
                ];
                
                \Log::info("💾 Saving detail for nominal {$nominal}:", $detailData);
                
                DetailThicknessGauge::create($detailData);
                $detailCount++;
                
                \Log::info("✅ Detail saved for nominal {$nominal}");
            } else {
                \Log::debug("⏭️ Skipping nominal {$nominal} - no ulangan data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Thickness Gauge");

        // ==================================================================
        // 4. UPDATE CALIBRATION
        // ==================================================================
        $updateData = [];
        
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if ($request->filled('tanggal_kalibrasi')) {
            $updateData['calibration_date'] = $request->tanggal_kalibrasi;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration data updated:', $updateData);
        }

        \Log::info('📋 STORE SUMMARY:', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $detailCount,
        ]);

        \Log::info('🎉 storeThicknessGauge COMPLETED SUCCESSFULLY');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeThicknessGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
        ]);
        throw $e;
    }
}

/**
 * Helper function untuk mengambil nilai dari request dengan atau tanpa _tab
 */
private function getRequestValue($request, $fieldName, $tabId)
{
    // Coba dengan _tab
    $value = $request->input("{$fieldName}_tab{$tabId}");
    
    // Jika tidak ditemukan, coba tanpa _tab
    if ($value === null) {
        $value = $request->input($fieldName);
    }
    
    return $value;
}
        
        /**
         * Format nilai numerik - untuk handling koma/point
         */
   private function formatNumericValue($value)
{
    // Jika null atau empty string, return null
    if ($value === null || $value === '') {
        return null;
    }
    
    // Bersihkan spasi di awal dan akhir, tapi pertahankan karakter asli
    $value = trim($value);
    
    // Jika setelah trim masih empty, return null
    if ($value === '') {
        return null;
    }
    
    // Kembalikan apa adanya (string)
    return $value;
}
        
        /**
         * Update Thickness Gauge data - VERSI SIMPLE (ALAT STANDAR TETAP)
         */
      private function updateThicknessGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 ===== START updateThicknessGauge =====', [
            'calibration_id' => $calibration->id,
            'timestamp' => now()->toDateTimeString()
        ]);
        
        \Log::info('📋 Request data keys:', array_keys($request->all()));
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head thickness gauge untuk cek certificate_id
        $headThicknessGauge = $calibration->headThicknessGauge;
        $currentCertificateId = $headThicknessGauge->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE HEAD THICKNESS GAUGE - NILAI TETAP
        // ==================================================================
        $alatStandarValue = 'Gauge Block Set Grade 0'; // NILAI TETAP
        
        $headData = [
            'standard' => $alatStandarValue,
            'calibrationMethod' => 'PAS-IK1102-21',
            'satuan_unit' => $request->satuan_unit ?? null,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($headThicknessGauge) {
            $headThicknessGauge->update($headData);
            \Log::info('✅ HeadThicknessGauge updated', [
                'id' => $headThicknessGauge->id,
                'standard' => $alatStandarValue,
                'certificate_id' => $headThicknessGauge->certificate_id,
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $headData['certificate_id'] = $headData['certificate_id'] ?? $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
            
            $headThicknessGauge = HeadThicknessGauge::create($headData);
            \Log::info('➕ HeadThicknessGauge created baru', [
                'id' => $headThicknessGauge->id,
                'calibration_id' => $calibration->id,
                'certificate_id' => $headThicknessGauge->certificate_id
            ]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS (DELETE & RECREATE) - TANPA SANITIZE
        // ==================================================================
        \Log::info('🔄 Updating detail measurements...');
        
        // Hapus data detail lama
        $deletedCount = DetailThicknessGauge::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Data lama dihapus', ['deleted_count' => $deletedCount]);
        
        // Simpan data detail baru
        $detailCount = 0;
        
        // Mapping antara nilai nominal dan format field name di form
        $nominalMapping = [
            ['0.0', '0'],      // Field: ulangan_0_1, ulangan_0_2, dst.
            ['0.5', '0_5'],    // Field: ulangan_0_5_1, ulangan_0_5_2, dst.
            ['1.0', '1_0'],    // Field: ulangan_1_0_1, ulangan_1_0_2, dst.
            ['2.0', '2_0'],    // Field: ulangan_2_0_1, ulangan_2_0_2, dst.
            ['3.0', '3_0'],    // Field: ulangan_3_0_1, ulangan_3_0_2, dst.
            ['4.0', '4_0'],    // Field: ulangan_4_0_1, ulangan_4_0_2, dst.
            ['5.0', '5_0'],    // Field: ulangan_5_0_1, ulangan_5_0_2, dst.
            ['6.0', '6_0'],    // Field: ulangan_6_0_1, ulangan_6_0_2, dst.
            ['7.0', '7_0'],    // Field: ulangan_7_0_1, ulangan_7_0_2, dst.
            ['8.0', '8_0'],    // Field: ulangan_8_0_1, ulangan_8_0_2, dst.
            ['9.0', '9_0'],    // Field: ulangan_9_0_1, ulangan_9_0_2, dst.
            ['10.0', '10_0'],  // Field: ulangan_10_0_1, ulangan_10_0_2, dst.
            ['15.0', '15_0'],  // Field: ulangan_15_0_1, ulangan_15_0_2, dst.
            ['20.0', '20_0'],  // Field: ulangan_20_0_1, ulangan_20_0_2, dst.
            ['30.0', '30_0'],  // Field: ulangan_30_0_1, ulangan_30_0_2, dst.
            ['40.0', '40_0'],  // Field: ulangan_40_0_1, ulangan_40_0_2, dst.
            ['50.0', '50_0'],  // Field: ulangan_50_0_1, ulangan_50_0_2, dst.
        ];
        
        // Log untuk debugging
        \Log::info('🔍 CHECKING ULANGAN FIELDS FROM REQUEST:');
        foreach ($nominalMapping as $mapping) {
            $fieldSuffix = $mapping[1];
            for ($i = 1; $i <= 5; $i++) {
                $fieldName = "ulangan_{$fieldSuffix}_{$i}";
                $value = $request->input($fieldName);
                if (!empty($value)) {
                    \Log::info("  ✅ {$fieldName}: {$value}");
                }
            }
        }
        
        foreach ($nominalMapping as $mapping) {
            $nominal = $mapping[0]; // Nilai asli dengan titik: 0.0, 0.5, dst.
            $fieldSuffix = $mapping[1]; // Format untuk field name: 0, 0_5, 1_0, dst.
            
            // AMBIL DATA ULANGAN (5 kolom) - TANPA SANITIZE
            $ulangan01 = $request->input("ulangan_{$fieldSuffix}_1");
            $ulangan02 = $request->input("ulangan_{$fieldSuffix}_2");
            $ulangan03 = $request->input("ulangan_{$fieldSuffix}_3");
            $ulangan04 = $request->input("ulangan_{$fieldSuffix}_4");
            $ulangan05 = $request->input("ulangan_{$fieldSuffix}_5");
            
            \Log::debug("📝 Data untuk nominal {$nominal} (field: {$fieldSuffix}):", [
                'ulangan_1' => $ulangan01,
                'ulangan_2' => $ulangan02,
                'ulangan_3' => $ulangan03,
                'ulangan_4' => $ulangan04,
                'ulangan_5' => $ulangan05,
            ]);
            
            // Validasi: Simpan hanya jika ada minimal satu data ulangan
            $hasUlangan = !empty($ulangan01) || !empty($ulangan02) || !empty($ulangan03) || 
                         !empty($ulangan04) || !empty($ulangan05);
            
            if ($hasUlangan) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $nominal, // Simpan nilai asli dengan titik
                    'ulangan01' => $ulangan01, // Langsung simpan tanpa format
                    'ulangan02' => $ulangan02,
                    'ulangan03' => $ulangan03,
                    'ulangan04' => $ulangan04,
                    'ulangan05' => $ulangan05,
                ];
                
                \Log::info("💾 Saving detail for nominal {$nominal}:", $detailData);
                
                DetailThicknessGauge::create($detailData);
                $detailCount++;
                
                \Log::info("✅ Detail saved for nominal {$nominal}");
            } else {
                \Log::debug("⏭️ Skipping nominal {$nominal} - no ulangan data");
            }
        }
        
        \Log::info('✅ Detail measurements updated', ['total_records' => $detailCount]);

        // ==================================================================
        // 3. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TANPA CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Nama untuk TTD Dikalibrasi
        if ($request->filled('nama_dikalibrasi')) {
            $updateData['calibrated_by'] = $request->nama_dikalibrasi;
            \Log::info('📝 Nama dikalibrasi updated:', ['nama' => $request->nama_dikalibrasi]);
        }
        
        // Nama untuk TTD Diperiksa
        if ($request->filled('nama_diperiksa')) {
            $updateData['verified_by'] = $request->nama_diperiksa;
            \Log::info('📝 Nama diperiksa updated:', ['nama' => $request->nama_diperiksa]);
        }
        
        // Tanggal Dikalibrasi
        if ($request->filled('tanggal_kalibrasi')) {
            $updateData['calibration_date'] = $request->tanggal_kalibrasi;
            \Log::info('📅 Tanggal dikalibrasi updated:', ['tanggal' => $request->tanggal_kalibrasi]);
        }
        
        // Tanggal Diperiksa
        if ($request->filled('tanggal_diperiksa')) {
            $updateData['verification_date'] = $request->tanggal_diperiksa;
            \Log::info('📅 Tanggal diperiksa updated:', ['tanggal' => $request->tanggal_diperiksa]);
        }
        
        // Uncertainty dan kesimpulan - TANPA SANITIZE
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
            \Log::info('📊 Uncertainty updated:', ['uncertainty' => $updateData['uncertainty']]);
        }
        
        // Status kalibrasi
        if ($request->filled('status')) {
            $updateData['status'] = $request->status;
            \Log::info('📈 Status updated:', ['status' => $request->status]);
        }
        
        // Kosongkan certificate_id di calibration (biar null, tidak dipakai)
        // Certificate ID hanya disimpan di HEAD saja
        $updateData['certificate_id'] = null;
        
        // Update calibration data
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration data updated:', $updateData);
        }

        // ==================================================================
        // 4. HANDLE TTD (TANDA TANGAN) - Jika ada di request
        // ==================================================================
        // TTD Dikalibrasi
        if ($request->filled('ttd_dikalibrasi') && strpos($request->ttd_dikalibrasi, 'data:image') === 0) {
            try {
                $ttdImage = base64_decode(preg_replace('#^data:image/\w+;base64,#i', '', $request->ttd_dikalibrasi));
                $ttdFileName = 'ttd_dikalibrasi_' . $calibration->id . '_' . time() . '.png';
                
                Storage::disk('public')->put('ttd/' . $ttdFileName, $ttdImage);
                
                $calibration->update(['ttd_calibrated' => 'ttd/' . $ttdFileName]);
                \Log::info('💾 TTD dikalibrasi saved:', ['filename' => $ttdFileName]);
            } catch (\Exception $e) {
                \Log::error('❌ Failed to save TTD dikalibrasi:', ['error' => $e->getMessage()]);
            }
        }
        
        // TTD Diperiksa
        if ($request->filled('ttd_diperiksa') && strpos($request->ttd_diperiksa, 'data:image') === 0) {
            try {
                $ttdImage = base64_decode(preg_replace('#^data:image/\w+;base64,#i', '', $request->ttd_diperiksa));
                $ttdFileName = 'ttd_diperiksa_' . $calibration->id . '_' . time() . '.png';
                
                Storage::disk('public')->put('ttd/' . $ttdFileName, $ttdImage);
                
                $calibration->update(['ttd_verified' => 'ttd/' . $ttdFileName]);
                \Log::info('💾 TTD diperiksa saved:', ['filename' => $ttdFileName]);
            } catch (\Exception $e) {
                \Log::error('❌ Failed to save TTD diperiksa:', ['error' => $e->getMessage()]);
            }
        }

        // ==================================================================
        // 5. FINAL VERIFICATION
        // ==================================================================
        $finalDetailCount = DetailThicknessGauge::where('calibration_id', $calibration->id)->count();
        $finalHead = HeadThicknessGauge::where('calibration_id', $calibration->id)->first();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'head_id' => $headThicknessGauge->id,
            'detail_records' => $finalDetailCount,
            'standard' => $alatStandarValue,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        // ==================================================================
        // 6. VALIDASI AKHIR
        // ==================================================================
        $savedDetails = DetailThicknessGauge::where('calibration_id', $calibration->id)
            ->select('titikUkur', 'ulangan01', 'ulangan02', 'ulangan03', 'ulangan04', 'ulangan05')
            ->get()
            ->toArray();
        
        \Log::info('🔍 FINAL VALIDATION - Saved details:', $savedDetails);

        \Log::info('🎉 updateThicknessGauge COMPLETED SUCCESSFULLY');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateThicknessGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        
        throw new \Exception("Gagal mengupdate data Thickness Gauge: " . $e->getMessage());
    }
}

       private function storePenggaris($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        $alatStandarValue = 'Reading Glass Scale, Metrology, OP-RS410/A';
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandarValue, 'tab_id' => $tabId]);

        // Simpan ke Head Penggaris
        $head = HeadPenggaris::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarValue,
            'calibrationMethod' => 'PAS-IK1102-28',
            'satuan_unit' => $request->satuan_unit ?? null,
        ]);

        \Log::info('✅ Head Penggaris saved:', ['head_id' => $head->id]);

        // ==================================================================
        // SIMPAN DETAIL MEASUREMENTS (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving detail measurements...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 16; $i++) {
            // 🔥 CARI NOMINAL DENGAN ATAU TANPA _tab
            $nominal = $this->getRequestValue($request, "nominal_{$i}", $tabId);
            
            if (!empty($nominal)) {
                // 🔥 CARI PENUNJUKAN DENGAN ATAU TANPA _tab
                $penunjukan1 = $this->getRequestValue($request, "penunjukan_{$i}_1", $tabId);
                $penunjukan2 = $this->getRequestValue($request, "penunjukan_{$i}_2", $tabId);
                $penunjukan3 = $this->getRequestValue($request, "penunjukan_{$i}_3", $tabId);
                $penunjukan4 = $this->getRequestValue($request, "penunjukan_{$i}_4", $tabId);
                $penunjukan5 = $this->getRequestValue($request, "penunjukan_{$i}_5", $tabId);
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $nominal,
                    'ulangan01' => $penunjukan1,
                    'ulangan02' => $penunjukan2,
                    'ulangan03' => $penunjukan3,
                    'ulangan04' => $penunjukan4,
                    'ulangan05' => $penunjukan5,
                ];

                \Log::info("📝 Saving detail row {$i}:", $detailData);
                
                DetailPenggaris::create($detailData);
                $detailCount++;
            } else {
                \Log::debug("⏭️ Skipping row {$i} - no nominal value");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements");
        
        // ==================================================================
        // UPDATE CALIBRATION
        // ==================================================================
        $updateData = [];
        
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration data updated:', $updateData);
        }
        
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Penggaris data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A'
        ]);
        throw $e;
    }
}



        private function updatePenggaris($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 ===== START updatePenggaris =====', [
            'calibration_id' => $calibration->id,
            'timestamp' => now()->toDateTimeString()
        ]);
        
        \Log::info('📋 Request data keys:', array_keys($request->all()));
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head penggaris untuk cek certificate_id
        $headPenggaris = $calibration->headPenggaris;
        $currentCertificateId = $headPenggaris->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE HEAD PENGARIS
        // ==================================================================
        $alatStandarValue = 'Reading Glass Scale, Metrology, OP-RS410/A'; // NILAI TETAP
        
        $headData = [
            'standard' => $alatStandarValue,
            'calibrationMethod' => 'PAS-IK1102-28',
            'satuan_unit' => $request->satuan_unit ?? null,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($headPenggaris) {
            $headPenggaris->update($headData);
            \Log::info('✅ HeadPenggaris updated', [
                'id' => $headPenggaris->id,
                'standard' => $alatStandarValue,
                'certificate_id' => $headPenggaris->certificate_id,
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $headData['certificate_id'] = $headData['certificate_id'] ?? $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
            
            $headPenggaris = HeadPenggaris::create($headData);
            \Log::info('➕ HeadPenggaris created baru', [
                'id' => $headPenggaris->id,
                'calibration_id' => $calibration->id,
                'certificate_id' => $headPenggaris->certificate_id
            ]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS (16 BARIS) - TANPA SANITIZE
        // ==================================================================
        \Log::info('🔄 Updating detail measurements (16 baris)...');
        
        // Hapus data lama terlebih dahulu (lebih aman)
        $deletedCount = DetailPenggaris::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Data lama dihapus', ['deleted_count' => $deletedCount]);
        
        // Simpan data baru
        $detailCount = 0;
        
        for ($i = 1; $i <= 16; $i++) {
            $nominalField = "nominal_$i";
            $nominalValue = $request->$nominalField;
            
            // Log untuk debugging
            \Log::debug("Checking row {$i}:", [
                'field' => $nominalField,
                'value' => $nominalValue,
                'has_value' => !empty($nominalValue)
            ]);
            
            // Simpan jika ada nilai nominal
            if (!empty($nominalValue)) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $nominalValue,
                    'ulangan01' => $request->{"penunjukan_{$i}_1"} ?? null,
                    'ulangan02' => $request->{"penunjukan_{$i}_2"} ?? null,
                    'ulangan03' => $request->{"penunjukan_{$i}_3"} ?? null,
                    'ulangan04' => $request->{"penunjukan_{$i}_4"} ?? null,
                    'ulangan05' => $request->{"penunjukan_{$i}_5"} ?? null,
                ];
                
                \Log::info("💾 Saving detail row {$i}:", $detailData);
                
                DetailPenggaris::create($detailData);
                $detailCount++;
            } else {
                \Log::debug("⏭️ Skipping row {$i} - empty nominal");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements");

        // ==================================================================
        // 3. UPDATE CALIBRATION UNIT
        // ==================================================================
        if ($request->filled('unit')) {
            $calibration->update(['unit' => $request->unit]);
            \Log::info('📏 Unit updated:', ['unit' => $request->unit]);
        }

        // ==================================================================
        // 4. UPDATE DATA TAMBAHAN (TTD, NAMA, DLL) - TANPA CERTIFICATE ID
        // ==================================================================
        $updateData = [];
        
        // Nama untuk TTD Dikalibrasi
        if ($request->filled('nama_dikalibrasi')) {
            $updateData['calibrated_by'] = $request->nama_dikalibrasi;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->nama_dikalibrasi]);
        }
        
        // Tanggal Dikalibrasi
        if ($request->filled('tanggal_dikalibrasi')) {
            $updateData['calibration_date'] = $request->tanggal_dikalibrasi;
            \Log::info('📅 Tanggal dikalibrasi:', ['tanggal' => $request->tanggal_dikalibrasi]);
        }
        
        // Nama untuk TTD Diperiksa
        if ($request->filled('nama_diperiksa')) {
            $updateData['verified_by'] = $request->nama_diperiksa;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->nama_diperiksa]);
        }
        
        // Tanggal Diperiksa
        if ($request->filled('tanggal_diperiksa')) {
            $updateData['verification_date'] = $request->tanggal_diperiksa;
            \Log::info('📅 Tanggal diperiksa:', ['tanggal' => $request->tanggal_diperiksa]);
        }
        
        // Uncertainty dan kesimpulan - TANPA SANITIZE
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
            \Log::info('📊 Uncertainty updated:', ['uncertainty' => $updateData['uncertainty']]);
        }
        
        // Status kalibrasi
        if ($request->filled('status')) {
            $updateData['status'] = $request->status;
            \Log::info('📈 Status updated:', ['status' => $request->status]);
        }
        
        // Kosongkan certificate_id di calibration (biar null, tidak dipakai)
        // Certificate ID hanya disimpan di HEAD saja
        $updateData['certificate_id'] = null;
        
        // Update calibration data
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration data updated:', $updateData);
        }

        // ==================================================================
        // 5. HANDLE TANDA TANGAN (TTD)
        // ==================================================================
        // TTD Dikalibrasi
        if ($request->filled('ttd_dikalibrasi') && strpos($request->ttd_dikalibrasi, 'data:image') === 0) {
            try {
                $ttdImage = base64_decode(preg_replace('#^data:image/\w+;base64,#i', '', $request->ttd_dikalibrasi));
                $ttdFileName = 'ttd_dikalibrasi_' . $calibration->id . '_' . time() . '.png';
                
                Storage::disk('public')->put('ttd/' . $ttdFileName, $ttdImage);
                
                $calibration->update(['ttd_calibrated' => 'ttd/' . $ttdFileName]);
                \Log::info('💾 TTD dikalibrasi saved:', ['filename' => $ttdFileName]);
            } catch (\Exception $e) {
                \Log::error('❌ Failed to save TTD dikalibrasi:', ['error' => $e->getMessage()]);
            }
        }
        
        // TTD Diperiksa
        if ($request->filled('ttd_diperiksa') && strpos($request->ttd_diperiksa, 'data:image') === 0) {
            try {
                $ttdImage = base64_decode(preg_replace('#^data:image/\w+;base64,#i', '', $request->ttd_diperiksa));
                $ttdFileName = 'ttd_diperiksa_' . $calibration->id . '_' . time() . '.png';
                
                Storage::disk('public')->put('ttd/' . $ttdFileName, $ttdImage);
                
                $calibration->update(['ttd_verified' => 'ttd/' . $ttdFileName]);
                \Log::info('💾 TTD diperiksa saved:', ['filename' => $ttdFileName]);
            } catch (\Exception $e) {
                \Log::error('❌ Failed to save TTD diperiksa:', ['error' => $e->getMessage()]);
            }
        }

        // ==================================================================
        // 6. FINAL VERIFICATION
        // ==================================================================
        $finalDetailCount = DetailPenggaris::where('calibration_id', $calibration->id)->count();
        $finalHead = HeadPenggaris::where('calibration_id', $calibration->id)->first();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'certificate_id_head' => $finalHead->certificate_id ?? 'TIDAK ADA',
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'head_id' => $headPenggaris->id,
            'detail_records' => $finalDetailCount,
            'standard' => $alatStandarValue,
            'unit' => $calibration->unit ?? null,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        // ==================================================================
        // 7. VALIDASI AKHIR
        // ==================================================================
        $savedDetails = DetailPenggaris::where('calibration_id', $calibration->id)
            ->select('titikUkur', 'ulangan01', 'ulangan02', 'ulangan03', 'ulangan04', 'ulangan05')
            ->get()
            ->toArray();
        
        \Log::info('🔍 FINAL VALIDATION - Saved details:', $savedDetails);

        \Log::info('🎉 updatePenggaris COMPLETED SUCCESSFULLY');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePenggaris:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        
        throw new \Exception("Gagal mengupdate data Penggaris: " . $e->getMessage());
    }
}
         private function storeEnclosure($request, $calibration, $certificateId, $tabId = null)
{
    try {
        \Log::info('🚀 START storeEnclosure - MULTIPLE REPETITION');
        
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🔥🔥🔥 storeEnclosure DIPANGGIL!', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 1. TENTUKAN JUMLAH PENGULANGAN
        // ==================================================================
        $repetition = 0;
        for ($i = 1; $i <= 3; $i++) {
            $hasData = false;
            
            // Cek suhu_setting_X
            if ($this->getRequestValue($request, "suhu_setting_{$i}", $tabId)) {
                $hasData = true;
            }
            
            // Cek apakah ada data alat atau sensor untuk pengulangan ini
            if (!$hasData) {
                foreach ([1, 2, 3, 4, 5, 13, 20, 30] as $interval) {
                    $alatField = $this->getRequestValue($request, "alat_{$i}_{$interval}", $tabId);
                    if ($alatField) {
                        $hasData = true;
                        break;
                    }
                    
                    for ($s = 1; $s <= 9; $s++) {
                        $sensorField = $this->getRequestValue($request, "sensor_{$i}_{$interval}_{$s}", $tabId);
                        if ($sensorField) {
                            $hasData = true;
                            break 2;
                        }
                    }
                }
            }
            
            if ($hasData) {
                $repetition = $i;
            }
        }
        
        if ($repetition === 0) {
            $repetition = 1;
        }
        
        \Log::info('📊 Jumlah pengulangan DITENTUKAN:', ['repetition' => $repetition]);
        
        // ==================================================================
        // 2. PROSES ALAT STANDAR
        // ==================================================================
        $textValue = trim($request->alat_standar_text ?? '');
        $arrayValue = $request->input('alat_standar', []);
        
        if (!empty($textValue)) {
            $standardValue = $textValue;
        } elseif (is_array($arrayValue) && count($arrayValue) > 0) {
            $standardValue = implode("\n", $arrayValue);
        } else {
            $standardValue = '';
        }
        
        \Log::info('🔧 Alat standar selected:', [
            'textarea' => $textValue,
            'checkbox_array' => $arrayValue,
            'saved_to_db' => $standardValue
        ]);
        
        // ==================================================================
        // 3. SIMPAN KE HEAD ENCLOSURE
        // ==================================================================
        $head = HeadEnclosure::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-29',
        ]);
        
        \Log::info('✅ HeadEnclosure saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 4. SIMPAN KE ADD ENCLOSURE
        // ==================================================================
        \Log::info('📊 Saving AddEnclosure data for each repetition...');
        
        $allIntervals = [1, 2, 3, 4, 5, 13, 20, 30];
        $intervalJson = json_encode($allIntervals);
        
        for ($p = 1; $p <= $repetition; $p++) {
            $tsettingValue = $this->getRequestValue($request, "suhu_setting_{$p}", $tabId);
            
            \Log::debug("📝 AddEnclosure data for repetition {$p}:", [
                'suhu_setting' => $tsettingValue,
            ]);
            
            try {
                AddEnclosure::create([
                    'calibration_id' => $calibration->id,
                    'head_enclosure_id' => $head->id,
                    'repetition_number' => $p,
                    'Tsetting' => $tsettingValue,
                    'Interval' => $intervalJson,
                ]);
                \Log::info("✅ AddEnclosure saved for repetition {$p}");
            } catch (\Exception $e) {
                \Log::error("❌ AddEnclosure save failed for repetition {$p}:", [
                    'error' => $e->getMessage(),
                ]);
            }
        }
        
        // ==================================================================
        // 5. SIMPAN DETAIL ENCLOSURE
        // ==================================================================
        \Log::info('📊 Saving DetailEnclosure data for each repetition...');
        $totalDetailCount = 0;
        
        for ($p = 1; $p <= $repetition; $p++) {
            $detailCount = 0;
            
            foreach ($allIntervals as $interval) {
                // Ambil nilai alat
                $alatValue = $this->getRequestValue($request, "alat_{$p}_{$interval}", $tabId);
                $hasAlatData = !empty($alatValue);
                
                // Ambil data sensor untuk 9 kolom
                $sensorData = [];
                $hasSensorData = false;
                
                for ($col = 1; $col <= 9; $col++) {
                    $rawValue = $this->getRequestValue($request, "sensor_{$p}_{$interval}_{$col}", $tabId);
                    
                    if (!empty($rawValue)) {
                        $sensorData[$col] = str_replace(',', '.', $rawValue);
                        $hasSensorData = true;
                    } else {
                        $sensorData[$col] = null;
                    }
                }
                
                \Log::debug("Checking repetition {$p}, interval {$interval}:", [
                    'alat_value' => $alatValue,
                    'hasAlatData' => $hasAlatData,
                    'hasSensorData' => $hasSensorData,
                    'sensor_values' => array_slice($sensorData, 1, 5) // log first 5 sensors
                ]);
                
                // Simpan jika ada data (alat atau minimal satu sensor)
                if ($hasAlatData || $hasSensorData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'head_enclosure_id' => $head->id,
                        'repetition_number' => $p,
                        'interval_number' => $interval,
                        'readAlat' => $hasAlatData ? str_replace(',', '.', $alatValue) : null,
                        'readSensor1' => $sensorData[1] ?? null,
                        'readSensor2' => $sensorData[2] ?? null,
                        'readSensor3' => $sensorData[3] ?? null,
                        'readSensor4' => $sensorData[4] ?? null,
                        'readSensor5' => $sensorData[5] ?? null,
                        'readSensor6' => $sensorData[6] ?? null,
                        'readSensor7' => $sensorData[7] ?? null,
                        'readSensor8' => $sensorData[8] ?? null,
                        'readSensor9' => $sensorData[9] ?? null,
                    ];
                    
                    \Log::debug("💾 Saving DetailEnclosure for repetition {$p}, interval {$interval}");
                    
                    try {
                        DetailEnclosure::create($detailData);
                        $detailCount++;
                        $totalDetailCount++;
                    } catch (\Exception $e) {
                        \Log::error("❌ DetailEnclosure save failed:", [
                            'repetition' => $p,
                            'interval' => $interval,
                            'error' => $e->getMessage(),
                        ]);
                    }
                } else {
                    \Log::debug("⏭️ Skipping repetition {$p}, interval {$interval} - no data");
                }
            }
            
            \Log::info("✅ Saved {$detailCount} DetailEnclosure records for repetition {$p}");
        }
        
        \Log::info("✅ Saved {$totalDetailCount} DetailEnclosure records total (for {$repetition} repetitions)");
        
        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated with additional data');
        }
        
        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailEnclosure::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddEnclosure::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (MULTIPLE REPETITION):', [
            'calibration_id' => $calibration->id,
            'repetition_count' => $repetition,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'tab_id' => $tabId,
        ]);
        
        \Log::info('🎉 storeEnclosure COMPLETED (Multiple Repetition)');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeEnclosure:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
        ]);
        throw $e;
    }
}

public function updateEnclosure($request, $calibration)
{
    \Log::info('🚀 START updateEnclosure - NO AUTO INCREMENT');
    
    // 1. PROSES ALAT STANDAR DARI CHECKBOX
    $arrayValue = $request->input('standard_list', []);
    
    if (is_array($arrayValue) && count($arrayValue) > 0) {
        $standardValue = implode("\n", $arrayValue);
    } else {
        $headEnclosure = HeadEnclosure::where('calibration_id', $calibration->id)->first();
        $standardValue = $headEnclosure->standard ?? '';
    }
    
    // 2. GENERATE CERTIFICATE ID
    $certificateId = $this->generateCertificateId($calibration->namaAlat ?? 'Unknown');
    
    // 3. Update HeadEnclosure
    $headEnclosure = HeadEnclosure::updateOrCreate(
        ['calibration_id' => $calibration->id],
        [
            'certificate_id' => $certificateId,
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-29 (SNSU PK.P-29:2020)',
        ]
    );
    
    // 4. **PERBAIKAN: Tentukan jumlah pengulangan dari input, BUKAN fixed**
    // Cari repetition tertinggi dari input yang ada
    $maxRepetitionFromInput = 0;
    for ($i = 1; $i <= 10; $i++) { // Check up to 10 repetitions
        $fieldName = "suhu_setting_$i";
        if ($request->has($fieldName) && !empty(trim($request->input($fieldName)))) {
            $maxRepetitionFromInput = $i;
        }
    }
    
    // **PERBAIKAN: Gunakan repetition yang sudah ada di database jika tidak ada input baru**
    if ($maxRepetitionFromInput === 0) {
        // Cari repetition tertinggi yang sudah ada di database
        $existingMaxRep = AddEnclosure::where('calibration_id', $calibration->id)
            ->max('repetition_number');
        
        $repetition = $existingMaxRep ?? 1; // Default 1 jika tidak ada
        \Log::info('📊 Menggunakan repetition dari database:', ['repetition' => $repetition]);
    } else {
        $repetition = $maxRepetitionFromInput;
        \Log::info('📊 Menggunakan repetition dari input:', ['repetition' => $repetition]);
    }
    
    // **PERBAIKAN: Jangan hapus semua data, hanya update yang perlu**
    $allIntervals = [1, 2, 3, 4, 5, 13, 20, 30];
    $intervalJson = json_encode($allIntervals);
    
    // **PERBAIKAN: Update atau Create AddEnclosure hanya untuk repetition yang ada di input**
    for ($p = 1; $p <= $repetition; $p++) {
        $fieldName = "suhu_setting_$p";
        $tsettingValue = null;
        
        // **PERBAIKAN: Cek apakah ada input untuk repetition ini**
        $hasInputForThisRepetition = false;
        
        if ($request->has($fieldName)) {
            $rawValue = $request->input($fieldName);
            
            if (!empty($rawValue)) {
                $tsettingValue = trim($rawValue);
                $hasInputForThisRepetition = true;
                
                \Log::debug("📝 Processing TSetting for repetition {$p}", [
                    'raw' => $rawValue,
                    'cleaned' => $tsettingValue
                ]);
            }
        }
        
        // **PERBAIKAN: Jika tidak ada input, cek data existing**
        if (!$hasInputForThisRepetition) {
            // Cari data existing untuk repetition ini
            $existingData = AddEnclosure::where('calibration_id', $calibration->id)
                ->where('repetition_number', $p)
                ->first();
            
            if ($existingData) {
                // Pertahankan nilai yang sudah ada
                $tsettingValue = $existingData->TSetting ?? $existingData->Tsetting ?? null;
                \Log::debug("📝 Using existing TSetting for repetition {$p}", ['value' => $tsettingValue]);
            } else {
                // Tidak ada data existing, set null
                $tsettingValue = null;
            }
        }
        
        // **PERBAIKAN: UpdateOrCreate (jangan selalu create baru)**
        $addData = [
            'calibration_id' => $calibration->id,
            'repetition_number' => $p,
            'Interval' => $intervalJson,
            'TSetting' => $tsettingValue,
            'Tsetting' => $tsettingValue, // Simpan di kedua field untuk kompatibilitas
        ];
        
        AddEnclosure::updateOrCreate(
            [
                'calibration_id' => $calibration->id,
                'repetition_number' => $p // **KUNCI: cari berdasarkan repetition_number**
            ],
            $addData
        );
        
        \Log::debug("✅ AddEnclosure processed for repetition {$p}", [
            'repetition_number' => $p,
            'tsetting_value' => $tsettingValue,
            'action' => $hasInputForThisRepetition ? 'UPDATED' : 'RETAINED'
        ]);
    }
    
    // **PERBAIKAN: Hapus repetition yang lebih tinggi dari yang diinput**
    if ($repetition > 0) {
        AddEnclosure::where('calibration_id', $calibration->id)
            ->where('repetition_number', '>', $repetition)
            ->delete();
        
        \Log::info("🗑️ Deleted extra repetitions above {$repetition}");
    }
    
    // 5. **PERBAIKAN: Update DetailEnclosure dengan cara yang sama**
    // Hapus detail untuk repetition yang dihapus
    if ($repetition > 0) {
        DetailEnclosure::where('calibration_id', $calibration->id)
            ->where('repetition_number', '>', $repetition)
            ->delete();
    }
    
    // Update atau create detail untuk repetition yang ada
    $totalDetailCount = 0;
    
    for ($p = 1; $p <= $repetition; $p++) {
        $detailCount = 0;
        
        foreach ($allIntervals as $interval) {
            // **PERBAIKAN: Cek apakah ada input untuk interval ini**
            $hasData = false;
            $alatValue = null;
            $sensorData = [];
            
            // Cek data alat
            $alatField = "alat_{$p}_{$interval}";
            if ($request->has($alatField) && !empty(trim($request->input($alatField)))) {
                $alatValue = trim($request->input($alatField));
                $hasData = true;
            }
            
            // Cek data sensor
            for ($col = 1; $col <= 9; $col++) {
                $fieldName = "sensor_{$p}_{$interval}_{$col}";
                $sensorValue = null;
                
                if ($request->has($fieldName) && !empty(trim($request->input($fieldName)))) {
                    $sensorValue = trim($request->input($fieldName));
                    $hasData = true;
                }
                
                $sensorData[$col] = $sensorValue;
            }
            
            // **PERBAIKAN: Gunakan UpdateOrCreate untuk detail juga**
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'repetition_number' => $p,
                    'interval_number' => $interval,
                    'readAlat' => $alatValue,
                ];
                
                // Tambahkan sensor data
                for ($col = 1; $col <= 9; $col++) {
                    $detailData["readSensor{$col}"] = $sensorData[$col];
                }
                
                DetailEnclosure::updateOrCreate(
                    [
                        'calibration_id' => $calibration->id,
                        'repetition_number' => $p,
                        'interval_number' => $interval
                    ],
                    $detailData
                );
                
                $detailCount++;
                $totalDetailCount++;
            } else {
                // **PERBAIKAN: Jika tidak ada data, hapus record untuk interval ini (opsional)**
                // DetailEnclosure::where('calibration_id', $calibration->id)
                //     ->where('repetition_number', $p)
                //     ->where('interval_number', $interval)
                //     ->delete();
            }
        }
        
        \Log::info("✅ Processed {$detailCount} DetailEnclosure records for repetition {$p}");
    }
    
    // 6. Update Calibration dengan data tambahan
    $updateData = [];
    
    if ($request->filled('calibratedBy')) {
        $updateData['calibrated_by'] = $request->calibratedBy;
    }
    
    if ($request->filled('verifiedBy')) {
        $updateData['verified_by'] = $request->verifiedBy;
    }
    
    if ($request->filled('uncertainty')) {
        $updateData['uncertainty'] = $request->uncertainty;
    }
    
    if ($request->filled('conclusion')) {
        $updateData['keterangan'] = $request->conclusion;
    }
    
    if (!empty($updateData)) {
        $calibration->update($updateData);
    }
    
    // 7. LOG HASIL AKHIR
    $finalRepetitionCount = AddEnclosure::where('calibration_id', $calibration->id)
        ->count();
    
    $finalDetailCount = DetailEnclosure::where('calibration_id', $calibration->id)
        ->count();
    
    $repetitionList = AddEnclosure::where('calibration_id', $calibration->id)
        ->orderBy('repetition_number')
        ->pluck('repetition_number')
        ->toArray();
    
    \Log::info('📋 UPDATE ENCLOSURE FINAL - FIXED REPETITION:', [
        'calibration_id' => $calibration->id,
        'certificate_id' => $certificateId,
        'final_repetition_count' => $finalRepetitionCount,
        'repetition_numbers' => $repetitionList,
        'detail_records' => $finalDetailCount,
        'repetition_logic' => 'NO AUTO INCREMENT - REPETITION PRESERVED',
    ]);
    
    return true;
}
        private function storeClimaticChamber($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1, $tabId = null)
{
    \Log::info('🚀 ===== START storeClimaticChamber =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        // 🔥 AMBIL REPETITION DARI REQUEST
        $repetition = (int) ($request->repetition ?? 1);
        if ($repetition < 1) {
            $repetition = 1;
        }
        \Log::info('Repetition value from request:', ['repetition' => $repetition]);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm,
            'tab_id' => $tabId,
            'repetition' => $repetition
        ]);
        
        // ==================================================================
        // EKSTRAK DATA DARI SEMUA FORM
        // ==================================================================
        $allFormsData = [];
        
        if ($isMultipleSubmit) {
            for ($i = 1; $i <= $jumlahForm; $i++) {
                $formData = [];
                foreach ($request->all() as $key => $value) {
                    if (strpos($key, "form_{$i}_") === 0) {
                        $originalKey = substr($key, strlen("form_{$i}_"));
                        
                        if (strpos($originalKey, 'alat_standar') !== false) {
                            if (!isset($formData['alat_standar'])) {
                                $formData['alat_standar'] = [];
                            }
                            if (!is_array($value)) {
                                $formData['alat_standar'][] = $value;
                            } else {
                                $formData['alat_standar'] = array_merge($formData['alat_standar'], $value);
                            }
                        } else {
                            if (!is_array($value)) {
                                $formData[$originalKey] = $value;
                            } else {
                                $formData[$originalKey] = json_encode($value);
                            }
                        }
                    }
                }
                $formData['form_index'] = $i;
                $allFormsData[$i] = $formData;
            }
        } else {
            $allFormsData[1] = $request->all();
            $allFormsData[1]['form_index'] = 1;
        }
        
        // ==================================================================
        // ALAT STANDAR
        // ==================================================================
        $form1Data = $allFormsData[1] ?? [];
        $alatStandar = $form1Data['alat_standar'] ?? [];
        if (is_string($alatStandar)) {
            $alatStandar = json_decode($alatStandar, true) ?? [$alatStandar];
        }
        if (!is_array($alatStandar)) {
            $alatStandar = [];
        }
        $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        // ==================================================================
        // STORE HEADS
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            HeadChamber::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK1102-29B',
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
        }
        
        // ==================================================================
        // DELETE OLD DATA
        // ==================================================================
        AddChamber::where('calibration_id', $calibration->id)->delete();
        DetailChamber::where('calibration_id', $calibration->id)->delete();
        
        $totalAddCount = 0;
        $totalDetailCount = 0;
        $allIntervals = [1, 2, 3, 4, 5, 13, 20, 30];
        $intervalJson = json_encode($allIntervals);
        
        // ==================================================================
        // LOOP FORM INDEX
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $formData = $allFormsData[$formIndex] ?? [];
            \Log::info("📊 Processing details for form {$formIndex}");
            
            // ==============================================================
            // ADD CHAMBER (PER REPETITION)
            // ==============================================================
            for ($p = 1; $p <= $repetition; $p++) {
                // 🔥 CARI Tsetting DENGAN BERBAGAI POLA
                $tsettingValue = null;
                $patterns = [
                    "form_{$formIndex}_suhu_setting_{$formIndex}_{$p}_tab{$tabId}",
                    "suhu_setting_{$formIndex}_{$p}_tab{$tabId}",
                    "form_{$formIndex}_suhu_setting_{$formIndex}_{$p}",
                    "suhu_setting_{$formIndex}_{$p}",
                    "suhu_setting_{$p}"
                ];
                
                foreach ($patterns as $pattern) {
                    if (isset($formData[$pattern]) && $formData[$pattern] !== '') {
                        $tsettingValue = $formData[$pattern];
                        break;
                    }
                    if ($request->has($pattern) && $request->input($pattern) !== '') {
                        $tsettingValue = $request->input($pattern);
                        break;
                    }
                }
                
                AddChamber::create([
                    'calibration_id' => $calibration->id,
                    'form_index' => $formIndex,
                    'repetition_number' => $p,
                    'Tsetting' => $tsettingValue,
                    'Interval' => $intervalJson,
                ]);
                $totalAddCount++;
                \Log::info("✅ AddChamber saved for form {$formIndex}, repetition {$p}, Tsetting: {$tsettingValue}");
            }
            
            // ==============================================================
            // DETAIL CHAMBER (PER REPETITION & INTERVAL)
            // ==============================================================
            for ($p = 1; $p <= $repetition; $p++) {
                foreach ($allIntervals as $interval) {
                    // 🔥 CARI READ ALAT
                    $readAlatValue = null;
                    $patternsReadAlat = [
                        "form_{$formIndex}_alat_{$formIndex}_{$p}_{$interval}_tab{$tabId}",
                        "alat_{$formIndex}_{$p}_{$interval}_tab{$tabId}",
                        "form_{$formIndex}_alat_{$formIndex}_{$p}_{$interval}",
                        "alat_{$formIndex}_{$p}_{$interval}",
                        "alat_{$p}_{$interval}"
                    ];
                    
                    foreach ($patternsReadAlat as $pattern) {
                        if (isset($formData[$pattern]) && $formData[$pattern] !== '') {
                            $readAlatValue = $formData[$pattern];
                            break;
                        }
                        if ($request->has($pattern) && $request->input($pattern) !== '') {
                            $readAlatValue = $request->input($pattern);
                            break;
                        }
                    }
                    
                    // 🔥 CARI RH ALAT
                    $rhAlatValue = null;
                    $patternsRhAlat = [
                        "form_{$formIndex}_alat_percent_{$formIndex}_{$p}_{$interval}_tab{$tabId}",
                        "alat_percent_{$formIndex}_{$p}_{$interval}_tab{$tabId}",
                        "form_{$formIndex}_alat_percent_{$formIndex}_{$p}_{$interval}",
                        "alat_percent_{$formIndex}_{$p}_{$interval}",
                        "alat_percent_{$p}_{$interval}"
                    ];
                    
                    foreach ($patternsRhAlat as $pattern) {
                        if (isset($formData[$pattern]) && $formData[$pattern] !== '') {
                            $rhAlatValue = $formData[$pattern];
                            break;
                        }
                        if ($request->has($pattern) && $request->input($pattern) !== '') {
                            $rhAlatValue = $request->input($pattern);
                            break;
                        }
                    }
                    
                    // 🔥 CARI SENSOR VALUES (1-9)
                    $sensorValues = [];
                    for ($s = 1; $s <= 9; $s++) {
                        $sensorValue = null;
                        $patternsSensor = [
                            "form_{$formIndex}_sensor_{$formIndex}_{$p}_{$interval}_{$s}_tab{$tabId}",
                            "sensor_{$formIndex}_{$p}_{$interval}_{$s}_tab{$tabId}",
                            "form_{$formIndex}_sensor_{$formIndex}_{$p}_{$interval}_{$s}",
                            "sensor_{$formIndex}_{$p}_{$interval}_{$s}",
                            "sensor_{$p}_{$interval}_{$s}"
                        ];
                        
                        foreach ($patternsSensor as $pattern) {
                            if (isset($formData[$pattern]) && $formData[$pattern] !== '') {
                                $sensorValue = $formData[$pattern];
                                break;
                            }
                            if ($request->has($pattern) && $request->input($pattern) !== '') {
                                $sensorValue = $request->input($pattern);
                                break;
                            }
                        }
                        $sensorValues[$s] = $sensorValue;
                    }
                    
                    // 🔥 CARI RH ULANGAN
                    $rhUlanganValue = null;
                    $patternsRhUlangan = [
                        "form_{$formIndex}_sensor_percent_{$formIndex}_{$p}_{$interval}_tab{$tabId}",
                        "sensor_percent_{$formIndex}_{$p}_{$interval}_tab{$tabId}",
                        "form_{$formIndex}_sensor_percent_{$formIndex}_{$p}_{$interval}",
                        "sensor_percent_{$formIndex}_{$p}_{$interval}",
                        "sensor_percent_{$p}_{$interval}"
                    ];
                    
                    foreach ($patternsRhUlangan as $pattern) {
                        if (isset($formData[$pattern]) && $formData[$pattern] !== '') {
                            $rhUlanganValue = $formData[$pattern];
                            break;
                        }
                        if ($request->has($pattern) && $request->input($pattern) !== '') {
                            $rhUlanganValue = $request->input($pattern);
                            break;
                        }
                    }
                    
                    // Log untuk debugging
                    if ($formIndex == 2) {
                        \Log::info("📊 FORM 2 DETAIL - Rep {$p}, Interval {$interval}:", [
                            'readAlat' => $readAlatValue,
                            'rhAlat' => $rhAlatValue,
                            'sensor1' => $sensorValues[1] ?? null,
                            'sensor_percent' => $rhUlanganValue
                        ]);
                    }
                    
                    // Cek apakah ada data
                    $hasData = !empty($readAlatValue) || !empty($rhAlatValue) || 
                               !empty($sensorValues[1]) || !empty($sensorValues[2]) || 
                               !empty($sensorValues[3]) || !empty($sensorValues[4]) || 
                               !empty($sensorValues[5]) || !empty($sensorValues[6]) || 
                               !empty($sensorValues[7]) || !empty($sensorValues[8]) || 
                               !empty($sensorValues[9]) || !empty($rhUlanganValue);
                    
                    if ($hasData) {
                        DetailChamber::create([
                            'calibration_id' => $calibration->id,
                            'form_index' => $formIndex,
                            'repetition_number' => $p,
                            'interval_number' => $interval,
                            'readAlat' => $readAlatValue,
                            'RHAlat' => $rhAlatValue,
                            'ulangan01' => $sensorValues[1] ?? null,
                            'ulangan02' => $sensorValues[2] ?? null,
                            'ulangan03' => $sensorValues[3] ?? null,
                            'ulangan04' => $sensorValues[4] ?? null,
                            'ulangan05' => $sensorValues[5] ?? null,
                            'ulangan06' => $sensorValues[6] ?? null,
                            'ulangan07' => $sensorValues[7] ?? null,
                            'ulangan08' => $sensorValues[8] ?? null,
                            'ulangan09' => $sensorValues[9] ?? null,
                            'RHulangan' => $rhUlanganValue,
                        ]);
                        $totalDetailCount++;
                        \Log::debug("✅ Detail saved for form {$formIndex}, repetition {$p}, interval {$interval}");
                    }
                }
            }
        }
        
        // ==================================================================
        // UPDATE CALIBRATION
        // ==================================================================
        $calibration->update([
            'jumlah_form' => $jumlahForm,
            'repetition' => $repetition,
        ]);
        
        \Log::info('✅ storeClimaticChamber completed successfully', [
            'calibration_id' => $calibration->id,
            'total_add' => $totalAddCount,
            'total_details' => $totalDetailCount,
            'jumlah_form' => $jumlahForm,
            'repetition' => $repetition
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeClimaticChamber FAILED:', [
            'message' => $e->getMessage(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}
/**
 * Helper function untuk mencari nilai dengan berbagai pola nama field
 */
private function getChamberValue($request, $formData, $formIndex, $repetition, $baseName, $tabId, $interval = null, $sensor = null)
{
    $value = null;
    
    // Bangun pola nama field berdasarkan parameter
    if ($sensor !== null) {
        // Untuk sensor: sensor_{formIndex}_{repetition}_{interval}_{sensor}
        $patterns = [
            "form_{$formIndex}_{$baseName}_{$formIndex}_{$repetition}_{$interval}_{$sensor}_tab{$tabId}",
            "{$baseName}_{$formIndex}_{$repetition}_{$interval}_{$sensor}_tab{$tabId}",
            "form_{$formIndex}_{$baseName}_{$formIndex}_{$repetition}_{$interval}_{$sensor}",
            "{$baseName}_{$formIndex}_{$repetition}_{$interval}_{$sensor}",
            "{$baseName}_{$repetition}_{$interval}_{$sensor}"
        ];
    } elseif ($interval !== null) {
        // Untuk alat: alat_{formIndex}_{repetition}_{interval}
        $patterns = [
            "form_{$formIndex}_{$baseName}_{$formIndex}_{$repetition}_{$interval}_tab{$tabId}",
            "{$baseName}_{$formIndex}_{$repetition}_{$interval}_tab{$tabId}",
            "form_{$formIndex}_{$baseName}_{$formIndex}_{$repetition}_{$interval}",
            "{$baseName}_{$formIndex}_{$repetition}_{$interval}",
            "{$baseName}_{$repetition}_{$interval}"
        ];
    } else {
        // Untuk Tsetting: suhu_setting_{formIndex}_{repetition}
        $patterns = [
            "form_{$formIndex}_{$baseName}_{$formIndex}_{$repetition}_tab{$tabId}",
            "{$baseName}_{$formIndex}_{$repetition}_tab{$tabId}",
            "form_{$formIndex}_{$baseName}_{$formIndex}_{$repetition}",
            "{$baseName}_{$formIndex}_{$repetition}",
            "{$baseName}_{$repetition}"
        ];
    }
    
    // Cari nilai dari patterns
    foreach ($patterns as $pattern) {
        if (isset($formData[$pattern]) && $formData[$pattern] !== '' && $formData[$pattern] !== null) {
            $value = $formData[$pattern];
            break;
        }
        if ($request->has($pattern) && $request->input($pattern) !== '' && $request->input($pattern) !== null) {
            $value = $request->input($pattern);
            break;
        }
    }
    
    // Jika masih null, coba dengan getRequestValue biasa
    if ($value === null) {
        $simpleKey = $interval !== null 
            ? ($sensor !== null 
                ? "{$baseName}_{$formIndex}_{$repetition}_{$interval}_{$sensor}"
                : "{$baseName}_{$formIndex}_{$repetition}_{$interval}")
            : "{$baseName}_{$formIndex}_{$repetition}";
        $value = $this->getRequestValue($request, $simpleKey, $tabId);
    }
    
    return $value;
}


   public function updateClimaticChamber($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateClimaticChamber =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head chamber untuk cek certificate_id (form 1)
        $headChamber = HeadChamber::where('calibration_id', $calibration->id)
            ->where('form_index', 1)
            ->first();
        
        $currentCertificateId = $headChamber->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. AMBIL JUMLAH FORM
        // ==================================================================
        $jumlahForm = (int) ($request->jumlah_form ?? $calibration->jumlah_form ?? 1);
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 UPDATE Climatic Chamber - Multiple Form', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
        ]);
        
        // ==================================================================
        // 2. PROSES ALAT STANDAR DARI FORM 1
        // ==================================================================
        $arrayValue = $request->input('alat_standar', []);
        
        if (is_array($arrayValue) && count($arrayValue) > 0) {
            $standardValue = implode("\n", $arrayValue);
        } else {
            $headChamberForm1 = HeadChamber::where('calibration_id', $calibration->id)
                ->where('form_index', 1)
                ->first();
            $standardValue = $headChamberForm1->standard ?? '';
        }
        
        // ==================================================================
        // 3. UPDATE HEAD CHAMBER UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $headData = [
                'standard' => $standardValue,
                'calibrationMethod' => 'PAS-IK1102-29B',
            ];
            
            // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
            if ($certificateIdUpdated && !empty($certificateIdBaru)) {
                $headData['certificate_id'] = $certificateIdBaru;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex}: {$certificateIdBaru}");
            } elseif ($newCertificateId && !$certificateIdUpdated) {
                $headData['certificate_id'] = $newCertificateId;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex} dari parameter: {$newCertificateId}");
            }
            
            $head = HeadChamber::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                $headData
            );
            
            \Log::info("✅ HeadChamber updated for form {$formIndex}", [
                'id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        }
        
        // Hapus head untuk form yang tidak digunakan
        HeadChamber::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 4. AMBIL REPETITION DARI REQUEST
        // ==================================================================
        $repetition = 0;
        for ($i = 1; $i <= 3; $i++) {
            for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
                $fieldName = "suhu_setting_{$formIndex}_{$i}";
                if ($request->filled($fieldName)) {
                    $repetition = max($repetition, $i);
                }
            }
        }
        
        if ($repetition === 0) {
            $repetition = 1;
        }
        
        \Log::info('📊 Jumlah pengulangan untuk update:', ['repetition' => $repetition]);
        
        // ==================================================================
        // 5. HAPUS DATA LAMA
        // ==================================================================
        AddChamber::where('calibration_id', $calibration->id)->delete();
        DetailChamber::where('calibration_id', $calibration->id)->delete();
        
        $allIntervals = [1, 2, 3, 4, 5, 13, 20, 30];
        $intervalJson = json_encode($allIntervals);
        
        $totalAddCount = 0;
        $totalDetailCount = 0;
        
        // ==================================================================
        // 6. SIMPAN ADD CHAMBER & DETAIL CHAMBER UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing form {$formIndex}");
            
            // ==============================================================
            // 6a. SIMPAN ADD CHAMBER
            // ==============================================================
            for ($p = 1; $p <= $repetition; $p++) {
                $tsettingValue = null;
                $fieldName = "suhu_setting_{$formIndex}_{$p}";
                
                if ($request->filled($fieldName)) {
                    $rawValue = $request->input($fieldName);
                    if (!empty($rawValue)) {
                        $tsettingValue = trim($rawValue);
                    }
                }
                
                $addData = [
                    'calibration_id' => $calibration->id,
                    'form_index' => $formIndex,
                    'repetition_number' => $p,
                    'Tsetting' => $tsettingValue,
                    'Interval' => $intervalJson,
                ];
                
                AddChamber::create($addData);
                $totalAddCount++;
                \Log::debug("✅ AddChamber created for form {$formIndex}, repetition {$p}");
            }
            
            // ==============================================================
            // 6b. SIMPAN DETAIL CHAMBER
            // ==============================================================
            for ($p = 1; $p <= $repetition; $p++) {
                foreach ($allIntervals as $interval) {
                    // Ambil data readAlat (suhu)
                    $readAlatValue = null;
                    $readAlatField = "alat_{$formIndex}_{$p}_{$interval}";
                    if ($request->filled($readAlatField)) {
                        $rawValue = $request->input($readAlatField);
                        if (!empty($rawValue)) {
                            $readAlatValue = trim($rawValue);
                        }
                    }
                    
                    // Ambil data RHAlat (kelembaban alat)
                    $rhAlatValue = null;
                    $rhAlatField = "alat_percent_{$formIndex}_{$p}_{$interval}";
                    if ($request->filled($rhAlatField)) {
                        $rawValue = $request->input($rhAlatField);
                        if (!empty($rawValue)) {
                            $rhAlatValue = trim($rawValue);
                        }
                    }
                    
                    // Ambil data sensor 1-9
                    $sensorValues = [];
                    for ($s = 1; $s <= 9; $s++) {
                        $sensorField = "sensor_{$formIndex}_{$p}_{$interval}_{$s}";
                        $sensorValue = null;
                        if ($request->filled($sensorField)) {
                            $rawValue = $request->input($sensorField);
                            if (!empty($rawValue)) {
                                $sensorValue = trim($rawValue);
                            }
                        }
                        $sensorValues[$s] = $sensorValue;
                    }
                    
                    // Ambil data RH ulangan (kelembaban sensor)
                    $rhUlanganValue = null;
                    $rhUlanganField = "sensor_percent_{$formIndex}_{$p}_{$interval}";
                    if ($request->filled($rhUlanganField)) {
                        $rawValue = $request->input($rhUlanganField);
                        if (!empty($rawValue)) {
                            $rhUlanganValue = trim($rawValue);
                        }
                    }
                    
                    // Cek apakah ada data
                    $hasData = !empty($readAlatValue) || !empty($rhAlatValue) || 
                               !empty($sensorValues[1]) || !empty($sensorValues[2]) || 
                               !empty($sensorValues[3]) || !empty($sensorValues[4]) || 
                               !empty($sensorValues[5]) || !empty($sensorValues[6]) || 
                               !empty($sensorValues[7]) || !empty($sensorValues[8]) || 
                               !empty($sensorValues[9]) || !empty($rhUlanganValue);
                    
                    if ($hasData) {
                        $detailData = [
                            'calibration_id' => $calibration->id,
                            'form_index' => $formIndex,
                            'repetition_number' => $p,
                            'interval_number' => $interval,
                            'readAlat' => $readAlatValue,
                            'RHAlat' => $rhAlatValue,
                            'ulangan01' => $sensorValues[1] ?? null,
                            'ulangan02' => $sensorValues[2] ?? null,
                            'ulangan03' => $sensorValues[3] ?? null,
                            'ulangan04' => $sensorValues[4] ?? null,
                            'ulangan05' => $sensorValues[5] ?? null,
                            'ulangan06' => $sensorValues[6] ?? null,
                            'ulangan07' => $sensorValues[7] ?? null,
                            'ulangan08' => $sensorValues[8] ?? null,
                            'ulangan09' => $sensorValues[9] ?? null,
                            'RHulangan' => $rhUlanganValue,
                        ];
                        
                        DetailChamber::create($detailData);
                        $totalDetailCount++;
                    }
                }
            }
        }
        
        // ==================================================================
        // 7. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TANPA CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Field untuk calibratedBy dan verifiedBy
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        // Jika ada field uncertainty dan conclusion
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
        }
        
        if ($request->filled('conclusion')) {
            $updateData['keterangan'] = $request->conclusion;
        }
        
        // Kosongkan certificate_id di calibration (biar null, tidak dipakai)
        // Certificate ID hanya disimpan di HEAD saja
        $updateData['certificate_id'] = null;
        $updateData['jumlah_form'] = $jumlahForm;
        $updateData['repetition'] = $repetition;
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated with additional data', $updateData);
        }
        
        // ==================================================================
        // 8. FINAL VERIFICATION
        // ==================================================================
        $savedDetailCount = DetailChamber::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddChamber::where('calibration_id', $calibration->id)->count();
        $finalHeads = HeadChamber::where('calibration_id', $calibration->id)->orderBy('form_index')->get();
        
        // Ambil contoh TSetting yang disimpan untuk debug
        $exampleTSettings = AddChamber::where('calibration_id', $calibration->id)
            ->orderBy('form_index')
            ->orderBy('repetition_number')
            ->limit(5)
            ->get(['form_index', 'repetition_number', 'Tsetting'])
            ->toArray();
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'heads_count' => $finalHeads->count(),
            'certificate_id_calibration' => $calibration->certificate_id,
            'certificate_id_heads' => $finalHeads->pluck('certificate_id')->toArray(),
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'repetition_count' => $repetition,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'tsetting_examples' => $exampleTSettings,
        ]);
        
        \Log::info('🎉 updateClimaticChamber COMPLETED SUCCESSFULLY');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateClimaticChamber FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'unknown'
        ]);
        throw $e;
    }
}

    
    private function storePressureGauge($request, $calibration, $certificateId, $tabId = null)
{
    try {
        \Log::info('🚀 START storePressureGauge - 20 BARIS (10 KIRI + 10 KANAN)');
        
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storePressureGauge called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dengan berbagai kemungkinan nama field
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        // Coba juga dengan format array
        $alatStandarArray = $request->input('alat_standar', []);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Pressure Gauge:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. SIMPAN KE HEAD PRESSURE GAUGE (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $satuanAlatKiri = $this->getRequestValue($request, 'satuan_alat_kiri', $tabId);
        $satuanStdKiri = $this->getRequestValue($request, 'satuan_std_kiri', $tabId);
        $satuanAlatKanan = $this->getRequestValue($request, 'satuan_alat_kanan', $tabId);
        $satuanStdKanan = $this->getRequestValue($request, 'satuan_std_kanan', $tabId);
        
        $head = HeadPressureGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-17',
            'satuan_alat_kiri' => $satuanAlatKiri,
            'satuan_std_kiri' => $satuanStdKiri,
            'satuan_alat_kanan' => $satuanAlatKanan,
            'satuan_std_kanan' => $satuanStdKanan,
        ]);

        \Log::info('✅ HeadPressureGauge saved:', [
            'head_id' => $head->id,
            'satuan_alat_kiri' => $satuanAlatKiri,
            'satuan_std_kiri' => $satuanStdKiri
        ]);

        // ==================================================================
        // 3. SIMPAN DETAIL PRESSURE GAUGE (20 BARIS: 10 KIRI + 10 KANAN)
        // ==================================================================
        \Log::info('📊 Saving Pressure Gauge detail measurements (20 rows)...');
        $detailCount = 0;
        
        // Proses 10 baris kiri
        for ($i = 1; $i <= 10; $i++) {
            // Cari pembacaan alat kiri dengan dukungan _tab
            $pembacaanAlatValue = $this->getRequestValue($request, "pembacaan_alat_kiri_{$i}", $tabId);
            if (!$pembacaanAlatValue) {
                $pembacaanAlatValue = $this->getRequestValue($request, "pembacaan_alat_kiri", $tabId);
                if (is_array($pembacaanAlatValue)) {
                    $pembacaanAlatValue = $pembacaanAlatValue[$i-1] ?? null;
                }
            }
            
            $stdNaik = $this->getRequestValue($request, "naik_kiri_{$i}", $tabId);
            $stdTurun = $this->getRequestValue($request, "turun_kiri_{$i}", $tabId);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($pembacaanAlatValue) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $pembacaanAlatValue,
                    'STDNaik' => $stdNaik,
                    'STDTurun' => $stdTurun,
                ];
                
                DetailPressureGauge::create($detailData);
                $detailCount++;
                \Log::debug("✅ Detail saved for row {$i} (kiri)");
            }
        }
        
        // Proses 10 baris kanan
        for ($i = 1; $i <= 10; $i++) {
            // Cari pembacaan alat kanan dengan dukungan _tab
            $pembacaanAlatValue = $this->getRequestValue($request, "pembacaan_alat_kanan_{$i}", $tabId);
            if (!$pembacaanAlatValue) {
                $pembacaanAlatValue = $this->getRequestValue($request, "pembacaan_alat_kanan", $tabId);
                if (is_array($pembacaanAlatValue)) {
                    $pembacaanAlatValue = $pembacaanAlatValue[$i-1] ?? null;
                }
            }
            
            $stdNaik = $this->getRequestValue($request, "naik_kanan_{$i}", $tabId);
            $stdTurun = $this->getRequestValue($request, "turun_kanan_{$i}", $tabId);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($pembacaanAlatValue) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $pembacaanAlatValue,
                    'STDNaik' => $stdNaik,
                    'STDTurun' => $stdTurun,
                ];
                
                DetailPressureGauge::create($detailData);
                $detailCount++;
                \Log::debug("✅ Detail saved for row {$i} (kanan)");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Pressure Gauge");

        // ==================================================================
        // 4. SIMPAN ADD PRESSURE GAUGE (DATA REPEATABILITY)
        // ==================================================================
        \Log::info('📊 Saving AddPressureGauge data (repeatability)...');
        
        $repeatData = [
            'calibration_id' => $calibration->id,
            'repeatability' => $this->getRequestValue($request, 'repeatability', $tabId),
            'repeatabilitySTD' => $this->getRequestValue($request, 'repeatability_unit', $tabId),
            'ulangan01' => $this->getRequestValue($request, 'row1_col1', $tabId),
            'ulangan02' => $this->getRequestValue($request, 'row1_col2', $tabId),
            'ulangan03' => $this->getRequestValue($request, 'row1_col3', $tabId),
            'ulangan04' => $this->getRequestValue($request, 'row2_col1', $tabId),
            'ulangan05' => $this->getRequestValue($request, 'row2_col2', $tabId),
        ];
        
        // Cek apakah ada data untuk disimpan
        $hasRepeatData = false;
        foreach ($repeatData as $key => $value) {
            if ($key !== 'calibration_id' && $value !== null && $value !== '') {
                $hasRepeatData = true;
                break;
            }
        }
        
        if ($hasRepeatData) {
            $addRecord = AddPressureGauge::create($repeatData);
            \Log::info('✅ AddPressureGauge saved:', ['add_id' => $addRecord->id]);
        } else {
            \Log::info('⚠️ No AddPressureGauge data to save');
        }

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $updateData['keterangan'] = $this->getRequestValue($request, 'conclusion', $tabId) ?? 'Alat diterima, memenuhi kriteria kalibrasi';
            \Log::info('📝 Uncertainty data:', ['uncertainty' => $uncertainty]);
        }
        
        // Nama untuk TTD
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailPressureGauge::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddPressureGauge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Pressure Gauge - 20 rows):', [
            'calibration_id' => $calibration->id,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
        ]);

        \Log::info('🎉 storePressureGauge COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storePressureGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailPressureGauge::where('calibration_id', $calibration->id)->delete();
                AddPressureGauge::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Pressure Gauge: " . $e->getMessage());
    }
}

/**
 * Update Pressure Gauge data - 20 BARIS (10 KIRI + 10 KANAN)
 */
private function updatePressureGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updatePressureGauge - 20 BARIS (10 KIRI + 10 KANAN)', [
            'calibration_id' => $calibration->id,
            'new_certificate_id' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head pressure gauge untuk cek certificate_id
        $headPressureGauge = HeadPressureGauge::where('calibration_id', $calibration->id)->first();
        $currentCertificateId = $headPressureGauge->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE HEAD PRESSURE GAUGE
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        // Ambil data satuan dari request (menggunakan array notation)
        $headPressureData = $request->headPressureGauge ?? [];
        $satuanAlatKiri = $headPressureData['satuan_alat_kiri'] ?? null;
        $satuanStdKiri = $headPressureData['satuan_std_kiri'] ?? null;
        $satuanAlatKanan = $headPressureData['satuan_alat_kanan'] ?? null;
        $satuanStdKanan = $headPressureData['satuan_std_kanan'] ?? null;
        
        // Data untuk update head
        $headUpdateData = [
            'standard' => $alatStandarString,
            'satuan_alat_kiri' => $satuanAlatKiri,
            'satuan_std_kiri' => $satuanStdKiri,
            'satuan_alat_kanan' => $satuanAlatKanan,
            'satuan_std_kanan' => $satuanStdKanan,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headUpdateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headUpdateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($head = $calibration->headPressureGauge) {
            $head->update($headUpdateData);
            \Log::info('✅ HeadPressureGauge updated:', $headUpdateData);
        } else {
            // Jika head belum ada, buat baru
            $head = HeadPressureGauge::create(array_merge([
                'calibration_id' => $calibration->id,
                'calibrationMethod' => 'PAS-IK1102-17',
            ], $headUpdateData));
            \Log::info('➕ HeadPressureGauge created baru:', ['head_id' => $head->id]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL PRESSURE GAUGE (DELETE & RECREATE 20 BARIS)
        // ==================================================================
        // Hapus data detail lama
        DetailPressureGauge::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        // Proses 10 baris KIRI (index 0-9)
        for ($i = 0; $i < 10; $i++) {
            $pembacaanAlat = $request->{"pembacaan_alat_kiri"} ?? [];
            $pembacaanAlatValue = $pembacaanAlat[$i] ?? null;
            $stdNaik = $request->{"naik_kiri_".$i} ?? null;
            $stdTurun = $request->{"turun_kiri_".$i} ?? null;
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($pembacaanAlatValue) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                DetailPressureGauge::create([
                    'calibration_id' => $calibration->id,
                     'titikUkur' =>  $pembacaanAlatValue,
                    'STDNaik' =>  $stdNaik,
                    'STDTurun' =>  $stdTurun,
                ]);
                $detailCount++;
            }
        }
        
        // Proses 10 baris KANAN (index 0-9)
        for ($i = 0; $i < 10; $i++) {
            $pembacaanAlat = $request->{"pembacaan_alat_kanan"} ?? [];
            $pembacaanAlatValue = $pembacaanAlat[$i] ?? null;
            // Untuk kanan, $i + 10 karena di view menggunakan naik_kanan_10, naik_kanan_11, dst
            $stdNaik = $request->{"naik_kanan_".($i+10)} ?? null;
            $stdTurun = $request->{"turun_kanan_".($i+10)} ?? null;
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($pembacaanAlatValue) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                DetailPressureGauge::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur' =>  $pembacaanAlatValue,
                    'STDNaik' =>  $stdNaik,
                    'STDTurun' =>  $stdTurun,
                ]);
                $detailCount++;
            }
        }
        
        \Log::info('✅ DetailPressureGauge updated:', ['total_records' => $detailCount]);

        // ==================================================================
        // 3. UPDATE ADD PRESSURE GAUGE (REPEATABILITY)
        // ==================================================================
        // Ambil repeatability_in_bracket (ini adalah repeatabilitySTD)
        $repeatabilitySTD = $request->repeatabilitySTD ?? null;
        
        if ($addGauge = $calibration->addPressureGauge) {
            $addGauge->update([
                'repeatability' =>  $request->repeatability ?? $addGauge->repeatability,
                'repeatabilitySTD' => $repeatabilitySTD,
                'ulangan01' =>  $request->ulangan01 ?? $addGauge->ulangan01,
                'ulangan02' =>  $request->ulangan02 ?? $addGauge->ulangan02,
                'ulangan03' =>  $request->ulangan03 ?? $addGauge->ulangan03,
                'ulangan04' =>  $request->ulangan04 ?? $addGauge->ulangan04,
                'ulangan05' =>  $request->ulangan05 ?? $addGauge->ulangan05,
            ]);
            \Log::info('✅ AddPressureGauge updated', [
                'repeatability' => $request->repeatability,
                'repeatabilitySTD' => $repeatabilitySTD,
            ]);
        } else {
            // Buat baru jika belum ada
            AddPressureGauge::create([
                'calibration_id' => $calibration->id,
                'repeatability' =>  $request->repeatability ?? null,
                'repeatabilitySTD' => $repeatabilitySTD,
                'ulangan01' =>  $request->ulangan01 ?? null,
                'ulangan02' =>  $request->ulangan02 ?? null,
                'ulangan03' =>  $request->ulangan03 ?? null,
                'ulangan04' =>  $request->ulangan04 ?? null,
                'ulangan05' =>  $request->ulangan05 ?? null,
            ]);
            \Log::info('➕ AddPressureGauge created baru');
        }

        // ==================================================================
        // 4. UPDATE CALIBRATION (HANYA YANG PERLU)
        // ==================================================================
        $updateData = [];
        
        // Update certificate_id di calibration jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk calibration: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $updateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk calibration dari parameter: {$newCertificateId}");
        }
        
        // Update nama alat jika berubah (untuk keperluan generate certificate ID)
        if ($request->filled('namaAlat') && $request->namaAlat != $calibration->namaAlat) {
            $updateData['namaAlat'] = $request->namaAlat;
        }
        
        // Update calibrated_by dan verified_by
        if ($request->filled('nama_dikalibrasi')) {
            $updateData['calibrated_by'] = $request->nama_dikalibrasi;
        }
        
        if ($request->filled('nama_diperiksa')) {
            $updateData['verified_by'] = $request->nama_diperiksa;
        }
        
        // Update uncertainty dan conclusion
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
        }
        
        if ($request->filled('conclusion')) {
            $updateData['keterangan'] = $request->conclusion;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated', array_keys($updateData));
        }

        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $finalDetailCount = DetailPressureGauge::where('calibration_id', $calibration->id)->count();
        $finalAddCount = AddPressureGauge::where('calibration_id', $calibration->id)->count();
        
        // Ambil head terbaru untuk cek certificate_id
        $finalHead = HeadPressureGauge::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📋 UPDATE SUMMARY (Pressure Gauge - 20 rows):', [
            'calibration_id' => $calibration->id,
            'certificate_id_calibration' => $calibration->certificate_id,
            'certificate_id_head' => $finalHead->certificate_id ?? null,
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'detail_records' => $finalDetailCount,
            'add_records' => $finalAddCount,
            'standard' => $alatStandarString,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updatePressureGauge COMPLETED (20 rows total)');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePressureGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        throw $e;
    }
}


        private function storeDifferentialPressureGauge($request, $calibration, $certificateId, $tabId = null)
{
    try {
        \Log::info('🚀 START storeDifferentialPressureGauge - 20 BARIS (10 KIRI + 10 KANAN)');
        
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeDifferentialPressureGauge called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dengan berbagai kemungkinan nama field
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        // Coba juga dengan format array
        $alatStandarArray = $request->input('alat_standar', []);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. SIMPAN KE HEAD DIFFERENTIAL PRESSURE GAUGE
        // ==================================================================
        $satuanAlatKiri = $this->getRequestValue($request, 'satuan_alat_kiri', $tabId);
        $satuanStdKiri = $this->getRequestValue($request, 'satuan_std_kiri', $tabId);
        $satuanAlatKanan = $this->getRequestValue($request, 'satuan_alat_kanan', $tabId);
        $satuanStdKanan = $this->getRequestValue($request, 'satuan_std_kanan', $tabId);
        
        $head = HeadDifferentialPressureGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-17',
            'satuan_alat_kiri' => $satuanAlatKiri,
            'satuan_std_kiri' => $satuanStdKiri,
            'satuan_alat_kanan' => $satuanAlatKanan,
            'satuan_std_kanan' => $satuanStdKanan,
        ]);

        \Log::info('✅ HeadDifferentialPressureGauge saved:', [
            'head_id' => $head->id,
            'satuan_alat_kiri' => $satuanAlatKiri,
            'satuan_std_kiri' => $satuanStdKiri
        ]);

        // ==================================================================
        // 3. SIMPAN DETAIL DIFFERENTIAL PRESSURE GAUGE (20 BARIS)
        // ==================================================================
        \Log::info('📊 Saving Differential Pressure Gauge detail measurements...');
        $detailCount = 0;
        
        // Ambil data pembacaan alat kiri dan kanan
        $pembacaanAlatKiri = [];
        $pembacaanAlatKanan = [];
        
        for ($i = 1; $i <= 10; $i++) {
            $val = $this->getRequestValue($request, "pembacaan_alat_kiri_{$i}", $tabId);
            if ($val) {
                $pembacaanAlatKiri[] = $val;
            }
        }
        
        // Jika tidak ditemukan dengan format individual, coba array
        if (empty($pembacaanAlatKiri)) {
            $pembacaanAlatKiri = $this->getRequestValue($request, 'pembacaan_alat_kiri', $tabId);
            if (!is_array($pembacaanAlatKiri)) {
                $pembacaanAlatKiri = [];
            }
        }
        
        for ($i = 1; $i <= 10; $i++) {
            $val = $this->getRequestValue($request, "pembacaan_alat_kanan_{$i}", $tabId);
            if ($val) {
                $pembacaanAlatKanan[] = $val;
            }
        }
        
        if (empty($pembacaanAlatKanan)) {
            $pembacaanAlatKanan = $this->getRequestValue($request, 'pembacaan_alat_kanan', $tabId);
            if (!is_array($pembacaanAlatKanan)) {
                $pembacaanAlatKanan = [];
            }
        }
        
        // Proses 10 baris kiri
        for ($i = 1; $i <= 10; $i++) {
            $titikUkur = isset($pembacaanAlatKiri[$i-1]) ? $pembacaanAlatKiri[$i-1] : null;
            $stdNaik = $this->getRequestValue($request, "naik_kiri_{$i}", $tabId);
            $stdTurun = $this->getRequestValue($request, "turun_kiri_{$i}", $tabId);
            
            $hasData = !empty($titikUkur) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                DetailDifferentialPressureGauge::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    'STDNaik' => $stdNaik,
                    'STDTurun' => $stdTurun,
                ]);
                $detailCount++;
                \Log::debug("✅ Detail saved for row {$i} (kiri)");
            }
        }
        
        // Proses 10 baris kanan
        for ($i = 1; $i <= 10; $i++) {
            $titikUkur = isset($pembacaanAlatKanan[$i-1]) ? $pembacaanAlatKanan[$i-1] : null;
            $stdNaik = $this->getRequestValue($request, "naik_kanan_{$i}", $tabId);
            $stdTurun = $this->getRequestValue($request, "turun_kanan_{$i}", $tabId);
            
            $hasData = !empty($titikUkur) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                DetailDifferentialPressureGauge::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    'STDNaik' => $stdNaik,
                    'STDTurun' => $stdTurun,
                ]);
                $detailCount++;
                \Log::debug("✅ Detail saved for row {$i} (kanan)");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Differential Pressure Gauge");

        // ==================================================================
        // 4. SIMPAN ADD DIFFERENTIAL PRESSURE GAUGE (REPEATABILITY)
        // ==================================================================
        \Log::info('📊 Saving AddDifferentialPressureGauge data (repeatability)...');
        
        $repeatabilitySTD = $this->getRequestValue($request, 'repeatability_unit', $tabId);
        
        $repeatData = [
            'calibration_id' => $calibration->id,
            'repeatability' => $this->getRequestValue($request, 'repeatability', $tabId),
            'repeatabilitySTD' => $repeatabilitySTD,
            'ulangan01' => $this->getRequestValue($request, 'row1_col1', $tabId),
            'ulangan02' => $this->getRequestValue($request, 'row1_col2', $tabId),
            'ulangan03' => $this->getRequestValue($request, 'row1_col3', $tabId),
            'ulangan04' => $this->getRequestValue($request, 'row2_col1', $tabId),
            'ulangan05' => $this->getRequestValue($request, 'row2_col2', $tabId),
        ];
        
        // Cek apakah ada data untuk disimpan
        $hasRepeatData = false;
        foreach ($repeatData as $key => $value) {
            if ($key !== 'calibration_id' && $value !== null && $value !== '') {
                $hasRepeatData = true;
                break;
            }
        }
        
        if ($hasRepeatData) {
            $addRecord = AddDifferentialPressureGauge::create($repeatData);
            \Log::info('✅ AddDifferentialPressureGauge saved:', ['add_id' => $addRecord->id]);
        } else {
            \Log::info('⚠️ No AddDifferentialPressureGauge data to save');
        }

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $updateData['keterangan'] = $this->getRequestValue($request, 'conclusion', $tabId) ?? 'Alat diterima, memenuhi kriteria kalibrasi';
            \Log::info('📝 Uncertainty data:', ['uncertainty' => $uncertainty]);
        }
        
        // Nama untuk TTD
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailDifferentialPressureGauge::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddDifferentialPressureGauge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Differential Pressure Gauge - 20 rows):', [
            'calibration_id' => $calibration->id,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
        ]);

        \Log::info('🎉 storeDifferentialPressureGauge COMPLETED (20 rows total)');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeDifferentialPressureGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailDifferentialPressureGauge::where('calibration_id', $calibration->id)->delete();
                AddDifferentialPressureGauge::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Differential Pressure Gauge: " . $e->getMessage());
    }
}
        /**
         * Update Pressure Gauge data - 20 BARIS (10 KIRI + 10 KANAN)
         */
      private function updateDifferentialPressureGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateDifferentialPressureGauge - 20 BARIS (10 KIRI + 10 KANAN)', [
            'calibration_id' => $calibration->id,
            'new_certificate_id' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head differential pressure gauge untuk cek certificate_id
        $headDifferentialPressureGauge = HeadDifferentialPressureGauge::where('calibration_id', $calibration->id)->first();
        $currentCertificateId = $headDifferentialPressureGauge->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE HEAD DIFFERENTIAL PRESSURE GAUGE
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        $headDifferentialPressureData = $request->headDifferentialPressureGauge ?? [];
        $satuanAlatKiri = $headDifferentialPressureData['satuan_alat_kiri'] ?? null;
        $satuanStdKiri = $headDifferentialPressureData['satuan_std_kiri'] ?? null;
        $satuanAlatKanan = $headDifferentialPressureData['satuan_alat_kanan'] ?? null;
        $satuanStdKanan = $headDifferentialPressureData['satuan_std_kanan'] ?? null;
        
        // Data untuk update head
        $headUpdateData = [
            'standard' => $alatStandarString,
            'satuan_alat_kiri' => $satuanAlatKiri,
            'satuan_std_kiri' => $satuanStdKiri,
            'satuan_alat_kanan' => $satuanAlatKanan,
            'satuan_std_kanan' => $satuanStdKanan,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headUpdateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headUpdateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($head = $calibration->headDifferentialPressureGauge) {
            $head->update($headUpdateData);
            \Log::info('✅ HeadDifferentialPressureGauge updated:', $headUpdateData);
        } else {
            // Jika head belum ada, buat baru
            $head = HeadDifferentialPressureGauge::create(array_merge([
                'calibration_id' => $calibration->id,
                'calibrationMethod' => 'PAS-IK1102-17B',
            ], $headUpdateData));
            \Log::info('➕ HeadDifferentialPressureGauge created baru:', ['head_id' => $head->id]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL DIFFERENTIAL PRESSURE GAUGE (20 BARIS)
        // ==================================================================
        // Hapus data detail lama
        DetailDifferentialPressureGauge::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        // Proses 10 baris KIRI (index 0-9)
        for ($i = 0; $i < 10; $i++) {
            $pembacaanAlat = $request->{"pembacaan_alat_kiri"} ?? [];
            $pembacaanAlatValue = $pembacaanAlat[$i] ?? null;
            $stdNaik = $request->{"naik_kiri_".$i} ?? null;
            $stdTurun = $request->{"turun_kiri_".$i} ?? null;
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($pembacaanAlatValue) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                DetailDifferentialPressureGauge::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $pembacaanAlatValue,
                    'STDNaik' => $stdNaik,
                    'STDTurun' => $stdTurun,
                ]);
                $detailCount++;
            }
        }
        
        // Proses 10 baris KANAN (index 0-9)
        for ($i = 0; $i < 10; $i++) {
            $pembacaanAlat = $request->{"pembacaan_alat_kanan"} ?? [];
            $pembacaanAlatValue = $pembacaanAlat[$i] ?? null;
            // Untuk kanan, $i + 10 karena di view menggunakan naik_kanan_10, naik_kanan_11, dst
            $stdNaik = $request->{"naik_kanan_".($i+10)} ?? null;
            $stdTurun = $request->{"turun_kanan_".($i+10)} ?? null;
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($pembacaanAlatValue) || !empty($stdNaik) || !empty($stdTurun);
            
            if ($hasData) {
                DetailDifferentialPressureGauge::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $pembacaanAlatValue,
                    'STDNaik' => $stdNaik,
                    'STDTurun' => $stdTurun,
                ]);
                $detailCount++;
            }
        }
        
        \Log::info('✅ DetailDifferentialPressureGauge updated:', ['total_records' => $detailCount]);

        // ==================================================================
        // 3. UPDATE ADD DIFFERENTIAL PRESSURE GAUGE (REPEATABILITY)
        // ==================================================================
        // Ambil repeatabilitySTD dari request (name="repeatability_unit")
        $repeatabilitySTD = $request->repeatability_unit ?? null;
        
        if ($addGauge = $calibration->addDifferentialPressureGauge) {
            $addGauge->update([
                'repeatability' => $request->repeatability ?? $addGauge->repeatability,
                'repeatabilitySTD' => $repeatabilitySTD ?? $addGauge->repeatabilitySTD,
                'ulangan01' => $request->row1_col1 ?? $addGauge->ulangan01,
                'ulangan02' => $request->row1_col2 ?? $addGauge->ulangan02,
                'ulangan03' => $request->row1_col3 ?? $addGauge->ulangan03,
                'ulangan04' => $request->row2_col1 ?? $addGauge->ulangan04,
                'ulangan05' => $request->row2_col2 ?? $addGauge->ulangan05,
            ]);
            \Log::info('✅ AddDifferentialPressureGauge updated', [
                'repeatability' => $request->repeatability,
                'repeatabilitySTD' => $repeatabilitySTD,
                'ulangan01' => $request->row1_col1,
                'ulangan02' => $request->row1_col2,
                'ulangan03' => $request->row1_col3,
                'ulangan04' => $request->row2_col1,
                'ulangan05' => $request->row2_col2,
            ]);
        } else {
            // Buat baru jika belum ada
            AddDifferentialPressureGauge::create([
                'calibration_id' => $calibration->id,
                'repeatability' => $request->repeatability ?? null,
                'repeatabilitySTD' => $repeatabilitySTD ?? null,
                'ulangan01' => $request->row1_col1 ?? null,
                'ulangan02' => $request->row1_col2 ?? null,
                'ulangan03' => $request->row1_col3 ?? null,
                'ulangan04' => $request->row2_col1 ?? null,
                'ulangan05' => $request->row2_col2 ?? null,
            ]);
            \Log::info('➕ AddDifferentialPressureGauge created baru');
        }

        // ==================================================================
        // 4. UPDATE CALIBRATION
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if ($request->filled('namaAlat') && $request->namaAlat != $calibration->namaAlat) {
            $updateData['namaAlat'] = $request->namaAlat;
        }
        
        // UPDATE CERTIFICATE ID DI CALIBRATION jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk calibration: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $updateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk calibration dari parameter: {$newCertificateId}");
        }
        
        // Update uncertainty dan conclusion
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima';
        }
        
        // Update nama dari input yang dikirim
        if ($request->filled('nama_dikalibrasi')) {
            $updateData['calibrated_by'] = $request->nama_dikalibrasi;
        }
        
        if ($request->filled('nama_diperiksa')) {
            $updateData['verified_by'] = $request->nama_diperiksa;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated', array_keys($updateData));
        }

        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $finalDetailCount = DetailDifferentialPressureGauge::where('calibration_id', $calibration->id)->count();
        $finalAddCount = AddDifferentialPressureGauge::where('calibration_id', $calibration->id)->count();
        
        // Ambil head terbaru untuk cek certificate_id
        $finalHead = HeadDifferentialPressureGauge::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📋 UPDATE SUMMARY (Differential Pressure Gauge - 20 rows):', [
            'calibration_id' => $calibration->id,
            'certificate_id_calibration' => $calibration->certificate_id,
            'certificate_id_head' => $finalHead->certificate_id ?? null,
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'detail_records' => $finalDetailCount,
            'add_records' => $finalAddCount,
            'standard' => $alatStandarString,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updateDifferentialPressureGauge COMPLETED (20 rows total)');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateDifferentialPressureGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        throw $e;
    }
}

        
    private function storeVolumetrik($request, $calibration, $certificateId, $tabId = null)
{
    try {
        \Log::info('🚀 START storeVolumetrik - DENGAN INPUT MANUAL');
        
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeVolumetrik called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dengan berbagai kemungkinan nama field
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        // Coba juga dengan format array
        $alatStandarArray = $request->input('alat_standar', []);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. TENTUKAN NAMA ALAT YANG AKAN DIGUNAKAN (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $namaAlatFinal = $calibration->namaAlat; // Default: dari create awal
        
        // Cari nama alat dari request dengan dukungan _tab
        $namaAlatDropdown = $this->getRequestValue($request, 'nama_alat', $tabId);
        $namaAlatManual = $this->getRequestValue($request, 'nama_alat_manual', $tabId);
        
        \Log::info('🔍 Initial nama alat state:', [
            'calibration_namaAlat' => $calibration->namaAlat,
            'request_nama_alat' => $namaAlatDropdown,
            'request_nama_alat_manual' => $namaAlatManual,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId
        ]);
        
        // Jika ada input manual nama alat, update dengan itu
        if (!empty($namaAlatManual)) {
            $namaAlatFinal = $namaAlatManual;
            $calibration->update(['namaAlat' => $namaAlatFinal]);
            \Log::info('📝 Nama alat diupdate dari input manual:', ['nama_alat' => $namaAlatFinal]);
        } 
        // Jika dari dropdown dan bukan "MANUAL_INPUT"
        elseif (!empty($namaAlatDropdown) && $namaAlatDropdown !== 'MANUAL_INPUT') {
            // Update jika berbeda dengan yang sudah ada
            if ($calibration->namaAlat !== $namaAlatDropdown) {
                $namaAlatFinal = $namaAlatDropdown;
                $calibration->update(['namaAlat' => $namaAlatFinal]);
                \Log::info('📝 Nama alat diupdate dari dropdown:', ['nama_alat' => $namaAlatFinal]);
            }
        }
        
        // ==================================================================
        // 3. PERBAIKI CERTIFICATE ID JIKA MASIH MENGANDUNG "MANUAL_INPUT"
        // ==================================================================
        $needRegenerate = false;
        
        // Cek 1: Jika certificate_id mengandung "MANUAL_INPUT"
        if (strpos($certificateId, 'MANUAL_INPUT') !== false) {
            $needRegenerate = true;
            \Log::info('⚠️ Certificate ID contains MANUAL_INPUT, will regenerate');
        }
        
        // Cek 2: Jika certificate_id tidak mengandung nama alat yang benar
        if (!$needRegenerate && $namaAlatFinal !== 'MANUAL_INPUT') {
            $certificateParts = explode('-', $certificateId);
            $namaAlatInCertificate = end($certificateParts);
            
            if ($namaAlatInCertificate === 'MANUAL_INPUT' || 
                stripos($namaAlatFinal, $namaAlatInCertificate) === false) {
                $needRegenerate = true;
                \Log::info('🔍 Certificate ID nama tidak match:', [
                    'nama_alat_final' => $namaAlatFinal,
                    'nama_in_certificate' => $namaAlatInCertificate
                ]);
            }
        }
        
        // REGENERATE CERTIFICATE ID JIKA PERLU
        if ($needRegenerate) {
            $certificateId = $this->generateCertificateId($namaAlatFinal);
            $calibration->update(['certificate_id' => $certificateId]);
            \Log::info('🆔 Certificate ID regenerated:', [
                'nama_alat' => $namaAlatFinal,
                'new_certificate_id' => $certificateId
            ]);
        } else {
            \Log::info('✅ Certificate ID sudah benar:', ['certificate_id' => $certificateId]);
        }

        // ==================================================================
        // 4. SIMPAN KE HEAD VOLUMETRIK (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $satuanAlatUkur = $this->getRequestValue($request, 'satuan_alatUkur', $tabId);
        $satuanRep = $this->getRequestValue($request, 'satuan_rep', $tabId);
        
        $head = HeadVolumetrik::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-38 (Volumetrik Glassware)',
            'satuan_alatUkur' => $satuanAlatUkur,
            'satuan_rep' => $satuanRep,
        ]);

        \Log::info('✅ HeadVolumetrik saved:', ['head_id' => $head->id]);

        // ==================================================================
        // 5. SIMPAN DETAIL VOLUMETRIK (5 BARIS) - TANPA formatNumericValue
        // ==================================================================
        \Log::info('📊 Saving DetailVolumetrik data (5 rows)...');
        $detailCount = 0;
        
        for ($nominal = 1; $nominal <= 5; $nominal++) {
            // Ambil nilai nominal dari form dengan dukungan _tab
            $nominalValue = $this->getRequestValue($request, "nominal_{$nominal}", $tabId);
            
            // Jika ada nominal, simpan semua data untuk nominal tersebut
            if (!empty($nominalValue)) {
                // Kumpulkan data untuk 3 pengulangan (nilai asli, tanpa format)
                $massaKosong01 = $this->getRequestValue($request, "massa_kosong_{$nominal}_1", $tabId);
                $massaKosong02 = $this->getRequestValue($request, "massa_kosong_{$nominal}_2", $tabId);
                $massaKosong03 = $this->getRequestValue($request, "massa_kosong_{$nominal}_3", $tabId);
                
                $massaIsi01 = $this->getRequestValue($request, "massa_isi_{$nominal}_1", $tabId);
                $massaIsi02 = $this->getRequestValue($request, "massa_isi_{$nominal}_2", $tabId);
                $massaIsi03 = $this->getRequestValue($request, "massa_isi_{$nominal}_3", $tabId);
                
                $T_airSuling01 = $this->getRequestValue($request, "suhu_{$nominal}_1", $tabId);
                $T_airSuling02 = $this->getRequestValue($request, "suhu_{$nominal}_2", $tabId);
                $T_airSuling03 = $this->getRequestValue($request, "suhu_{$nominal}_3", $tabId);
                
                $P_Udara01 = $this->getRequestValue($request, "tekanan_{$nominal}_1", $tabId);
                $P_Udara02 = $this->getRequestValue($request, "tekanan_{$nominal}_2", $tabId);
                $P_Udara03 = $this->getRequestValue($request, "tekanan_{$nominal}_3", $tabId);
                
                // Cek apakah ada data minimal 1 nilai
                $hasData = !empty($massaKosong01) || !empty($massaKosong02) || !empty($massaKosong03) ||
                          !empty($massaIsi01) || !empty($massaIsi02) || !empty($massaIsi03) ||
                          !empty($T_airSuling01) || !empty($T_airSuling02) || !empty($T_airSuling03) ||
                          !empty($P_Udara01) || !empty($P_Udara02) || !empty($P_Udara03);
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'head_volumetrik_id' => $head->id,
                        'titikUkur' => $nominalValue,
                        'masssaKosong01' => $massaKosong01,
                        'masssaKosong02' => $massaKosong02,
                        'masssaKosong03' => $massaKosong03,
                        'massaIsi01' => $massaIsi01,
                        'massaIsi02' => $massaIsi02,
                        'massaIsi03' => $massaIsi03,
                        'T_airSuling01' => $T_airSuling01,
                        'T_airSuling02' => $T_airSuling02,
                        'T_airSuling03' => $T_airSuling03,
                        'P_Udara01' => $P_Udara01,
                        'P_Udara02' => $P_Udara02,
                        'P_Udara03' => $P_Udara03,
                    ];
                    
                    DetailVolumetrik::create($detailData);
                    $detailCount++;
                    \Log::info("💾 Saved detail for nominal: {$nominalValue}");
                }
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailVolumetrik records");

        // ==================================================================
        // 6. SIMPAN ADD VOLUMETRIK (REPEATABILITY - 10 BARIS) - TANPA formatNumericValue
        // ==================================================================
        \Log::info('📊 Saving AddVolumetrik data (repeatability - 10 repetitions)...');

        // Ambil nilai titik ukur (nominal) dari input repeatability_nominal
        $repeatabilityNominal = $this->getRequestValue($request, 'repeatability_nominal', $tabId);

        $addCount = 0;

        // Loop untuk 10 pengulangan
        for ($i = 1; $i <= 10; $i++) {
            // Ambil data dari masing-masing baris pengulangan (nilai asli, tanpa format)
            $massaKosong = $this->getRequestValue($request, "repeat_massa_kosong_{$i}", $tabId);
            $massaIsi    = $this->getRequestValue($request, "repeat_massa_isi_{$i}", $tabId);
            $suhu        = $this->getRequestValue($request, "repeat_suhu_{$i}", $tabId);
            $tekanan     = $this->getRequestValue($request, "repeat_tekanan_{$i}", $tabId);

            // Cek apakah ada setidaknya satu field yang terisi di baris ini
            if ($massaKosong !== null || $massaIsi !== null || $suhu !== null || $tekanan !== null) {
                
                $addData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur'      => $repeatabilityNominal,
                    'massaKosong'    => $massaKosong,
                    'massaIsi'       => $massaIsi,
                    'T_airSuling'    => $suhu,
                    'P_Udara'        => $tekanan,
                ];

                AddVolumetrik::create($addData);
                $addCount++;
                
                \Log::info("💾 Saved AddVolumetrik repetition {$i}", $addData);
            }
        }

        if ($addCount > 0) {
            \Log::info("✅ Successfully saved {$addCount} AddVolumetrik records (repeatability)");
        } else {
            \Log::info('⚠️ No AddVolumetrik data was filled or saved');
        }

        // ==================================================================
        // 7. UPDATE CALIBRATION DENGAN DATA TTD (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $updateData = [];
        
        // Nama untuk TTD Dikalibrasi
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy]);
        }
        
        // Nama untuk TTD Diperiksa
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy]);
        }
        
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Juga update certificate_id di calibration jika sudah diregenerate
        if ($needRegenerate) {
            $updateData['certificate_id'] = $certificateId;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with TTD data' . ($needRegenerate ? ' and new certificate_id' : ''));
        }

        // ==================================================================
        // 8. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailVolumetrik::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddVolumetrik::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Volumetrik):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
            'nama_alat_final' => $namaAlatFinal,
        ]);

        \Log::info('🎉 storeVolumetrik COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeVolumetrik:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback
        if (isset($head) && $head->id) {
            try {
                DetailVolumetrik::where('calibration_id', $calibration->id)->delete();
                AddVolumetrik::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Volumetrik: " . $e->getMessage());
    }
}

private function updateVolumetrik($request, $calibration)
{
    \Log::info('🚀 START updateVolumetrik - WITH CERTIFICATE ID UPDATE (generateCertificateIdFromNamaAlat)');
    
    // ==================================================================
    // 1. TENTUKAN NAMA ALAT YANG BARU DARI BERBAGAI SUMBER
    // ==================================================================
    $namaAlatLama = $calibration->namaAlat;
    $namaAlatBaru = $namaAlatLama; // Default: tetap sama
    
    \Log::info('🔍 Nama alat sebelum update:', [
        'nama_alat_lama' => $namaAlatLama,
        'from_hidden_input' => $request->namaAlat ?? 'not_set',
        'from_manual_input' => $request->nama_alat_manual ?? 'not_set',
        'from_dropdown' => $request->nama_alat ?? 'not_set',
        'dropdown_value' => $request->nama_alat_select ?? 'not_set'
    ]);
    
    // Priority 1: Hidden input namaAlat (sudah diproses JavaScript)
    if ($request->has('namaAlat') && !empty($request->namaAlat)) {
        $namaAlatBaru = $request->namaAlat;
        \Log::info('📝 Nama alat dari hidden input:', ['nama_alat_baru' => $namaAlatBaru]);
    }
    // Priority 2: Input manual
    elseif ($request->has('nama_alat_manual') && !empty($request->nama_alat_manual)) {
        $namaAlatBaru = $request->nama_alat_manual;
        \Log::info('📝 Nama alat dari input manual:', ['nama_alat_baru' => $namaAlatBaru]);
    }
    // Priority 3: Dropdown (bukan MANUAL_INPUT)
    elseif ($request->filled('nama_alat') && $request->nama_alat !== 'MANUAL_INPUT') {
        $namaAlatBaru = $request->nama_alat;
        \Log::info('📝 Nama alat dari dropdown:', ['nama_alat_baru' => $namaAlatBaru]);
    }
    
    // ==================================================================
    // 2. PERBARUI NAMA ALAT DI CALIBRATION JIKA BERBEDA
    // ==================================================================
    $namaAlatUpdated = false;
    if ($namaAlatLama !== $namaAlatBaru) {
        $calibration->update(['namaAlat' => $namaAlatBaru]);
        $namaAlatUpdated = true;
        \Log::info('✅ Nama alat diupdate di calibration:', [
            'dari' => $namaAlatLama,
            'menjadi' => $namaAlatBaru
        ]);
    }
    
    // ==================================================================
    // 3. GENERATE CERTIFICATE ID BARU MENGGUNAKAN generateCertificateIdFromNamaAlat()
    // ==================================================================
    $certificateIdLama = $calibration->certificate_id;
    $certificateIdBaru = $certificateIdLama;
    $certificateIdUpdated = false;
    
    if ($namaAlatUpdated) {
        // Generate certificate ID baru menggunakan generateCertificateIdFromNamaAlat()
        $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatBaru, $calibration);
        $certificateIdUpdated = true;
        
        // Update certificate_id di calibration
        $calibration->update(['certificate_id' => $certificateIdBaru]);
        
        \Log::info('🆔 Certificate ID updated menggunakan generateCertificateIdFromNamaAlat():', [
            'nama_alat_lama' => $namaAlatLama,
            'nama_alat_baru' => $namaAlatBaru,
            'certificate_id_lama' => $certificateIdLama,
            'certificate_id_baru' => $certificateIdBaru,
            'method_used' => 'generateCertificateIdFromNamaAlat'
        ]);
    } elseif (empty($certificateIdLama) || strpos($certificateIdLama, 'MANUAL_INPUT') !== false) {
        // Jika certificate_id masih kosong atau mengandung MANUAL_INPUT, generate baru
        $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatBaru, $calibration);
        $calibration->update(['certificate_id' => $certificateIdBaru]);
        $certificateIdUpdated = true;
        
        \Log::info('🆔 Certificate ID generated menggunakan generateCertificateIdFromNamaAlat():', [
            'reason' => empty($certificateIdLama) ? 'certificate_id kosong' : 'mengandung MANUAL_INPUT',
            'certificate_id_baru' => $certificateIdBaru,
            'method_used' => 'generateCertificateIdFromNamaAlat'
        ]);
    } else {
        \Log::info('✅ Certificate ID tidak berubah:', [
            'certificate_id' => $certificateIdLama,
            'reason' => 'nama alat tidak berubah'
        ]);
    }
    
    // Gunakan certificate_id yang sudah ditentukan
    $certificateIdToUse = $certificateIdBaru;
    
    // ==================================================================
    // 4. PROSES ALAT STANDAR DARI CHECKBOX (TANPA formatNumericValue)
    // ==================================================================
    $arrayValue = $request->input('alat_standar', []);
    
    if (is_array($arrayValue) && count($arrayValue) > 0) {
        $standardValue = implode(", ", $arrayValue);
        \Log::info('🔧 Alat standar dari checkbox:', [
            'count' => count($arrayValue),
            'items' => $arrayValue,
            'string' => $standardValue
        ]);
    } else {
        // Coba ambil dari data yang sudah ada
        $headVolumetrik = HeadVolumetrik::where('calibration_id', $calibration->id)->first();
        $standardValue = $headVolumetrik->standard ?? '';
        \Log::info('🔧 Alat standar dari data lama:', ['standard' => $standardValue]);
    }
    
    // ==================================================================
    // 5. Update HeadVolumetrik dengan certificate_id yang benar
    // ==================================================================
    $headData = [
        'standard' => $standardValue,
        'calibrationMethod' => $request->calibration_method ?? 'PAS-IK1102-38 (Volumetrik Glassware)',
        'satuan_alatUkur' => $request->satuan_alatUkur ?? 'mL',
        'satuan_rep' => $request->satuan_rep ?? 'mL',
    ];
    
    // Update certificate_id hanya jika berubah
    if ($certificateIdUpdated) {
        $headData['certificate_id'] = $certificateIdToUse;
        \Log::info('📝 Certificate ID akan diupdate di HeadVolumetrik:', ['certificate_id' => $certificateIdToUse]);
    }
    
    $headVolumetrik = HeadVolumetrik::updateOrCreate(
        ['calibration_id' => $calibration->id],
        $headData
    );
    
    \Log::info('✅ HeadVolumetrik updated/created:', [
        'id' => $headVolumetrik->id,
        'standard' => $standardValue,
        'certificate_id' => $headVolumetrik->certificate_id,
        'certificate_updated' => $certificateIdUpdated ? 'Yes' : 'No'
    ]);
    
    // ==================================================================
    // 6. Hapus data DetailVolumetrik lama
    // ==================================================================
    $deletedDetailCount = DetailVolumetrik::where('calibration_id', $calibration->id)->delete();
    \Log::info('🗑️ Deleted old DetailVolumetrik records:', ['count' => $deletedDetailCount]);
    
    // ==================================================================
    // 7. Simpan DetailVolumetrik baru (Data utama kalibrasi) - TANPA formatNumericValue
    // ==================================================================
    $detailCount = 0;
    
    // Proses data untuk 5 nominal (nominal_1 sampai nominal_5)
    for ($nominalNumber = 1; $nominalNumber <= 5; $nominalNumber++) {
        // Ambil nilai nominal (nilai asli, tanpa format)
        $titikUkur = $request->input("nominal_{$nominalNumber}");
        
        // Ambil data untuk 3 pengulangan (nilai asli, tanpa format)
        $masssaKosong01 = $request->input("massa_kosong_{$nominalNumber}_1");
        $masssaKosong02 = $request->input("massa_kosong_{$nominalNumber}_2");
        $masssaKosong03 = $request->input("massa_kosong_{$nominalNumber}_3");
        
        $massaIsi01 = $request->input("massa_isi_{$nominalNumber}_1");
        $massaIsi02 = $request->input("massa_isi_{$nominalNumber}_2");
        $massaIsi03 = $request->input("massa_isi_{$nominalNumber}_3");
        
        $T_airSuling01 = $request->input("suhu_{$nominalNumber}_1");
        $T_airSuling02 = $request->input("suhu_{$nominalNumber}_2");
        $T_airSuling03 = $request->input("suhu_{$nominalNumber}_3");
        
        $P_Udara01 = $request->input("tekanan_{$nominalNumber}_1");
        $P_Udara02 = $request->input("tekanan_{$nominalNumber}_2");
        $P_Udara03 = $request->input("tekanan_{$nominalNumber}_3");
        
        // Cek apakah ada setidaknya satu data yang diisi
        $hasData = !empty($titikUkur) || 
                   !empty($masssaKosong01) || !empty($masssaKosong02) || !empty($masssaKosong03) ||
                   !empty($massaIsi01) || !empty($massaIsi02) || !empty($massaIsi03) ||
                   !empty($T_airSuling01) || !empty($T_airSuling02) || !empty($T_airSuling03) ||
                   !empty($P_Udara01) || !empty($P_Udara02) || !empty($P_Udara03);
        
        if ($hasData) {
            try {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_volumetrik_id' => $headVolumetrik->id,
                    'titikUkur' => $titikUkur,
                    
                    // Massa Kosong - 3 pengulangan
                    'masssaKosong01' => $masssaKosong01,
                    'masssaKosong02' => $masssaKosong02,
                    'masssaKosong03' => $masssaKosong03,
                    
                    // Massa Isi - 3 pengulangan
                    'massaIsi01' => $massaIsi01,
                    'massaIsi02' => $massaIsi02,
                    'massaIsi03' => $massaIsi03,
                    
                    // Suhu Air Suling - 3 pengulangan
                    'T_airSuling01' => $T_airSuling01,
                    'T_airSuling02' => $T_airSuling02,
                    'T_airSuling03' => $T_airSuling03,
                    
                    // Tekanan Udara - 3 pengulangan
                    'P_Udara01' => $P_Udara01,
                    'P_Udara02' => $P_Udara02,
                    'P_Udara03' => $P_Udara03,
                ];
                
                DetailVolumetrik::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ DetailVolumetrik nominal_{$nominalNumber} saved", [
                    'titikUkur' => $titikUkur,
                    'index' => $nominalNumber - 1
                ]);
                
            } catch (\Exception $e) {
                \Log::error("❌ Failed to save DetailVolumetrik nominal_{$nominalNumber}", [
                    'error' => $e->getMessage(),
                    'nominalNumber' => $nominalNumber
                ]);
            }
        }
    }
    
    \Log::info("✅ DetailVolumetrik saved: {$detailCount} records");
    
    // ==================================================================
    // 8. Hapus data AddVolumetrik lama
    // ==================================================================
    $deletedAddCount = AddVolumetrik::where('calibration_id', $calibration->id)->delete();
    \Log::info('🗑️ Deleted old AddVolumetrik records:', ['count' => $deletedAddCount]);
    
    // ==================================================================
    // 9. Simpan AddVolumetrik baru (Repeatability data) - TANPA formatNumericValue
    // ==================================================================
    $repeatCount = 0;
    $repeatabilityNominal = $request->repeatability_nominal;
    
    // Proses data dari input repeat_massa_kosong_1 sampai repeat_massa_kosong_10 (10 baris)
    for ($i = 1; $i <= 10; $i++) {
        // Ambil data dari request (nilai asli, tanpa format)
        $massaKosong = $request->input("repeat_massa_kosong_{$i}");
        $massaIsi = $request->input("repeat_massa_isi_{$i}");
        $T_airSuling = $request->input("repeat_suhu_{$i}");
        $P_Udara = $request->input("repeat_tekanan_{$i}");
        
        // Cek apakah ada data untuk baris ini
        $hasData = !empty($massaKosong) || !empty($massaIsi) || 
                   !empty($T_airSuling) || !empty($P_Udara);
        
        if ($hasData && !empty($repeatabilityNominal)) {
            try {
                $repeatData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $repeatabilityNominal,
                    'massaKosong' => $massaKosong,
                    'massaIsi' => $massaIsi,
                    'T_airSuling' => $T_airSuling,
                    'P_Udara' => $P_Udara,
                ];
                
                AddVolumetrik::create($repeatData);
                $repeatCount++;
                
            } catch (\Exception $e) {
                \Log::error("❌ Failed to save AddVolumetrik row {$i}", [
                    'error' => $e->getMessage(),
                    'row' => $i
                ]);
            }
        }
    }
    
    \Log::info("✅ AddVolumetrik saved: {$repeatCount} records");
    
    // ==================================================================
    // 10. Update Calibration dengan data tambahan
    // ==================================================================
    $updateData = [];
    
    // Periksa kedua kemungkinan nama field
    if ($request->filled('calibrated_by')) {
        $updateData['calibrated_by'] = $request->calibrated_by;
    } elseif ($request->filled('calibratedBy')) {
        $updateData['calibrated_by'] = $request->calibratedBy;
    }
    
    if ($request->filled('verified_by')) {
        $updateData['verified_by'] = $request->verified_by;
    } elseif ($request->filled('verifiedBy')) {
        $updateData['verified_by'] = $request->verifiedBy;
    }
    
    if ($request->filled('uncertainty')) {
        $updateData['uncertainty'] = $request->uncertainty;
    }
    
    if ($request->filled('conclusion')) {
        $updateData['keterangan'] = $request->conclusion;
    }
    
    if (!empty($updateData)) {
        $calibration->update($updateData);
        \Log::info('✅ Calibration additional data updated', $updateData);
    }
    
    // ==================================================================
    // 11. LOG HASIL AKHIR
    // ==================================================================
    $savedDetailCount = DetailVolumetrik::where('calibration_id', $calibration->id)->count();
    $savedAddCount = AddVolumetrik::where('calibration_id', $calibration->id)->count();
    
    \Log::info('📋 UPDATE VOLUMETRIK FINAL SUMMARY:', [
        'calibration_id' => $calibration->id,
        'nama_alat_lama' => $namaAlatLama,
        'nama_alat_baru' => $namaAlatBaru,
        'nama_alat_updated' => $namaAlatUpdated ? 'Yes' : 'No',
        'certificate_id_lama' => $certificateIdLama,
        'certificate_id_baru' => $certificateIdToUse,
        'certificate_updated' => $certificateIdUpdated ? 'Yes' : 'No',
        'certificate_method' => 'generateCertificateIdFromNamaAlat',
        'head_id' => $headVolumetrik->id,
        'detail_records' => $savedDetailCount,
        'add_records' => $savedAddCount,
        'standard' => $standardValue,
        'calibrated_by' => $calibration->calibrated_by ?? null,
        'verified_by' => $calibration->verified_by ?? null,
    ]);
    
    \Log::info('🎉 updateVolumetrik COMPLETED SUCCESSFULLY - menggunakan generateCertificateIdFromNamaAlat()');
    return true;
}


private function storeThermohygrometer($request, $calibration, $certificateId, $tabId = null)
{
    try {
        \Log::info('🚀 START storeThermohygrometer');
        
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeThermohygrometer called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. TENTUKAN TYPE (IN/OUT atau SINGLE)
        // ==================================================================
        $type = $this->getRequestValue($request, 'type', $tabId);
        if (empty($type) || !in_array($type, ['in_out', 'single'])) {
            $type = 'single';
            \Log::warning('⚠️ Type invalid or not found, set to default: single');
        }
        
        \Log::info('📊 Thermohygrometer type:', ['type' => $type, 'tab_id' => $tabId]);
        
        // ==================================================================
        // 2. SIMPAN TYPE KE CALIBRATION TABLE
        // ==================================================================
        $calibration->update([
            'type' => $type,
        ]);
        
        \Log::info('✅ Thermohygrometer type saved to calibration');
        
        // ==================================================================
        // 3. TENTUKAN STANDARD DAN METHOD
        // ==================================================================
        if ($type === 'in_out') {
            $alatStandarString = 'Temperature & Humidity Transmitter, Rotronic, 71946262; 20345594';
            $calibrationMethod = 'PAS-IK1102-50';
            \Log::info('🔧 Alat standar selected (IN/OUT fixed):', [
                'alat_standar' => $alatStandarString,
                'tab_id' => $tabId
            ]);
        } else {
            $alatStandar = [];
            
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = "alat_standar_{$i}";
                $value = $this->getRequestValue($request, $fieldName, $tabId);
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
            
            $alatStandarArray = $request->input('alat_standar', []);
            if (is_array($alatStandarArray)) {
                foreach ($alatStandarArray as $value) {
                    if ($value && !in_array($value, $alatStandar)) {
                        $alatStandar[] = $value;
                    }
                }
            }
            
            $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
            
            if (empty($alatStandarString)) {
                $alatStandarString = 'Temperature & Humidity Transmitter, Rotronic, 71946262; 20345594';
                \Log::warning('⚠️ No alat_standar provided for SINGLE type, using default');
            }
            
            $calibrationMethod = 'PAS-IK1102-50';
            
            \Log::info('📌 Using custom standard for SINGLE type', [
                'alat_standar_raw' => $alatStandar,
                'alat_standar_string' => $alatStandarString,
                'tab_id' => $tabId
            ]);
        }
        
        \Log::info('📊 Standard and method determined:', [
            'type' => $type,
            'standard' => $alatStandarString,
            'method' => $calibrationMethod,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 4. SIMPAN KE HEAD THERMOHYGROMETER
        // ==================================================================
        $headData = [
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => $calibrationMethod,
        ];
        
        $headThermohygrometer = \App\Models\HeadThermohygrometer::where('calibration_id', $calibration->id)->first();
        
        if ($headThermohygrometer) {
            $headThermohygrometer->update($headData);
            \Log::info('✅ Updated existing HeadThermohygrometer');
        } else {
            \App\Models\HeadThermohygrometer::create($headData);
            \Log::info('✅ Created new HeadThermohygrometer');
        }
        
        // ==================================================================
        // 5. HAPUS DATA DETAIL LAMA
        // ==================================================================
        $existingDetails = \App\Models\DetailThermohygrometer::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            \App\Models\DetailThermohygrometer::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records");
        }
        
        // ==================================================================
        // 6. SIMPAN DETAIL BERDASARKAN TYPE
        // ==================================================================
        \Log::info('📊 Saving Thermohygrometer detail measurements...');
        
        $detailCount = 0;
        
        if ($type === 'in_out') {
            \Log::info('Processing IN/OUT data (7 rows)...');
            
            $tempData = $request->input('temp', []);
            $humidityData = $request->input('humidity', []);
            $maxRows = max(count($tempData), count($humidityData), 7);
            
            for ($i = 0; $i < $maxRows; $i++) {
                $tempRow = $tempData[$i] ?? [];
                $humidityRow = $humidityData[$i] ?? [];
                
                $tempSetPoint = $tempRow['set_point'] ?? null;
                $tempStdX1 = $tempRow['std_x1'] ?? null;
                $tempStdX2 = $tempRow['std_x2'] ?? null;
                $tempStdX3 = $tempRow['std_x3'] ?? null;
                $tempInX1 = $tempRow['in_x1'] ?? null;
                $tempInX2 = $tempRow['in_x2'] ?? null;
                $tempInX3 = $tempRow['in_x3'] ?? null;
                $tempOutX1 = $tempRow['out_x1'] ?? null;
                $tempOutX2 = $tempRow['out_x2'] ?? null;
                $tempOutX3 = $tempRow['out_x3'] ?? null;
                
                $humiditySetPoint = $humidityRow['set_point'] ?? null;
                $humidityStdX1 = $humidityRow['std_x1'] ?? null;
                $humidityStdX2 = $humidityRow['std_x2'] ?? null;
                $humidityStdX3 = $humidityRow['std_x3'] ?? null;
                $humidityAlatX1 = $humidityRow['alat_x1'] ?? null;
                $humidityAlatX2 = $humidityRow['alat_x2'] ?? null;
                $humidityAlatX3 = $humidityRow['alat_x3'] ?? null;
                
                $hasValidTempData = false;
                $tempValues = [$tempSetPoint, $tempStdX1, $tempStdX2, $tempStdX3, $tempInX1, $tempInX2, $tempInX3, $tempOutX1, $tempOutX2, $tempOutX3];
                foreach($tempValues as $value) {
                    if ($value !== null && $value !== '') {
                        $hasValidTempData = true;
                        break;
                    }
                }
                
                $hasValidHumidityData = false;
                $humidityValues = [$humiditySetPoint, $humidityStdX1, $humidityStdX2, $humidityStdX3, $humidityAlatX1, $humidityAlatX2, $humidityAlatX3];
                foreach($humidityValues as $value) {
                    if ($value !== null && $value !== '') {
                        $hasValidHumidityData = true;
                        break;
                    }
                }
                
                if ($hasValidTempData || $hasValidHumidityData) {
                    try {
                        \App\Models\DetailThermohygrometer::create([
                            'calibration_id' => $calibration->id,
                            'titikUkur_T' => $tempSetPoint,
                            'T_STD1' => $tempStdX1,
                            'T_STD2' => $tempStdX2,
                            'T_STD3' => $tempStdX3,
                            'T_IN1' => $tempInX1,
                            'T_IN2' => $tempInX2,
                            'T_IN3' => $tempInX3,
                            'T_OUT1' => $tempOutX1,
                            'T_OUT2' => $tempOutX2,
                            'T_OUT3' => $tempOutX3,
                            'titikUkur_RH' => $humiditySetPoint,
                            'RH_STD1' => $humidityStdX1,
                            'RH_STD2' => $humidityStdX2,
                            'RH_STD3' => $humidityStdX3,
                            'RH_ALAT1' => $humidityAlatX1,
                            'RH_ALAT2' => $humidityAlatX2,
                            'RH_ALAT3' => $humidityAlatX3,
                        ]);
                        
                        $detailCount++;
                        \Log::debug("✅ Saved IN/OUT row {$i}");
                        
                    } catch (\Exception $e) {
                        \Log::error("❌ Failed to save IN/OUT row {$i}: " . $e->getMessage());
                    }
                } else {
                    \Log::debug("⏭️ Skipping IN/OUT row {$i} - no data");
                }
            }
            
        } else {
            // ==============================================================
            // PROSES SINGLE TYPE - Menggunakan format field dengan _tab
            // ==============================================================
            \Log::info('Processing SINGLE data (10 rows)...');
            
            // Buat suffix untuk tab (contoh: _tab1, _tab2, dll)
            $tabSuffix = '_tab' . $tabId;
            
            for ($i = 1; $i <= 10; $i++) {
                // Ambil data temperatur dengan format t_set1, t_std1_1_tab1, dll
                $tSet = $request->input("t_set{$i}");
                $tStd1 = $request->input("t_std{$i}_1{$tabSuffix}");
                $tStd2 = $request->input("t_std{$i}_2{$tabSuffix}");
                $tStd3 = $request->input("t_std{$i}_3{$tabSuffix}");
                $tInst1 = $request->input("t_inst{$i}_1{$tabSuffix}");
                $tInst2 = $request->input("t_inst{$i}_2{$tabSuffix}");
                $tInst3 = $request->input("t_inst{$i}_3{$tabSuffix}");
                
                // Jika tidak ditemukan dengan format _tab, coba tanpa _tab
                if (empty($tStd1) && empty($tStd2) && empty($tStd3)) {
                    $tStd1 = $request->input("t_std{$i}_1");
                    $tStd2 = $request->input("t_std{$i}_2");
                    $tStd3 = $request->input("t_std{$i}_3");
                    $tInst1 = $request->input("t_inst{$i}_1");
                    $tInst2 = $request->input("t_inst{$i}_2");
                    $tInst3 = $request->input("t_inst{$i}_3");
                }
                
                // Ambil data humidity dengan format h_set1, h_std1_1_tab1, dll
                $hSet = $request->input("h_set{$i}");
                $hStd1 = $request->input("h_std{$i}_1{$tabSuffix}");
                $hStd2 = $request->input("h_std{$i}_2{$tabSuffix}");
                $hStd3 = $request->input("h_std{$i}_3{$tabSuffix}");
                $hInst1 = $request->input("h_inst{$i}_1{$tabSuffix}");
                $hInst2 = $request->input("h_inst{$i}_2{$tabSuffix}");
                $hInst3 = $request->input("h_inst{$i}_3{$tabSuffix}");
                
                // Jika tidak ditemukan dengan format _tab, coba tanpa _tab
                if (empty($hStd1) && empty($hStd2) && empty($hStd3)) {
                    $hStd1 = $request->input("h_std{$i}_1");
                    $hStd2 = $request->input("h_std{$i}_2");
                    $hStd3 = $request->input("h_std{$i}_3");
                    $hInst1 = $request->input("h_inst{$i}_1");
                    $hInst2 = $request->input("h_inst{$i}_2");
                    $hInst3 = $request->input("h_inst{$i}_3");
                }
                
                // Cek apakah ada data untuk baris ini
                $hasTempData = !empty($tSet) || !empty($tStd1) || !empty($tStd2) || !empty($tStd3) ||
                              !empty($tInst1) || !empty($tInst2) || !empty($tInst3);
                
                $hasHumidityData = !empty($hSet) || !empty($hStd1) || !empty($hStd2) || !empty($hStd3) ||
                                 !empty($hInst1) || !empty($hInst2) || !empty($hInst3);
                
                if ($hasTempData || $hasHumidityData) {
                    try {
                        \App\Models\DetailThermohygrometer::create([
                            'calibration_id' => $calibration->id,
                            
                            // Data Temperatur
                            'titikUkur_T' => $tSet,
                            'T_STD1' => $tStd1,
                            'T_STD2' => $tStd2,
                            'T_STD3' => $tStd3,
                            'T_IN1' => $tInst1,
                            'T_IN2' => $tInst2,
                            'T_IN3' => $tInst3,
                            'T_OUT1' => null,
                            'T_OUT2' => null,
                            'T_OUT3' => null,
                            
                            // Data Kelembaban
                            'titikUkur_RH' => $hSet,
                            'RH_STD1' => $hStd1,
                            'RH_STD2' => $hStd2,
                            'RH_STD3' => $hStd3,
                            'RH_ALAT1' => $hInst1,
                            'RH_ALAT2' => $hInst2,
                            'RH_ALAT3' => $hInst3,
                        ]);
                        
                        $detailCount++;
                        \Log::debug("✅ Saved SINGLE row {$i}", [
                            't_set' => $tSet,
                            'h_set' => $hSet,
                            'tab_suffix' => $tabSuffix
                        ]);
                        
                    } catch (\Exception $e) {
                        \Log::error("❌ Failed to save SINGLE row {$i}: " . $e->getMessage());
                    }
                } else {
                    \Log::debug("⏭️ Skipping SINGLE row {$i} - no data");
                }
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail records");
        
        // ==================================================================
        // 7. SIMPAN DATA TTD DAN NAMA
        // ==================================================================
        $additionalData = [];
        
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $additionalData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $additionalData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy]);
        }
        
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $additionalData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $additionalData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($alatStandarString)) {
            $additionalData['alat_standar'] = $alatStandarString;
        }
        
        $calibrationMethodReq = $this->getRequestValue($request, 'calibration_method', $tabId);
        if ($calibrationMethodReq) {
            $additionalData['calibration_method'] = $calibrationMethodReq;
        }
        
        if (!empty($additionalData)) {
            $calibration->update($additionalData);
            \Log::info('✅ Additional data saved to calibration');
        }
        
        // ==================================================================
        // 8. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = \App\Models\DetailThermohygrometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Thermohygrometer):', [
            'calibration_id' => $calibration->id,
            'type' => $type,
            'tab_id' => $tabId,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $certificateId,
            'alat_standar' => $alatStandarString,
            'calibration_method' => $calibrationMethod,
        ]);
        
        \Log::info('🎉 storeThermohygrometer COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeThermohygrometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A'
        ]);
        
        throw new \Exception("Gagal menyimpan data Thermohygrometer: " . $e->getMessage());
    }
}
private function updateThermohygrometer($request, $calibration, $certificateId = null)
{
    try {
        \Log::info('🚀 START updateThermohygrometer', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $certificateId
        ]);

        // ==================================================================
        // 1. AMBIL NAMA ALAT BARU DARI REQUEST (name="nama_alat")
        // ==================================================================
        $namaAlatBaru = $request->nama_alat ?? $calibration->namaAlat;
        
        \Log::info('📝 Nama alat untuk Thermohygrometer:', [
            'nama_alat' => $namaAlatBaru,
            'source' => 'nama_alat'
        ]);

        // ==================================================================
        // 2. GENERATE CERTIFICATE ID BARU BERDASARKAN NAMA ALAT
        // ==================================================================
        $finalCertificateId = $certificateId;
        
        // Jika certificateId dari parameter null atau nama alat berubah, generate baru
        if (empty($finalCertificateId) || $finalCertificateId != $calibration->certificate_id) {
            // Generate certificate ID baru berdasarkan nama alat
            $finalCertificateId = $this->generateCertificateIdFromNamaAlat($namaAlatBaru, $calibration);
            
            \Log::info('🆔 Generate certificate ID baru:', [
                'nama_alat' => $namaAlatBaru,
                'certificate_id_baru' => $finalCertificateId
            ]);
        }
        
        // Jika masih kosong, ambil dari calibration
        if (empty($finalCertificateId)) {
            $finalCertificateId = $calibration->certificate_id;
        }
        
        // Jika masih kosong, throw error
        if (empty($finalCertificateId)) {
            throw new \Exception('Certificate ID is required for Thermohygrometer update');
        }

        // ==================================================================
        // 3. UPDATE CERTIFICATE_ID DI TABEL HEAD DAN CALIBRATION
        // ==================================================================
        \Log::info('🔄 Update certificate_id di head_thermohygrometers dan calibration', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $finalCertificateId
        ]);
        
        // Update di head_thermohygrometers
        \App\Models\HeadThermohygrometer::where('calibration_id', $calibration->id)
            ->update(['certificate_id' => $finalCertificateId]);
        
        // Update di tabel calibration
        $calibration->update(['certificate_id' => $finalCertificateId]);
        
        // Update nama alat di calibration jika berbeda
        if ($namaAlatBaru && $calibration->namaAlat !== $namaAlatBaru) {
            $calibration->update(['namaAlat' => $namaAlatBaru]);
            \Log::info('✅ Nama alat diupdate di calibration:', [
                'dari' => $calibration->getOriginal('namaAlat'),
                'menjadi' => $namaAlatBaru
            ]);
        }
        
        \Log::info('✅ Certificate ID updated di head_thermohygrometers dan calibration');

        // ==================================================================
        // 4. TENTUKAN TYPE (IN/OUT atau SINGLE)
        // ==================================================================
        $type = $calibration->type ?? 'single';
        
        if (!in_array($type, ['in_out', 'single'])) {
            $type = 'single';
            \Log::warning('⚠️ Type invalid, set to default: single');
        }
        
        \Log::info('📊 Thermohygrometer type for update:', ['type' => $type]);
        
        // ==================================================================
        // 5. TENTUKAN STANDARD DAN METHOD BERDASARKAN TYPE
        // ==================================================================
        if ($type === 'in_out') {
            $alatStandarString = $request->standard ?? $calibration->headThermohygrometer->standard ?? 'Temperature & Humidity Transmitter, Rotronic, 71946262; 20345594';
            $calibrationMethod = $request->metode ?? $calibration->headThermohygrometer->metode ?? 'PAS-IK1102-50';
            $traceable = $request->traceable ?? $calibration->headThermohygrometer->traceable ?? 'Certus Metrology';
        } else {
            $alatStandarString = $request->standard ?? $calibration->headThermohygrometer->standard ?? 'Temperature & Humidity Transmitter, Rotronic,T017';
            $calibrationMethod = $request->metode ?? $calibration->headThermohygrometer->metode ?? 'PAS-IK1102-50';
            $traceable = $request->traceable ?? $calibration->headThermohygrometer->traceable ?? 'Certus Metrology';
        }
        
        \Log::info('📊 Standard and method for update:', [
            'type' => $type,
            'standard' => $alatStandarString,
            'method' => $calibrationMethod,
            'traceable' => $traceable
        ]);
        
        // ==================================================================
        // 6. UPDATE HEAD THERMOHYGROMETER
        // ==================================================================
        $headData = [
            'certificate_id' => $finalCertificateId,
            'standard' => $alatStandarString,
            'metode' => $calibrationMethod,
            'traceable' => $traceable,
            'calibrated_by' => $request->calibrated_by ?? $calibration->headThermohygrometer->calibrated_by ?? null,
            'verified_by' => $request->verified_by ?? $calibration->headThermohygrometer->verified_by ?? null,
        ];
        
        // Handle TTD upload jika ada
        if ($request->hasFile('ttd_calibrated_by')) {
            $path = $request->file('ttd_calibrated_by')->store('ttd', 'public');
            $headData['ttd_calibrated_by'] = $path;
            \Log::info('📷 Uploaded new ttd_calibrated_by');
        }
        
        if ($request->hasFile('ttd_verified_by')) {
            $path = $request->file('ttd_verified_by')->store('ttd', 'public');
            $headData['ttd_verified_by'] = $path;
            \Log::info('📷 Uploaded new ttd_verified_by');
        }
        
        $headThermohygrometer = \App\Models\HeadThermohygrometer::where('calibration_id', $calibration->id)->first();
        
        if ($headThermohygrometer) {
            $headThermohygrometer->update($headData);
            \Log::info('✅ Updated existing HeadThermohygrometer', [
                'old_certificate_id' => $headThermohygrometer->certificate_id,
                'new_certificate_id' => $finalCertificateId
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $headThermohygrometer = \App\Models\HeadThermohygrometer::create($headData);
            \Log::info('✅ Created new HeadThermohygrometer with certificate_id:', ['certificate_id' => $finalCertificateId]);
        }
        
        // ==================================================================
        // 7. HAPUS DATA DETAIL LAMA
        // ==================================================================
        $existingDetails = \App\Models\DetailThermohygrometer::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            \App\Models\DetailThermohygrometer::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records");
        }
        
        // ==================================================================
        // 8. SIMPAN DETAIL BARU BERDASARKAN TYPE
        // ==================================================================
        \Log::info('📊 Updating Thermohygrometer detail measurements...');
        
        $detailCount = 0;
        
        if ($type === 'in_out') {
            for ($i = 0; $i < 7; $i++) {
                $tempSetPoint = $request->input("temp.{$i}.set_point");
                $tempStdX1 = $request->input("temp.{$i}.std_x1");
                $tempStdX2 = $request->input("temp.{$i}.std_x2");
                $tempStdX3 = $request->input("temp.{$i}.std_x3");
                $tempInX1 = $request->input("temp.{$i}.in_x1");
                $tempInX2 = $request->input("temp.{$i}.in_x2");
                $tempInX3 = $request->input("temp.{$i}.in_x3");
                $tempOutX1 = $request->input("temp.{$i}.out_x1");
                $tempOutX2 = $request->input("temp.{$i}.out_x2");
                $tempOutX3 = $request->input("temp.{$i}.out_x3");
                
                $humiditySetPoint = $request->input("humidity.{$i}.set_point");
                $humidityStdX1 = $request->input("humidity.{$i}.std_x1");
                $humidityStdX2 = $request->input("humidity.{$i}.std_x2");
                $humidityStdX3 = $request->input("humidity.{$i}.std_x3");
                $humidityAlatX1 = $request->input("humidity.{$i}.alat_x1");
                $humidityAlatX2 = $request->input("humidity.{$i}.alat_x2");
                $humidityAlatX3 = $request->input("humidity.{$i}.alat_x3");
                
                $hasTempData = $tempSetPoint !== null || $tempStdX1 !== null || $tempInX1 !== null;
                $hasHumidityData = $humiditySetPoint !== null || $humidityStdX1 !== null || $humidityAlatX1 !== null;
                
                if ($hasTempData || $hasHumidityData) {
                    \App\Models\DetailThermohygrometer::create([
                        'calibration_id' => $calibration->id,
                        'titikUkur_T' => $tempSetPoint,
                        'T_STD1' => $tempStdX1,
                        'T_STD2' => $tempStdX2,
                        'T_STD3' => $tempStdX3,
                        'T_IN1' => $tempInX1,
                        'T_IN2' => $tempInX2,
                        'T_IN3' => $tempInX3,
                        'T_OUT1' => $tempOutX1,
                        'T_OUT2' => $tempOutX2,
                        'T_OUT3' => $tempOutX3,
                        'titikUkur_RH' => $humiditySetPoint,
                        'RH_STD1' => $humidityStdX1,
                        'RH_STD2' => $humidityStdX2,
                        'RH_STD3' => $humidityStdX3,
                        'RH_ALAT1' => $humidityAlatX1,
                        'RH_ALAT2' => $humidityAlatX2,
                        'RH_ALAT3' => $humidityAlatX3,
                    ]);
                    $detailCount++;
                }
            }
            
        } else {
            // SINGLE type - SELALU 10 BARIS
            for ($i = 1; $i <= 10; $i++) {
                \App\Models\DetailThermohygrometer::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur_T' => $request->input("t_set{$i}"),
                    'T_STD1' => $request->input("t_std{$i}_1"),
                    'T_STD2' => $request->input("t_std{$i}_2"),
                    'T_STD3' => $request->input("t_std{$i}_3"),
                    'T_IN1' => $request->input("t_inst{$i}_1"),
                    'T_IN2' => $request->input("t_inst{$i}_2"),
                    'T_IN3' => $request->input("t_inst{$i}_3"),
                    'T_OUT1' => null,
                    'T_OUT2' => null,
                    'T_OUT3' => null,
                    'titikUkur_RH' => $request->input("h_set{$i}"),
                    'RH_STD1' => $request->input("h_std{$i}_1"),
                    'RH_STD2' => $request->input("h_std{$i}_2"),
                    'RH_STD3' => $request->input("h_std{$i}_3"),
                    'RH_ALAT1' => $request->input("h_inst{$i}_1"),
                    'RH_ALAT2' => $request->input("h_inst{$i}_2"),
                    'RH_ALAT3' => $request->input("h_inst{$i}_3"),
                ]);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Updated {$detailCount} detail records");
        
        // ==================================================================
        // 9. UPDATE DATA TAMBAHAN DI CALIBRATION TABLE
        // ==================================================================
        $additionalData = [];
        
        if ($request->filled('calibrated_by')) {
            $additionalData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verified_by')) {
            $additionalData['verified_by'] = $request->verified_by;
        }
        
        if ($request->filled('uncertainty')) {
            $additionalData['uncertainty'] = $request->uncertainty;
            $additionalData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($alatStandarString)) {
            $additionalData['alat_standar'] = $alatStandarString;
        }
        
        if (!empty($additionalData)) {
            $calibration->update($additionalData);
            \Log::info('✅ Additional data updated in calibration');
        }
        
        // ==================================================================
        // 10. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('🎉 updateThermohygrometer COMPLETED', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $finalCertificateId,
            'nama_alat' => $namaAlatBaru,
            'type' => $type,
            'detail_records' => $detailCount,
            'alat_standar' => $alatStandarString,
        ]);
        
        return $headThermohygrometer;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateThermohygrometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A'
        ]);
        
        throw new \Exception("Gagal mengupdate data Thermohygrometer: " . $e->getMessage());
    }
}
            

private function storeViscometer($request, $calibration, $certificateId, $tabId = null)
{
    try {
        \Log::info('🚀 START storeViscometer with tab_id:', ['tab_id' => $tabId]);
        
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR (8 CHECKBOX) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dengan berbagai kemungkinan nama field (dengan dukungan _tab)
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        // Coba juga dengan format array (tanpa _tab)
        $alatStandarArray = $request->input('alat_standar', []);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Viscometer:', [
            'alat_standar' => $alatStandar,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. SIMPAN SATUAN STANDARD DAN SATUAN ALAT - DENGAN DUKUNGAN _tab
        // ==================================================================
        $satuanStd = $this->getRequestValue($request, 'satuan_std', $tabId) ?? '';
        $satuanAlat = $this->getRequestValue($request, 'satuan_alat', $tabId) ?? '';
        
        \Log::info('📏 Satuan:', [
            'satuan_std' => $satuanStd, 
            'satuan_alat' => $satuanAlat,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 3. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE)
        // ==================================================================
        $head = HeadViscometer::where('calibration_id', $calibration->id)->first();
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $alatStandarString,
                'satuan_std' => $satuanStd,
                'satuan_alat' => $satuanAlat,
                'calibrationMethod' => 'PAS-IK1102-43',
            ]);
            \Log::info('✅ HeadViscometer updated:', ['head_id' => $head->id]);
        } else {
            // Buat head baru
            $head = HeadViscometer::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $alatStandarString,
                'satuan_std' => $satuanStd,
                'satuan_alat' => $satuanAlat,
                'calibrationMethod' => 'PAS-IK1102-43',
            ]);
            \Log::info('✅ HeadViscometer created:', ['head_id' => $head->id]);
        }

        // ==================================================================
        // 4. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE)
        // ==================================================================
        $existingDetails = DetailViscometer::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailViscometer::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records");
        }

        // ==================================================================
        // 5. SIMPAN DETAIL MEASUREMENTS (15 BARIS) - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving Viscometer detail measurements (15 rows)...');
        $detailCount = 0;
        
        for ($row = 0; $row < 15; $row++) {
            // Ambil data dari request dengan dukungan _tab
            $titikUkur = $this->getRequestValue($request, "nilai_standard_{$row}", $tabId);
            $spindle = $this->getRequestValue($request, "spindle_{$row}", $tabId);
            $rpm = $this->getRequestValue($request, "rpm_{$row}", $tabId);
            $ulangan01 = $this->getRequestValue($request, "pembacaan_1_{$row}", $tabId);
            $ulangan02 = $this->getRequestValue($request, "pembacaan_2_{$row}", $tabId);
            $ulangan03 = $this->getRequestValue($request, "pembacaan_3_{$row}", $tabId);
            $ulangan04 = $this->getRequestValue($request, "pembacaan_4_{$row}", $tabId);
            $ulangan05 = $this->getRequestValue($request, "pembacaan_5_{$row}", $tabId);
            $resolution = $this->getRequestValue($request, "resolusi_{$row}", $tabId);
            $tAwal = $this->getRequestValue($request, "suhu_awal_{$row}", $tabId);
            $tAkhir = $this->getRequestValue($request, "suhu_akhir_{$row}", $tabId);
            
            // Cek apakah ada data untuk baris ini (minimal satu kolom terisi)
            $hasData = !empty($titikUkur) || !empty($spindle) || !empty($rpm) || 
                      !empty($ulangan01) || !empty($ulangan02) || !empty($ulangan03) ||
                      !empty($ulangan04) || !empty($ulangan05) || !empty($resolution) ||
                      !empty($tAwal) || !empty($tAkhir);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    'spindle' => $spindle,
                    'RPM' => $rpm,
                    'ulangan01' => $ulangan01,
                    'ulangan02' => $ulangan02,
                    'ulangan03' => $ulangan03,
                    'ulangan04' => $ulangan04,
                    'ulangan05' => $ulangan05,
                    'resolution' => $resolution,
                    'T_awal' => $tAwal,
                    'T_akhir' => $tAkhir,
                ];
                
                DetailViscometer::create($detailData);
                $detailCount++;
                
                \Log::debug("📝 Saved Viscometer row {$row}", [
                    'titikUkur' => $titikUkur,
                    'spindle' => $spindle,
                    'RPM' => $rpm,
                    'tab_id' => $tabId
                ]);
            } else {
                \Log::debug("⏭️ Skipping Viscometer row {$row} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Viscometer");

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Nama untuk TTD Dikalibrasi
        $dikalibrasiNama = $this->getRequestValue($request, 'dikalibrasi_nama', $tabId);
        if ($dikalibrasiNama) {
            $updateData['calibrated_by'] = $dikalibrasiNama;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $dikalibrasiNama, 'tab_id' => $tabId]);
        }
        
        // Nama untuk TTD Diperiksa
        $diperiksaNama = $this->getRequestValue($request, 'diperiksa_nama', $tabId);
        if ($diperiksaNama) {
            $updateData['verified_by'] = $diperiksaNama;
            \Log::info('📝 Nama diperiksa:', ['nama' => $diperiksaNama, 'tab_id' => $tabId]);
        }
        
        // TTD Dikalibrasi
        $dikalibrasiTtd = $this->getRequestValue($request, 'dikalibrasi_ttd', $tabId);
        if ($dikalibrasiTtd) {
            \Log::info('✍️ TTD dikalibrasi:', ['ttd' => $dikalibrasiTtd, 'tab_id' => $tabId]);
            if ($head) {
                $head->update(['ttd_kalibrator' => $dikalibrasiTtd]);
            }
        }
        
        // TTD Diperiksa
        $diperiksaTtd = $this->getRequestValue($request, 'diperiksa_ttd', $tabId);
        if ($diperiksaTtd) {
            \Log::info('✍️ TTD diperiksa:', ['ttd' => $diperiksaTtd, 'tab_id' => $tabId]);
            if ($head) {
                $head->update(['ttd_pemeriksa' => $diperiksaTtd]);
            }
        }
        
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Alat standar sudah ditentukan di atas
        if (!empty($alatStandarString)) {
            $updateData['alat_standar'] = $alatStandarString;
        }
        
        $calibrationMethodReq = $this->getRequestValue($request, 'calibration_method', $tabId);
        if ($calibrationMethodReq) {
            $updateData['calibration_method'] = $calibrationMethodReq;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailViscometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Viscometer):', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $certificateId,
            'alat_standar' => $alatStandarString,
            'satuan_std' => $satuanStd,
            'satuan_alat' => $satuanAlat,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 storeViscometer COMPLETED for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeViscometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailViscometer::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Viscometer: " . $e->getMessage());
    }
}

/**
 * Update Viscometer data
 */
private function updateViscometer($request, $calibration, $certificateId = null)
{
    try {
        \Log::info('🚀 START updateViscometer', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $certificateId
        ]);

        // ==================================================================
        // 1. AMBIL NAMA ALAT BARU DARI REQUEST
        // ==================================================================
        $namaAlatBaru = $request->namaAlat ?? $calibration->namaAlat;
        
        \Log::info('📝 Nama alat untuk Viscometer:', [
            'nama_alat' => $namaAlatBaru,
            'source' => 'namaAlat'
        ]);

        // ==================================================================
        // 2. GENERATE CERTIFICATE ID BARU BERDASARKAN NAMA ALAT
        // ==================================================================
        $finalCertificateId = $certificateId;
        
        // Jika certificateId dari parameter null atau nama alat berubah, generate baru
        if (empty($finalCertificateId) || $finalCertificateId != $calibration->certificate_id) {
            // Generate certificate ID baru berdasarkan nama alat
            $finalCertificateId = $this->generateCertificateIdFromNamaAlat($namaAlatBaru, $calibration);
            
            \Log::info('🆔 Generate certificate ID baru:', [
                'nama_alat' => $namaAlatBaru,
                'certificate_id_baru' => $finalCertificateId
            ]);
        }
        
        // Jika masih kosong, ambil dari calibration
        if (empty($finalCertificateId)) {
            $finalCertificateId = $calibration->certificate_id;
        }
        
        // Jika masih kosong, throw error
        if (empty($finalCertificateId)) {
            throw new \Exception('Certificate ID is required for Viscometer update');
        }

        // ==================================================================
        // 3. UPDATE CERTIFICATE_ID DI TABEL HEAD DAN CALIBRATION
        // ==================================================================
        \Log::info('🔄 Update certificate_id di head_viscometers dan calibration', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $finalCertificateId
        ]);
        
        // Update di head_viscometers
        \App\Models\HeadViscometer::where('calibration_id', $calibration->id)
            ->update(['certificate_id' => $finalCertificateId]);
        
        // Update di tabel calibration
        $calibration->update(['certificate_id' => $finalCertificateId]);
        
        // Update nama alat di calibration jika berbeda
        if ($namaAlatBaru && $calibration->namaAlat !== $namaAlatBaru) {
            $calibration->update(['namaAlat' => $namaAlatBaru]);
            \Log::info('✅ Nama alat diupdate di calibration:', [
                'dari' => $calibration->getOriginal('namaAlat'),
                'menjadi' => $namaAlatBaru
            ]);
        }
        
        \Log::info('✅ Certificate ID updated di head_viscometers dan calibration');

        // ==================================================================
        // 4. PROSES ALAT STANDAR (MULTIPLE CHECKBOX)
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        
        // Proses viscosity types jika ada
        $viscosityTypes = $request->viscosity_types ?? [];
        $thermometerTypes = $request->thermometer_types ?? [];
        
        // Gabungkan semua tipe yang dipilih
        $allSelectedTypes = array_merge($viscosityTypes, $thermometerTypes);
        
        // Jika ada alat standar yang dipilih, gabungkan dengan tipe-tipenya
        if (!empty($alatStandar) || !empty($allSelectedTypes)) {
            $alatStandarString = !empty($allSelectedTypes) ? implode(', ', $allSelectedTypes) : implode(', ', $alatStandar);
        } else {
            $alatStandarString = '';
        }
        
        \Log::info('🔧 Alat standar:', ['standard' => $alatStandarString]);

        // ==================================================================
        // 5. UPDATE SATUAN STANDARD DAN SATUAN ALAT
        // ==================================================================
        $satuanStd = $request->satuan_std ?? '';
        $satuanAlat = $request->satuan_alat ?? '';
        $calibrationMethod = $request->calibrationMethod ?? 'PAS-IK1102-43B';
        
        \Log::info('📏 Satuan:', ['satuan_std' => $satuanStd, 'satuan_alat' => $satuanAlat]);

        // ==================================================================
        // 6. UPDATE HEAD VISCOMETER
        // ==================================================================
        if ($head = $calibration->headViscometer) {
            $head->update([
                'certificate_id' => $finalCertificateId,
                'standard' => $alatStandarString,
                'satuan_std' => $satuanStd,
                'satuan_alat' => $satuanAlat,
                'calibrationMethod' => $calibrationMethod,
                'ttd_kalibrator' => $request->ttd_kalibrator ?? $head->ttd_kalibrator,
                'ttd_pemeriksa' => $request->ttd_pemeriksa ?? $head->ttd_pemeriksa,
            ]);
            \Log::info('✅ HeadViscometer updated:', [
                'head_id' => $head->id,
                'certificate_id' => $finalCertificateId
            ]);
        } else {
            // Jika head belum ada, buat baru
            $head = HeadViscometer::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $finalCertificateId,
                'standard' => $alatStandarString,
                'satuan_std' => $satuanStd,
                'satuan_alat' => $satuanAlat,
                'calibrationMethod' => $calibrationMethod,
                'ttd_kalibrator' => $request->ttd_kalibrator ?? null,
                'ttd_pemeriksa' => $request->ttd_pemeriksa ?? null,
            ]);
            \Log::info('➕ HeadViscometer created baru:', [
                'head_id' => $head->id,
                'certificate_id' => $finalCertificateId
            ]);
        }

        // ==================================================================
        // 7. UPDATE DETAIL VISCOMETER (DELETE & RECREATE 15 BARIS)
        // ==================================================================
        // Hapus data detail lama
        $deleted = DetailViscometer::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old details:', ['count' => $deleted]);
        
        $detailCount = 0;
        
        // Proses 15 baris - TANPA formatNumericValue
        for ($row = 0; $row < 15; $row++) {
            // Ambil data dari request sesuai dengan form edit
            $titikUkur = $request->titikUkur[$row] ?? null;
            $spindle = $request->spindle[$row] ?? null;
            $rpm = $request->RPM[$row] ?? null;
            $ulangan01 = $request->ulangan01[$row] ?? null;
            $ulangan02 = $request->ulangan02[$row] ?? null;
            $ulangan03 = $request->ulangan03[$row] ?? null;
            $ulangan04 = $request->ulangan04[$row] ?? null;
            $ulangan05 = $request->ulangan05[$row] ?? null;
            $resolution = $request->resolution[$row] ?? null;
            $tAwal = $request->T_awal[$row] ?? null;
            $tAkhir = $request->T_akhir[$row] ?? null;
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($titikUkur) || !empty($spindle) || !empty($rpm) || 
                      !empty($ulangan01) || !empty($ulangan02) || !empty($ulangan03) ||
                      !empty($ulangan04) || !empty($ulangan05) || !empty($resolution) ||
                      !empty($tAwal) || !empty($tAkhir);
            
            if ($hasData) {
                DetailViscometer::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    'spindle' => $spindle,
                    'RPM' => $rpm,
                    'ulangan01' => $ulangan01,
                    'ulangan02' => $ulangan02,
                    'ulangan03' => $ulangan03,
                    'ulangan04' => $ulangan04,
                    'ulangan05' => $ulangan05,
                    'resolution' => $resolution,
                    'T_awal' => $tAwal,
                    'T_akhir' => $tAkhir,
                ]);
                $detailCount++;
                
                \Log::debug("📝 Saved Viscometer row {$row}", [
                    'titikUkur' => $titikUkur,
                    'spindle' => $spindle,
                    'RPM' => $rpm
                ]);
            }
        }
        
        \Log::info('✅ DetailViscometer updated:', ['total_records' => $detailCount]);

        // ==================================================================
        // 8. LOG HASIL AKHIR
        // ==================================================================
        $finalDetailCount = DetailViscometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Viscometer):', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $finalCertificateId,
            'nama_alat' => $namaAlatBaru,
            'detail_records' => $finalDetailCount,
            'standard' => $alatStandarString,
            'satuan_std' => $satuanStd,
            'satuan_alat' => $satuanAlat,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updateViscometer COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateViscometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function storePushPull($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🚀 START storePushPull with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 0. DEBUG SEMUA INPUT STD (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $debugStd = [];
        for ($i = 1; $i <= 10; $i++) {
            $debugStd["std_{$i}"] = $this->getRequestValue($request, "std_{$i}", $tabId) ?? 'NULL';
        }
        \Log::info('🔍 DEBUG STD INPUTS:', array_merge(['tab_id' => $tabId], $debugStd));

        // ==================================================================
        // 1. PROSES ALAT STANDAR (DENGAN DUKUNGAN _tab)
        // ==================================================================
        // Cek textarea terlebih dahulu
        $textValue = trim($this->getRequestValue($request, 'alat_standar_text', $tabId) ?? '');
        
        // Cek array checkbox
        $arrayValue = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (!is_array($arrayValue)) {
            $arrayValue = $request->input('alat_standar', []);
        }

        if (!empty($textValue)) {
            $standardValue = $textValue; // Prioritas: textarea
        } elseif (is_array($arrayValue) && count($arrayValue) > 0) {
            $standardValue = implode("\n", $arrayValue); // Fallback ke checkbox
        } else {
            $standardValue = '';
        }
        
        \Log::info('🔧 Alat standar selected for Push Pull:', [
            'standard' => $standardValue,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE)
        // ==================================================================
        $head = HeadPushPull::where('calibration_id', $calibration->id)->first();
        
        $satuanTitikUkur = $this->getRequestValue($request, 'satuan_titik_ukur', $tabId);
        $satuanTarik = $this->getRequestValue($request, 'satuan_tarik', $tabId);
        $satuanTekan = $this->getRequestValue($request, 'satuan_tekan', $tabId);
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $standardValue,
                'calibrationMethod' => 'PAS-IK1102-34',
                'satuan_titik_ukur' => $satuanTitikUkur,
                'satuan_tarik' => $satuanTarik,
                'satuan_tekan' => $satuanTekan,
            ]);
            \Log::info('✅ HeadPushPull updated:', ['head_id' => $head->id, 'tab_id' => $tabId]);
        } else {
            // Buat head baru
            $head = HeadPushPull::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $standardValue,
                'calibrationMethod' => 'PAS-IK1102-34',
                'satuan_titik_ukur' => $satuanTitikUkur,
                'satuan_tarik' => $satuanTarik,
                'satuan_tekan' => $satuanTekan,
            ]);
            \Log::info('✅ HeadPushPull created:', ['head_id' => $head->id, 'tab_id' => $tabId]);
        }

        // ==================================================================
        // 3. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE)
        // ==================================================================
        $existingDetails = DetailPushPull::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailPushPull::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records");
        }
        
        $existingAddData = AddPushPull::where('calibration_id', $calibration->id)->count();
        if ($existingAddData > 0) {
            AddPushPull::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingAddData} old add data records");
        }

        // ==================================================================
        // 4. SIMPAN DETAIL MEASUREMENTS (10 BARIS) - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving DetailPushPull detail measurements...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 10; $i++) {
            // Ambil data dengan dukungan _tab
            $titikUkur = $this->getRequestValue($request, "titik_ukur_{$i}", $tabId);
            $std = $this->getRequestValue($request, "std_{$i}", $tabId);
            
            // Data tarik
            $tarik01 = $this->getRequestValue($request, "tarik_{$i}_1", $tabId);
            $tarik02 = $this->getRequestValue($request, "tarik_{$i}_2", $tabId);
            $tarik03 = $this->getRequestValue($request, "tarik_{$i}_3", $tabId);
            
            // Data tekan
            $tekan01 = $this->getRequestValue($request, "tekan_{$i}_1", $tabId);
            $tekan02 = $this->getRequestValue($request, "tekan_{$i}_2", $tabId);
            $tekan03 = $this->getRequestValue($request, "tekan_{$i}_3", $tabId);
            
            // Debug setiap baris
            \Log::debug("📝 Row {$i} raw data (tab {$tabId}):", [
                'titik_ukur' => $titikUkur,
                'std' => $std,
                'tarik01' => $tarik01,
                'tarik02' => $tarik02,
                'tarik03' => $tarik03,
                'tekan01' => $tekan01,
                'tekan02' => $tekan02,
                'tekan03' => $tekan03,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($titikUkur) || !empty($std) || 
                      !empty($tarik01) || !empty($tarik02) || !empty($tarik03) || 
                      !empty($tekan01) || !empty($tekan02) || !empty($tekan03);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    'STD' => $std,
                    'ulanganTarik01' => $tarik01,
                    'ulanganTarik02' => $tarik02,
                    'ulanganTarik03' => $tarik03,
                    'ulanganTekan01' => $tekan01,
                    'ulanganTekan02' => $tekan02,
                    'ulanganTekan03' => $tekan03,
                ];

                // Debug sebelum menyimpan
                \Log::debug("💾 Saving row {$i}:", $detailData);
                
                // Simpan
                $detailRecord = DetailPushPull::create($detailData);
                $detailCount++;
                
                // Debug setelah menyimpan
                \Log::debug("✅ Saved row {$i}, ID: {$detailRecord->id}", [
                    'saved_STD' => $detailRecord->STD,
                    'saved_titikUkur' => $detailRecord->titikUkur
                ]);
            } else {
                \Log::debug("⏭️ Skipping row {$i} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Push Pull");

        // ==================================================================
        // 5. VERIFIKASI DATA YANG DISIMPAN
        // ==================================================================
        $savedDetails = DetailPushPull::where('calibration_id', $calibration->id)->get();
        
        \Log::info('🔎 VERIFICATION - Saved details:', [
            'total_saved' => $savedDetails->count(),
            'tab_id' => $tabId,
            'data_sample' => $savedDetails->take(3)->map(function($item) {
                return [
                    'id' => $item->id,
                    'titikUkur' => $item->titikUkur,
                    'STD' => $item->STD,
                    'ulanganTarik01' => $item->ulanganTarik01,
                    'created_at' => $item->created_at
                ];
            })->toArray(),
            'all_STD_values' => $savedDetails->pluck('STD')->toArray()
        ]);

        // ==================================================================
        // 6. SIMPAN ADD PUSH PULL (REPEATABILITY) - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving AddPushPull data (repeatability)...');
        
        $addData = [
            'calibration_id' => $calibration->id,
            
            // Repeatability Tarik
            'repeatabilityTarik01' => $this->getRequestValue($request, 'repeat_tarik_1', $tabId),
            'repeatabilityTarik02' => $this->getRequestValue($request, 'repeat_tarik_2', $tabId),
            'repeatabilityTarik03' => $this->getRequestValue($request, 'repeat_tarik_3', $tabId),
            'repeatabilityTarik04' => $this->getRequestValue($request, 'repeat_tarik_4', $tabId),
            'repeatabilityTarik05' => $this->getRequestValue($request, 'repeat_tarik_5', $tabId),
            'repeatabilityTarik06' => $this->getRequestValue($request, 'repeat_tarik_6', $tabId),
            'repeatabilityTarik07' => $this->getRequestValue($request, 'repeat_tarik_7', $tabId),
            'repeatabilityTarik08' => $this->getRequestValue($request, 'repeat_tarik_8', $tabId),
            'repeatabilityTarik09' => $this->getRequestValue($request, 'repeat_tarik_9', $tabId),
            'repeatabilityTarik10' => $this->getRequestValue($request, 'repeat_tarik_10', $tabId),
            
            // Repeatability Tekan
            'repeatabilityTekan01' => $this->getRequestValue($request, 'repeat_tekan_1', $tabId),
            'repeatabilityTekan02' => $this->getRequestValue($request, 'repeat_tekan_2', $tabId),
            'repeatabilityTekan03' => $this->getRequestValue($request, 'repeat_tekan_3', $tabId),
            'repeatabilityTekan04' => $this->getRequestValue($request, 'repeat_tekan_4', $tabId),
            'repeatabilityTekan05' => $this->getRequestValue($request, 'repeat_tekan_5', $tabId),
            'repeatabilityTekan06' => $this->getRequestValue($request, 'repeat_tekan_6', $tabId),
            'repeatabilityTekan07' => $this->getRequestValue($request, 'repeat_tekan_7', $tabId),
            'repeatabilityTekan08' => $this->getRequestValue($request, 'repeat_tekan_8', $tabId),
            'repeatabilityTekan09' => $this->getRequestValue($request, 'repeat_tekan_9', $tabId),
            'repeatabilityTekan10' => $this->getRequestValue($request, 'repeat_tekan_10', $tabId),
        ];
        
        // Cek data untuk disimpan
        $hasAddData = false;
        foreach ($addData as $key => $value) {
            if (!in_array($key, ['calibration_id']) && $value !== null && $value !== '') {
                $hasAddData = true;
                break;
            }
        }
        
        if ($hasAddData) {
            $addRecord = AddPushPull::create($addData);
            \Log::info('✅ AddPushPull saved:', ['add_id' => $addRecord->id, 'tab_id' => $tabId]);
        } else {
            \Log::info('⚠️ No AddPushPull data to save');
        }

        // ==================================================================
        // 7. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Calibrated by
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy, 'tab_id' => $tabId]);
        }
        
        // Verified by
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy, 'tab_id' => $tabId]);
        }
        
        // Alat standar
        if (!empty($standardValue)) {
            $updateData['alat_standar'] = $standardValue;
        }
        
        // Calibration method
        $calibrationMethodReq = $this->getRequestValue($request, 'calibration_method', $tabId);
        if ($calibrationMethodReq) {
            $updateData['calibration_method'] = $calibrationMethodReq;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }

        // ==================================================================
        // 8. FINAL VERIFICATION
        // ==================================================================
        $allDetails = DetailPushPull::where('calibration_id', $calibration->id)->get();
        
        \Log::info('🏁 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId,
            'total_details' => $allDetails->count(),
            'STD_values' => $allDetails->pluck('STD')->toArray(),
            'first_record_full' => $allDetails->first() ? $allDetails->first()->toArray() : null
        ]);

        \Log::info('🎉 storePushPull COMPLETED for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storePushPull:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal menyimpan data Push Pull: " . $e->getMessage());
    }
}
private function updatePushPull($request, $calibration, $certificateId = null)
{
    try {
        \Log::info('🚀 START updatePushPull', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $certificateId
        ]);

        // ==================================================================
        // 1. AMBIL NAMA ALAT BARU DARI REQUEST
        // ==================================================================
        $namaAlatBaru = $request->namaAlat ?? $calibration->namaAlat;
        
        \Log::info('📝 Nama alat untuk Push Pull:', [
            'nama_alat' => $namaAlatBaru,
            'source' => 'namaAlat'
        ]);

        // ==================================================================
        // 2. GENERATE CERTIFICATE ID BARU BERDASARKAN NAMA ALAT
        // ==================================================================
        $finalCertificateId = $certificateId;
        
        // Jika certificateId dari parameter null atau nama alat berubah, generate baru
        if (empty($finalCertificateId) || $finalCertificateId != $calibration->certificate_id) {
            // Generate certificate ID baru berdasarkan nama alat
            $finalCertificateId = $this->generateCertificateIdFromNamaAlat($namaAlatBaru, $calibration);
            
            \Log::info('🆔 Generate certificate ID baru:', [
                'nama_alat' => $namaAlatBaru,
                'certificate_id_baru' => $finalCertificateId
            ]);
        }
        
        // Jika masih kosong, ambil dari calibration
        if (empty($finalCertificateId)) {
            $finalCertificateId = $calibration->certificate_id;
        }
        
        // Jika masih kosong, throw error
        if (empty($finalCertificateId)) {
            throw new \Exception('Certificate ID is required for Push Pull update');
        }

        // ==================================================================
        // 3. UPDATE CERTIFICATE_ID DI TABEL HEAD DAN CALIBRATION
        // ==================================================================
        \Log::info('🔄 Update certificate_id di head_pushpulls dan calibration', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $finalCertificateId
        ]);
        
        // Update di head_pushpulls
        \App\Models\HeadPushPull::where('calibration_id', $calibration->id)
            ->update(['certificate_id' => $finalCertificateId]);
        
        // Update di tabel calibration
        $calibration->update(['certificate_id' => $finalCertificateId]);
        
        // Update nama alat di calibration jika berbeda
        if ($namaAlatBaru && $calibration->namaAlat !== $namaAlatBaru) {
            $calibration->update(['namaAlat' => $namaAlatBaru]);
            \Log::info('✅ Nama alat diupdate di calibration:', [
                'dari' => $calibration->getOriginal('namaAlat'),
                'menjadi' => $namaAlatBaru
            ]);
        }
        
        \Log::info('✅ Certificate ID updated di head_pushpulls dan calibration');

        // ==================================================================
        // 4. UPDATE HEAD PUSH PULL (termasuk satuan)
        // ==================================================================
        $head = HeadPushPull::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'certificate_id' => $finalCertificateId,
            'standard' => $request->standard ?? '',
            'satuanTarik' => $request->satuan_tarik ?? 'N',
            'satuanTekan' => $request->satuan_tekan ?? 'N',
            'satuanTitikUkur' => $request->satuan_titik_ukur ?? 'N',
            'calibrationMethod' => 'PAS-IK1102-34',
        ];
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadPushpull updated:', [
                'head_id' => $head->id,
                'certificate_id' => $finalCertificateId
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadPushPull::create($headData);
            \Log::info('➕ HeadPushPull created:', [
                'head_id' => $head->id,
                'certificate_id' => $finalCertificateId
            ]);
        }

        // ==================================================================
        // 5. UPDATE DETAIL PUSH PULL (TANPA formatNumericValue)
        // ==================================================================
        // Hapus data detail lama
        DetailPushpull::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        // Ambil data dari request (dalam bentuk array)
        $titikUkurArray = $request->input('titikUkur', []);
        $stdArray = $request->input('STD', []);
        $ulanganTarik01Array = $request->input('ulanganTarik01', []);
        $ulanganTarik02Array = $request->input('ulanganTarik02', []);
        $ulanganTarik03Array = $request->input('ulanganTarik03', []);
        $ulanganTekan01Array = $request->input('ulanganTekan01', []);
        $ulanganTekan02Array = $request->input('ulanganTekan02', []);
        $ulanganTekan03Array = $request->input('ulanganTekan03', []);
        
        // Proses maksimal 10 baris
        for ($i = 0; $i < 10; $i++) {
            $titikUkur = $titikUkurArray[$i] ?? null;
            $std = $stdArray[$i] ?? null;
            
            // Data tarik (pull)
            $tarik01 = $ulanganTarik01Array[$i] ?? null;
            $tarik02 = $ulanganTarik02Array[$i] ?? null;
            $tarik03 = $ulanganTarik03Array[$i] ?? null;
            
            // Data tekan (push)
            $tekan01 = $ulanganTekan01Array[$i] ?? null;
            $tekan02 = $ulanganTekan02Array[$i] ?? null;
            $tekan03 = $ulanganTekan03Array[$i] ?? null;
            
            // Cek apakah ada data (tidak kosong)
            $hasData = !empty($titikUkur) || !empty($std) || 
                      !empty($tarik01) || !empty($tarik02) || !empty($tarik03) ||
                      !empty($tekan01) || !empty($tekan02) || !empty($tekan03);
            
            if ($hasData) {
                DetailPushpull::create([
                    'calibration_id' => $calibration->id,
                    'head_pushpull_id' => $head->id,
                    'titikUkur' => $titikUkur,  // LANGSUNG tanpa formatNumericValue
                    'STD' => $std,
                    'ulanganTarik01' => $tarik01,  // LANGSUNG tanpa formatNumericValue
                    'ulanganTarik02' => $tarik02,  // LANGSUNG tanpa formatNumericValue
                    'ulanganTarik03' => $tarik03,  // LANGSUNG tanpa formatNumericValue
                    'ulanganTekan01' => $tekan01,  // LANGSUNG tanpa formatNumericValue
                    'ulanganTekan02' => $tekan02,  // LANGSUNG tanpa formatNumericValue
                    'ulanganTekan03' => $tekan03,  // LANGSUNG tanpa formatNumericValue
                ]);
                $detailCount++;
            }
        }
        
        \Log::info('✅ DetailPushpull updated:', ['total_records' => $detailCount]);

        // ==================================================================
        // 6. UPDATE ADD PUSH PULL (repeatability) - TANPA formatNumericValue
        // ==================================================================
        $addPushpull = AddPushpull::where('calibration_id', $calibration->id)->first();
        
        // Data repeatability dari request - LANGSUNG tanpa formatNumericValue
        $addData = [
            'repeatabilityTarik01' => $request->repeatabilityTarik01 ?? null,
            'repeatabilityTarik02' => $request->repeatabilityTarik02 ?? null,
            'repeatabilityTarik03' => $request->repeatabilityTarik03 ?? null,
            'repeatabilityTarik04' => $request->repeatabilityTarik04 ?? null,
            'repeatabilityTarik05' => $request->repeatabilityTarik05 ?? null,
            'repeatabilityTarik06' => $request->repeatabilityTarik06 ?? null,
            'repeatabilityTarik07' => $request->repeatabilityTarik07 ?? null,
            'repeatabilityTarik08' => $request->repeatabilityTarik08 ?? null,
            'repeatabilityTarik09' => $request->repeatabilityTarik09 ?? null,
            'repeatabilityTarik10' => $request->repeatabilityTarik10 ?? null,
            
            'repeatabilityTekan01' => $request->repeatabilityTekan01 ?? null,
            'repeatabilityTekan02' => $request->repeatabilityTekan02 ?? null,
            'repeatabilityTekan03' => $request->repeatabilityTekan03 ?? null,
            'repeatabilityTekan04' => $request->repeatabilityTekan04 ?? null,
            'repeatabilityTekan05' => $request->repeatabilityTekan05 ?? null,
            'repeatabilityTekan06' => $request->repeatabilityTekan06 ?? null,
            'repeatabilityTekan07' => $request->repeatabilityTekan07 ?? null,
            'repeatabilityTekan08' => $request->repeatabilityTekan08 ?? null,
            'repeatabilityTekan09' => $request->repeatabilityTekan09 ?? null,
            'repeatabilityTekan10' => $request->repeatabilityTekan10 ?? null,
        ];
        
        // Cek apakah ada data repeatability yang terisi
        $hasAddData = false;
        foreach ($addData as $value) {
            if ($value !== null && $value !== '') {
                $hasAddData = true;
                break;
            }
        }
        
        if ($hasAddData) {
            if ($addPushpull) {
                $addPushpull->update($addData);
                \Log::info('✅ AddPushpull updated');
            } else {
                $addData['calibration_id'] = $calibration->id;
                AddPushpull::create($addData);
                \Log::info('➕ AddPushpull created');
            }
        }

        // ==================================================================
        // 7. UPDATE CALIBRATION (verified_by, calibrated_by)
        // ==================================================================
        $updateCalibration = [];
        
        if ($request->filled('calibratedBy')) {
            $updateCalibration['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateCalibration['verified_by'] = $request->verifiedBy;
        }
        
        if (!empty($updateCalibration)) {
            $calibration->update($updateCalibration);
            \Log::info('✅ Calibration updated with user data');
        }

        // ==================================================================
        // 8. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('📋 UPDATE SUMMARY (Push Pull):', [
            'calibration_id' => $calibration->id,
            'certificate_id' => $finalCertificateId,
            'nama_alat' => $namaAlatBaru,
            'detail_records' => $detailCount,
            'satuan_tarik' => $headData['satuanTarik'],
            'satuan_tekan' => $headData['satuanTekan'],
            'satuan_titik_ukur' => $headData['satuanTitikUkur'],
        ]);

        \Log::info('🎉 updatePushPull COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePushPull:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}


private function storeTimbangan($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1)
{
    \Log::info('🚀 ===== START storeTimbangan =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm
    ]);
    
    try {
        // ==================================================================
        // 1. KONFIGURASI MULTIPLE FORM & TAB
        // ==================================================================
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        // Ambil tab_id untuk mendukung multiple tab dalam satu form
        $tabId = $request->input('tab_id', 1);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. AMBIL ALAT STANDAR DARI FORM 1
        // ==================================================================
        $alatStandar = [];
        
        // Coba dengan getRequestValue dulu
        $alatStandarValue = $this->getRequestValue($request, 'alat_standar', 1);
        if (is_array($alatStandarValue) && !empty($alatStandarValue)) {
            $alatStandar = $alatStandarValue;
        }
        
        // Jika tidak ditemukan, coba dari form_1_alat_standar[]
        if (empty($alatStandar)) {
            foreach ($request->all() as $key => $value) {
                if (strpos($key, 'form_1_alat_standar[]') !== false) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        // Jika masih tidak ditemukan, coba dari form_1_alat_standar (tanpa [])
        if (empty($alatStandar)) {
            $form1AlatStandar = $request->input('form_1_alat_standar');
            if (is_array($form1AlatStandar)) {
                $alatStandar = $form1AlatStandar;
            }
        }
        
        // Cek textarea alat standar
        $textValue = trim($this->getRequestValue($request, 'alat_standar_text', 1) ?? '');
        if (!empty($textValue)) {
            $standardValue = $textValue;
        } else {
            $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        }
        
        \Log::info('📋 Alat Standar:', ['standard_value' => $standardValue]);
        
        // ==================================================================
        // 3. LOOPING UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📝 Processing form {$formIndex}");
            
            // ==============================================================
            // 3.1. AMBIL DATA UNTUK FORM INI (DENGAN DUKUNGAN TAB)
            // ==============================================================
            $prefix = $isMultipleSubmit ? "form_{$formIndex}_" : "";
            
            // Gunakan getRequestValue dengan mempertimbangkan prefix dan tab
            $setengahKapasitas = $this->getRequestValueWithPrefix($request, $prefix . "setengah_kapasitas", $formIndex, $tabId);
            $kapasitasMax = $this->getRequestValueWithPrefix($request, $prefix . "kapasitas_max", $formIndex, $tabId);
            $catatanPenting = $this->getRequestValueWithPrefix($request, $prefix . "catatan_penting", $formIndex, $tabId);
            $calibrationMethod = $this->getRequestValueWithPrefix($request, $prefix . "calibration_method", $formIndex, $tabId);
            
            // ==============================================================
            // 3.2. SIMPAN HEAD TIMBANGAN
            // ==============================================================
            $head = HeadTimbangan::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'standard' => $standardValue,
                    'calibrationMethod' => $calibrationMethod ?? 'PAS-IK1102-15 (Monograph 4 : The Calibration of Weights and Balances, NMI Australia 2010)',
                    'note' => $catatanPenting,
                    'kapasitas_max' => $kapasitasMax,
                    'setengah_kapasitas' => $setengahKapasitas,
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id,
                ]
            );
            \Log::info("✅ HeadTimbangan saved for form {$formIndex}", ['head_id' => $head->id]);
            
            // ==============================================================
            // 3.3. HAPUS DETAIL LAMA (UNTUK UPDATE)
            // ==============================================================
            $existingDetails = DetailTimbangan::where('calibration_id', $calibration->id)
                                              ->where('form_index', $formIndex)
                                              ->count();
            if ($existingDetails > 0) {
                DetailTimbangan::where('calibration_id', $calibration->id)
                              ->where('form_index', $formIndex)
                              ->delete();
                \Log::info("🔄 Deleted {$existingDetails} old detail records for form {$formIndex}");
            }
            
            // ==============================================================
            // 3.4. SIMPAN DETAIL TIMBANGAN (10 baris)
            // ==============================================================
            for ($row = 1; $row <= 10; $row++) {
                // Ambil data untuk baris ini dengan getRequestValue
                if ($isMultipleSubmit) {
                    $skalaNominal = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_skala_nominal_{$formIndex}_{$row}", null, $tabId);
                    $Lz1 = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_z1_1_{$formIndex}_{$row}", null, $tabId);
                    $Lm1 = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_m1_1_{$formIndex}_{$row}", null, $tabId);
                    $Rm1 = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_m1_2_{$formIndex}_{$row}", null, $tabId);
                    $Rz1 = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_z1_2_{$formIndex}_{$row}", null, $tabId);
                    $STD = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_standar_{$formIndex}_{$row}", null, $tabId);
                } else {
                    $skalaNominal = $this->getRequestValueWithPrefix($request, "skala_nominal_{$formIndex}_{$row}", null, $tabId);
                    $Lz1 = $this->getRequestValueWithPrefix($request, "z1_1_{$formIndex}_{$row}", null, $tabId);
                    $Lm1 = $this->getRequestValueWithPrefix($request, "m1_1_{$formIndex}_{$row}", null, $tabId);
                    $Rm1 = $this->getRequestValueWithPrefix($request, "m1_2_{$formIndex}_{$row}", null, $tabId);
                    $Rz1 = $this->getRequestValueWithPrefix($request, "z1_2_{$formIndex}_{$row}", null, $tabId);
                    $STD = $this->getRequestValueWithPrefix($request, "standar_{$formIndex}_{$row}", null, $tabId);
                }
                
                // Log untuk debugging (hanya 2 baris pertama)
                if ($row <= 2) {
                    \Log::debug("Form {$formIndex} Row {$row} data (tab {$tabId}):", [
                        'skala_nominal' => $skalaNominal,
                        'Lz1' => $Lz1,
                        'Lm1' => $Lm1,
                        'Rm1' => $Rm1,
                        'Rz1' => $Rz1,
                        'STD' => $STD
                    ]);
                }
                
                $hasData = !empty($skalaNominal) || !empty($STD) || 
                          !empty($Lm1) || !empty($Lz1) || 
                          !empty($Rm1) || !empty($Rz1);
                
                if ($hasData) {
                    DetailTimbangan::create([
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'head_timbangan_id' => $head->id,
                        'titikUkur' => $skalaNominal,
                        'Lz1' => $Lz1,
                        'Lm1' => $Lm1,
                        'Rm1' => $Rm1,
                        'Rz1' => $Rz1,
                        'STD' => $STD,
                    ]);
                    \Log::debug("✅ DetailTimbangan saved for form {$formIndex}, row {$row}");
                }
            }
            
            // ==============================================================
            // 3.5. HAPUS ADD DATA LAMA (UNTUK UPDATE)
            // ==============================================================
            $existingAddData = AddTimbangan::where('calibration_id', $calibration->id)
                                           ->where('form_index', $formIndex)
                                           ->count();
            if ($existingAddData > 0) {
                AddTimbangan::where('calibration_id', $calibration->id)
                            ->where('form_index', $formIndex)
                            ->delete();
                \Log::info("🔄 Deleted {$existingAddData} old add data records for form {$formIndex}");
            }
            
            // ==============================================================
            // 3.6. SIMPAN ADD TIMBANGAN (Repeatability & OffCenter)
            // ==============================================================
            $addData = [
                'calibration_id' => $calibration->id,
                'form_index' => $formIndex,
            ];
            
            for ($i = 1; $i <= 10; $i++) {
                if ($isMultipleSubmit) {
                    $addData["HalfMax_z1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_setengah_z1_{$formIndex}_{$i}", null, $tabId);
                    $addData["HalfMax_m1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_setengah_m1_{$formIndex}_{$i}", null, $tabId);
                    $addData["FullMax_z1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_kapasitas_z1_{$formIndex}_{$i}", null, $tabId);
                    $addData["FullMax_m1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_kapasitas_m1_{$formIndex}_{$i}", null, $tabId);
                } else {
                    $addData["HalfMax_z1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "setengah_z1_{$formIndex}_{$i}", null, $tabId);
                    $addData["HalfMax_m1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "setengah_m1_{$formIndex}_{$i}", null, $tabId);
                    $addData["FullMax_z1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "kapasitas_z1_{$formIndex}_{$i}", null, $tabId);
                    $addData["FullMax_m1_" . sprintf("%02d", $i)] = $this->getRequestValueWithPrefix($request, "kapasitas_m1_{$formIndex}_{$i}", null, $tabId);
                }
            }
            
            // Off Center Data
            if ($isMultipleSubmit) {
                $addData['bebanOffCenter'] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_beban_timbangan_{$formIndex}", null, $tabId);
                $addData['offCenterMiddle'] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_beban_tengah_{$formIndex}", null, $tabId);
                $addData['offCenterFront'] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_beban_depan_{$formIndex}", null, $tabId);
                $addData['offCenterBack'] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_beban_belakang_{$formIndex}", null, $tabId);
                $addData['offCenterRight'] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_beban_kanan_{$formIndex}", null, $tabId);
                $addData['offCenterLeft'] = $this->getRequestValueWithPrefix($request, "form_{$formIndex}_beban_kiri_{$formIndex}", null, $tabId);
            } else {
                $addData['bebanOffCenter'] = $this->getRequestValueWithPrefix($request, "beban_timbangan_{$formIndex}", null, $tabId);
                $addData['offCenterMiddle'] = $this->getRequestValueWithPrefix($request, "beban_tengah_{$formIndex}", null, $tabId);
                $addData['offCenterFront'] = $this->getRequestValueWithPrefix($request, "beban_depan_{$formIndex}", null, $tabId);
                $addData['offCenterBack'] = $this->getRequestValueWithPrefix($request, "beban_belakang_{$formIndex}", null, $tabId);
                $addData['offCenterRight'] = $this->getRequestValueWithPrefix($request, "beban_kanan_{$formIndex}", null, $tabId);
                $addData['offCenterLeft'] = $this->getRequestValueWithPrefix($request, "beban_kiri_{$formIndex}", null, $tabId);
            }
            
            AddTimbangan::create($addData);
            \Log::info("✅ AddTimbangan saved for form {$formIndex}");
        }
        
        // ==================================================================
        // 4. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD)
        // ==================================================================
        $updateData = [];
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Calibrated by
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy, 'tab_id' => $tabId]);
        }
        
        // Verified by
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy, 'tab_id' => $tabId]);
        }
        
        // Alat standar
        if (!empty($standardValue)) {
            $updateData['alat_standar'] = $standardValue;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }
        
        // Update jumlah form
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        \Log::info('✅ storeTimbangan completed successfully');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeTimbangan FAILED:', [
            'message' => $e->getMessage(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

/**
 * Helper function untuk mengambil nilai request dengan mempertimbangkan prefix dan tab
 */
private function getRequestValueWithPrefix($request, $baseKey, $formIndex = null, $tabId = null)
{
    // Coba dengan format yang paling spesifik dulu
    $possibleKeys = [];
    
    if ($formIndex !== null && $tabId !== null) {
        $possibleKeys[] = $baseKey . "_{$formIndex}_tab{$tabId}";
        $possibleKeys[] = $baseKey . "_tab{$tabId}_{$formIndex}";
        $possibleKeys[] = $baseKey . "_{$formIndex}";
    }
    
    if ($tabId !== null) {
        $possibleKeys[] = $baseKey . "_tab{$tabId}";
    }
    
    $possibleKeys[] = $baseKey;
    
    foreach ($possibleKeys as $key) {
        $value = $request->input($key);
        if ($value !== null && $value !== '') {
            return $value;
        }
    }
    
    return null;
}

private function updateTimbangan($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateTimbangan =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. AMBIL JUMLAH FORM
        // ==================================================================
        $jumlahForm = $calibration->jumlah_form ?? 1;
        $jumlahForm = max(1, $jumlahForm);
        
        // ==================================================================
        // 1. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        $namaAlatDariRequest = $request->namaAlat ?? $calibration->namaAlat;
        $headTimbangan = $calibration->headTimbangan;
        $currentCertificateId = $headTimbangan->certificate_id ?? null;
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        } elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        }
        
        // ==================================================================
        // 2. PROSES ALAT STANDAR (HANYA DARI FORM 1)
        // ==================================================================
        $alatStandar = $request->input('alat_standar', []);
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandar]);
        
        // ==================================================================
        // 3. LOOP UNTUK SETIAP FORM (1 - jumlahForm)
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $isFirstForm = ($formIndex == 1);
            \Log::info("📝 Processing Form {$formIndex}");
            
            // ==============================================================
            // 3a. UPDATE HEAD TIMBANGAN PER FORM
            // ==============================================================
            $head = $calibration->headTimbangan()->where('form_index', $formIndex)->first();
            
            $headData = [
                'form_index' => $formIndex,
                'satuan_unit' => $request->input("satuan_unit_{$formIndex}", 'mm'),
                'note' => $request->input("catatan_penting_{$formIndex}"), // CATATAN PENTING PER FORM
                'standard' => $alatStandarString, // SEMUA FORM PAKAI STANDAR YANG SAMA
                'calibrated_by' => $request->input('calibratedBy', $request->calibrated_by ?? null),
                'verified_by' => $request->input('verifiedBy', $request->verified_by ?? null),
                'setengah_kapasitas' => $request->input("setengah_kap_max_{$formIndex}"),
                'kapasitas_max' => $request->input("kapasitas_max_{$formIndex}"),
            ];
            
            // Hanya form 1 yang dapat mengupdate certificate_id
            if ($isFirstForm && $certificateIdUpdated && !empty($certificateIdBaru)) {
                $headData['certificate_id'] = $certificateIdBaru;
            } elseif ($isFirstForm && $newCertificateId && !$certificateIdUpdated) {
                $headData['certificate_id'] = $newCertificateId;
            }
            
            if ($head) {
                $head->update($headData);
                \Log::info("✅ HeadTimbangan Form {$formIndex} updated", [
                    'note' => $headData['note'] ?? null,
                    'setengah_kapasitas' => $headData['setengah_kapasitas'] ?? null,
                    'kapasitas_max' => $headData['kapasitas_max'] ?? null,
                ]);
            } else {
                $headData['calibration_id'] = $calibration->id;
                $head = HeadTimbangan::create($headData);
                \Log::info("➕ HeadTimbangan Form {$formIndex} created");
            }
            
            // ==============================================================
            // 3b. UPDATE DETAIL TIMBANGAN PER FORM (DELETE & RECREATE - 10 BARIS)
            // ==============================================================
            DetailTimbangan::where('calibration_id', $calibration->id)
                ->where('form_index', $formIndex)
                ->delete();
            
            $detailCount = 0;
            
            // Ambil data array dari request
            $titikUkurArray = $request->input("titikUkur_{$formIndex}", []);
            $Lz1Array = $request->input("Lz1_{$formIndex}", []);
            $Lm1Array = $request->input("Lm1_{$formIndex}", []);
            $Rm1Array = $request->input("Rm1_{$formIndex}", []);
            $Rz1Array = $request->input("Rz1_{$formIndex}", []);
            $STDArray = $request->input("STD_{$formIndex}", []);
            
            for ($i = 0; $i < 10; $i++) {
                $titikUkur = $titikUkurArray[$i] ?? null;
                $Lz1 = $Lz1Array[$i] ?? null;
                $Lm1 = $Lm1Array[$i] ?? null;
                $Rm1 = $Rm1Array[$i] ?? null;
                $Rz1 = $Rz1Array[$i] ?? null;
                $STD = $STDArray[$i] ?? null;
                
                $hasData = !empty($titikUkur) || !empty($Lz1) || !empty($Lm1) || 
                          !empty($Rm1) || !empty($Rz1) || !empty($STD);
                
                if ($hasData) {
                    DetailTimbangan::create([
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'titikUkur' => $titikUkur,
                        'Lz1' => $Lz1,
                        'Lm1' => $Lm1,
                        'Rm1' => $Rm1,
                        'Rz1' => $Rz1,
                        'STD' => $STD,
                    ]);
                    $detailCount++;
                }
            }
            
            \Log::info("✅ DetailTimbangan Form {$formIndex} updated", ['records' => $detailCount]);
            
            // ==============================================================
            // 3c. UPDATE ADD TIMBANGAN PER FORM (REPEATABILITY & OFF CENTER)
            // ==============================================================
            $addTimbangan = $calibration->addTimbangan()->where('form_index', $formIndex)->first();
            
            $addUpdateData = [
                'form_index' => $formIndex,
                
                // Setengah Kap. Max - Penunjukan z1
                'HalfMax_z1_01' => $request->input("setengah_z1_{$formIndex}_1"),
                'HalfMax_z1_02' => $request->input("setengah_z1_{$formIndex}_2"),
                'HalfMax_z1_03' => $request->input("setengah_z1_{$formIndex}_3"),
                'HalfMax_z1_04' => $request->input("setengah_z1_{$formIndex}_4"),
                'HalfMax_z1_05' => $request->input("setengah_z1_{$formIndex}_5"),
                'HalfMax_z1_06' => $request->input("setengah_z1_{$formIndex}_6"),
                'HalfMax_z1_07' => $request->input("setengah_z1_{$formIndex}_7"),
                'HalfMax_z1_08' => $request->input("setengah_z1_{$formIndex}_8"),
                'HalfMax_z1_09' => $request->input("setengah_z1_{$formIndex}_9"),
                'HalfMax_z1_10' => $request->input("setengah_z1_{$formIndex}_10"),
                
                // Setengah Kap. Max - Penunjukan m1
                'HalfMax_m1_01' => $request->input("setengah_m1_{$formIndex}_1"),
                'HalfMax_m1_02' => $request->input("setengah_m1_{$formIndex}_2"),
                'HalfMax_m1_03' => $request->input("setengah_m1_{$formIndex}_3"),
                'HalfMax_m1_04' => $request->input("setengah_m1_{$formIndex}_4"),
                'HalfMax_m1_05' => $request->input("setengah_m1_{$formIndex}_5"),
                'HalfMax_m1_06' => $request->input("setengah_m1_{$formIndex}_6"),
                'HalfMax_m1_07' => $request->input("setengah_m1_{$formIndex}_7"),
                'HalfMax_m1_08' => $request->input("setengah_m1_{$formIndex}_8"),
                'HalfMax_m1_09' => $request->input("setengah_m1_{$formIndex}_9"),
                'HalfMax_m1_10' => $request->input("setengah_m1_{$formIndex}_10"),
                
                // Kapasitas Max - Penunjukan z1
                'FullMax_z1_01' => $request->input("kapasitas_z1_{$formIndex}_1"),
                'FullMax_z1_02' => $request->input("kapasitas_z1_{$formIndex}_2"),
                'FullMax_z1_03' => $request->input("kapasitas_z1_{$formIndex}_3"),
                'FullMax_z1_04' => $request->input("kapasitas_z1_{$formIndex}_4"),
                'FullMax_z1_05' => $request->input("kapasitas_z1_{$formIndex}_5"),
                'FullMax_z1_06' => $request->input("kapasitas_z1_{$formIndex}_6"),
                'FullMax_z1_07' => $request->input("kapasitas_z1_{$formIndex}_7"),
                'FullMax_z1_08' => $request->input("kapasitas_z1_{$formIndex}_8"),
                'FullMax_z1_09' => $request->input("kapasitas_z1_{$formIndex}_9"),
                'FullMax_z1_10' => $request->input("kapasitas_z1_{$formIndex}_10"),
                
                // Kapasitas Max - Penunjukan m1
                'FullMax_m1_01' => $request->input("kapasitas_m1_{$formIndex}_1"),
                'FullMax_m1_02' => $request->input("kapasitas_m1_{$formIndex}_2"),
                'FullMax_m1_03' => $request->input("kapasitas_m1_{$formIndex}_3"),
                'FullMax_m1_04' => $request->input("kapasitas_m1_{$formIndex}_4"),
                'FullMax_m1_05' => $request->input("kapasitas_m1_{$formIndex}_5"),
                'FullMax_m1_06' => $request->input("kapasitas_m1_{$formIndex}_6"),
                'FullMax_m1_07' => $request->input("kapasitas_m1_{$formIndex}_7"),
                'FullMax_m1_08' => $request->input("kapasitas_m1_{$formIndex}_8"),
                'FullMax_m1_09' => $request->input("kapasitas_m1_{$formIndex}_9"),
                'FullMax_m1_10' => $request->input("kapasitas_m1_{$formIndex}_10"),
                
                // Off Center Data
                'bebanOffCenter' => $request->input("beban_timbangan_{$formIndex}"),
                'offCenterFront' => $request->input("beban_depan_{$formIndex}"),
                'offCenterMiddle' => $request->input("beban_tengah_{$formIndex}"),
                'offCenterBack' => $request->input("beban_belakang_{$formIndex}"),
                'offCenterRight' => $request->input("beban_kanan_{$formIndex}"),
                'offCenterLeft' => $request->input("beban_kiri_{$formIndex}"),
            ];
            
            // Filter null values
            $addUpdateData = array_filter($addUpdateData, function($value) {
                return $value !== null;
            });
            
            if ($addTimbangan) {
                $addTimbangan->update($addUpdateData);
                \Log::info("✅ AddTimbangan Form {$formIndex} updated");
            } else if (count($addUpdateData) > 1) {
                $addUpdateData['calibration_id'] = $calibration->id;
                AddTimbangan::create($addUpdateData);
                \Log::info("➕ AddTimbangan Form {$formIndex} created");
            }
        }
        
        // ==================================================================
        // 4. UPDATE CALIBRATION - DATA UMUM (HANYA DARI FORM 1)
        // ==================================================================
        $updateCalibrationData = [];
        
        $fieldsToUpdate = [
            'namaAlat', 'brandAlat', 'kodeAlat', 'typeAlat', 'NoSeri',
            'kapasitas', 'resolusi', 'pemilikAlat', 'tanggalMasuk', 
            'tanggalKalibrasi', 'jenisPembacaan', 'tempatKalibrasi', 
            'lokasiPT', 'kondisiAlat', 'keterangan',
            'RT_condition1', 'RT_condition2', 'RT_condition3',
            'RH_condition1', 'RH_condition2', 'RH_condition3'
        ];
        
        foreach ($fieldsToUpdate as $field) {
            if ($request->filled($field)) {
                $updateCalibrationData[$field] = $request->$field;
            }
        }
        
        if ($request->filled('calibratedBy')) {
            $updateCalibrationData['calibrated_by'] = $request->calibratedBy;
        }
        if ($request->filled('verifiedBy')) {
            $updateCalibrationData['verified_by'] = $request->verifiedBy;
        }
        
        $updateCalibrationData['certificate_id'] = null;
        
        if (!empty($updateCalibrationData)) {
            $calibration->update($updateCalibrationData);
            \Log::info('✅ Calibration updated:', array_keys($updateCalibrationData));
        }
        
        // ==================================================================
        // 5. FINAL VERIFICATION
        // ==================================================================
        $calibration->refresh();
        
        $allHeads = HeadTimbangan::where('calibration_id', $calibration->id)->get();
        foreach ($allHeads as $head) {
            \Log::info("📊 HeadTimbangan Form {$head->form_index}:", [
                'note' => $head->note,
                'certificate_id' => $head->certificate_id,
            ]);
        }
        
        \Log::info('🔍 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'heads_count' => $allHeads->count(),
            'detail_records' => DetailTimbangan::where('calibration_id', $calibration->id)->count(),
            'add_records' => AddTimbangan::where('calibration_id', $calibration->id)->count(),
        ]);

        \Log::info('🎉 updateTimbangan COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTimbangan:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        throw $e;
    }
}
private function storeTimbanganMoisture($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🚀 START storeTimbanganMoisture - COMBINED TEMPERATURE & WEIGHT', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR (DENGAN DUKUNGAN _tab)
        // ==================================================================
        // Cek textarea terlebih dahulu
        $textValue = trim($this->getRequestValue($request, 'alat_standar_text', $tabId) ?? '');
        
        // Cek array checkbox
        $arrayValue = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (!is_array($arrayValue)) {
            $arrayValue = $request->input('alat_standar', []);
        }
        
        if (!empty($textValue)) {
            $alatStandarString = $textValue; // Prioritas: textarea
        } elseif (is_array($arrayValue) && count($arrayValue) > 0) {
            $alatStandarString = implode(', ', $arrayValue); // Fallback ke checkbox
        } else {
            $alatStandarString = '';
        }
        
        \Log::info('🔧 Alat standar selected for Timbangan Moisture:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE)
        // ==================================================================
        $head = HeadTimbanganMoisture::where('calibration_id', $calibration->id)->first();
        
        $kapasitasMax = $this->getRequestValue($request, 'kapasitas_max', $tabId);
        $setengahKapasitas = $this->getRequestValue($request, 'setengah_kapasitas', $tabId);
        $calibrationMethod = $this->getRequestValue($request, 'calibration_method', $tabId);
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod ?? 'PAS-IK1102-15 (Monograph 4 : The Calibration of Weights and Balances, NMI Australia 2010)',
                'kapasitas_max' => $kapasitasMax,
                'setengah_kapasitas' => $setengahKapasitas,
            ]);
            \Log::info('✅ HeadTimbanganMoisture updated:', ['head_id' => $head->id, 'tab_id' => $tabId]);
        } else {
            // Buat head baru
            $head = HeadTimbanganMoisture::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod ?? 'PAS-IK1102-15 (Monograph 4 : The Calibration of Weights and Balances, NMI Australia 2010)',
                'kapasitas_max' => $kapasitasMax,
                'setengah_kapasitas' => $setengahKapasitas,
            ]);
            \Log::info('✅ HeadTimbanganMoisture created:', ['head_id' => $head->id, 'tab_id' => $tabId]);
        }

        // ==================================================================
        // 3. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE)
        // ==================================================================
        $existingDetails = DetailTimbanganMoisture::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailTimbanganMoisture::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records for tab {$tabId}");
        }
        
        $existingAddData = AddTimbanganMoisture::where('calibration_id', $calibration->id)->count();
        if ($existingAddData > 0) {
            AddTimbanganMoisture::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingAddData} old add data records for tab {$tabId}");
        }
        
        // ==================================================================
        // 4. SIMPAN 10 RECORD DENGAN DATA GABUNGAN (SUHU DI RECORD 1-3)
        // ==================================================================
        \Log::info('📊 Saving 10 combined records (temperature in record 1-3, weight data)...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 10; $i++) {
            // Data timbangan untuk semua record (dengan dukungan _tab)
            $titikUkur = $this->getRequestValue($request, "skala_nominal_{$i}", $tabId);
            $Lz1 = $this->getRequestValue($request, "z1_1_{$i}", $tabId);
            $Lm1 = $this->getRequestValue($request, "m1_1_{$i}", $tabId);
            $Rm1 = $this->getRequestValue($request, "m1_2_{$i}", $tabId);
            $Rz1 = $this->getRequestValue($request, "z1_2_{$i}", $tabId);
            $STD = $this->getRequestValue($request, "standar_{$i}", $tabId);
            
            // Data suhu HANYA untuk record 1-3
            $tsetting = null;
            $readAlat01 = null;
            $readAlat02 = null;
            $readAlat03 = null;
            $readSTD01 = null;
            $readSTD02 = null;
            $readSTD03 = null;
            
            if ($i <= 3) {
                // Record 1-3: tambahkan data suhu (dengan dukungan _tab)
                $settingNum = $i; // setting suhu ke-1, ke-2, ke-3 sesuai record
                $tsetting = $this->getRequestValue($request, "setting_suhu_{$settingNum}", $tabId);
                
                $readAlat01 = $this->getRequestValue($request, "pembacaan_alat_{$settingNum}_1", $tabId);
                $readAlat02 = $this->getRequestValue($request, "pembacaan_alat_{$settingNum}_2", $tabId);
                $readAlat03 = $this->getRequestValue($request, "pembacaan_alat_{$settingNum}_3", $tabId);
                
                $readSTD01 = $this->getRequestValue($request, "pembacaan_standar_{$settingNum}_1", $tabId);
                $readSTD02 = $this->getRequestValue($request, "pembacaan_standar_{$settingNum}_2", $tabId);
                $readSTD03 = $this->getRequestValue($request, "pembacaan_standar_{$settingNum}_3", $tabId);
                
                \Log::debug("🌡️ Record {$i}: Temperature data added (tab {$tabId})", [
                    'Tsetting' => $tsetting,
                    'setting_num' => $settingNum
                ]);
            }
            
            // Cek apakah ada data untuk record ini
            $hasTimbanganData = !empty($titikUkur) || !empty($STD) || 
                              !empty($Lm1) || !empty($Lz1) || 
                              !empty($Rm1) || !empty($Rz1);
            
            $hasSuhuData = ($i <= 3) && ($tsetting !== null && $tsetting !== '' || 
                         $readAlat01 !== null && $readAlat01 !== '' ||
                         $readAlat02 !== null && $readAlat02 !== '' ||
                         $readAlat03 !== null && $readAlat03 !== '' ||
                         $readSTD01 !== null && $readSTD01 !== '' ||
                         $readSTD02 !== null && $readSTD02 !== '' ||
                         $readSTD03 !== null && $readSTD03 !== '');
            
            $hasData = $hasTimbanganData || $hasSuhuData;
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_timbangan_moisture_id' => $head->id,
                    // Data timbangan
                    'titikUkur' => $titikUkur,
                    'STD' => $STD,
                    'Lm1' => $Lm1,
                    'Lz1' => $Lz1,
                    'Rm1' => $Rm1,
                    'Rz1' => $Rz1,
                    // Data suhu (hanya untuk record 1-3, null untuk lainnya)
                    'Tsetting' => $tsetting,
                    'ReadAlat01' => $readAlat01,
                    'ReadAlat02' => $readAlat02,
                    'ReadAlat03' => $readAlat03,
                    'ReadSTD01' => $readSTD01,
                    'ReadSTD02' => $readSTD02,
                    'ReadSTD03' => $readSTD03,
                ];
                
                $record = DetailTimbanganMoisture::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Record {$i} saved (tab {$tabId})", [
                    'record_id' => $record->id,
                    'has_temperature' => $i <= 3 ? 'YES' : 'NO',
                    'titikUkur' => $detailData['titikUkur'],
                    'Tsetting' => $detailData['Tsetting']
                ]);
            } else {
                \Log::debug("⏭️ Skipping record {$i} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} combined records (temperature in record 1-3) for tab {$tabId}");
        
        // ==================================================================
        // 5. SIMPAN ADD TIMBANGAN MOISTURE (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving AddTimbanganMoisture data...');
        
        $addData = [
            'calibration_id' => $calibration->id,
            
            // Pemeriksaan Nilai Repeatability - Setengah Kap. Max
            'HalfMax_z1_01' => $this->getRequestValue($request, 'setengah_z1_1', $tabId),
            'HalfMax_z1_02' => $this->getRequestValue($request, 'setengah_z1_2', $tabId),
            'HalfMax_z1_03' => $this->getRequestValue($request, 'setengah_z1_3', $tabId),
            'HalfMax_z1_04' => $this->getRequestValue($request, 'setengah_z1_4', $tabId),
            'HalfMax_z1_05' => $this->getRequestValue($request, 'setengah_z1_5', $tabId),
            'HalfMax_z1_06' => $this->getRequestValue($request, 'setengah_z1_6', $tabId),
            'HalfMax_z1_07' => $this->getRequestValue($request, 'setengah_z1_7', $tabId),
            'HalfMax_z1_08' => $this->getRequestValue($request, 'setengah_z1_8', $tabId),
            'HalfMax_z1_09' => $this->getRequestValue($request, 'setengah_z1_9', $tabId),
            'HalfMax_z1_10' => $this->getRequestValue($request, 'setengah_z1_10', $tabId),
            
            'HalfMax_m1_01' => $this->getRequestValue($request, 'setengah_m1_1', $tabId),
            'HalfMax_m1_02' => $this->getRequestValue($request, 'setengah_m1_2', $tabId),
            'HalfMax_m1_03' => $this->getRequestValue($request, 'setengah_m1_3', $tabId),
            'HalfMax_m1_04' => $this->getRequestValue($request, 'setengah_m1_4', $tabId),
            'HalfMax_m1_05' => $this->getRequestValue($request, 'setengah_m1_5', $tabId),
            'HalfMax_m1_06' => $this->getRequestValue($request, 'setengah_m1_6', $tabId),
            'HalfMax_m1_07' => $this->getRequestValue($request, 'setengah_m1_7', $tabId),
            'HalfMax_m1_08' => $this->getRequestValue($request, 'setengah_m1_8', $tabId),
            'HalfMax_m1_09' => $this->getRequestValue($request, 'setengah_m1_9', $tabId),
            'HalfMax_m1_10' => $this->getRequestValue($request, 'setengah_m1_10', $tabId),
            
            // Pemeriksaan Nilai Repeatability - Kapasitas Max
            'FullMax_z1_01' => $this->getRequestValue($request, 'kapasitas_z1_1', $tabId),
            'FullMax_z1_02' => $this->getRequestValue($request, 'kapasitas_z1_2', $tabId),
            'FullMax_z1_03' => $this->getRequestValue($request, 'kapasitas_z1_3', $tabId),
            'FullMax_z1_04' => $this->getRequestValue($request, 'kapasitas_z1_4', $tabId),
            'FullMax_z1_05' => $this->getRequestValue($request, 'kapasitas_z1_5', $tabId),
            'FullMax_z1_06' => $this->getRequestValue($request, 'kapasitas_z1_6', $tabId),
            'FullMax_z1_07' => $this->getRequestValue($request, 'kapasitas_z1_7', $tabId),
            'FullMax_z1_08' => $this->getRequestValue($request, 'kapasitas_z1_8', $tabId),
            'FullMax_z1_09' => $this->getRequestValue($request, 'kapasitas_z1_9', $tabId),
            'FullMax_z1_10' => $this->getRequestValue($request, 'kapasitas_z1_10', $tabId),
            
            'FullMax_m1_01' => $this->getRequestValue($request, 'kapasitas_m1_1', $tabId),
            'FullMax_m1_02' => $this->getRequestValue($request, 'kapasitas_m1_2', $tabId),
            'FullMax_m1_03' => $this->getRequestValue($request, 'kapasitas_m1_3', $tabId),
            'FullMax_m1_04' => $this->getRequestValue($request, 'kapasitas_m1_4', $tabId),
            'FullMax_m1_05' => $this->getRequestValue($request, 'kapasitas_m1_5', $tabId),
            'FullMax_m1_06' => $this->getRequestValue($request, 'kapasitas_m1_6', $tabId),
            'FullMax_m1_07' => $this->getRequestValue($request, 'kapasitas_m1_7', $tabId),
            'FullMax_m1_08' => $this->getRequestValue($request, 'kapasitas_m1_8', $tabId),
            'FullMax_m1_09' => $this->getRequestValue($request, 'kapasitas_m1_9', $tabId),
            'FullMax_m1_10' => $this->getRequestValue($request, 'kapasitas_m1_10', $tabId),
            
            // Off-Center Loading Test
            'bebanOffCenter' => $this->getRequestValue($request, 'beban_timbangan', $tabId),
            'offCenterFront' => $this->getRequestValue($request, 'beban_depan', $tabId),
            'offCenterMiddle' => $this->getRequestValue($request, 'beban_tengah', $tabId),
            'offCenterBack' => $this->getRequestValue($request, 'beban_belakang', $tabId),
            'offCenterRight' => $this->getRequestValue($request, 'beban_kanan', $tabId),
            'offCenterLeft' => $this->getRequestValue($request, 'beban_kiri', $tabId),
        ];
        
        // Cek apakah ada data untuk disimpan
        $hasAddData = false;
        foreach ($addData as $key => $value) {
            if ($key !== 'calibration_id' && $value !== null && $value !== '') {
                $hasAddData = true;
                break;
            }
        }
        
        if ($hasAddData) {
            $addRecord = AddTimbanganMoisture::create($addData);
            \Log::info('✅ AddTimbanganMoisture saved:', ['add_id' => $addRecord->id, 'tab_id' => $tabId]);
        } else {
            \Log::info('⚠️ No AddTimbanganMoisture data to save for tab ' . $tabId);
        }

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Calibrated by (nama_dikalibrasi)
        $calibratedBy = $this->getRequestValue($request, 'nama_dikalibrasi', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy, 'tab_id' => $tabId]);
        }
        
        // Verified by (nama_diperiksa)
        $verifiedBy = $this->getRequestValue($request, 'nama_diperiksa', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy, 'tab_id' => $tabId]);
        }
        
        // Alat standar
        if (!empty($alatStandarString)) {
            $updateData['alat_standar'] = $alatStandarString;
        }
        
        // Calibration method
        if ($calibrationMethod) {
            $updateData['calibration_method'] = $calibrationMethod;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data for tab ' . $tabId);
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailTimbanganMoisture::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddTimbanganMoisture::where('calibration_id', $calibration->id)->count();
        
        // Cek record yang memiliki data suhu
        $temperatureRecords = DetailTimbanganMoisture::where('calibration_id', $calibration->id)
            ->where(function($query) {
                $query->whereNotNull('Tsetting')
                      ->orWhereNotNull('ReadAlat01')
                      ->orWhereNotNull('ReadAlat02')
                      ->orWhereNotNull('ReadAlat03')
                      ->orWhereNotNull('ReadSTD01')
                      ->orWhereNotNull('ReadSTD02')
                      ->orWhereNotNull('ReadSTD03');
            })
            ->count();
        
        \Log::info('📋 STORE SUMMARY (Timbangan Moisture - COMBINED DATA):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'tab_id' => $tabId,
            'total_records' => $savedDetailCount,
            'records_with_temperature' => $temperatureRecords . ' (should be 1-3)',
            'record_structure' => '✅ ALL 10 records have weight data, records 1-3 ALSO have temperature data',
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateId,
            'alat_standar' => $alatStandarString,
        ]);

        \Log::info('🎉 storeTimbanganMoisture COMPLETED (COMBINED TEMPERATURE & WEIGHT) for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeTimbanganMoisture:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailTimbanganMoisture::where('calibration_id', $calibration->id)->delete();
                AddTimbanganMoisture::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Timbangan Moisture: " . $e->getMessage());
    }
}

private function updateTimbanganMoisture($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateTimbanganMoisture - COMBINED TEMPERATURE & WEIGHT');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdUpdated = false;
        $certificateIdBaru = $newCertificateId;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $calibration->certificate_id,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $calibration->certificate_id,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Timbangan Moisture:', ['alat_standar' => $alatStandar]);

        // ==================================================================
        // 2. UPDATE ATAU BUAT HEAD TIMBANGAN MOISTURE
        // ==================================================================
        if ($head = $calibration->headTimbanganMoisture) {
            $headUpdateData = [
                'standard' => $alatStandarString,
                'calibrationMethod' => 'PAS-IK1102-15 (Monograph 4 : The Calibration of Weights and Balances, NMI Australia 2010)',
                'kapasitas_max' => $request->kapasitas_max ?? $head->kapasitas_max,
                'setengah_kapasitas' => $request->setengah_kapasitas ?? $head->setengah_kapasitas,
            ];
            
            // Update certificate_id di head jika diperlukan
            if ($certificateIdUpdated && !empty($certificateIdBaru)) {
                $headUpdateData['certificate_id'] = $certificateIdBaru;
                \Log::info("📝 Setting certificate_id di head: {$certificateIdBaru}");
            } elseif ($newCertificateId && !$certificateIdUpdated) {
                $headUpdateData['certificate_id'] = $newCertificateId;
            }
            
            $head->update($headUpdateData);
            \Log::info('✅ HeadTimbanganMoisture updated:', ['head_id' => $head->id]);
        } else {
            $headCreateData = [
                'calibration_id' => $calibration->id,
                'standard' => $alatStandarString,
                'calibrationMethod' => 'PAS-IK1102-15 (Monograph 4 : The Calibration of Weights and Balances, NMI Australia 2010)',
                'kapasitas_max' => $request->kapasitas_max ?? null,
                'setengah_kapasitas' => $request->setengah_kapasitas ?? null,
            ];
            
            if ($certificateIdUpdated && !empty($certificateIdBaru)) {
                $headCreateData['certificate_id'] = $certificateIdBaru;
            } elseif ($newCertificateId) {
                $headCreateData['certificate_id'] = $newCertificateId;
            }
            
            $head = HeadTimbanganMoisture::create($headCreateData);
            \Log::info('➕ HeadTimbanganMoisture created baru:', ['head_id' => $head->id]);
        }

        // ==================================================================
        // 3. UPDATE DETAIL TIMBANGAN MOISTURE (HAPUS & BUAT BARU - 10 RECORD)
        // ==================================================================
        DetailTimbanganMoisture::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        \Log::info('📊 Updating 10 combined records (temperature in record 1-3, weight data)...');
        
        // Ambil data suhu dari format ARRAY (sesuai dengan form)
        $Tsetting = $request->input('Tsetting', []);
        $ReadAlat01 = $request->input('ReadAlat01', []);
        $ReadAlat02 = $request->input('ReadAlat02', []);
        $ReadAlat03 = $request->input('ReadAlat03', []);
        $ReadSTD01 = $request->input('ReadSTD01', []);
        $ReadSTD02 = $request->input('ReadSTD02', []);
        $ReadSTD03 = $request->input('ReadSTD03', []);
        
        for ($i = 1; $i <= 10; $i++) {
            // Data timbangan untuk semua record (format individual)
            $titikUkur = $request->input("titikUkur_$i");
            $Lz1 = $request->input("Lz1_$i");
            $Lm1 = $request->input("Lm1_$i");
            $Rm1 = $request->input("Rm1_$i");
            $Rz1 = $request->input("Rz1_$i");
            $STD = $request->input("STD_$i");
            
            // Data suhu HANYA untuk record 1-3 - ambil dari ARRAY berdasarkan index
            $tsetting = null;
            $readAlat01 = null;
            $readAlat02 = null;
            $readAlat03 = null;
            $readSTD01 = null;
            $readSTD02 = null;
            $readSTD03 = null;
            
            if ($i <= 3) {
                $index = $i - 1; // index array dimulai dari 0
                
                $tsetting = isset($Tsetting[$index]) ? $Tsetting[$index] : null;
                $readAlat01 = isset($ReadAlat01[$index]) ? $ReadAlat01[$index] : null;
                $readAlat02 = isset($ReadAlat02[$index]) ? $ReadAlat02[$index] : null;
                $readAlat03 = isset($ReadAlat03[$index]) ? $ReadAlat03[$index] : null;
                $readSTD01 = isset($ReadSTD01[$index]) ? $ReadSTD01[$index] : null;
                $readSTD02 = isset($ReadSTD02[$index]) ? $ReadSTD02[$index] : null;
                $readSTD03 = isset($ReadSTD03[$index]) ? $ReadSTD03[$index] : null;
            }
            
            $detailData = [
                'calibration_id' => $calibration->id,
                
                // Data timbangan (langsung simpan apa adanya)
                'titikUkur' => $titikUkur,
                'STD' => $STD,
                'Lm1' => $Lm1,
                'Lz1' => $Lz1,
                'Rm1' => $Rm1,
                'Rz1' => $Rz1,
                
                // Data suhu (hanya untuk record 1-3, null untuk lainnya)
                'Tsetting' => $tsetting,
                'ReadAlat01' => $readAlat01,
                'ReadAlat02' => $readAlat02,
                'ReadAlat03' => $readAlat03,
                'ReadSTD01' => $readSTD01,
                'ReadSTD02' => $readSTD02,
                'ReadSTD03' => $readSTD03,
            ];
            
            $record = DetailTimbanganMoisture::create($detailData);
            $detailCount++;
        }
        
        \Log::info("✅ Updated {$detailCount} combined records (temperature in record 1-3)");

        // ==================================================================
        // 4. UPDATE ADD TIMBANGAN MOISTURE (LANGSUNG SIMPAN APA ADANYA)
        // ==================================================================
        \Log::info('📊 Updating AddTimbanganMoisture data...');
        
        if ($addTimbangan = $calibration->addTimbanganMoisture) {
            $updateData = [
                // Pemeriksaan Nilai Repeatability - Setengah Kap. Max
                'HalfMax_z1_01' => $request->input('setengah_z1_1', $addTimbangan->HalfMax_z1_01),
                'HalfMax_z1_02' => $request->input('setengah_z1_2', $addTimbangan->HalfMax_z1_02),
                'HalfMax_z1_03' => $request->input('setengah_z1_3', $addTimbangan->HalfMax_z1_03),
                'HalfMax_z1_04' => $request->input('setengah_z1_4', $addTimbangan->HalfMax_z1_04),
                'HalfMax_z1_05' => $request->input('setengah_z1_5', $addTimbangan->HalfMax_z1_05),
                'HalfMax_z1_06' => $request->input('setengah_z1_6', $addTimbangan->HalfMax_z1_06),
                'HalfMax_z1_07' => $request->input('setengah_z1_7', $addTimbangan->HalfMax_z1_07),
                'HalfMax_z1_08' => $request->input('setengah_z1_8', $addTimbangan->HalfMax_z1_08),
                'HalfMax_z1_09' => $request->input('setengah_z1_9', $addTimbangan->HalfMax_z1_09),
                'HalfMax_z1_10' => $request->input('setengah_z1_10', $addTimbangan->HalfMax_z1_10),
                
                'HalfMax_m1_01' => $request->input('setengah_m1_1', $addTimbangan->HalfMax_m1_01),
                'HalfMax_m1_02' => $request->input('setengah_m1_2', $addTimbangan->HalfMax_m1_02),
                'HalfMax_m1_03' => $request->input('setengah_m1_3', $addTimbangan->HalfMax_m1_03),
                'HalfMax_m1_04' => $request->input('setengah_m1_4', $addTimbangan->HalfMax_m1_04),
                'HalfMax_m1_05' => $request->input('setengah_m1_5', $addTimbangan->HalfMax_m1_05),
                'HalfMax_m1_06' => $request->input('setengah_m1_6', $addTimbangan->HalfMax_m1_06),
                'HalfMax_m1_07' => $request->input('setengah_m1_7', $addTimbangan->HalfMax_m1_07),
                'HalfMax_m1_08' => $request->input('setengah_m1_8', $addTimbangan->HalfMax_m1_08),
                'HalfMax_m1_09' => $request->input('setengah_m1_9', $addTimbangan->HalfMax_m1_09),
                'HalfMax_m1_10' => $request->input('setengah_m1_10', $addTimbangan->HalfMax_m1_10),
                
                // Pemeriksaan Nilai Repeatability - Kapasitas Max
                'FullMax_z1_01' => $request->input('kapasitas_z1_1', $addTimbangan->FullMax_z1_01),
                'FullMax_z1_02' => $request->input('kapasitas_z1_2', $addTimbangan->FullMax_z1_02),
                'FullMax_z1_03' => $request->input('kapasitas_z1_3', $addTimbangan->FullMax_z1_03),
                'FullMax_z1_04' => $request->input('kapasitas_z1_4', $addTimbangan->FullMax_z1_04),
                'FullMax_z1_05' => $request->input('kapasitas_z1_5', $addTimbangan->FullMax_z1_05),
                'FullMax_z1_06' => $request->input('kapasitas_z1_6', $addTimbangan->FullMax_z1_06),
                'FullMax_z1_07' => $request->input('kapasitas_z1_7', $addTimbangan->FullMax_z1_07),
                'FullMax_z1_08' => $request->input('kapasitas_z1_8', $addTimbangan->FullMax_z1_08),
                'FullMax_z1_09' => $request->input('kapasitas_z1_9', $addTimbangan->FullMax_z1_09),
                'FullMax_z1_10' => $request->input('kapasitas_z1_10', $addTimbangan->FullMax_z1_10),
                
                'FullMax_m1_01' => $request->input('kapasitas_m1_1', $addTimbangan->FullMax_m1_01),
                'FullMax_m1_02' => $request->input('kapasitas_m1_2', $addTimbangan->FullMax_m1_02),
                'FullMax_m1_03' => $request->input('kapasitas_m1_3', $addTimbangan->FullMax_m1_03),
                'FullMax_m1_04' => $request->input('kapasitas_m1_4', $addTimbangan->FullMax_m1_04),
                'FullMax_m1_05' => $request->input('kapasitas_m1_5', $addTimbangan->FullMax_m1_05),
                'FullMax_m1_06' => $request->input('kapasitas_m1_6', $addTimbangan->FullMax_m1_06),
                'FullMax_m1_07' => $request->input('kapasitas_m1_7', $addTimbangan->FullMax_m1_07),
                'FullMax_m1_08' => $request->input('kapasitas_m1_8', $addTimbangan->FullMax_m1_08),
                'FullMax_m1_09' => $request->input('kapasitas_m1_9', $addTimbangan->FullMax_m1_09),
                'FullMax_m1_10' => $request->input('kapasitas_m1_10', $addTimbangan->FullMax_m1_10),
                
                // Off-Center Loading Test
                'bebanOffCenter' => $request->input('beban_timbangan', $addTimbangan->bebanOffCenter),
                'offCenterFront' => $request->input('beban_depan', $addTimbangan->offCenterFront),
                'offCenterMiddle' => $request->input('beban_tengah', $addTimbangan->offCenterMiddle),
                'offCenterBack' => $request->input('beban_belakang', $addTimbangan->offCenterBack),
                'offCenterRight' => $request->input('beban_kanan', $addTimbangan->offCenterRight),
                'offCenterLeft' => $request->input('beban_kiri', $addTimbangan->offCenterLeft),
            ];
            
            $addTimbangan->update($updateData);
            \Log::info('✅ AddTimbanganMoisture updated');
            
        } else {
            // Buat baru jika belum ada
            $addData = [
                'calibration_id' => $calibration->id,
                
                'HalfMax_z1_01' => $request->input('setengah_z1_1'),
                'HalfMax_z1_02' => $request->input('setengah_z1_2'),
                'HalfMax_z1_03' => $request->input('setengah_z1_3'),
                'HalfMax_z1_04' => $request->input('setengah_z1_4'),
                'HalfMax_z1_05' => $request->input('setengah_z1_5'),
                'HalfMax_z1_06' => $request->input('setengah_z1_6'),
                'HalfMax_z1_07' => $request->input('setengah_z1_7'),
                'HalfMax_z1_08' => $request->input('setengah_z1_8'),
                'HalfMax_z1_09' => $request->input('setengah_z1_9'),
                'HalfMax_z1_10' => $request->input('setengah_z1_10'),
                
                'HalfMax_m1_01' => $request->input('setengah_m1_1'),
                'HalfMax_m1_02' => $request->input('setengah_m1_2'),
                'HalfMax_m1_03' => $request->input('setengah_m1_3'),
                'HalfMax_m1_04' => $request->input('setengah_m1_4'),
                'HalfMax_m1_05' => $request->input('setengah_m1_5'),
                'HalfMax_m1_06' => $request->input('setengah_m1_6'),
                'HalfMax_m1_07' => $request->input('setengah_m1_7'),
                'HalfMax_m1_08' => $request->input('setengah_m1_8'),
                'HalfMax_m1_09' => $request->input('setengah_m1_9'),
                'HalfMax_m1_10' => $request->input('setengah_m1_10'),
                
                'FullMax_z1_01' => $request->input('kapasitas_z1_1'),
                'FullMax_z1_02' => $request->input('kapasitas_z1_2'),
                'FullMax_z1_03' => $request->input('kapasitas_z1_3'),
                'FullMax_z1_04' => $request->input('kapasitas_z1_4'),
                'FullMax_z1_05' => $request->input('kapasitas_z1_5'),
                'FullMax_z1_06' => $request->input('kapasitas_z1_6'),
                'FullMax_z1_07' => $request->input('kapasitas_z1_7'),
                'FullMax_z1_08' => $request->input('kapasitas_z1_8'),
                'FullMax_z1_09' => $request->input('kapasitas_z1_9'),
                'FullMax_z1_10' => $request->input('kapasitas_z1_10'),
                
                'FullMax_m1_01' => $request->input('kapasitas_m1_1'),
                'FullMax_m1_02' => $request->input('kapasitas_m1_2'),
                'FullMax_m1_03' => $request->input('kapasitas_m1_3'),
                'FullMax_m1_04' => $request->input('kapasitas_m1_4'),
                'FullMax_m1_05' => $request->input('kapasitas_m1_5'),
                'FullMax_m1_06' => $request->input('kapasitas_m1_6'),
                'FullMax_m1_07' => $request->input('kapasitas_m1_7'),
                'FullMax_m1_08' => $request->input('kapasitas_m1_8'),
                'FullMax_m1_09' => $request->input('kapasitas_m1_9'),
                'FullMax_m1_10' => $request->input('kapasitas_m1_10'),
                
                'bebanOffCenter' => $request->input('beban_timbangan'),
                'offCenterFront' => $request->input('beban_depan'),
                'offCenterMiddle' => $request->input('beban_tengah'),
                'offCenterBack' => $request->input('beban_belakang'),
                'offCenterRight' => $request->input('beban_kanan'),
                'offCenterLeft' => $request->input('beban_kiri'),
            ];
            
            $hasAddData = false;
            foreach ($addData as $key => $value) {
                if ($key !== 'calibration_id' && $value !== null && $value !== '') {
                    $hasAddData = true;
                    break;
                }
            }
            
            if ($hasAddData) {
                $addRecord = AddTimbanganMoisture::create($addData);
                \Log::info('➕ AddTimbanganMoisture created baru:', ['add_id' => $addRecord->id]);
            }
        }

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA BARU (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $finalUpdateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $finalUpdateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate:', ['old' => $originalNamaAlat, 'new' => $namaAlatDariRequest]);
        }
        
        // Update certificate_id di calibration jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $finalUpdateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di calibration:', ['new' => $certificateIdBaru]);
        }
        
        // Update calibrated_by dan verified_by
        if ($request->filled('calibrated_by')) {
            $finalUpdateData['calibratedBy'] = $request->calibrated_by;
        }
        if ($request->filled('verified_by')) {
            $finalUpdateData['verifiedBy'] = $request->verified_by;
        }
        
        if (!empty($finalUpdateData)) {
            $calibration->update($finalUpdateData);
            \Log::info('✅ Calibration updated:', array_keys($finalUpdateData));
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        
        $savedDetailCount = DetailTimbanganMoisture::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddTimbanganMoisture::where('calibration_id', $calibration->id)->count();
        
        $temperatureRecords = DetailTimbanganMoisture::where('calibration_id', $calibration->id)
            ->where(function($query) {
                $query->whereNotNull('Tsetting')
                      ->orWhereNotNull('ReadAlat01')
                      ->orWhereNotNull('ReadAlat02')
                      ->orWhereNotNull('ReadAlat03')
                      ->orWhereNotNull('ReadSTD01')
                      ->orWhereNotNull('ReadSTD02')
                      ->orWhereNotNull('ReadSTD03');
            })
            ->count();
        
        \Log::info('📋 UPDATE SUMMARY (Timbangan Moisture - COMBINED DATA):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'total_records' => $savedDetailCount,
            'records_with_temperature' => $temperatureRecords . ' (should be 1-3)',
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateIdBaru ?? $calibration->certificate_id,
            'alat_standar' => $alatStandarString,
            'calibrated_by' => $calibration->calibratedBy,
            'verified_by' => $calibration->verifiedBy,
        ]);

        \Log::info('🎉 updateTimbanganMoisture COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTimbanganMoisture:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        
        throw new \Exception("Gagal mengupdate data Timbangan Moisture: " . $e->getMessage());
    }
}
/**
 * Format nilai string (mengizinkan karakter apapun)
 */
private function formatStringValue($value)
{
    if ($value === null || $value === '') {
        return null;
    }
    
    return trim($value);
}



private function storeTimbanganBias($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🚀 START storeTimbanganBias', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - NILAI FIX/TETAP (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandarString = 'Anak Timbang Kelas M1 | M2';
        $calibrationMethod = 'The Calibration of Weight and Balance, Third Edition - NMI Australia.';
        
        \Log::info('🔧 Alat standar FIXED:', [
            'alat_standar' => $alatStandarString,
            'method' => $calibrationMethod,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $head = HeadTimbanganBias::where('calibration_id', $calibration->id)->first();
        
        $note = $this->getRequestValue($request, 'catatan', $tabId);
        $bebanSetengahKapasitas = $this->getRequestValue($request, 'beban_setengah_kapasitas', $tabId);
        $bebanKapasitasMaks = $this->getRequestValue($request, 'beban_kapasitas_maks', $tabId);
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod,
                'note' => $note,
                'beban_setengah_kapasitas' => $bebanSetengahKapasitas,
                'beban_kapasitas_maks' => $bebanKapasitasMaks,
            ]);
            \Log::info('✅ HeadTimbanganBias updated:', ['head_id' => $head->id, 'tab_id' => $tabId]);
        } else {
            // Buat head baru
            $head = HeadTimbanganBias::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod,
                'note' => $note,
                'beban_setengah_kapasitas' => $bebanSetengahKapasitas,
                'beban_kapasitas_maks' => $bebanKapasitasMaks,
            ]);
            \Log::info('✅ HeadTimbanganBias created:', ['head_id' => $head->id, 'tab_id' => $tabId]);
        }

        // ==================================================================
        // 3. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $existingDetails = DetailTimbanganBias::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailTimbanganBias::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records for tab {$tabId}");
        }
        
        $existingAddData = AddTimbanganBias::where('calibration_id', $calibration->id)->count();
        if ($existingAddData > 0) {
            AddTimbanganBias::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingAddData} old add data records for tab {$tabId}");
        }

        // ==================================================================
        // 4. SIMPAN DETAIL TIMBANGAN BIAS - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving DetailTimbanganBias data...');
        $detailCount = 0;

        // Array mapping untuk mengkonversi nama input HTML ke field database
        $dataMapping = [
            // Baris Umum (z M M z) - ini adalah baris pertama di HTML
            [
                'titik_ukir' => 'titik_umum',
                'Lz1' => 'val_z_umum',
                'Lm1' => 'val_m1_umum',
                'Rm1' => 'val_m2_umum',
                'Rz1' => 'val_z2_umum',
                'STD' => 'standar_umum',
            ],
            // Titik 1 sampai 9
            ['titik_ukir' => 'titik_1', 'Lz1' => 'val_z_1', 'Lm1' => 'val_m1_1', 'Rm1' => 'val_m2_1', 'Rz1' => 'val_z2_1', 'STD' => 'standar_1'],
            ['titik_ukir' => 'titik_2', 'Lz1' => 'val_z_2', 'Lm1' => 'val_m1_2', 'Rm1' => 'val_m2_2', 'Rz1' => 'val_z2_2', 'STD' => 'standar_2'],
            ['titik_ukir' => 'titik_3', 'Lz1' => 'val_z_3', 'Lm1' => 'val_m1_3', 'Rm1' => 'val_m2_3', 'Rz1' => 'val_z2_3', 'STD' => 'standar_3'],
            ['titik_ukir' => 'titik_4', 'Lz1' => 'val_z_4', 'Lm1' => 'val_m1_4', 'Rm1' => 'val_m2_4', 'Rz1' => 'val_z2_4', 'STD' => 'standar_4'],
            ['titik_ukir' => 'titik_5', 'Lz1' => 'val_z_5', 'Lm1' => 'val_m1_5', 'Rm1' => 'val_m2_5', 'Rz1' => 'val_z2_5', 'STD' => 'standar_5'],
            ['titik_ukir' => 'titik_6', 'Lz1' => 'val_z_6', 'Lm1' => 'val_m1_6', 'Rm1' => 'val_m2_6', 'Rz1' => 'val_z2_6', 'STD' => 'standar_6'],
            ['titik_ukir' => 'titik_7', 'Lz1' => 'val_z_7', 'Lm1' => 'val_m1_7', 'Rm1' => 'val_m2_7', 'Rz1' => 'val_z2_7', 'STD' => 'standar_7'],
            ['titik_ukir' => 'titik_8', 'Lz1' => 'val_z_8', 'Lm1' => 'val_m1_8', 'Rm1' => 'val_m2_8', 'Rz1' => 'val_z2_8', 'STD' => 'standar_8'],
            ['titik_ukir' => 'titik_9', 'Lz1' => 'val_z_9', 'Lm1' => 'val_m1_9', 'Rm1' => 'val_m2_9', 'Rz1' => 'val_z2_9', 'STD' => 'standar_9'],
        ];
        
        foreach ($dataMapping as $index => $mapping) {
            // Ambil data dari request dengan getRequestValue (dukungan _tab)
            $titikUkur = $this->getRequestValue($request, $mapping['titik_ukir'], $tabId);
            $Lz1 = $this->getRequestValue($request, $mapping['Lz1'], $tabId);
            $Lm1 = $this->getRequestValue($request, $mapping['Lm1'], $tabId);
            $Rm1 = $this->getRequestValue($request, $mapping['Rm1'], $tabId);
            $Rz1 = $this->getRequestValue($request, $mapping['Rz1'], $tabId);
            $STD = $this->getRequestValue($request, $mapping['STD'], $tabId);
            
            \Log::debug("🔍 Row " . ($index + 1) . " data from request (tab {$tabId}):", [
                'titik_ukir' => $titikUkur,
                'Lz1' => $Lz1,
                'Lm1' => $Lm1,
                'Rm1' => $Rm1,
                'Rz1' => $Rz1,
                'STD' => $STD,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($titikUkur) || !empty($STD) || 
                      !empty($Lm1) || !empty($Lz1) || 
                      !empty($Rm1) || !empty($Rz1);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_timbangan_bias_id' => $head->id,
                    'titikUkur' => $titikUkur,
                    'STD' => $STD,
                    'Lm1' => $Lm1,
                    'Lz1' => $Lz1,
                    'Rm1' => $Rm1,
                    'Rz1' => $Rz1,
                ];
                
                \Log::debug("💾 Saving DetailTimbanganBias row " . ($index + 1) . ":", $detailData);
                
                DetailTimbanganBias::create($detailData);
                $detailCount++;
            } else {
                \Log::debug("⏭️ Skipping row " . ($index + 1) . " - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailTimbanganBias records for tab {$tabId}");

        // ==================================================================
        // 5. SIMPAN ADD TIMBANGAN BIAS - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving AddTimbanganBias data...');
        
        $addData = [
            'calibration_id' => $calibration->id,
            
            // HalfMax (Setengah Kapasitas) - m1
            'HalfMax_m1_01' => $this->getRequestValue($request, 'setengah_mi_1', $tabId),
            'HalfMax_m1_02' => $this->getRequestValue($request, 'setengah_mi_2', $tabId),
            'HalfMax_m1_03' => $this->getRequestValue($request, 'setengah_mi_3', $tabId),
            'HalfMax_m1_04' => $this->getRequestValue($request, 'setengah_mi_4', $tabId),
            'HalfMax_m1_05' => $this->getRequestValue($request, 'setengah_mi_5', $tabId),
            'HalfMax_m1_06' => $this->getRequestValue($request, 'setengah_mi_6', $tabId),
            'HalfMax_m1_07' => $this->getRequestValue($request, 'setengah_mi_7', $tabId),
            'HalfMax_m1_08' => $this->getRequestValue($request, 'setengah_mi_8', $tabId),
            'HalfMax_m1_09' => $this->getRequestValue($request, 'setengah_mi_9', $tabId),
            'HalfMax_m1_10' => $this->getRequestValue($request, 'setengah_mi_10', $tabId),
            
            // FullMax (Kapasitas Maks) - m1
            'FullMax_m1_01' => $this->getRequestValue($request, 'kapasitas_mi_1', $tabId),
            'FullMax_m1_02' => $this->getRequestValue($request, 'kapasitas_mi_2', $tabId),
            'FullMax_m1_03' => $this->getRequestValue($request, 'kapasitas_mi_3', $tabId),
            'FullMax_m1_04' => $this->getRequestValue($request, 'kapasitas_mi_4', $tabId),
            'FullMax_m1_05' => $this->getRequestValue($request, 'kapasitas_mi_5', $tabId),
            'FullMax_m1_06' => $this->getRequestValue($request, 'kapasitas_mi_6', $tabId),
            'FullMax_m1_07' => $this->getRequestValue($request, 'kapasitas_mi_7', $tabId),
            'FullMax_m1_08' => $this->getRequestValue($request, 'kapasitas_mi_8', $tabId),
            'FullMax_m1_09' => $this->getRequestValue($request, 'kapasitas_mi_9', $tabId),
            'FullMax_m1_10' => $this->getRequestValue($request, 'kapasitas_mi_10', $tabId),

            // HalfMax (Setengah Kapasitas) - z1
            'HalfMax_z1_01' => $this->getRequestValue($request, 'setengah_zi_1', $tabId),
            'HalfMax_z1_02' => $this->getRequestValue($request, 'setengah_zi_2', $tabId),
            'HalfMax_z1_03' => $this->getRequestValue($request, 'setengah_zi_3', $tabId),
            'HalfMax_z1_04' => $this->getRequestValue($request, 'setengah_zi_4', $tabId),
            'HalfMax_z1_05' => $this->getRequestValue($request, 'setengah_zi_5', $tabId),
            'HalfMax_z1_06' => $this->getRequestValue($request, 'setengah_zi_6', $tabId),
            'HalfMax_z1_07' => $this->getRequestValue($request, 'setengah_zi_7', $tabId),
            'HalfMax_z1_08' => $this->getRequestValue($request, 'setengah_zi_8', $tabId),
            'HalfMax_z1_09' => $this->getRequestValue($request, 'setengah_zi_9', $tabId),
            'HalfMax_z1_10' => $this->getRequestValue($request, 'setengah_zi_10', $tabId),
            
            // FullMax (Kapasitas Maks) - z1
            'FullMax_z1_01' => $this->getRequestValue($request, 'kapasitas_zi_1', $tabId),
            'FullMax_z1_02' => $this->getRequestValue($request, 'kapasitas_zi_2', $tabId),
            'FullMax_z1_03' => $this->getRequestValue($request, 'kapasitas_zi_3', $tabId),
            'FullMax_z1_04' => $this->getRequestValue($request, 'kapasitas_zi_4', $tabId),
            'FullMax_z1_05' => $this->getRequestValue($request, 'kapasitas_zi_5', $tabId),
            'FullMax_z1_06' => $this->getRequestValue($request, 'kapasitas_zi_6', $tabId),
            'FullMax_z1_07' => $this->getRequestValue($request, 'kapasitas_zi_7', $tabId),
            'FullMax_z1_08' => $this->getRequestValue($request, 'kapasitas_zi_8', $tabId),
            'FullMax_z1_09' => $this->getRequestValue($request, 'kapasitas_zi_9', $tabId),
            'FullMax_z1_10' => $this->getRequestValue($request, 'kapasitas_zi_10', $tabId),
            
            // Off-Center Loading Test
            'bebanOffCenter' => $this->getRequestValue($request, 'beban_massa', $tabId),
            'offCenterFront' => $this->getRequestValue($request, 'effect_depan', $tabId),
            'offCenterMiddle' => $this->getRequestValue($request, 'effect_tengah', $tabId),
            'offCenterBack' => $this->getRequestValue($request, 'effect_belakang', $tabId),
            'offCenterRight' => $this->getRequestValue($request, 'effect_kanan', $tabId),
            'offCenterLeft' => $this->getRequestValue($request, 'effect_kiri', $tabId),
        ];
        
        // Cek apakah ada data untuk disimpan
        $hasAddData = false;
        foreach ($addData as $key => $value) {
            if ($key !== 'calibration_id' && $value !== null && $value !== '') {
                $hasAddData = true;
                break;
            }
        }
        
        if ($hasAddData) {
            $addRecord = AddTimbanganBias::create($addData);
            \Log::info('✅ AddTimbanganBias saved:', ['add_id' => $addRecord->id, 'tab_id' => $tabId]);
        } else {
            \Log::info('⚠️ No AddTimbanganBias data to save for tab ' . $tabId);
        }

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Calibrated by (nama_dikalibrasi)
        $calibratedBy = $this->getRequestValue($request, 'nama_dikalibrasi', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy, 'tab_id' => $tabId]);
        }
        
        // Verified by (nama_diperiksa)
        $verifiedBy = $this->getRequestValue($request, 'nama_diperiksa', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy, 'tab_id' => $tabId]);
        }
        
        // Bias factor
        $biasFactor = $this->getRequestValue($request, 'bias_factor', $tabId);
        if ($biasFactor) {
            $updateData['correction_factor'] = $biasFactor;
        }
        
        // Beban massa
        $bebanMassa = $this->getRequestValue($request, 'beban_massa', $tabId);
        if ($bebanMassa) {
            $updateData['beban_massa'] = $bebanMassa;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data for tab ' . $tabId);
        }

        // ==================================================================
        // 7. UPDATE JUMLAH FORM DI CALIBRATION
        // ==================================================================
        $totalForms = $calibration->jumlah_form ?? 1;
        if ($tabId > $totalForms) {
            $calibration->update(['jumlah_form' => $tabId]);
            \Log::info("✅ Updated jumlah_form to {$tabId}");
        }

        // ==================================================================
        // 8. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailTimbanganBias::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddTimbanganBias::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Timbangan Bias):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'tab_id' => $tabId,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateId,
            'alat_standar' => $alatStandarString,
        ]);

        \Log::info('🎉 storeTimbanganBias COMPLETED for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeTimbanganBias:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback jika terjadi error
        if (isset($head) && $head->id) {
            try {
                DetailTimbanganBias::where('calibration_id', $calibration->id)->delete();
                AddTimbanganBias::where('calibration_id', $calibration->id)->delete();
                $head->delete();
                \Log::info('🔄 Rollback completed for tab ' . $tabId);
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Timbangan Bias: " . $e->getMessage());
    }
}

private function updateTimbanganBias($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateTimbanganBias');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headTimbanganBias;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PRE-UPDATE: PASTIKAN calibratedBy dan verifiedBy TIDAK NULL
        // ==================================================================
        $preUpdateData = [];
        
        if ($request->filled('calibratedBy')) {
            $preUpdateData['calibratedBy'] = $request->calibratedBy;
            \Log::info('🔄 PRE-UPDATE calibratedBy from request:', ['value' => $request->calibratedBy]);
        }
        
        if ($request->filled('verifiedBy')) {
            $preUpdateData['verifiedBy'] = $request->verifiedBy;
            \Log::info('🔄 PRE-UPDATE verifiedBy from request:', ['value' => $request->verifiedBy]);
        }
        
        if (!empty($preUpdateData)) {
            $calibration->update($preUpdateData);
            \Log::info('✅ PRE-UPDATE calibration completed:', $preUpdateData);
        }
        
        $calibration->refresh();
        
        // ==================================================================
        // 2. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Timbangan Bias:', ['alat_standar' => $alatStandar]);
        
        // ==================================================================
        // 3. UPDATE ATAU BUAT HEAD TIMBANGAN BIAS
        // ==================================================================
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-15 (Monograph 4 : The Calibration of Weights and Balances, NMI Australia 2010)',
            'note' => $request->input('note'),
            'beban_setengah_kapasitas' => $request->input('beban_setengah_kapasitas'),
            'beban_kapasitas_maks' => $request->input('beban_kapasitas_maks'),
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head = $calibration->headTimbanganBias) {
            $head->update($headData);
            \Log::info('✅ HeadTimbanganBias updated', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadTimbanganBias::create($headData);
            \Log::info('➕ HeadTimbanganBias created', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 4. UPDATE DETAIL TIMBANGAN BIAS (HAPUS & BUAT BARU - 10 RECORD)
        // ==================================================================
        DetailTimbanganBias::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        \Log::info('📊 Updating 10 records for Timbangan Bias...');
        
        for ($i = 1; $i <= 10; $i++) {
            // Data untuk setiap baris - LANGSUNG tanpa format
            $titikUkur = $request->input("titikUkur_$i");
            $Lz1 = $request->input("Lz1_$i");
            $Lm1 = $request->input("Lm1_$i");
            $Rm1 = $request->input("Rm1_$i");
            $Rz1 = $request->input("Rz1_$i");
            $STD = $request->input("STD_$i");
            
            // SELALU simpan 10 record (agar kotak selalu muncul)
            $detailData = [
                'calibration_id' => $calibration->id,
                'titikUkur' => $titikUkur,
                'Lz1' => $Lz1,
                'Lm1' => $Lm1,
                'Rm1' => $Rm1,
                'Rz1' => $Rz1,
                'STD' => $STD,
            ];
            
            $record = DetailTimbanganBias::create($detailData);
            $detailCount++;
            
            \Log::debug("✅ Record {$i} saved", [
                'record_id' => $record->id,
                'titikUkur' => $detailData['titikUkur']
            ]);
        }
        
        \Log::info("✅ Updated {$detailCount} records for Timbangan Bias");
        
        // ==================================================================
        // 5. UPDATE ADD TIMBANGAN BIAS - LANGSUNG TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating AddTimbanganBias data...');
        
        $addUpdateData = [];
        
        // Off Center Data
        $addUpdateData['offCenterMiddle'] = $request->input('offCenterMiddle');
        $addUpdateData['offCenterFront'] = $request->input('offCenterFront');
        $addUpdateData['offCenterBack'] = $request->input('offCenterBack');
        $addUpdateData['offCenterRight'] = $request->input('offCenterRight');
        $addUpdateData['offCenterLeft'] = $request->input('offCenterLeft');
        
        // HalfMax (Setengah Kapasitas) - m1 dan z1 untuk 10 baris
        for ($i = 1; $i <= 10; $i++) {
            $addUpdateData["HalfMax_m1_" . str_pad($i, 2, '0', STR_PAD_LEFT)] = $request->input("HalfMax_m1_{$i}");
            $addUpdateData["HalfMax_z1_" . str_pad($i, 2, '0', STR_PAD_LEFT)] = $request->input("HalfMax_z1_{$i}");
        }
        
        // FullMax (Kapasitas Maks) - m1 dan z1 untuk 10 baris
        for ($i = 1; $i <= 10; $i++) {
            $addUpdateData["FullMax_m1_" . str_pad($i, 2, '0', STR_PAD_LEFT)] = $request->input("FullMax_m1_{$i}");
            $addUpdateData["FullMax_z1_" . str_pad($i, 2, '0', STR_PAD_LEFT)] = $request->input("FullMax_z1_{$i}");
        }
        
        // Filter null values
        $addUpdateData = array_filter($addUpdateData, function($value) {
            return $value !== null;
        });
        
        if ($addTimbangan = $calibration->addTimbanganBias) {
            if (!empty($addUpdateData)) {
                $addTimbangan->update($addUpdateData);
                \Log::info('✅ AddTimbanganBias updated');
            } else {
                \Log::info('⚠️ No AddTimbanganBias data to update');
            }
        } else {
            $addUpdateData['calibration_id'] = $calibration->id;
            AddTimbanganBias::create($addUpdateData);
            \Log::info('➕ AddTimbanganBias created');
        }
        
        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $finalUpdateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $finalUpdateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $finalUpdateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Update data lainnya
        $fieldsToUpdate = [
            'brandAlat', 'kodeAlat', 'typeAlat', 'NoSeri', 'kapasitas', 'resolusi',
            'pemilikAlat', 'tanggalMasuk', 'tanggalKalibrasi', 'jenisPembacaan',
            'tempatKalibrasi', 'lokasiPT', 'kondisiAlat', 'keterangan',
            'RT_condition1', 'RT_condition2', 'RT_condition3',
            'RH_condition1', 'RH_condition2', 'RH_condition3'
        ];
        
        foreach ($fieldsToUpdate as $field) {
            if ($request->filled($field)) {
                $finalUpdateData[$field] = $request->$field;
            }
        }
        
        if (!empty($finalUpdateData)) {
            $calibration->update($finalUpdateData);
            \Log::info('✅ Calibration updated:', array_keys($finalUpdateData));
        }
        
        // ==================================================================
        // 7. FINAL VERIFICATION
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headTimbanganBias;
        $detailCountFinal = DetailTimbanganBias::where('calibration_id', $calibration->id)->count();
        $addCountFinal = AddTimbanganBias::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Timbangan Bias):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $detailCountFinal,
            'add_records' => $addCountFinal,
            'alat_standar' => $alatStandarString,
            'calibrated_by' => $calibration->calibratedBy,
            'verified_by' => $calibration->verifiedBy,
            'beban_setengah_kapasitas' => $headBaru->beban_setengah_kapasitas ?? null,
            'beban_kapasitas_maks' => $headBaru->beban_kapasitas_maks ?? null,
        ]);

        \Log::info('🎉 updateTimbanganBias COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTimbanganBias:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        
        throw new \Exception("Gagal mengupdate data Timbangan Bias: " . $e->getMessage());
    }
}

private function storeGaugeBlock($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🚀 START storeGaugeBlock', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // DEBUG: CEK APAKAH FILE TERDETEKSI
        // ==================================================================
        \Log::info('🔍 DEBUG - Request has files?', [
            'has_file' => $request->hasFile('attachments'),
            'all_files' => array_keys($request->allFiles()),
            'files_count' => $request->hasFile('attachments') ? count($request->file('attachments')) : 0,
            'tab_id' => $tabId
        ]);
        
        // Jika ada file, log detailnya
        if ($request->hasFile('attachments')) {
            foreach ($request->file('attachments') as $index => $file) {
                \Log::info("🔍 DEBUG - File {$index}:", [
                    'name' => $file->getClientOriginalName(),
                    'size' => $file->getSize(),
                    'mime' => $file->getMimeType(),
                    'valid' => $file->isValid(),
                    'error' => $file->getError(),
                    'tab_id' => $tabId
                ]);
            }
        } else {
            \Log::warning('⚠️ DEBUG - TIDAK ADA FILE attachments DI REQUEST!', ['tab_id' => $tabId]);
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR (DENGAN DUKUNGAN _tab)
        // ==================================================================
        // Alat standar default
        $alatStandarDefault = 'Mesin ULM 01-600D';
        
        // Cek apakah ada alat standar dari checkbox atau textarea
        $alatStandarValues = [];
        
        // Cek checkbox
        $checkboxValue = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (is_array($checkboxValue) && count($checkboxValue) > 0) {
            $alatStandarValues = $checkboxValue;
        } else {
            // Cek textarea
            $textValue = trim($this->getRequestValue($request, 'alat_standar_text', $tabId) ?? '');
            if (!empty($textValue)) {
                $alatStandarValues = [$textValue];
            }
        }
        
        // Jika tidak ada, gunakan default
        $alatStandarString = !empty($alatStandarValues) ? implode(', ', $alatStandarValues) : $alatStandarDefault;
        
        // Calibration method (bisa dari request atau default)
        $calibrationMethod = $this->getRequestValue($request, 'calibration_method', $tabId);
        if (empty($calibrationMethod)) {
            $calibrationMethod = 'PAS-IK1102-65';
        }
        
        \Log::info('🔧 Alat standar:', [
            'standard' => $alatStandarString,
            'method' => $calibrationMethod,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // HANDLE MULTIPLE ATTACHMENTS (SIMPAN KE PUBLIC)
        // ==================================================================
        $attachmentPaths = [];
        $attachmentNames = [];
        $attachmentSizes = [];
        $attachmentMimes = [];
        
        if ($request->hasFile('attachments')) {
            foreach ($request->file('attachments') as $file) {
                if ($file->isValid()) {
                    try {
                        $originalName = $file->getClientOriginalName();
                        $safeName = preg_replace('/[^a-zA-Z0-9._-]/', '', $originalName);
                        $fileName = time() . '_' . uniqid() . '_' . $safeName;
                        
                        // Simpan ke folder public/uploads/gauge-block/
                        $destinationPath = public_path('uploads/gauge-block/' . $calibration->id);
                        
                        // Buat folder jika belum ada
                        if (!file_exists($destinationPath)) {
                            mkdir($destinationPath, 0777, true);
                        }
                        
                        // Pindahkan file ke public
                        $file->move($destinationPath, $fileName);
                        
                        // Path untuk disimpan di database (relatif dari public)
                        $filePath = 'uploads/gauge-block/' . $calibration->id . '/' . $fileName;
                        
                        $attachmentPaths[] = $filePath;
                        $attachmentNames[] = $originalName;
                        $attachmentSizes[] = $file->getSize();
                        $attachmentMimes[] = $file->getMimeType();
                        
                        \Log::info('📎 Attachment uploaded to public:', [
                            'path' => $filePath,
                            'name' => $originalName,
                            'tab_id' => $tabId
                        ]);
                    } catch (\Exception $e) {
                        \Log::error('❌ Failed to upload attachment:', [
                            'error' => $e->getMessage(),
                            'tab_id' => $tabId
                        ]);
                    }
                }
            }
        }

        // ==================================================================
        // 2. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $head = HeadGaugeBlock::where('calibration_id', $calibration->id)->first();
        
        $satuanUnit = $this->getRequestValue($request, 'satuan_unit', $tabId);
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod,
                'satuan_unit' => $satuanUnit,
                'attachment' => !empty($attachmentPaths) ? json_encode($attachmentPaths) : $head->attachment,
                'attachment_name' => !empty($attachmentNames) ? json_encode($attachmentNames) : $head->attachment_name,
                'attachment_size' => !empty($attachmentSizes) ? json_encode($attachmentSizes) : $head->attachment_size,
                'attachment_mime' => !empty($attachmentMimes) ? json_encode($attachmentMimes) : $head->attachment_mime,
                'certificate_id' => $certificateId,
            ]);
            \Log::info('✅ HeadGaugeBlock updated:', [
                'head_id' => $head->id, 
                'attachments_count' => count($attachmentPaths),
                'tab_id' => $tabId
            ]);
        } else {
            // Buat head baru
            $head = HeadGaugeBlock::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod,
                'satuan_unit' => $satuanUnit,
                'attachment' => !empty($attachmentPaths) ? json_encode($attachmentPaths) : null,
                'attachment_name' => !empty($attachmentNames) ? json_encode($attachmentNames) : null,
                'attachment_size' => !empty($attachmentSizes) ? json_encode($attachmentSizes) : null,
                'attachment_mime' => !empty($attachmentMimes) ? json_encode($attachmentMimes) : null,
            ]);
            \Log::info('✅ HeadGaugeBlock created:', [
                'head_id' => $head->id, 
                'attachments_count' => count($attachmentPaths),
                'tab_id' => $tabId
            ]);
        }

        // ==================================================================
        // 3. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $existingDetails = DetailGaugeBlock::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailGaugeBlock::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records for tab {$tabId}");
        }
        
        $existingAddData = AddGaugeBlock::where('calibration_id', $calibration->id)->count();
        if ($existingAddData > 0) {
            AddGaugeBlock::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingAddData} old add records for tab {$tabId}");
        }

        // ==================================================================
        // 4. SIMPAN DETAIL GAUGE BLOCK - 15 BARIS (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving DetailGaugeBlock...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 15; $i++) {
            // Ambil data dengan getRequestValue
            $titikUkur = $this->getRequestValue($request, "titikUkur_{$i}", $tabId);
            $noSeri = $this->getRequestValue($request, "NoSeri_{$i}", $tabId);
            $std = $this->getRequestValue($request, "STD_{$i}", $tabId);
            
            $hasData = ($titikUkur !== null && $titikUkur !== '') || 
                       ($noSeri !== null && $noSeri !== '') || 
                       ($std !== null && $std !== '');
            
            if ($hasData) {
                DetailGaugeBlock::create([
                    'calibration_id' => $calibration->id,
                    'head_gauge_block_id' => $head->id,
                    'titikUkur' => $titikUkur,
                    'NoSeri' => $noSeri,
                    'STD' => $std,
                    'C1M' => $this->getRequestValue($request, "C1M_{$i}", $tabId),
                    'C1UL' => $this->getRequestValue($request, "C1UL_{$i}", $tabId),
                    'C1LL' => $this->getRequestValue($request, "C1LL_{$i}", $tabId),
                    'C1UR' => $this->getRequestValue($request, "C1UR_{$i}", $tabId),
                    'C1LR' => $this->getRequestValue($request, "C1LR_{$i}", $tabId),
                    'C1C' => $this->getRequestValue($request, "C1C_{$i}", $tabId),
                    'C2M' => $this->getRequestValue($request, "C2M_{$i}", $tabId),
                    'C2UL' => $this->getRequestValue($request, "C2UL_{$i}", $tabId),
                    'C2LL' => $this->getRequestValue($request, "C2LL_{$i}", $tabId),
                    'C2UR' => $this->getRequestValue($request, "C2UR_{$i}", $tabId),
                    'C2LR' => $this->getRequestValue($request, "C2LR_{$i}", $tabId),
                    'C2C' => $this->getRequestValue($request, "C2C_{$i}", $tabId),
                ]);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailGaugeBlock records for tab {$tabId}");

        // ==================================================================
        // 5. SIMPAN ADD GAUGE BLOCK - 3 RECORD (Uji Kerataan) (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving AddGaugeBlock...');
        $addCount = 0;
        
        for ($i = 1; $i <= 3; $i++) {
            $titikUkurKerataan = $this->getRequestValue($request, "nominal_gauge_{$i}", $tabId);
            $kiriValue = $this->getRequestValue($request, "kiri{$i}", $tabId);
            $kananValue = $this->getRequestValue($request, "kanan{$i}", $tabId);
            
            $hasData = ($titikUkurKerataan !== null && $titikUkurKerataan !== '') || 
                       ($kiriValue !== null && $kiriValue !== '') || 
                       ($kananValue !== null && $kananValue !== '');
            
            if ($hasData) {
                AddGaugeBlock::create([
                    'calibration_id' => $calibration->id,
                    'head_gauge_block_id' => $head->id,
                    'titikUkurKerataan' => $titikUkurKerataan,
                    'Lsurface' => $kiriValue,
                    'Rsurface' => $kananValue,
                ]);
                $addCount++;
            }
        }
        
        \Log::info("✅ Saved {$addCount} AddGaugeBlock records for tab {$tabId}");

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Calibrated by
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy, 'tab_id' => $tabId]);
        }
        
        // Verified by
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy, 'tab_id' => $tabId]);
        }
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Alat standar
        if (!empty($alatStandarString)) {
            $updateData['alat_standar'] = $alatStandarString;
        }
        
        // Calibration method
        if ($calibrationMethod) {
            $updateData['calibration_method'] = $calibrationMethod;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data for tab ' . $tabId);
        }

        // ==================================================================
        // 7. UPDATE JUMLAH FORM DI CALIBRATION
        // ==================================================================
        $totalForms = $calibration->jumlah_form ?? 1;
        if ($tabId > $totalForms) {
            $calibration->update(['jumlah_form' => $tabId]);
            \Log::info("✅ Updated jumlah_form to {$tabId}");
        }

        // ==================================================================
        // 8. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailGaugeBlock::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddGaugeBlock::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Gauge Block):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'tab_id' => $tabId,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateId,
            'attachments_count' => count($attachmentPaths),
            'attachments' => $attachmentPaths,
        ]);

        \Log::info('🎉 storeGaugeBlock COMPLETED for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeGaugeBlock:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback jika terjadi error
        if (isset($head) && $head->id) {
            try {
                DetailGaugeBlock::where('calibration_id', $calibration->id)->delete();
                AddGaugeBlock::where('calibration_id', $calibration->id)->delete();
                $head->delete();
                \Log::info('🔄 Rollback completed for tab ' . $tabId);
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Gauge Block: " . $e->getMessage());
    }
}

private function updateGaugeBlock($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateGaugeBlock');

        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;

        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $calibration->namaAlat;
        $originalNamaAlat = $calibration->namaAlat;

        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        } elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
        } else {
            $existingHead = $calibration->headGaugeBlock;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
            }
        }

        // ==================================================================
        // 1. HANDLE MULTIPLE ATTACHMENTS
        // ==================================================================
        $head = $calibration->headGaugeBlock;

        // Ambil data attachment yang sudah ada
        $existingAttachments = [];
        $existingAttachmentNames = [];
        $existingAttachmentSizes = [];
        $existingAttachmentMimes = [];

        if ($head) {
            $existingAttachments = $head->attachment ? (is_string($head->attachment) ? json_decode($head->attachment, true) : ($head->attachment ?? [])) : [];
            $existingAttachmentNames = $head->attachment_name ? (is_string($head->attachment_name) ? json_decode($head->attachment_name, true) : ($head->attachment_name ?? [])) : [];
            $existingAttachmentSizes = $head->attachment_size ? (is_string($head->attachment_size) ? json_decode($head->attachment_size, true) : ($head->attachment_size ?? [])) : [];
            $existingAttachmentMimes = $head->attachment_mime ? (is_string($head->attachment_mime) ? json_decode($head->attachment_mime, true) : ($head->attachment_mime ?? [])) : [];
        }

        // 1a. HAPUS FILE YANG DIPILIH (files_to_delete)
        $filesToDelete = json_decode($request->input('files_to_delete', '[]'), true);
        if (!empty($filesToDelete) && is_array($filesToDelete)) {
            foreach ($filesToDelete as $fileName) {
                $index = array_search($fileName, $existingAttachmentNames);
                if ($index !== false) {
                    // Hapus file fisik dari storage
                    $filePath = $existingAttachments[$index] ?? null;
                    if ($filePath && Storage::disk('public')->exists($filePath)) {
                        Storage::disk('public')->delete($filePath);
                        \Log::info('🗑️ Attachment deleted:', ['path' => $filePath]);
                    }
                    // Hapus dari array
                    unset($existingAttachments[$index]);
                    unset($existingAttachmentNames[$index]);
                    unset($existingAttachmentSizes[$index]);
                    unset($existingAttachmentMimes[$index]);
                }
            }
            // Reindex array
            $existingAttachments = array_values($existingAttachments);
            $existingAttachmentNames = array_values($existingAttachmentNames);
            $existingAttachmentSizes = array_values($existingAttachmentSizes);
            $existingAttachmentMimes = array_values($existingAttachmentMimes);
        }

        // 1b. UPLOAD FILE BARU (multiple files)
        if ($request->hasFile('attachments')) {
            $files = $request->file('attachments');
            
            // Pastikan $files adalah array
            if (!is_array($files)) {
                $files = [$files];
            }
            
            foreach ($files as $file) {
                if ($file && $file->isValid()) {
                    $originalName = $file->getClientOriginalName();
                    
                    // Cek duplikat nama file
                    if (in_array($originalName, $existingAttachmentNames)) {
                        \Log::warning('⚠️ Duplicate file skipped:', ['name' => $originalName]);
                        continue;
                    }
                    
                    // Cek ukuran file (max 25MB)
                    if ($file->getSize() > 25 * 1024 * 1024) {
                        \Log::warning('⚠️ File too large, skipped:', ['name' => $originalName, 'size' => $file->getSize()]);
                        continue;
                    }
                    
                    // Generate nama file unik
                    $safeName = time() . '_' . uniqid() . '_' . preg_replace('/[^a-zA-Z0-9._-]/', '', $originalName);
                    
                    // Simpan ke folder uploads/gauge-block/{certificate_id}/
                    $certificateFolder = $head && $head->certificate_id ? $head->certificate_id : ($certificateIdBaru ?? 'temp');
                    $folderPath = 'uploads/gauge-block/' . $certificateFolder;
                    
                    // Simpan file
                    $filePath = $file->storeAs($folderPath, $safeName, 'public');
                    
                    if ($filePath) {
                        $existingAttachments[] = $filePath;
                        $existingAttachmentNames[] = $originalName;
                        $existingAttachmentSizes[] = $file->getSize();
                        $existingAttachmentMimes[] = $file->getMimeType();
                        
                        \Log::info('📎 New attachment uploaded:', [
                            'original_name' => $originalName,
                            'saved_as' => $safeName,
                            'path' => $filePath,
                            'size' => $file->getSize()
                        ]);
                    }
                }
            }
        }

        // ==================================================================
        // 2. UPDATE HEAD GAUGE BLOCK (DENGAN MULTIPLE ATTACHMENTS)
        // ==================================================================
        $textValue = trim($request->alat_standar_text ?? '');
        $arrayValue = $request->input('alat_standar', []);

        if (!empty($textValue)) {
            $standardValue = $textValue;
        } elseif (is_array($arrayValue) && count($arrayValue) > 0) {
            $standardValue = implode("\n", $arrayValue);
        } else {
            $standardValue = '';
        }

        $headData = [
            'standard' => $standardValue,
            'satuan_unit' => $request->satuan_unit ?? null,
            'calibrationMethod' => 'PAS-IK1102-09 (JIS B 7506:2003 (JMA/JSA); SNSU PK.P-09:2020)',
            'attachment' => !empty($existingAttachments) ? json_encode($existingAttachments) : null,
            'attachment_name' => !empty($existingAttachmentNames) ? json_encode($existingAttachmentNames) : null,
            'attachment_size' => !empty($existingAttachmentSizes) ? json_encode($existingAttachmentSizes) : null,
            'attachment_mime' => !empty($existingAttachmentMimes) ? json_encode($existingAttachmentMimes) : null,
            'updated_at' => now(),
        ];

        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
        }

        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadGaugeBlock updated:', [
                'head_id' => $head->id,
                'attachments_count' => count($existingAttachments),
                'attachments' => $existingAttachmentNames
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadGaugeBlock::create($headData);
            \Log::info('➕ HeadGaugeBlock created baru:', ['head_id' => $head->id]);
        }

        // ==================================================================
        // 3. UPDATE DETAIL GAUGE BLOCK (DELETE & RECREATE)
        // ==================================================================
        DetailGaugeBlock::where('calibration_id', $calibration->id)->delete();
        $detailCount = 0;

        for ($i = 1; $i <= 15; $i++) {
            $hasData = false;

            $titikUkur = $request->input("titikUkur_{$i}");
            $noSeri = $request->input("NoSeri_{$i}");
            $STD = $request->input("STD_{$i}");

            if (($titikUkur !== null && $titikUkur !== '') || 
                ($noSeri !== null && $noSeri !== '') || 
                ($STD !== null && $STD !== '')) {
                $hasData = true;
            }

            $c1Fields = ['C1M', 'C1UL', 'C1LL', 'C1UR', 'C1LR', 'C1C'];
            foreach ($c1Fields as $field) {
                if (($request->input("{$field}_{$i}") ?? '') !== '') {
                    $hasData = true;
                    break;
                }
            }

            $c2Fields = ['C2M', 'C2UL', 'C2LL', 'C2UR', 'C2LR', 'C2C'];
            foreach ($c2Fields as $field) {
                if (($request->input("{$field}_{$i}") ?? '') !== '') {
                    $hasData = true;
                    break;
                }
            }

            if ($hasData) {
                DetailGaugeBlock::create([
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    'NoSeri' => $noSeri,
                    'STD' => $STD,
                    'C1M' => $request->input("C1M_{$i}"),
                    'C1UL' => $request->input("C1UL_{$i}"),
                    'C1LL' => $request->input("C1LL_{$i}"),
                    'C1UR' => $request->input("C1UR_{$i}"),
                    'C1LR' => $request->input("C1LR_{$i}"),
                    'C1C' => $request->input("C1C_{$i}"),
                    'C2M' => $request->input("C2M_{$i}"),
                    'C2UL' => $request->input("C2UL_{$i}"),
                    'C2LL' => $request->input("C2LL_{$i}"),
                    'C2UR' => $request->input("C2UR_{$i}"),
                    'C2LR' => $request->input("C2LR_{$i}"),
                    'C2C' => $request->input("C2C_{$i}"),
                ]);
                $detailCount++;
            }
        }

        // ==================================================================
        // 4. UPDATE ADD GAUGE BLOCK
        // ==================================================================
        AddGaugeBlock::where('calibration_id', $calibration->id)->delete();
        $addCount = 0;

        for ($i = 1; $i <= 3; $i++) {
            $titikUkurKerataan = $request->input("titikUkurKerataan{$i}");
            $Lsurface = $request->input("Lsurface{$i}");
            $Rsurface = $request->input("Rsurface{$i}");

            $hasAddData = ($titikUkurKerataan !== null && $titikUkurKerataan !== '') || 
                          ($Lsurface !== null && $Lsurface !== '') || 
                          ($Rsurface !== null && $Rsurface !== '');

            if ($hasAddData) {
                AddGaugeBlock::create([
                    'calibration_id' => $calibration->id,
                    'titikUkurKerataan' => $titikUkurKerataan,
                    'Lsurface' => $Lsurface,
                    'Rsurface' => $Rsurface,
                    'note' => $request->input('note'),
                ]);
                $addCount++;
            }
        }

        // ==================================================================
        // 5. UPDATE CALIBRATION
        // ==================================================================
        $updateData = [];

        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
        }

        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
        }

        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }

        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }

        if (!empty($updateData)) {
            $calibration->update($updateData);
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('📋 UPDATE SUMMARY (Gauge Block):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $detailCount,
            'add_records' => $addCount,
            'certificate_id' => $head->certificate_id ?? null,
            'attachments_count' => count($existingAttachments),
            'attachments_deleted' => $filesToDelete ?? [],
            'attachments_new' => $existingAttachmentNames,
        ]);

        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateGaugeBlock:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
        ]);
        throw $e;
    }
}

/**
 * Hapus attachment file untuk Gauge Block
 * 
 * @param Request $request
 * @param string $id
 * @param int $index
 * @return \Illuminate\Http\JsonResponse
 */
public function deleteAttachment(Request $request, $id, $index)
{
    try {
        \Log::info('🗑️ DELETE ATTACHMENT GAUGE BLOCK:', [
            'calibration_id' => $id,
            'index' => $index
        ]);

        // Cari calibration
        $calibration = Calibration::findOrFail($id);
        
        // Ambil head Gauge Block
        $head = $calibration->headGaugeBlock;
        
        if (!$head) {
            return response()->json([
                'success' => false,
                'message' => 'Data Gauge Block tidak ditemukan'
            ], 404);
        }
        
        // Ambil data attachment yang sudah ada
        $existingAttachments = [];
        $existingAttachmentNames = [];
        $existingAttachmentSizes = [];
        $existingAttachmentMimes = [];
        
        if ($head->attachment) {
            $existingAttachments = is_string($head->attachment) ? json_decode($head->attachment, true) : ($head->attachment ?? []);
        }
        if ($head->attachment_name) {
            $existingAttachmentNames = is_string($head->attachment_name) ? json_decode($head->attachment_name, true) : ($head->attachment_name ?? []);
        }
        if ($head->attachment_size) {
            $existingAttachmentSizes = is_string($head->attachment_size) ? json_decode($head->attachment_size, true) : ($head->attachment_size ?? []);
        }
        if ($head->attachment_mime) {
            $existingAttachmentMimes = is_string($head->attachment_mime) ? json_decode($head->attachment_mime, true) : ($head->attachment_mime ?? []);
        }
        
        // Cek apakah index valid
        if (!isset($existingAttachments[$index])) {
            return response()->json([
                'success' => false,
                'message' => 'File tidak ditemukan'
            ], 400);
        }
        
        // Hapus file fisik dari storage public
        $filePath = $existingAttachments[$index];
        $fullPath = public_path($filePath);
        
        if (file_exists($fullPath)) {
            unlink($fullPath);
            \Log::info('✅ File deleted:', ['path' => $fullPath]);
        } else {
            \Log::warning('⚠️ File not found:', ['path' => $fullPath]);
        }
        
        // Hapus dari array
        unset($existingAttachments[$index]);
        unset($existingAttachmentNames[$index]);
        unset($existingAttachmentSizes[$index]);
        unset($existingAttachmentMimes[$index]);
        
        // Reindex array
        $existingAttachments = array_values($existingAttachments);
        $existingAttachmentNames = array_values($existingAttachmentNames);
        $existingAttachmentSizes = array_values($existingAttachmentSizes);
        $existingAttachmentMimes = array_values($existingAttachmentMimes);
        
        // Update ke database
        $head->attachment = !empty($existingAttachments) ? json_encode($existingAttachments) : null;
        $head->attachment_name = !empty($existingAttachmentNames) ? json_encode($existingAttachmentNames) : null;
        $head->attachment_size = !empty($existingAttachmentSizes) ? json_encode($existingAttachmentSizes) : null;
        $head->attachment_mime = !empty($existingAttachmentMimes) ? json_encode($existingAttachmentMimes) : null;
        $head->save();
        
        \Log::info('✅ Attachment deleted successfully:', [
            'calibration_id' => $id,
            'remaining' => count($existingAttachments)
        ]);
        
        return response()->json([
            'success' => true,
            'message' => 'File berhasil dihapus',
            'remaining' => count($existingAttachments),
            'attachments' => $existingAttachmentNames
        ]);
        
    } catch (\Exception $e) {
        \Log::error('❌ Error deleting attachment:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine()
        ]);
        
        return response()->json([
            'success' => false,
            'message' => 'Gagal menghapus file: ' . $e->getMessage()
        ], 500);
    }
}

private function storeHoletest($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🚀 START storeHoletest', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR (DENGAN DUKUNGAN _tab)
        // ==================================================================
        // Alat standar default
        $alatStandarDefault = 'RING GAUGE 3 ~ 45 mm';
        
        // Cek apakah ada alat standar dari checkbox atau textarea
        $alatStandarValues = [];
        
        // Cek checkbox
        $checkboxValue = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (is_array($checkboxValue) && count($checkboxValue) > 0) {
            $alatStandarValues = $checkboxValue;
        } else {
            // Cek textarea
            $textValue = trim($this->getRequestValue($request, 'alat_standar_text', $tabId) ?? '');
            if (!empty($textValue)) {
                $alatStandarValues = [$textValue];
            }
        }
        
        // Jika tidak ada, gunakan default
        $alatStandarString = !empty($alatStandarValues) ? implode(', ', $alatStandarValues) : $alatStandarDefault;
        
        // Calibration method (bisa dari request atau default)
        $calibrationMethod = $this->getRequestValue($request, 'calibration_method', $tabId);
        if (empty($calibrationMethod)) {
            $calibrationMethod = 'PAS-IK1102-49';
        }
        
        \Log::info('🔧 Alat standar:', [
            'standard' => $alatStandarString,
            'method' => $calibrationMethod,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $head = HeadHoletest::where('calibration_id', $calibration->id)->first();
        
        $satuanUnit = $this->getRequestValue($request, 'satuan_unit', $tabId);
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod,
                'satuan_unit' => $satuanUnit,
                'certificate_id' => $certificateId,
            ]);
            \Log::info('✅ HeadHoletest updated:', [
                'head_id' => $head->id,
                'tab_id' => $tabId
            ]);
        } else {
            // Buat head baru
            $head = HeadHoletest::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $alatStandarString,
                'calibrationMethod' => $calibrationMethod,
                'satuan_unit' => $satuanUnit,
            ]);
            \Log::info('✅ HeadHoletest created:', [
                'head_id' => $head->id,
                'tab_id' => $tabId
            ]);
        }

        // ==================================================================
        // 3. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $existingDetails = DetailHoletest::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailHoletest::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records for tab {$tabId}");
        }

        // ==================================================================
        // 4. SIMPAN DETAIL MEASUREMENTS - 14 BARIS (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving detail measurements...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 14; $i++) {
            // Ambil data dengan getRequestValue
            $titikUkur = $this->getRequestValue($request, "nominal_{$i}", $tabId);
            
            // Cek apakah ada penunjukan yang diisi (minimal satu)
            $hasPenunjukan = false;
            $penunjukan = [];
            for ($j = 1; $j <= 5; $j++) {
                $value = $this->getRequestValue($request, "penunjukan_{$i}_{$j}", $tabId);
                $penunjukan[$j] = $value;
                if (!empty($value)) {
                    $hasPenunjukan = true;
                }
            }
            
            // Simpan jika ada data nominal atau penunjukan
            if (!empty($titikUkur) || $hasPenunjukan) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_holetest_id' => $head->id,
                    'titikUkur' => $titikUkur ?? '',
                    'rep01' => $penunjukan[1] ?? null,
                    'rep02' => $penunjukan[2] ?? null,
                    'rep03' => $penunjukan[3] ?? null,
                    'rep04' => $penunjukan[4] ?? null,
                    'rep05' => $penunjukan[5] ?? null,
                ];

                \Log::debug("📝 Saving detail row {$i}:", $detailData);
                
                DetailHoletest::create($detailData);
                $detailCount++;
            } else {
                \Log::debug("⏭️ Skipping row {$i} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for tab {$tabId}");

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Calibrated by
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy, 'tab_id' => $tabId]);
        }
        
        // Verified by
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy, 'tab_id' => $tabId]);
        }
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Alat standar
        if (!empty($alatStandarString)) {
            $updateData['alat_standar'] = $alatStandarString;
        }
        
        // Calibration method
        if ($calibrationMethod) {
            $updateData['calibration_method'] = $calibrationMethod;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data for tab ' . $tabId);
        }

        // ==================================================================
        // 6. UPDATE JUMLAH FORM DI CALIBRATION
        // ==================================================================
        $totalForms = $calibration->jumlah_form ?? 1;
        if ($tabId > $totalForms) {
            $calibration->update(['jumlah_form' => $tabId]);
            \Log::info("✅ Updated jumlah_form to {$tabId}");
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailHoletest::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Holetest):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'tab_id' => $tabId,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $certificateId,
            'alat_standar' => $alatStandarString,
        ]);

        \Log::info('🎉 storeHoletest COMPLETED for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeHoletest:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback jika terjadi error
        if (isset($head) && $head->id) {
            try {
                DetailHoletest::where('calibration_id', $calibration->id)->delete();
                $head->delete();
                \Log::info('🔄 Rollback completed for tab ' . $tabId);
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Holetest: " . $e->getMessage());
    }
}

private function updateHoletest($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateHoletest =====', [
        'calibration_id' => $calibration->id,
        'certificate_id' => $calibration->headHoletest->certificate_id ?? 'N/A',
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headHoletest;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. UPDATE ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 ALAT STANDAR UPDATE:', [
            'count' => count($alatStandar),
            'items' => $alatStandar,
            'string_value' => $alatStandarString,
            'old_value' => $calibration->headHoletest->standard ?? 'null'
        ]);

        // Update head data
        $headData = [
            'standard' => $alatStandarString,
            'satuan_unit' => $request->satuan_unit,
            'calibrationMethod' => 'PAS-XX-XXXX (Metode Kalibrasi Hole Test)',
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head = $calibration->headHoletest) {
            $head->update($headData);
            \Log::info('✅ HEAD DATA UPDATED:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id,
                'standard_updated' => true,
                'satuan_unit_updated' => $request->satuan_unit,
            ]);
        } else {
            \Log::warning('⚠️ NO HEAD DATA FOUND, creating new...');
            
            $headData['calibration_id'] = $calibration->id;
            $head = HeadHoletest::create($headData);
            
            \Log::info('➕ NEW HEAD CREATED:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS - LANGSUNG TANPA FORMAT
        // ==================================================================
        \Log::info('📊 DETAIL MEASUREMENTS UPDATE:', [
            'old_records_count' => DetailHoletest::where('calibration_id', $calibration->id)->count(),
            'new_titikUkur_count' => is_array($request->titikUkur) ? count(array_filter($request->titikUkur)) : 0
        ]);
        
        // Hapus data detail lama
        $deletedCount = DetailHoletest::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ OLD DATA DELETED:', ['deleted_count' => $deletedCount]);
        
        // Simpan data detail baru - 10 BARIS
        $detailCount = 0;
        $errors = [];
        $maxRows = 10;
        
        for ($i = 0; $i < $maxRows; $i++) {
            // Ambil data - LANGSUNG tanpa format
            $titikUkur = $request->input("titikUkur.{$i}") ?? $request->titikUkur[$i] ?? null;
            $rep01 = $request->input("rep01.{$i}") ?? $request->rep01[$i] ?? null;
            $rep02 = $request->input("rep02.{$i}") ?? $request->rep02[$i] ?? null;
            $rep03 = $request->input("rep03.{$i}") ?? $request->rep03[$i] ?? null;
            $rep04 = $request->input("rep04.{$i}") ?? $request->rep04[$i] ?? null;
            $rep05 = $request->input("rep05.{$i}") ?? $request->rep05[$i] ?? null;
            
            // Check if row has data
            $hasData = !empty(trim($titikUkur ?? '')) || 
                      !empty(trim($rep01 ?? '')) || 
                      !empty(trim($rep02 ?? '')) || 
                      !empty(trim($rep03 ?? '')) || 
                      !empty(trim($rep04 ?? '')) || 
                      !empty(trim($rep05 ?? ''));
            
            if ($hasData) {
                try {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $titikUkur,  // LANGSUNG, tanpa format
                        'rep01' => $rep01,          // LANGSUNG, tanpa format
                        'rep02' => $rep02,          // LANGSUNG, tanpa format
                        'rep03' => $rep03,          // LANGSUNG, tanpa format
                        'rep04' => $rep04,          // LANGSUNG, tanpa format
                        'rep05' => $rep05,          // LANGSUNG, tanpa format
                    ];
                    
                    \Log::debug("💾 SAVING ROW {$i}:", ['data' => $detailData]);
                    
                    DetailHoletest::create($detailData);
                    $detailCount++;
                    
                } catch (\Exception $rowError) {
                    $errors[] = "Row {$i}: " . $rowError->getMessage();
                    \Log::error("❌ ROW {$i} SAVE ERROR:", [
                        'error' => $rowError->getMessage()
                    ]);
                }
            } else {
                \Log::debug("⏭️ SKIPPING EMPTY ROW {$i}");
            }
        }
        
        \Log::info("✅ DETAIL DATA SAVED:", [
            'total_records' => $detailCount,
            'errors_count' => count($errors)
        ]);

        // ==================================================================
        // 3. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if ($request->filled('temperature')) {
            $updateData['temperature'] = $request->temperature;
        }
        
        if ($request->filled('humidity')) {
            $updateData['humidity'] = $request->humidity;
        }
        
        if ($request->filled('calibration_date')) {
            $updateData['calibration_date'] = $request->calibration_date;
        }
        
        if ($request->filled('next_calibration_date')) {
            $updateData['next_calibration_date'] = $request->next_calibration_date;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 CALIBRATION ADDITIONAL DATA UPDATED:', array_keys($updateData));
        }

        // ==================================================================
        // 4. VERIFY SAVED DATA
        // ==================================================================
        $savedDetails = DetailHoletest::where('calibration_id', $calibration->id)
            ->orderBy('id')
            ->get();
            
        \Log::info('🔍 VERIFY SAVED DATA:', [
            'total_saved' => $savedDetails->count(),
            'first_3_rows_sample' => $savedDetails->take(3)->map(function($item) {
                return [
                    'id' => $item->id,
                    'titikUkur' => $item->titikUkur,
                    'rep01' => $item->rep01,
                    'rep02' => $item->rep02,
                    'rep03' => $item->rep03,
                    'rep04' => $item->rep04,
                    'rep05' => $item->rep05,
                ];
            })->toArray()
        ]);

        // ==================================================================
        // 5. FINAL SUMMARY
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headHoletest;
        $finalDetailCount = DetailHoletest::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY:', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $finalDetailCount,
            'alat_standar' => $alatStandarString,
            'satuan_unit' => $headBaru->satuan_unit ?? 'N/A',
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
            'temperature' => $calibration->temperature,
            'humidity' => $calibration->humidity,
        ]);

        \Log::info('🎉 updateHoletest COMPLETED SUCCESSFULLY');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 updateHoletest FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString(),
            'calibration_id' => $calibration->id ?? 'unknown'
        ]);
        throw $e;
    }
}


private function storeConductivityMeter($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🚀 START storeConductivityMeter', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR (DENGAN DUKUNGAN _tab)
        // ==================================================================
        // Ambil nilai dari input alat_standar (bisa array dari checkbox)
        $alatStandarArray = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (!is_array($alatStandarArray)) {
            $alatStandarArray = $request->input('alat_standar', []);
        }
        
        \Log::info('🔍 Alat standar dari request:', [
            'alat_standar' => $alatStandarArray,
            'tab_id' => $tabId
        ]);
        
        // Jika berupa array, proses menjadi string
        if (is_array($alatStandarArray)) {
            // Filter nilai yang tidak kosong
            $filtered = array_filter($alatStandarArray, function($value) {
                return !empty($value) && $value !== 'on';
            });
            
            if (!empty($filtered)) {
                $standardValue = implode(', ', $filtered);
            } else {
                $standardValue = 'CRM, Thermoscientific';
            }
        } else {
            // Jika berupa string
            $standardValue = !empty($alatStandarArray) ? $alatStandarArray : 'CRM, Thermoscientific';
        }
        
        // Cek checkbox TES (jika ada input terpisah)
        $alatStandarTes = $this->getRequestValue($request, 'alat_standar_tes', $tabId);
        if ($alatStandarTes == 'TES') {
            if (!str_contains($standardValue, 'TES')) {
                $standardValue .= ', TES';
            }
        }
        
        // Cek checkbox TFA (jika ada input terpisah)
        $alatStandarTfa = $this->getRequestValue($request, 'alat_standar_tfa', $tabId);
        if ($alatStandarTfa == 'TFA') {
            if (!str_contains($standardValue, 'TFA')) {
                $standardValue .= ', TFA';
            }
        }
        
        // Bersihkan format: pastikan tidak ada titik di akhir
        $standardValue = rtrim($standardValue, '.');
        $standardValue = trim($standardValue);
        
        // Calibration method (bisa dari request atau default)
        $calibrationMethod = $this->getRequestValue($request, 'calibration_method', $tabId);
        if (empty($calibrationMethod)) {
            $calibrationMethod = 'PAS-IK1102-41';
        }
        
        \Log::info('🔧 Alat standar final:', [
            'standard' => $standardValue,
            'method' => $calibrationMethod,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $head = HeadConductivityMeter::where('calibration_id', $calibration->id)->first();
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $standardValue,
                'calibrationMethod' => $calibrationMethod,
                'certificate_id' => $certificateId,
            ]);
            \Log::info('✅ HeadConductivityMeter updated:', [
                'head_id' => $head->id,
                'tab_id' => $tabId
            ]);
        } else {
            // Buat head baru
            $head = HeadConductivityMeter::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $standardValue,
                'calibrationMethod' => $calibrationMethod,
            ]);
            \Log::info('✅ HeadConductivityMeter created:', [
                'head_id' => $head->id,
                'tab_id' => $tabId
            ]);
        }

        // ==================================================================
        // 3. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $existingDetails = DetailConductivityMeter::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailConductivityMeter::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records for tab {$tabId}");
        }

        // ==================================================================
        // 4. SIMPAN DETAIL CONDUCTIVITY METER (6 BARIS) - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving DetailConductivityMeter data (6 rows)...');
        $detailCount = 0;

        for ($i = 1; $i <= 6; $i++) {
            // Ambil data nilai CRM dari request dengan getRequestValue
            $nilaiCRM = $this->getRequestValue($request, "nilai_crm_{$i}", $tabId);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($nilaiCRM);
            
            // Cek pembacaan alat 1-5 untuk baris ini
            for ($j = 1; $j <= 5; $j++) {
                $fieldValue = $this->getRequestValue($request, "pembacaan_{$i}_{$j}", $tabId);
                if (!empty($fieldValue)) {
                    $hasData = true;
                    break;
                }
            }
            
            // Cek resolusi
            $resolusi = $this->getRequestValue($request, "resolusi_{$i}", $tabId);
            if (!empty($resolusi)) {
                $hasData = true;
            }
            
            // Cek suhu CRM
            $suhuCRM = $this->getRequestValue($request, "suhu_crm_{$i}", $tabId);
            if (!empty($suhuCRM)) {
                $hasData = true;
            }
            
            // Simpan jika ada data - LANGSUNG TANPA FORMAT
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_conductivity_meter_id' => $head->id,
                    'nilaiCRM' => $nilaiCRM,
                    'rep01' => $this->getRequestValue($request, "pembacaan_{$i}_1", $tabId),
                    'rep02' => $this->getRequestValue($request, "pembacaan_{$i}_2", $tabId),
                    'rep03' => $this->getRequestValue($request, "pembacaan_{$i}_3", $tabId),
                    'rep04' => $this->getRequestValue($request, "pembacaan_{$i}_4", $tabId),
                    'rep05' => $this->getRequestValue($request, "pembacaan_{$i}_5", $tabId),
                    'Resolusi' => $resolusi,
                    'suhuCRM' => $suhuCRM,
                ];

                DetailConductivityMeter::create($detailData);
                $detailCount++;
                
                \Log::debug("📝 Saved Conductivity Meter row {$i} for tab {$tabId}", [
                    'nilaiCRM' => $nilaiCRM,
                ]);
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailConductivityMeter records for tab {$tabId}");

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Calibrated by (ttd_dikalibrasi)
        $calibratedBy = $this->getRequestValue($request, 'ttd_dikalibrasi', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy, 'tab_id' => $tabId]);
        }
        
        // Verified by (ttd_diperiksa)
        $verifiedBy = $this->getRequestValue($request, 'ttd_diperiksa', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy, 'tab_id' => $tabId]);
        }
        
        // Data kondisi lingkungan - Suhu
        $temperature = $this->getRequestValue($request, 'RT_condition1', $tabId);
        if ($temperature) {
            $updateData['temperature'] = $temperature;
        }
        
        // Data kondisi lingkungan - Kelembaban
        $humidity = $this->getRequestValue($request, 'RH_condition1', $tabId);
        if ($humidity) {
            $updateData['humidity'] = $humidity;
        }
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Alat standar
        if (!empty($standardValue)) {
            $updateData['alat_standar'] = $standardValue;
        }
        
        // Calibration method
        if ($calibrationMethod) {
            $updateData['calibration_method'] = $calibrationMethod;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data for tab ' . $tabId);
        }

        // ==================================================================
        // 6. UPDATE JUMLAH FORM DI CALIBRATION
        // ==================================================================
        $totalForms = $calibration->jumlah_form ?? 1;
        if ($tabId > $totalForms) {
            $calibration->update(['jumlah_form' => $tabId]);
            \Log::info("✅ Updated jumlah_form to {$tabId}");
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailConductivityMeter::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Conductivity Meter):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'tab_id' => $tabId,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $certificateId,
            'alat_standar' => $standardValue,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 storeConductivityMeter COMPLETED for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeConductivityMeter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback jika terjadi error
        if (isset($head) && $head->id) {
            try {
                DetailConductivityMeter::where('calibration_id', $calibration->id)->delete();
                $head->delete();
                \Log::info('🔄 Rollback completed for tab ' . $tabId);
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Conductivity Meter: " . $e->getMessage());
    }
}

private function updateConductivityMeter($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateConductivityMeter');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headConductivityMeter;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. UPDATE HEAD CONDUCTIVITY METER
        // ==================================================================
        // Ambil nilai dari input alat_standar (ARRAY)
        $alatStandarArray = $request->input('alat_standar', []);
        
        \Log::info('🔍 Alat standar array:', ['alat_standar' => $alatStandarArray]);
        
        // Inisialisasi nilai standard
        $standardValue = 'CRM, Thermoscientific';
        $tesSelected = false;
        $tfaSelected = false;
        
        // Proses array untuk mendapatkan nilai
        foreach ($alatStandarArray as $value) {
            if ($value === 'TES') {
                $tesSelected = true;
            } elseif ($value === 'TFA') {
                $tfaSelected = true;
            } elseif (str_contains($value, 'CRM') || str_contains($value, 'Thermoscientific')) {
                $standardValue = $value;
            }
        }
        
        // Tambahkan TES jika dipilih
        if ($tesSelected && !str_contains($standardValue, 'TES')) {
            $standardValue .= ', TES';
        }
        
        // Tambahkan TFA jika dipilih
        if ($tfaSelected && !str_contains($standardValue, 'TFA')) {
            $standardValue .= ', TFA';
        }
        
        // Bersihkan format
        $standardValue = preg_replace('/,\s*,/', ',', $standardValue);
        $standardValue = trim($standardValue, ', ');
        $standardValue = rtrim($standardValue, '.');
        
        \Log::info('🔧 Standard value:', ['standard' => $standardValue]);
        
        // Data untuk head
        $headData = [
            'standard' => $standardValue,
            'calibrationMethod' => $request->calibration_method ?? 'PAS-IK1102-41',
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        // Update atau create head
        if ($head = $calibration->headConductivityMeter) {
            $head->update($headData);
            \Log::info('✅ HeadConductivityMeter updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadConductivityMeter::create($headData);
            \Log::info('➕ HeadConductivityMeter created baru:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL CONDUCTIVITY METER - TANPA formatNumericValue
        // ==================================================================
        // Hapus data detail lama
        DetailConductivityMeter::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        // Ambil data details dari request (sesuai dengan name="details[...]")
        $details = $request->input('details', []);
        
        \Log::info('📋 Details dari form:', ['count' => count($details)]);
        
        // Proses setiap baris detail - LANGSUNG TANPA FORMAT
        foreach ($details as $index => $detail) {
            // Cek apakah baris memiliki data
            $nilaiCRM = $detail['nilaiCRM'] ?? null;
            $rep01 = $detail['rep01'] ?? null;
            $rep02 = $detail['rep02'] ?? null;
            $rep03 = $detail['rep03'] ?? null;
            $rep04 = $detail['rep04'] ?? null;
            $rep05 = $detail['rep05'] ?? null;
            $resolusi = $detail['Resolusi'] ?? null;
            $suhuCRM = $detail['suhuCRM'] ?? null;
            
            $hasData = !empty($nilaiCRM) || !empty($rep01) || !empty($rep02) || 
                      !empty($rep03) || !empty($rep04) || !empty($rep05) || 
                      !empty($resolusi) || !empty($suhuCRM);
            
            if ($hasData) {
                DetailConductivityMeter::create([
                    'calibration_id' => $calibration->id,
                    'nilaiCRM' => $nilaiCRM,      // LANGSUNG, tanpa format
                    'rep01' => $rep01,            // LANGSUNG, tanpa format
                    'rep02' => $rep02,            // LANGSUNG, tanpa format
                    'rep03' => $rep03,            // LANGSUNG, tanpa format
                    'rep04' => $rep04,            // LANGSUNG, tanpa format
                    'rep05' => $rep05,            // LANGSUNG, tanpa format
                    'Resolusi' => $resolusi,      // LANGSUNG, tanpa format
                    'suhuCRM' => $suhuCRM,        // LANGSUNG, tanpa format
                ]);
                $detailCount++;
                
                \Log::debug("📝 Updated Conductivity Meter row " . ($index + 1), [
                    'nilaiCRM' => $nilaiCRM,
                ]);
            }
        }
        
        \Log::info('✅ DetailConductivityMeter updated:', ['total_records' => $detailCount]);

        // ==================================================================
        // 3. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Gunakan ttd_dikalibrasi dan ttd_diperiksa dari form
        if ($request->filled('ttd_dikalibrasi')) {
            $updateData['calibrated_by'] = $request->ttd_dikalibrasi;
        }
        
        if ($request->filled('ttd_diperiksa')) {
            $updateData['verified_by'] = $request->ttd_diperiksa;
        }
        
        // Data kondisi lingkungan
        if ($request->filled('RT_condition1')) {
            $updateData['temperature'] = $request->RT_condition1;
        }
        
        if ($request->filled('RH_condition1')) {
            $updateData['humidity'] = $request->RH_condition1;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated:', array_keys($updateData));
        }

        // ==================================================================
        // 4. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headConductivityMeter;
        $finalDetailCount = DetailConductivityMeter::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Conductivity Meter):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $finalDetailCount,
            'standard' => $standardValue,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updateConductivityMeter COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateConductivityMeter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function storeCoatingThickness($request, $calibration, $certificateId, $tabId = null)
{
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('🚀 START storeCoatingThickness', [
            'calibration_id' => $calibration->id,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR: SELALU ADA 2 ITEM DIPISAH KOMA
        // ==================================================================
        // Item pertama: selalu Coating Film Standar
        $alatStandar = ['Coating Film Standar'];

        // Proses No Seri (dengan dukungan _tab)
        $noSeriValue = '';

        $selectedOption = $this->getRequestValue($request, 'no_seri_pilihan', $tabId);
        
        if ($selectedOption == '1') {
            $noSeriInput = $this->getRequestValue($request, 'no_seri_1', $tabId);
            $noSeriValue = $noSeriInput ? trim($noSeriInput) : '';
        } elseif ($selectedOption == '2') {
            $noSeriValue = 'T99022255-1';
        }

        // Fallback jika tidak ada pilihan atau kosong
        if (empty($noSeriValue)) {
            $noSeriValue = 'T99022255-1';
        }

        \Log::info('🔢 No Seri selected:', [
            'value' => $noSeriValue,
            'tab_id' => $tabId
        ]);

        // Tambahkan dengan label "No. Seri"
        $alatStandar[] = 'No. Seri ' . $noSeriValue;

        // Gabungkan dengan koma
        $finalStandard = implode(', ', $alatStandar);

        // Calibration method (bisa dari request atau default)
        $calibrationMethod = $this->getRequestValue($request, 'calibration_method', $tabId);
        if (empty($calibrationMethod)) {
            $calibrationMethod = 'PAS-IK1102-46';
        }

        \Log::info('🔧 Final standard value (saved to DB):', [
            'standard' => $finalStandard,
            'method' => $calibrationMethod,
            'tab_id' => $tabId
        ]);

        // ==================================================================
        // 2. CEK APAKAH HEAD SUDAH ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $head = HeadCoatingThickness::where('calibration_id', $calibration->id)->first();
        
        $satuanUnit = $this->getRequestValue($request, 'satuan_unit', $tabId);
        
        if ($head) {
            // Update head yang sudah ada
            $head->update([
                'standard' => $finalStandard,
                'calibrationMethod' => $calibrationMethod,
                'satuan_unit' => $satuanUnit,
                'certificate_id' => $certificateId,
            ]);
            \Log::info('✅ HeadCoatingThickness updated:', [
                'head_id' => $head->id,
                'standard' => $head->standard,
                'tab_id' => $tabId
            ]);
        } else {
            // Buat head baru
            $head = HeadCoatingThickness::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $finalStandard,
                'calibrationMethod' => $calibrationMethod,
                'satuan_unit' => $satuanUnit,
            ]);
            \Log::info('✅ HeadCoatingThickness created:', [
                'head_id' => $head->id,
                'standard' => $head->standard,
                'tab_id' => $tabId
            ]);
        }

        // ==================================================================
        // 3. HAPUS DETAIL LAMA JIKA ADA (UNTUK UPDATE) - TANPA form_index
        // ==================================================================
        $existingDetails = DetailCoatingThickness::where('calibration_id', $calibration->id)->count();
        if ($existingDetails > 0) {
            DetailCoatingThickness::where('calibration_id', $calibration->id)->delete();
            \Log::info("🔄 Deleted {$existingDetails} old detail records for tab {$tabId}");
        }

        // ==================================================================
        // 4. SIMPAN DETAIL COATING THICKNESS - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving detailCoatingThickness data...');
        $detailCount = 0;

        $jumlah_baris = 12;
        
        for ($row = 1; $row <= $jumlah_baris; $row++) {
            // Ambil data dengan getRequestValue
            $titikUkur = $this->getRequestValue($request, "nominal_{$row}", $tabId);
            
            $hasData = false;
            
            if ($titikUkur !== null && $titikUkur !== '') {
                $hasData = true;
            } else {
                for ($col = 1; $col <= 5; $col++) {
                    $value = $this->getRequestValue($request, "pembacaan_{$row}_{$col}", $tabId);
                    if (!empty($value)) {
                        $hasData = true;
                        break;
                    }
                }
                
                if (!$hasData) {
                    $resolusi = $this->getRequestValue($request, "resolusi_{$row}", $tabId);
                    if (!empty($resolusi)) {
                        $hasData = true;
                    }
                }
            }
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_coating_thickness_id' => $head->id,
                    'titikUkur' => $titikUkur,
                    'rep01' => $this->getRequestValue($request, "pembacaan_{$row}_1", $tabId),
                    'rep02' => $this->getRequestValue($request, "pembacaan_{$row}_2", $tabId),
                    'rep03' => $this->getRequestValue($request, "pembacaan_{$row}_3", $tabId),
                    'rep04' => $this->getRequestValue($request, "pembacaan_{$row}_4", $tabId),
                    'rep05' => $this->getRequestValue($request, "pembacaan_{$row}_5", $tabId),
                    'resolusi' => $this->getRequestValue($request, "resolusi_{$row}", $tabId),
                ];

                DetailCoatingThickness::create($detailData);
                $detailCount++;
                
                \Log::debug("📝 Saved Coating Thickness row {$row} for tab {$tabId}", [
                    'titikUkur' => $titikUkur,
                    'pembacaan_1' => $this->getRequestValue($request, "pembacaan_{$row}_1", $tabId),
                ]);
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detailCoatingThickness records for tab {$tabId}");

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN (TTD) - DENGAN DUKUNGAN _tab
        // ==================================================================
        $updateData = [];
        
        // Calibrated by
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibratedBy'] = $calibratedBy;
        } else {
            $updateData['calibratedBy'] = '-';
            \Log::warning('⚠️ calibrated_by kosong, set calibratedBy = "-" for tab ' . $tabId);
        }
        
        // Verified by
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verifiedBy'] = $verifiedBy;
        } else {
            $updateData['verifiedBy'] = '-';
            \Log::warning('⚠️ verified_by kosong, set verifiedBy = "-" for tab ' . $tabId);
        }
        
        // Nama kalibrator
        $namaKalibrator = $this->getRequestValue($request, 'nama_kalibrator', $tabId);
        if ($namaKalibrator) {
            $updateData['calibrator_name'] = $namaKalibrator;
        }
        
        // Nama pemeriksa
        $namaPemeriksa = $this->getRequestValue($request, 'nama_pemeriksa', $tabId);
        if ($namaPemeriksa) {
            $updateData['verifier_name'] = $namaPemeriksa;
        }
        
        // Uncertainty
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
        }
        
        // Conclusion
        $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
        if ($conclusion) {
            $updateData['keterangan'] = $conclusion;
        }
        
        // Alat standar
        if (!empty($finalStandard)) {
            $updateData['alat_standar'] = $finalStandard;
        }
        
        // Calibration method
        if ($calibrationMethod) {
            $updateData['calibration_method'] = $calibrationMethod;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data for tab ' . $tabId, $updateData);
        }

        // ==================================================================
        // 6. UPDATE JUMLAH FORM DI CALIBRATION
        // ==================================================================
        $totalForms = $calibration->jumlah_form ?? 1;
        if ($tabId > $totalForms) {
            $calibration->update(['jumlah_form' => $tabId]);
            \Log::info("✅ Updated jumlah_form to {$tabId}");
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailCoatingThickness::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Coating Thickness):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'tab_id' => $tabId,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $certificateId,
            'standard' => $finalStandard,
            'calibratedBy' => $calibration->calibratedBy ?? null,
            'verifiedBy' => $calibration->verifiedBy ?? null,
        ]);

        \Log::info('🎉 storeCoatingThickness COMPLETED for tab ' . $tabId);
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeCoatingThickness:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback jika terjadi error
        if (isset($head) && $head->id) {
            try {
                DetailCoatingThickness::where('calibration_id', $calibration->id)->delete();
                $head->delete();
                \Log::info('🔄 Rollback completed for tab ' . $tabId);
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Coating Thickness: " . $e->getMessage());
    }
}

private function updateCoatingThickness($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateCoatingThickness');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headCoatingThickness;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. AMBIL ATAU BUAT HEAD COATING THICKNESS
        // ==================================================================
        $head = HeadCoatingThickness::where('calibration_id', $calibration->id)->first();
        
        // ==================================================================
        // 2. PROSES ALAT STANDAR: SELALU ADA 2 ITEM DIPISAH KOMA
        // ==================================================================
        // Cek apakah alat_standar berupa array atau string
        $alatStandarInput = $request->input('alat_standar');
        
        // Jika berupa array, ambil item pertama atau gabungkan
        if (is_array($alatStandarInput)) {
            if (count($alatStandarInput) == 1) {
                $alatStandar = [$alatStandarInput[0]];
            } else {
                $alatStandar = $alatStandarInput;
            }
        } else {
            $alatStandar = [$alatStandarInput ?: 'Coating Film Standar'];
        }
        
        // Proses No Seri
        $noSeriValue = '';
        
        if ($request->has('no_seri_pilihan')) {
            $selectedOption = $request->input('no_seri_pilihan');
            
            if ($selectedOption == 'custom') {
                $noSeriInput = $request->input('no_seri_custom', '');
                $noSeriValue = $noSeriInput ? trim($noSeriInput) : '';
            } elseif ($selectedOption == 'default') {
                $noSeriValue = 'T99022255-1';
            }
        }
        
        // Fallback jika tidak ada pilihan atau kosong
        if (empty($noSeriValue)) {
            $noSeriValue = 'T99022255-1';
        }
        
        \Log::info('🔢 No Seri selected:', ['value' => $noSeriValue]);
        
        // Pastikan $alatStandar adalah array sebelum implode
        if (!is_array($alatStandar)) {
            $alatStandar = [$alatStandar];
        }
        
        // Tambahkan dengan label "No. Seri"
        $alatStandar[] = 'No. Seri ' . $noSeriValue;
        
        // Gabungkan dengan koma
        $finalStandard = implode(', ', $alatStandar);
        
        \Log::info('🔧 Final standard value (saved to DB):', ['standard' => $finalStandard]);
        
        // ==================================================================
        // 3. UPDATE ATAU BUAT HEAD COATING THICKNESS
        // ==================================================================
        $headData = [
            'standard' => $finalStandard,
            'calibrationMethod' => $request->calibration_method ?? 'PAS-IK1102-46',
            'satuan_unit' => $request->satuan_unit,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadCoatingThickness updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id,
                'standard' => $head->standard
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadCoatingThickness::create($headData);
            \Log::info('➕ HeadCoatingThickness created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null,
                'standard' => $head->standard
            ]);
        }
        
        // ==================================================================
        // 4. UPDATE DETAIL COATING THICKNESS - TANPA formatNumericValue
        // ==================================================================
        \Log::info('📊 Updating detailCoatingThickness data...');
        
        // Hapus detail lama
        $deletedCount = DetailCoatingThickness::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records:', ['count' => $deletedCount]);
        
        // Simpan detail baru - LANGSUNG TANPA FORMAT
        $detailCount = 0;
        
        if ($request->has('detail') && is_array($request->detail)) {
            foreach ($request->detail as $row => $data) {
                // Cek apakah baris ini memiliki data
                $titikUkur = $data['titikUkur'] ?? null;
                $rep01 = $data['rep01'] ?? null;
                $rep02 = $data['rep02'] ?? null;
                $rep03 = $data['rep03'] ?? null;
                $rep04 = $data['rep04'] ?? null;
                $rep05 = $data['rep05'] ?? null;
                $resolusi = $data['resolusi'] ?? null;
                
                $hasData = !empty($titikUkur) || !empty($rep01) || !empty($rep02) || 
                          !empty($rep03) || !empty($rep04) || !empty($rep05) || 
                          !empty($resolusi);
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'titikUkur' => $titikUkur,      // LANGSUNG, tanpa format
                        'rep01' => $rep01,              // LANGSUNG, tanpa format
                        'rep02' => $rep02,              // LANGSUNG, tanpa format
                        'rep03' => $rep03,              // LANGSUNG, tanpa format
                        'rep04' => $rep04,              // LANGSUNG, tanpa format
                        'rep05' => $rep05,              // LANGSUNG, tanpa format
                        'resolusi' => $resolusi,        // LANGSUNG, tanpa format
                    ];

                    DetailCoatingThickness::create($detailData);
                    $detailCount++;
                    
                    \Log::debug("📝 Saved Coating Thickness row {$row}", $detailData);
                }
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detailCoatingThickness records");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Update calibratedBy dari input calibrated_by
        if ($request->filled('calibratedBy')) {
            $updateData['calibratedBy'] = $request->calibratedBy;
        } elseif ($request->filled('calibrated_by')) {
            $updateData['calibratedBy'] = $request->calibrated_by;
        } else {
            $updateData['calibratedBy'] = '-';
        }
        
        // Update verifiedBy dari input verified_by
        if ($request->filled('verifiedBy')) {
            $updateData['verifiedBy'] = $request->verifiedBy;
        } elseif ($request->filled('verified_by')) {
            $updateData['verifiedBy'] = $request->verified_by;
        } else {
            $updateData['verifiedBy'] = '-';
        }
        
        // Field tambahan jika ada
        if ($request->filled('nama_kalibrator')) {
            $updateData['calibrator_name'] = $request->nama_kalibrator;
        }
        
        if ($request->filled('nama_pemeriksa')) {
            $updateData['verifier_name'] = $request->nama_pemeriksa;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
        }
        
        if ($request->filled('conclusion')) {
            $updateData['keterangan'] = $request->conclusion;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated:', array_keys($updateData));
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headCoatingThickness;
        $savedDetailCount = DetailCoatingThickness::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Coating Thickness):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $savedDetailCount,
            'standard' => $finalStandard,
            'alat_standar' => $alatStandarInput,
            'no_seri' => $noSeriValue,
            'calibratedBy' => $calibration->calibratedBy,
            'verifiedBy' => $calibration->verifiedBy,
        ]);

        \Log::info('🎉 updateCoatingThickness COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateCoatingThickness:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Coating Thickness: " . $e->getMessage());
    }
}

private function storeDurometer($request, $calibration, $certificateId, $tabId = null)
{
    \Log::info('🚀 ===== START storeDurometer =====', [
        'calibration_id' => $calibration->id,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeDurometer called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dengan berbagai kemungkinan nama field
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        // Coba juga dengan format array
        $alatStandarArray = $request->input('alat_standar', []);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar for Durometer:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. SIMPAN KE HEAD DUROMETER
        // ==================================================================
        $head = HeadDurometer::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-56',
            'form_index' => 1,
        ]);
        
        \Log::info('✅ HeadDurometer saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 3. SIMPAN DETAIL DUROMETER (10 TITIK UKUR) - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving DetailDurometer data (10 titik ukur)...');
        $detailCount = 0;
        
        for ($row = 1; $row <= 10; $row++) {
            // Ambil titik ukur dengan berbagai kemungkinan format
            $titikUkur = $this->getRequestValue($request, "titikUkur_{$row}", $tabId);
            if (!$titikUkur) {
                $titikUkur = $this->getRequestValue($request, "titikUkur", $tabId);
                if (is_array($titikUkur)) {
                    $titikUkur = $titikUkur[$row - 1] ?? null;
                }
            }
            if (!$titikUkur) {
                $titikUkur = $this->getRequestValue($request, "titik_ukur_{$row}", $tabId);
            }
            
            // Ambil data pembacaan x1, x2, x3
            $x1 = $this->getRequestValue($request, "x1_{$row}", $tabId);
            $x2 = $this->getRequestValue($request, "x2_{$row}", $tabId);
            $x3 = $this->getRequestValue($request, "x3_{$row}", $tabId);
            
            // Jika tidak ditemukan, coba format array
            if (!$x1) {
                $x1Array = $this->getRequestValue($request, "x1", $tabId);
                if (is_array($x1Array)) {
                    $x1 = $x1Array[$row - 1] ?? null;
                }
            }
            if (!$x2) {
                $x2Array = $this->getRequestValue($request, "x2", $tabId);
                if (is_array($x2Array)) {
                    $x2 = $x2Array[$row - 1] ?? null;
                }
            }
            if (!$x3) {
                $x3Array = $this->getRequestValue($request, "x3", $tabId);
                if (is_array($x3Array)) {
                    $x3 = $x3Array[$row - 1] ?? null;
                }
            }
            
            // Cek apakah ada data untuk titik ukur ini
            $hasData = !empty($titikUkur) || !empty($x1) || !empty($x2) || !empty($x3);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'form_index' => 1,
                    'titikUkur' => $titikUkur,
                    'x1' => $x1,
                    'x2' => $x2,
                    'x3' => $x3,
                ];
                
                \Log::debug("💾 Saving DetailDurometer row {$row}:", [
                    'titikUkur' => $detailData['titikUkur'],
                    'x1' => $detailData['x1'],
                    'x2' => $detailData['x2'],
                    'x3' => $detailData['x3']
                ]);
                
                DetailDurometer::create($detailData);
                $detailCount++;
            } else {
                \Log::debug("⏭️ Skipping row {$row} - no data found");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailDurometer records");
        
        // ==================================================================
        // 4. SIMPAN ADD DUROMETER (DATA REPEATABILITY) - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving AddDurometer data (repeatability)...');
        
        $addData = [
            'calibration_id' => $calibration->id,
            'form_index' => 1,
        ];
        
        // Ambil 10 nilai repeatability (5 baris atas + 5 baris bawah)
        for ($row = 1; $row <= 2; $row++) {
            for ($col = 1; $col <= 5; $col++) {
                $value = $this->getRequestValue($request, "repeatability_{$row}_{$col}", $tabId);
                if (!$value) {
                    $value = $this->getRequestValue($request, "repeatability", $tabId);
                    if (is_array($value)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $value = $value[$index] ?? null;
                    }
                }
                if (!$value) {
                    $value = $this->getRequestValue($request, "rep_{$row}_{$col}", $tabId);
                }
                
                $repKey = "rep" . str_pad((($row - 1) * 5 + $col), 2, '0', STR_PAD_LEFT);
                $addData[$repKey] = $value;
            }
        }
        
        // Cek apakah ada data untuk disimpan
        $hasAddData = false;
        foreach ($addData as $key => $value) {
            if ($key !== 'calibration_id' && $key !== 'form_index' && $value !== null && $value !== '') {
                $hasAddData = true;
                break;
            }
        }
        
        if ($hasAddData) {
            $addRecord = AddDurometer::create($addData);
            \Log::info('✅ AddDurometer saved:', ['add_id' => $addRecord->id]);
        } else {
            \Log::info('⚠️ No AddDurometer data to save');
        }
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TTD DAN NAMA (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $updateData = [];
        
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy]);
        }
        
        $uncertainty = $this->getRequestValue($request, 'uncertainty', $tabId);
        if ($uncertainty) {
            $updateData['uncertainty'] = $uncertainty;
            $conclusion = $this->getRequestValue($request, 'conclusion', $tabId);
            $updateData['keterangan'] = $conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
            \Log::info('📝 Uncertainty data:', ['uncertainty' => $uncertainty]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailDurometer::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddDurometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Durometer):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
        ]);
        
        \Log::info('🎉 storeDurometer COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeDurometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal menyimpan data Durometer: " . $e->getMessage());
    }
}

private function updateDurometer($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateDurometer');
        \Log::info('📝 Updating Durometer data for calibration ID: ' . $calibration->id);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headDurometer;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR DARI CHECKBOX
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Durometer:', ['alat_standar' => $alatStandar]);
        
        // ==================================================================
        // 2. UPDATE ATAU CREATE HEAD DUROMETER
        // ==================================================================
        $head = HeadDurometer::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-56',
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadDurometer updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadDurometer::create($headData);
            \Log::info('➕ HeadDurometer created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL DUROMETER (TITIK UKUR) - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating DetailDurometer data...');
        
        // Hapus data lama terlebih dahulu
        $deletedDetails = DetailDurometer::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$deletedDetails} old DetailDurometer records");
        
        // Proses 10 titik ukur (sesuai form HTML) - LANGSUNG TANPA FORMAT
        $detailCount = 0;
        for ($i = 1; $i <= 10; $i++) {
            // Ambil titik ukur dari input
            $titikUkur = $request->input("titikUkur_{$i}");
            
            // Ambil data pembacaan
            $x1 = $request->input("x1_{$i}");
            $x2 = $request->input("x2_{$i}");
            $x3 = $request->input("x3_{$i}");
            
            // Cek apakah ada data untuk titik ukur ini
            $hasData = !empty($titikUkur) || !empty($x1) || !empty($x2) || !empty($x3);
            
            // HANYA simpan jika ada data - LANGSUNG TANPA FORMAT
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,  // LANGSUNG, tanpa format
                    'x1' => $x1,                // LANGSUNG, tanpa format
                    'x2' => $x2,                // LANGSUNG, tanpa format
                    'x3' => $x3,                // LANGSUNG, tanpa format
                ];
                
                \Log::debug("💾 Saving DetailDurometer row {$i}:", [
                    'titikUkur' => $detailData['titikUkur'],
                    'x1' => $detailData['x1'],
                    'x2' => $detailData['x2'],
                    'x3' => $detailData['x3'],
                ]);
                
                DetailDurometer::create($detailData);
                $detailCount++;
            } else {
                \Log::debug("⏭️ Skipping row {$i} - no data found");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailDurometer records");
        
        // ==================================================================
        // 4. UPDATE ADD DUROMETER (DATA REPEATABILITY) - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating AddDurometer data (repeatability)...');
        
        $addData = [
            'calibration_id' => $calibration->id,
            
            // Ulangan 1-10 - ambil dari input - LANGSUNG TANPA FORMAT
            'rep01' => $request->input('repeatability_1_1'),
            'rep02' => $request->input('repeatability_1_2'),
            'rep03' => $request->input('repeatability_1_3'),
            'rep04' => $request->input('repeatability_1_4'),
            'rep05' => $request->input('repeatability_1_5'),
            'rep06' => $request->input('repeatability_2_1'),
            'rep07' => $request->input('repeatability_2_2'),
            'rep08' => $request->input('repeatability_2_3'),
            'rep09' => $request->input('repeatability_2_4'),
            'rep10' => $request->input('repeatability_2_5'),
        ];
        
        // Cek apakah ada data untuk disimpan
        $hasAddData = false;
        foreach ($addData as $key => $value) {
            if ($key !== 'calibration_id' && $value !== null && $value !== '') {
                $hasAddData = true;
                break;
            }
        }
        
        if ($hasAddData) {
            $existingAdd = AddDurometer::where('calibration_id', $calibration->id)->first();
            
            if ($existingAdd) {
                $existingAdd->update($addData);
                \Log::info('✅ AddDurometer updated:', ['add_id' => $existingAdd->id]);
            } else {
                $addRecord = AddDurometer::create($addData);
                \Log::info('✅ AddDurometer created:', ['add_id' => $addRecord->id]);
            }
        } else {
            \Log::info('⚠️ No AddDurometer data to save');
            AddDurometer::where('calibration_id', $calibration->id)->delete();
            \Log::info('🗑️ Deleted AddDurometer records (no data)');
        }
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Ambil nama dari input calibrated_by dan verified_by
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headDurometer;
        $savedDetailCount = DetailDurometer::where('calibration_id', $calibration->id)->count();
        $savedAddCount = AddDurometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Durometer):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $savedDetailCount,
            'add_records' => $savedAddCount,
            'alat_standar' => $alatStandarString,
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);
        
        \Log::info('🎉 updateDurometer COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateDurometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Durometer: " . $e->getMessage());
    }
}

private function storeMikropipetDispenset($request, $calibration, $certificateId, $isMultipleSubmit = false, $jumlahForm = 1)
{
    \Log::info('🚀 ===== START storeMikropipetDispenset =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm
    ]);
    
    try {
        // ==================================================================
        // 1. KONFIGURASI MULTIPLE FORM
        // ==================================================================
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm
        ]);
        
        // ==================================================================
        // 2. FUNGSI BANTU UNTUK MENCARI NILAI (LOOPING SEMUA KEMUNGKINAN TAB)
        // ==================================================================
        
        /**
         * Mencari nilai dari request dengan berbagai kemungkinan format key (termasuk tab)
         */
        $findValue = function($baseKey, $formIndex, $additionalParams = []) use ($request) {
            $possibleKeys = [];
            $suffix = !empty($additionalParams) ? '_' . implode('_', $additionalParams) : '';
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan double formIndex dan tab
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tab}";
                
                // Format tanpa tab suffix
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "{$baseKey}{$suffix}";
            }
            
            // Hapus duplikasi
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai array (alat_standar) dengan berbagai format (termasuk tab)
         */
        $findArrayValue = function($baseKey, $formIndex) use ($request) {
            $possibleKeys = [];
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && !empty($value)) {
                    if (is_array($value)) {
                        return array_filter($value);
                    }
                    return [$value];
                }
            }
            
            return [];
        };
        
        /**
         * Mencari nilai satuan dengan berbagai format (termasuk tab)
         */
        $findSatuanValue = function($baseKey, $formIndex, $posisi = null) use ($request, $findValue) {
            if ($posisi) {
                return $findValue($baseKey, $formIndex, [$posisi]);
            }
            return $findValue($baseKey, $formIndex, []);
        };
        
        // ==================================================================
        // 3. AMBIL ALAT STANDAR DARI FORM 1
        // ==================================================================
        $alatStandar = $findArrayValue('alat_standar', 1);
        $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('📋 Alat Standar:', ['standard_value' => $standardValue]);
        
        // ==================================================================
        // 4. LOOP UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("=========================================");
            \Log::info("📝 PROCESSING FORM {$formIndex}");
            \Log::info("=========================================");
            
            // ==========================================================
            // AMBIL SATUAN UNTUK MASING-MASING POSISI
            // ==========================================================
            $satuanKiriAtas = $findSatuanValue('satuan_alat_ukur_kiri', $formIndex);
            $satuanKananAtas = $findSatuanValue('satuan_alat_ukur_kanan', $formIndex);
            $satuanKiriBawah = $findSatuanValue('satuan_alat_ukur_bawah_kiri', $formIndex);
            $satuanKananBawah = $findSatuanValue('satuan_alat_ukur_bawah_kanan', $formIndex);
            
            \Log::info("📝 Satuan values for form {$formIndex}", [
                'satuan_kiri_atas' => $satuanKiriAtas,
                'satuan_kanan_atas' => $satuanKananAtas,
                'satuan_kiri_bawah' => $satuanKiriBawah,
                'satuan_kanan_bawah' => $satuanKananBawah
            ]);
            
            // ==========================================================
            // SIMPAN HEAD MIKROPIPET DISPENSET
            // ==========================================================
            HeadMikropipetDispenset::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK102-39 (Volumetrik Piston)',
                    'certificate_id' => $certificateId,
                    'satuan_alat_ukur_kiri' => $satuanKiriAtas,
                    'satuan_alat_ukur_kanan' => $satuanKananAtas,
                    'satuan_alat_ukur_bawah_kiri' => $satuanKiriBawah,
                    'satuan_alat_ukur_bawah_kanan' => $satuanKananBawah,
                ]
            );
            
            // ==========================================================
            // SIMPAN DETAIL UNTUK MASING-MASING POSISI
            // ==========================================================
            
            // Detail untuk KIRI ATAS
            $this->saveMikropipetDetailWithFinder($findValue, $calibration->id, $formIndex, 'kiri', 'atas');
            
            // Detail untuk KANAN ATAS
            $this->saveMikropipetDetailWithFinder($findValue, $calibration->id, $formIndex, 'kanan', 'atas');
            
            // Detail untuk KIRI BAWAH
            $this->saveMikropipetDetailWithFinder($findValue, $calibration->id, $formIndex, 'kiri', 'bawah');
            
            // Detail untuk KANAN BAWAH
            $this->saveMikropipetDetailWithFinder($findValue, $calibration->id, $formIndex, 'kanan', 'bawah');
        }
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN JUMLAH FORM
        // ==================================================================
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $totalHeadRecords = HeadMikropipetDispenset::where('calibration_id', $calibration->id)->count();
        $totalDetailRecords = DetailMikropipetDispenset::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Mikropipet/Dispenset):', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'head_records' => $totalHeadRecords,
            'detail_records' => $totalDetailRecords,
            'certificate_id' => $certificateId,
            'alat_standar' => $standardValue,
        ]);
        
        \Log::info('🎉 storeMikropipetDispenset COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeMikropipetDispenset:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback
        try {
            DetailMikropipetDispenset::where('calibration_id', $calibration->id)->delete();
            HeadMikropipetDispenset::where('calibration_id', $calibration->id)->delete();
        } catch (\Exception $rollbackError) {
            \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
        }
        
        throw new \Exception("Gagal menyimpan data Mikropipet/Dispenset: " . $e->getMessage());
    }
}

/**
 * Helper method untuk menyimpan satu record DetailMikropipetDispenset DENGAN FINDER
 */
private function saveMikropipetDetailWithFinder($findValue, $calibrationId, $formIndex, $posisi, $bagian)
{
    $posisiPrefix = ($posisi === 'kiri') ? 'kiri' : 'kanan';
    $isBawah = ($bagian === 'bawah');
    
    // Cari nilai titik ukur (nominal)
    if ($isBawah) {
        $titikUkur = $findValue("nominal_{$posisiPrefix}_bawah", $formIndex);
        if (empty($titikUkur)) {
            $titikUkur = $findValue("nominal_bawah_{$posisiPrefix}", $formIndex);
        }
    } else {
        $titikUkur = $findValue("nominal_{$posisiPrefix}", $formIndex);
    }
    
    if (empty($titikUkur)) {
        $titikUkur = $findValue("titik_ukur_{$posisiPrefix}", $formIndex);
    }
    
    \Log::debug("🔍 Checking data for form {$formIndex}, {$posisi}-{$bagian}", [
        'titikUkur' => $titikUkur
    ]);
    
    // Cek apakah ada data (titik ukur tidak kosong)
    $hasData = !empty($titikUkur);
    
    // Cek nilai m0 sampai m11
    for ($i = 0; $i <= 11; $i++) {
        if ($isBawah) {
            $value = $findValue("m{$i}_{$posisiPrefix}_bawah", $formIndex);
            if (empty($value)) {
                $value = $findValue("m{$i}_bawah_{$posisiPrefix}", $formIndex);
            }
        } else {
            $value = $findValue("m{$i}_{$posisiPrefix}", $formIndex);
        }
        
        if (!empty($value)) {
            $hasData = true;
            break;
        }
    }
    
    // Cek parameter pendukung jika belum ada data
    if (!$hasData) {
        $paramKeys = [];
        if ($isBawah) {
            $paramKeys = [
                "suhu_awal_{$posisiPrefix}_bawah",
                "suhu_akhir_{$posisiPrefix}_bawah",
                "kelembaban_awal_{$posisiPrefix}_bawah",
                "kelembaban_akhir_{$posisiPrefix}_bawah",
                "tekanan_awal_{$posisiPrefix}_bawah",
                "tekanan_akhir_{$posisiPrefix}_bawah",
                "suhu_air_awal_{$posisiPrefix}_bawah",
                "suhu_air_akhir_{$posisiPrefix}_bawah",
                "waktu_{$posisiPrefix}_bawah"
            ];
        } else {
            $paramKeys = [
                "suhu_awal_{$posisiPrefix}",
                "suhu_akhir_{$posisiPrefix}",
                "kelembaban_awal_{$posisiPrefix}",
                "kelembaban_akhir_{$posisiPrefix}",
                "tekanan_awal_{$posisiPrefix}",
                "tekanan_akhir_{$posisiPrefix}",
                "suhu_air_awal_{$posisiPrefix}",
                "suhu_air_akhir_{$posisiPrefix}",
                "waktu_{$posisiPrefix}"
            ];
        }
        
        foreach ($paramKeys as $key) {
            $value = $findValue($key, $formIndex);
            if (!empty($value)) {
                $hasData = true;
                break;
            }
        }
    }
    
    if (!$hasData) {
        \Log::debug("⏭️ Skipping form {$formIndex} {$posisi}-{$bagian} - no data");
        return false;
    }
    
    // Persiapkan data untuk DetailMikropipetDispenset
    $detailData = [
        'calibration_id' => $calibrationId,
        'form_index' => $formIndex,
        'titikUkur' => $titikUkur,
    ];
    
    // Tambahkan nilai m0 sampai m11
    for ($i = 0; $i <= 11; $i++) {
        if ($isBawah) {
            $value = $findValue("m{$i}_{$posisiPrefix}_bawah", $formIndex);
            if (empty($value)) {
                $value = $findValue("m{$i}_bawah_{$posisiPrefix}", $formIndex);
            }
        } else {
            $value = $findValue("m{$i}_{$posisiPrefix}", $formIndex);
        }
        
        $detailData["m{$i}"] = $value;
    }
    
    // Tambahkan parameter pendukung
    if ($isBawah) {
        $detailData['TUdaraS'] = $findValue("suhu_awal_{$posisiPrefix}_bawah", $formIndex);
        $detailData['TUdaraE'] = $findValue("suhu_akhir_{$posisiPrefix}_bawah", $formIndex);
        $detailData['RHS'] = $findValue("kelembaban_awal_{$posisiPrefix}_bawah", $formIndex);
        $detailData['RHE'] = $findValue("kelembaban_akhir_{$posisiPrefix}_bawah", $formIndex);
        $detailData['PUdaraS'] = $findValue("tekanan_awal_{$posisiPrefix}_bawah", $formIndex);
        $detailData['PUdaraE'] = $findValue("tekanan_akhir_{$posisiPrefix}_bawah", $formIndex);
        $detailData['TAirS'] = $findValue("suhu_air_awal_{$posisiPrefix}_bawah", $formIndex);
        $detailData['TAirE'] = $findValue("suhu_air_akhir_{$posisiPrefix}_bawah", $formIndex);
        $detailData['waktu'] = $findValue("waktu_{$posisiPrefix}_bawah", $formIndex);
    } else {
        $detailData['TUdaraS'] = $findValue("suhu_awal_{$posisiPrefix}", $formIndex);
        $detailData['TUdaraE'] = $findValue("suhu_akhir_{$posisiPrefix}", $formIndex);
        $detailData['RHS'] = $findValue("kelembaban_awal_{$posisiPrefix}", $formIndex);
        $detailData['RHE'] = $findValue("kelembaban_akhir_{$posisiPrefix}", $formIndex);
        $detailData['PUdaraS'] = $findValue("tekanan_awal_{$posisiPrefix}", $formIndex);
        $detailData['PUdaraE'] = $findValue("tekanan_akhir_{$posisiPrefix}", $formIndex);
        $detailData['TAirS'] = $findValue("suhu_air_awal_{$posisiPrefix}", $formIndex);
        $detailData['TAirE'] = $findValue("suhu_air_akhir_{$posisiPrefix}", $formIndex);
        $detailData['waktu'] = $findValue("waktu_{$posisiPrefix}", $formIndex);
    }
    
    \Log::debug("💾 Saving DetailMikropipetDispenset [form {$formIndex}, {$posisi}-{$bagian}]:", [
        'titikUkur' => $detailData['titikUkur'],
        'calibration_id' => $calibrationId,
        'form_index' => $formIndex,
        'm0' => $detailData['m0'] ?? null
    ]);
    
    DetailMikropipetDispenset::create($detailData);
    return true;
}


private function updateMikropipetDispenset($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateMikropipetDispenset');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request (prioritaskan dari hidden input namaAlat)
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headMikropipetDispenset;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        // Cek berbagai kemungkinan key untuk alat standar (bisa dari form 1 atau multiple form)
        $alatStandar = [];
        if ($request->has('alat_standar_1')) {
            $alatStandar = $request->input('alat_standar_1', []);
            if (is_string($alatStandar)) {
                $alatStandar = [$alatStandar];
            }
        } elseif ($request->has('alat_standar')) {
            $alatStandar = $request->input('alat_standar', []);
            if (is_string($alatStandar)) {
                $alatStandar = [$alatStandar];
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Mikropipet/Dispenset:', ['alat_standar' => $alatStandar]);
        
        // ==================================================================
        // 2. AMBIL ATAU BUAT HEAD MIKROPIPET DISPENSET
        // ==================================================================
        $head = HeadMikropipetDispenset::where('calibration_id', $calibration->id)->first();
        
        // ==================================================================
        // 3. UPDATE ATAU BUAT HEAD MIKROPIPET DISPENSET
        // ==================================================================
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK102-39 (Volumetrik Piston)',
            'satuan_alat_ukur_kiri' => $request->input("satuan_alat_ukur_kiri_1"),
            'satuan_alat_ukur_kanan' => $request->input("satuan_alat_ukur_kanan_1"),
            'satuan_alat_ukur_bawah_kiri' => $request->input("satuan_alat_ukur_bawah_kiri_1"),
            'satuan_alat_ukur_bawah_kanan' => $request->input("satuan_alat_ukur_bawah_kanan_1"),
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadMikropipetDispenset updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadMikropipetDispenset::create($headData);
            \Log::info('➕ HeadMikropipetDispenset created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 4. UPDATE DETAIL MIKROPIPET DISPENSET (4 REKAMAN PER FORM)
        // ==================================================================
        \Log::info('📊 Updating DetailMikropipetDispenset data...');
        
        // Hapus detail lama
        $deletedCount = DetailMikropipetDispenset::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records:', ['count' => $deletedCount]);
        
        // Ambil jumlah form
        $jumlahForm = (int) ($request->jumlah_form ?? 1);
        $jumlahForm = max(1, $jumlahForm);
        
        $savedCount = 0;
        
        // Loop untuk setiap form
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            // Simpan 4 record berdasarkan posisi dan bagian untuk setiap form
            $positions = [
                ['posisi' => 'kiri', 'bagian' => 'atas'],
                ['posisi' => 'kanan', 'bagian' => 'atas'],
                ['posisi' => 'kiri', 'bagian' => 'bawah'],
                ['posisi' => 'kanan', 'bagian' => 'bawah'],
            ];
            
            foreach ($positions as $pos) {
                if ($this->updateMikropipetRecord($request, $calibration->id, $formIndex, $pos['posisi'], $pos['bagian'])) {
                    $savedCount++;
                }
            }
        }
        
        \Log::info("✅ Saved {$savedCount} DetailMikropipetDispenset records");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Data TTD dan nama dari calibration (ambil dari form 1)
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        } else {
            $updateData['calibrated_by'] = '-';
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        } else {
            $updateData['verified_by'] = '-';
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        $updateData['jumlah_form'] = $jumlahForm;
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated:', array_keys($updateData));
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headMikropipetDispenset;
        $totalDetailRecords = DetailMikropipetDispenset::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Mikropipet/Dispenset):', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $totalDetailRecords,
            'nama_alat' => $calibration->namaAlat,
            'alat_standar' => $alatStandarString,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);

        \Log::info('🎉 updateMikropipetDispenset COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateMikropipetDispenset:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Mikropipet/Dispenset: " . $e->getMessage());
    }
}

/**
 * Helper method untuk menyimpan satu record DetailMikropipetDispenset
 * dengan format name input yang sudah disesuaikan (suffix _formIndex)
 */
private function updateMikropipetRecord($request, $calibrationId, $formIndex, $posisi, $bagian)
{
    // Tentukan prefix berdasarkan posisi
    $posisiPrefix = ($posisi === 'kiri') ? 'kiri' : 'kanan';
    $isBawah = ($bagian === 'bawah');
    
    // Bangun key name untuk nominal
    $nominalKey = $isBawah 
        ? "nominal_{$posisiPrefix}_bawah_{$formIndex}"
        : "nominal_{$posisiPrefix}_{$formIndex}";
    
    $titikUkur = $request->input($nominalKey);
    
    // Log untuk debugging
    \Log::debug("🔍 Checking data for form {$formIndex}, {$posisi}-{$bagian}", [
        'nominalKey' => $nominalKey,
        'titikUkur' => $titikUkur
    ]);
    
    // Check if any data exists for this position
    $hasData = !empty($titikUkur);
    
    // Check m0-m11 values
    for ($i = 0; $i <= 11; $i++) {
        $valueKey = $isBawah
            ? "m{$i}_{$posisiPrefix}_bawah_{$formIndex}"
            : "m{$i}_{$posisiPrefix}_{$formIndex}";
        
        $value = $request->input($valueKey);
        if (!empty($value)) {
            $hasData = true;
            break;
        }
    }
    
    // Check parameter pendukung jika belum ada data
    if (!$hasData) {
        if ($isBawah) {
            $paramKeys = [
                "suhu_awal_{$posisiPrefix}_bawah_{$formIndex}",
                "suhu_akhir_{$posisiPrefix}_bawah_{$formIndex}",
                "kelembaban_awal_{$posisiPrefix}_bawah_{$formIndex}",
                "kelembaban_akhir_{$posisiPrefix}_bawah_{$formIndex}",
                "tekanan_awal_{$posisiPrefix}_bawah_{$formIndex}",
                "tekanan_akhir_{$posisiPrefix}_bawah_{$formIndex}",
                "suhu_air_awal_{$posisiPrefix}_bawah_{$formIndex}",
                "suhu_air_akhir_{$posisiPrefix}_bawah_{$formIndex}",
                "waktu_{$posisiPrefix}_bawah_{$formIndex}"
            ];
        } else {
            $paramKeys = [
                "suhu_awal_{$posisiPrefix}_{$formIndex}",
                "suhu_akhir_{$posisiPrefix}_{$formIndex}",
                "kelembaban_awal_{$posisiPrefix}_{$formIndex}",
                "kelembaban_akhir_{$posisiPrefix}_{$formIndex}",
                "tekanan_awal_{$posisiPrefix}_{$formIndex}",
                "tekanan_akhir_{$posisiPrefix}_{$formIndex}",
                "suhu_air_awal_{$posisiPrefix}_{$formIndex}",
                "suhu_air_akhir_{$posisiPrefix}_{$formIndex}",
                "waktu_{$posisiPrefix}_{$formIndex}"
            ];
        }
        
        foreach ($paramKeys as $key) {
            if ($request->filled($key)) {
                $hasData = true;
                break;
            }
        }
    }
    
    if (!$hasData) {
        \Log::debug("⏭️ Skipping form {$formIndex} {$posisi}-{$bagian} - no data");
        return false;
    }
    
    // Persiapkan data untuk DetailMikropipetDispenset
    $detailData = [
        'calibration_id' => $calibrationId,
        'form_index' => $formIndex,
        'posisi' => $posisi,
        'bagian' => $bagian,
        'titikUkur' => $titikUkur,
    ];
    
    // Tambahkan nilai m0 sampai m11
    for ($i = 0; $i <= 11; $i++) {
        $valueKey = $isBawah
            ? "m{$i}_{$posisiPrefix}_bawah_{$formIndex}"
            : "m{$i}_{$posisiPrefix}_{$formIndex}";
        
        $detailData["m{$i}"] = $request->input($valueKey);
    }
    
    // Tambahkan parameter pendukung dengan mapping ke field database
    if ($isBawah) {
        $detailData['TUdaraS'] = $request->input("suhu_awal_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['TUdaraE'] = $request->input("suhu_akhir_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['RHS'] = $request->input("kelembaban_awal_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['RHE'] = $request->input("kelembaban_akhir_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['PUdaraS'] = $request->input("tekanan_awal_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['PUdaraE'] = $request->input("tekanan_akhir_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['TAirS'] = $request->input("suhu_air_awal_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['TAirE'] = $request->input("suhu_air_akhir_{$posisiPrefix}_bawah_{$formIndex}");
        $detailData['waktu'] = $request->input("waktu_{$posisiPrefix}_bawah_{$formIndex}");
    } else {
        $detailData['TUdaraS'] = $request->input("suhu_awal_{$posisiPrefix}_{$formIndex}");
        $detailData['TUdaraE'] = $request->input("suhu_akhir_{$posisiPrefix}_{$formIndex}");
        $detailData['RHS'] = $request->input("kelembaban_awal_{$posisiPrefix}_{$formIndex}");
        $detailData['RHE'] = $request->input("kelembaban_akhir_{$posisiPrefix}_{$formIndex}");
        $detailData['PUdaraS'] = $request->input("tekanan_awal_{$posisiPrefix}_{$formIndex}");
        $detailData['PUdaraE'] = $request->input("tekanan_akhir_{$posisiPrefix}_{$formIndex}");
        $detailData['TAirS'] = $request->input("suhu_air_awal_{$posisiPrefix}_{$formIndex}");
        $detailData['TAirE'] = $request->input("suhu_air_akhir_{$posisiPrefix}_{$formIndex}");
        $detailData['waktu'] = $request->input("waktu_{$posisiPrefix}_{$formIndex}");
    }
    
    \Log::debug("💾 Saving DetailMikropipetDispenset [form {$formIndex}, {$posisi}-{$bagian}]:", [
        'titikUkur' => $detailData['titikUkur'],
        'calibration_id' => $calibrationId,
        'form_index' => $formIndex,
        'm0' => $detailData['m0'] ?? null
    ]);
    
    DetailMikropipetDispenset::create($detailData);
    return true;
}

private function storeTaperGauge($request, $calibration, $certificateId)
{
    try {
        $alatStandarString = 'GAUGE BLOCK SET GRADE 0 (1160776)';
        
        \Log::info('🔧 Alat standar FIXED for Holetest:', [
            'alat_standar' => $alatStandarString,
        ]);
        
      

        // Simpan ke Head Taper Gauge
        $head = HeadTaperGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-57',
            'satuan_unit' => $request->satuan_unit ?? null,
        ]);

        \Log::info('✅ Head Taper Gauge saved:', ['head_id' => $head->id]);

        // Simpan detail measurements - SEKARANG 14 BARIS
        \Log::info('📊 Saving detail measurements...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 15; $i++) { // UBAH DARI 11 MENJADI 14
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada penunjukan yang diisi (minimal satu)
            for ($j = 1; $j <= 5; $j++) {
                if ($request->has("penunjukan_{$i}_{$j}") && !empty(trim($request->{"penunjukan_{$i}_{$j}"}))) {
                    $hasData = true;
                    break;
                }
            }
            
            // Simpan jika ada data nominal atau penunjukan
            if (($request->has("nominal_$i") && !empty(trim($request->{"nominal_$i"}))) || $hasData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $request->{"nominal_$i"} ?? '',
                    'ulangan01' => $request->{"penunjukan_{$i}_1"} ?? null,
                    'ulangan02' => $request->{"penunjukan_{$i}_2"} ?? null,
                    'ulangan03' => $request->{"penunjukan_{$i}_3"} ?? null,
                    'ulangan04' => $request->{"penunjukan_{$i}_4"} ?? null,
                    'ulangan05' => $request->{"penunjukan_{$i}_5"} ?? null,
                ];

                \Log::info("📝 Saving detail row $i:", $detailData);
                
                DetailTaperGauge::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved $detailCount detail measurements");

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Taper Gauge data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine()
        ]);
        throw $e;
    }
}

private function updateTaperGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateTaperGauge');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headTaperGauge;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR (FIXED)
        // ==================================================================
        $alatStandarString = 'GAUGE BLOCK SET GRADE 0 (1160776)';
        
        \Log::info('🔧 Alat standar FIXED for TaperGauge:', [
            'alat_standar' => $alatStandarString,
        ]);
        
        // ==================================================================
        // 2. UPDATE HEAD TAPER GAUGE
        // ==================================================================
        
        // Cari head yang sudah ada
        $head = HeadTaperGauge::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-57',
            'satuan_unit' => $request->c,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ Head TaperGauge updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id,
                'satuan_unit' => $request->satuan_unit
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadTaperGauge::create($headData);
            \Log::info('✅ Head TaperGauge created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null,
                'satuan_unit' => $request->satuan_unit
            ]);
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL MEASUREMENTS - DELETE & RECREATE (TANPA FORMAT)
        // ==================================================================
        \Log::info('📊 Updating detail measurements for TaperGauge...');
        
        // Delete existing details untuk calibration ini
        $detailDeleted = DetailTaperGauge::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$detailDeleted} existing details");
        
        $detailCount = 0;
        
        // Proses 15 baris data (1-15) - LANGSUNG TANPA FORMAT
        for ($i = 1; $i <= 15; $i++) {
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada penunjukan yang diisi (minimal satu)
            for ($j = 1; $j <= 5; $j++) {
                $fieldName = "penunjukan_{$i}_{$j}";
                $value = $request->input($fieldName);
                if (!empty(trim($value ?? ''))) {
                    $hasData = true;
                    break;
                }
            }
            
            // Ambil nilai nominal
            $nominalField = "nominal_{$i}";
            $nominalValue = $request->input($nominalField);
            
            // Simpan jika ada data nominal atau penunjukan
            if (!empty(trim($nominalValue ?? '')) || $hasData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $nominalValue,                                    // LANGSUNG, tanpa format
                    'ulangan01' => $request->input("penunjukan_{$i}_1"),            // LANGSUNG, tanpa format
                    'ulangan02' => $request->input("penunjukan_{$i}_2"),            // LANGSUNG, tanpa format
                    'ulangan03' => $request->input("penunjukan_{$i}_3"),            // LANGSUNG, tanpa format
                    'ulangan04' => $request->input("penunjukan_{$i}_4"),            // LANGSUNG, tanpa format
                    'ulangan05' => $request->input("penunjukan_{$i}_5"),            // LANGSUNG, tanpa format
                ];

                \Log::debug("📝 Saving detail row {$i}:", [
                    'titikUkur' => $nominalValue,
                    'ulangan01' => $request->input("penunjukan_{$i}_1"),
                    'ulangan02' => $request->input("penunjukan_{$i}_2"),
                    'ulangan03' => $request->input("penunjukan_{$i}_3"),
                    'ulangan04' => $request->input("penunjukan_{$i}_4"),
                    'ulangan05' => $request->input("penunjukan_{$i}_5"),
                ]);
                
                DetailTaperGauge::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for TaperGauge");
        
        // ==================================================================
        // 4. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Update satuan unit jika ada
        if ($request->filled('unit')) {
            $updateData['unit'] = $request->unit;
        }
        
        // Update uncertainty jika ada
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Update range jika ada
        if ($request->filled('range')) {
            $updateData['range'] = $request->range;
        }
        
        // Update kondisi lingkungan
        $environmentData = [];
        if ($request->filled('temperature')) {
            $environmentData['temperature'] = $request->temperature;
        }
        if ($request->filled('humidity')) {
            $environmentData['humidity'] = $request->humidity;
        }
        if (!empty($environmentData)) {
            $updateData['environment_condition'] = json_encode($environmentData);
        }
        
        // Update nama kalibrator dan pemeriksa jika ada
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headTaperGauge;
        $savedDetailCount = DetailTaperGauge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (TaperGauge):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $savedDetailCount,
            'satuan_unit' => $request->satuan_unit,
            'unit' => $request->unit,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
            'nama_alat' => $calibration->namaAlat,
        ]);

        \Log::info('🎉 updateTaperGauge COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTaperGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data TaperGauge: " . $e->getMessage());
    }
}
    private function storeBoreGauge($request, $calibration, $certificateId)
{
    try {
        // ============================================
        // PROSES ALAT STANDAR DENGAN HANDLE "LAINNYA"
        // ============================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = '';
        
        if (!empty($alatStandar)) {
            $processedAlatStandar = [];
            
            foreach ($alatStandar as $index => $value) {
                if ($value === 'lainnya') {
                    $alatStandarTambahan = $request->alat_standar_tambahan;
                    if (!empty(trim($alatStandarTambahan))) {
                        $processedAlatStandar[] = trim($alatStandarTambahan);
                    }
                } else {
                    switch ($value) {
                        case 'dial_gauge_tester_0_25mm':
                            $processedAlatStandar[] = 'Dial Gauge Tester 0~25mm';
                            break;
                        case 'dial_indicator_1mm':
                            $processedAlatStandar[] = 'Dial Indicator 1 mm';
                            break;
                        default:
                            $processedAlatStandar[] = $value;
                    }
                }
            }
            
            $alatStandarString = implode(', ', $processedAlatStandar);
        }
        
        \Log::info('🔧 Alat standar Bore Gauge processed:', [
            'raw' => $alatStandar,
            'processed' => $processedAlatStandar ?? [],
            'string' => $alatStandarString
        ]);

        // ============================================
        // 1. SIMPAN HEAD BORE GAUGE
        // ============================================
        $head = HeadBoreGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-58 (berdasarkan JIS B 7515-1982)' ?? null ,
            'satuan_unit_bawah' => $request->satuan_unit_bawah ?? null,
            'satuan_unit_atas' => $request->satuan_unit_atas ?? null,
        ]);

        \Log::info('✅ Head Bore Gauge saved:', ['head_id' => $head->id]);

        // ============================================
        // 2. SIMPAN DETAIL BORE GAUGE - PAKAI CALIBRATION_ID
        // ============================================
        \Log::info('📊 Saving Bore Gauge detail measurements...');
        $detailCount = 0;
        
        // Hapus data lama jika ada
        DetailBoreGauge::where('calibration_id', $calibration->id)->delete();
        
        // Ambil data dari request
        $penunjukAlatArray = $request->penunjukanAlat ?? [];
        $stdNaikArray = $request->pembacaanNaik ?? [];
        $stdTurunArray = $request->pembacaanTurun ?? [];
        
        \Log::info('📊 Data received:', [
            'penunjukAlat_count' => count($penunjukAlatArray),
            'stdNaik_count' => count($stdNaikArray),
            'stdTurun_count' => count($stdTurunArray)
        ]);
        
        // Loop untuk 40 baris data (0-39)
        for ($i = 0; $i < 40; $i++) {
            $penunjukAlat = $penunjukAlatArray[$i] ?? '';
            $stdNaik = $stdNaikArray[$i] ?? null;
            $stdTurun = $stdTurunArray[$i] ?? null;
            
            // Bersihkan data
            $penunjukAlat = trim($penunjukAlat);
            
            // Simpan jika ada data
            if (!empty($penunjukAlat) || !is_null($stdNaik) || !is_null($stdTurun)) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'penunjukAlat' => $penunjukAlat,
                    'std_naik' => $stdNaik,
                    'std_turun' => $stdTurun,
                ];

                \Log::info("📝 Saving Bore Gauge detail row {$i}:", $detailData);
                
                DetailBoreGauge::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} Bore Gauge detail measurements");

        // ============================================
        // 3. SIMPAN REPEATABILITY
        // ============================================
        \Log::info('📊 Saving Bore Gauge repeatability data...');
        
        AddBoreGauge::where('calibration_id', $calibration->id)->delete();
        
        $repeatabilityData = [
            'calibration_id' => $calibration->id,
            'repeatability' => $request->repeatability,
            'rep01' => $request->rep01,
            'rep02' => $request->rep02,
            'rep03' => $request->rep03,
            'rep04' => $request->rep04,
            'rep05' => $request->rep05,
            'rep06' => $request->rep06,
            'rep07' => $request->rep07,
            'rep08' => $request->rep08,
            'rep09' => $request->rep09,
            'rep10' => $request->rep10,
        ];

        // Filter hanya yang tidak null
        $repeatabilityData = array_filter($repeatabilityData, function($value) {
            return !is_null($value);
        });

        if (count($repeatabilityData) > 1) {
            AddBoreGauge::create($repeatabilityData);
            \Log::info("✅ Bore Gauge repeatability saved");
        }

        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Bore Gauge data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function updateBoreGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateBoreGauge');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headBoreGauge;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // Jika certificate_id masih kosong, gunakan dari parameter atau generate
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $calibration->certificate_id;
        }
        
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        }
        
        $finalCertificateId = $certificateIdBaru;
        
        \Log::info('📋 Final Certificate ID:', [
            'certificate_id' => $finalCertificateId,
            'certificate_id_updated' => $certificateIdUpdated
        ]);

        // ============================================
        // PROSES ALAT STANDAR DENGAN HANDLE "LAINNYA"
        // ============================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = '';
        
        if (!empty($alatStandar)) {
            $processedAlatStandar = [];
            
            foreach ($alatStandar as $index => $value) {
                if ($value === 'lainnya') {
                    $alatStandarTambahan = $request->alat_standar_tambahan;
                    if (!empty(trim($alatStandarTambahan ?? ''))) {
                        $processedAlatStandar[] = trim($alatStandarTambahan);
                    }
                } else {
                    switch ($value) {
                        case 'dial_gauge_tester_0_25mm':
                            $processedAlatStandar[] = 'Dial Gauge Tester 0~25mm';
                            break;
                        case 'dial_indicator_1mm':
                            $processedAlatStandar[] = 'Dial Indicator 1 mm';
                            break;
                        default:
                            $processedAlatStandar[] = $value;
                    }
                }
            }
            
            $alatStandarString = implode(', ', $processedAlatStandar);
        }
        
        \Log::info('🔧 Alat standar Bore Gauge processed for update:', [
            'raw' => $alatStandar,
            'processed' => $processedAlatStandar ?? [],
            'string' => $alatStandarString,
            'calibration_id' => $calibration->id
        ]);

        // ============================================
        // 1. UPDATE HEAD BORE GAUGE
        // ============================================
        $head = HeadBoreGauge::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📊 Head Bore Gauge BEFORE update:', [
            'head_exists' => $head ? true : false,
            'head_id' => $head->id ?? null,
            'certificate_id_before' => $head->certificate_id ?? null,
            'calibration_id' => $calibration->id
        ]);
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-58 (berdasarkan JIS B 7515-1982)',
            'satuan_unit_bawah' => $request->satuan_unit_bawah,
            'satuan_unit_atas' => $request->satuan_unit_atas,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $headData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $finalCertificateId]);
        }
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ Head Bore Gauge updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadBoreGauge::create($headData);
            \Log::info('✅ Head Bore Gauge created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }

        // ============================================
        // 2. UPDATE DETAIL BORE GAUGE - TANPA FORMAT
        // ============================================
        \Log::info('📊 Updating Bore Gauge detail measurements...');
        $detailCount = 0;
        
        // Hapus data lama jika ada
        $deletedDetails = DetailBoreGauge::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records:', [
            'count' => $deletedDetails,
            'calibration_id' => $calibration->id
        ]);
        
        // Ambil data dari request - LANGSUNG TANPA FORMAT
        $penunjukAlatArray = $request->penunjukanAlat ?? [];
        $stdNaikArray = $request->pembacaanNaik ?? [];
        $stdTurunArray = $request->pembacaanTurun ?? [];
        
        // Loop untuk 40 baris data (0-39) - LANGSUNG TANPA FORMAT
        for ($i = 0; $i < 40; $i++) {
            $penunjukAlat = isset($penunjukAlatArray[$i]) ? trim($penunjukAlatArray[$i]) : '';
            $stdNaik = $stdNaikArray[$i] ?? null;
            $stdTurun = $stdTurunArray[$i] ?? null;
            
            if (!empty($penunjukAlat) || !is_null($stdNaik) || !is_null($stdTurun)) {
                DetailBoreGauge::create([
                    'calibration_id' => $calibration->id,
                    'penunjukAlat' => $penunjukAlat,  // LANGSUNG, tanpa format
                    'std_naik' => $stdNaik,           // LANGSUNG, tanpa format
                    'std_turun' => $stdTurun,         // LANGSUNG, tanpa format
                ]);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Updated {$detailCount} Bore Gauge detail measurements");

        // ============================================
        // 3. UPDATE REPEATABILITY - TANPA FORMAT
        // ============================================
        \Log::info('📊 Updating Bore Gauge repeatability data...');
        
        // Hapus data lama
        $deletedRepeatability = AddBoreGauge::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old repeatability records:', [
            'count' => $deletedRepeatability,
            'calibration_id' => $calibration->id
        ]);
        
        // Siapkan data repeatability - LANGSUNG TANPA FORMAT
        $repeatabilityData = [
            'calibration_id' => $calibration->id,
            'repeatability' => $request->repeatability,
            'rep01' => $request->rep01,
            'rep02' => $request->rep02,
            'rep03' => $request->rep03,
            'rep04' => $request->rep04,
            'rep05' => $request->rep05,
            'rep06' => $request->rep06,
            'rep07' => $request->rep07,
            'rep08' => $request->rep08,
            'rep09' => $request->rep09,
            'rep10' => $request->rep10,
        ];

        // Filter hanya yang tidak null
        $filteredRepeatabilityData = array_filter($repeatabilityData, function($value) {
            return !is_null($value);
        });

        if (count($filteredRepeatabilityData) > 2) {
            AddBoreGauge::create($filteredRepeatabilityData);
            \Log::info("✅ Bore Gauge repeatability updated");
        } else {
            \Log::info("⚠️ No repeatability data to update");
        }

        // ============================================
        // 4. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ============================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $finalCertificateId]);
        }
        
        // Update nama kalibrator dan pemeriksa jika ada
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        // Update uncertainty jika ada
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ============================================
        // 5. FINAL CHECK
        // ============================================
        $calibration->refresh();
        $head->refresh();
        
        \Log::info('🏁 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'certificate_id_di_head' => $head->certificate_id,
            'certificate_id_di_calibration' => $calibration->certificate_id,
            'detail_records' => $detailCount,
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);

        \Log::info('🎉 updateBoreGauge COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateBoreGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Bore Gauge: " . $e->getMessage());
    }
}
/**
 * FORMAT DECIMAL VALUE - CEK KOSONG DAN NULL
 */
private function formatDecimalValue($value)
{
    // Jika null atau undefined
    if (is_null($value)) {
        return null;
    }
    
    // Jika string kosong
    if ($value === '') {
        return null;
    }
    
    // Jika array kosong
    if (is_array($value) && empty($value)) {
        return null;
    }
    
    // Trim dan cek
    $trimmed = trim($value);
    if ($trimmed === '') {
        return null;
    }
    
    // Cek apakah numeric
    if (is_numeric($trimmed)) {
        return $trimmed;
    }
    
    // Jika tidak numeric, return null
    return null;
}

private function storeFeelerGauge($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1, $tabId = null)
{
    \Log::info('🚀 ===== START storeFeelerGauge =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        // ==================================================================
        // 1. KONFIGURASI MULTIPLE FORM
        // ==================================================================
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. FUNGSI BANTU UNTUK MENCARI NILAI (DENGAN DUKUNGAN TAB)
        // ==================================================================
        
        /**
         * Mencari nilai dari request dengan berbagai kemungkinan format key (termasuk tab)
         */
        $findValue = function($baseKey, $formIndex, $additionalParams = []) use ($request, $tabId) {
            $possibleKeys = [];
            $suffix = !empty($additionalParams) ? '_' . implode('_', $additionalParams) : '';
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tabId}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tabId}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "{$baseKey}{$suffix}";
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai array (alat_standar) dengan berbagai format
         */
        $findArrayValue = function($baseKey, $formIndex) use ($request, $tabId) {
            $possibleKeys = [];
            
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tabId}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}_tab{$tabId}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && !empty($value)) {
                    if (is_array($value)) {
                        return array_filter($value);
                    }
                    return [$value];
                }
            }
            
            return [];
        };
        
        // ==================================================================
        // 3. AMBIL ALAT STANDAR DARI FORM 1
        // ==================================================================
        $alatStandar = $findArrayValue('alat_standar', 1);
        $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : 'Mesin ULM 01-600D, Micrometer, Gauge Block';
        
        \Log::info('📋 Alat Standar:', ['standard_value' => $standardValue]);
        
        // Hapus semua detail yang lama untuk calibration ini
        DetailFeelerGauge::where('calibration_id', $calibration->id)->delete();
        
        // ==================================================================
        // 4. LOOP UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("=========================================");
            \Log::info("📝 PROCESSING FORM {$formIndex} - Feeler Gauge");
            \Log::info("=========================================");
            
            // ==========================================================
            // AMBIL SATUAN UNIT
            // ==========================================================
            $satuanUnitUUT = $findValue('satuan_unit_uut', $formIndex);
            if (empty($satuanUnitUUT)) {
                $satuanUnitUUT = 'mm';
            }
            
            $satuanUnitGaugeBlock = $findValue('satuan_unit_gauge_block', $formIndex);
            if (empty($satuanUnitGaugeBlock)) {
                $satuanUnitGaugeBlock = 'mm';
            }
            
            // ==========================================================
            // SIMPAN HEAD FEELER GAUGE
            // ==========================================================
            HeadFeelerGauge::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'satuan_unit_uut' => $satuanUnitUUT,
                    'satuan_unit_gauge_block' => $satuanUnitGaugeBlock,
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK1102-62',
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
            \Log::info("✅ HeadFeelerGauge saved for form {$formIndex}");
            
            // ==========================================================
            // SIMPAN DETAILS (25 BARIS)
            // ==========================================================
            $detailCount = 0;
            
            for ($row = 1; $row <= 25; $row++) {
                // Ambil nilai nominal UUT
                $nominalUUT = $findValue('nominal_uut', $formIndex, [$row]);
                if (empty($nominalUUT)) {
                    $nominalUUT = $findValue('nominalUUT', $formIndex, [$row]);
                }
                
                // Ambil nilai nominal Gauge Block
                $nominalGB = $findValue('nominal_gb', $formIndex, [$row]);
                if (empty($nominalGB)) {
                    $nominalGB = $findValue('nominalGB', $formIndex, [$row]);
                }
                
                // Ambil data pengukuran A dan B (AB)
                $ab_gb_a = $findValue('ab_gb_a', $formIndex, [$row]);
                $ab_uut_b = $findValue('ab_uut_b', $formIndex, [$row]);
                $ab_gb_a2 = $findValue('ab_gb_a2', $formIndex, [$row]);
                $ab_uut_b2 = $findValue('ab_uut_b2', $formIndex, [$row]);
                
                // Ambil data pengukuran A dan C (AC)
                $ac_gb_a = $findValue('ac_gb_a', $formIndex, [$row]);
                $ac_uut_c = $findValue('ac_uut_c', $formIndex, [$row]);
                $ac_gb_a2 = $findValue('ac_gb_a2', $formIndex, [$row]);
                $ac_uut_c2 = $findValue('ac_uut_c2', $formIndex, [$row]);
                
                $hasData = !empty($nominalUUT) || !empty($nominalGB) || 
                           !empty($ab_gb_a) || !empty($ab_uut_b) ||
                           !empty($ab_gb_a2) || !empty($ab_uut_b2) ||
                           !empty($ac_gb_a) || !empty($ac_uut_c) ||
                           !empty($ac_gb_a2) || !empty($ac_uut_c2);
                
                if ($hasData) {
                    DetailFeelerGauge::create([
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'nominalUUT' => $nominalUUT,
                        'nominalGB' => $nominalGB,
                        'GBA1' => $ab_gb_a,
                        'UUTB1' => $ab_uut_b,
                        'GBA2' => $ab_gb_a2,
                        'UUTB2' => $ab_uut_b2,
                        'GBA3' => $ac_gb_a,
                        'UUTC3' => $ac_uut_c,
                        'GBA4' => $ac_gb_a2,
                        'UUTC4' => $ac_uut_c2,
                    ]);
                    $detailCount++;
                    \Log::debug("Detail saved for form {$formIndex}, row {$row}");
                }
            }
            \Log::info("✅ Saved {$detailCount} details for form {$formIndex}");
        }
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN JUMLAH FORM
        // ==================================================================
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $savedHeadCount = HeadFeelerGauge::where('calibration_id', $calibration->id)->count();
        $savedDetailCount = DetailFeelerGauge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Feeler Gauge):', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'heads_count' => $savedHeadCount,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $calibration->certificate_id,
            'tab_id' => $tabId,
            'alat_standar' => $standardValue,
        ]);

        \Log::info('🎉 storeFeelerGauge COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeFeelerGauge FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback
        try {
            DetailFeelerGauge::where('calibration_id', $calibration->id)->delete();
            HeadFeelerGauge::where('calibration_id', $calibration->id)->delete();
        } catch (\Exception $rollbackError) {
            \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
        }
        
        throw new \Exception("Gagal menyimpan data Feeler Gauge: " . $e->getMessage());
    }
}

private function updateFeelerGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateFeelerGauge');
        \Log::info('📝 Updating Feeler Gauge data for calibration ID: ' . $calibration->id);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. AMBIL JUMLAH FORM
        // ==================================================================
        $jumlahForm = (int) ($request->jumlah_form ?? $calibration->jumlah_form ?? 1);
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 Jumlah form:', ['jumlah_form' => $jumlahForm]);
        
        // ==================================================================
        // 2. PROSES ALAT STANDAR (DARI FORM 1)
        // ==================================================================
        // Cek berbagai kemungkinan key untuk alat standar
        $alatStandar = [];
        if ($request->has('alat_standar_1')) {
            $alatStandar = $request->input('alat_standar_1', []);
        } elseif ($request->has('alat_standar')) {
            $alatStandar = $request->input('alat_standar', []);
        }
        
        if (is_string($alatStandar)) {
            $alatStandar = [$alatStandar];
        }
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar for Feeler Gauge:', ['alat_standar' => $alatStandarString]);
        
        // ==================================================================
        // 3. UPDATE ATAU CREATE HEAD FEELER GAUGE UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            // Cari satuan unit untuk form ini
            $satuanUnitUUT = $request->input("satuan_unit_uut_{$formIndex}") ?? 
                            $request->input('satuan_unit_uut') ?? 
                            $calibration->{'headFeelerGaugeForm' . $formIndex}->satuan_unit_uut ?? 'mm';
            
            $satuanUnitGaugeBlock = $request->input("satuan_unit_gauge_block_{$formIndex}") ?? 
                                   $request->input('satuan_unit_gauge_block') ?? 
                                   $calibration->{'headFeelerGaugeForm' . $formIndex}->satuan_unit_gauge_block ?? 'mm';
            
            $headData = [
                'standard' => $alatStandarString,
                'calibrationMethod' => 'PAS-IK1102-62',
                'satuan_unit_uut' => $satuanUnitUUT,
                'satuan_unit_gauge_block' => $satuanUnitGaugeBlock,
            ];
            
            // Update certificate_id di HEAD hanya untuk form 1 jika diperlukan
            if ($formIndex == 1 && $certificateIdUpdated && !empty($certificateIdBaru)) {
                $headData['certificate_id'] = $certificateIdBaru;
                \Log::info('📝 Setting certificate_id di HEAD form 1:', ['certificate_id' => $certificateIdBaru]);
            }
            
            $head = HeadFeelerGauge::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                $headData
            );
            
            \Log::info("✅ HeadFeelerGauge updated for form {$formIndex}:", [
                'head_id' => $head->id,
                'satuan_unit_uut' => $satuanUnitUUT,
                'satuan_unit_gauge_block' => $satuanUnitGaugeBlock
            ]);
        }
        
        // ==================================================================
        // 4. UPDATE DETAIL FEELER GAUGE UNTUK SETIAP FORM (25 BARIS)
        // ==================================================================
        \Log::info('📊 Updating DetailFeelerGauge data...');
        
        // Hapus data lama
        $deletedDetails = DetailFeelerGauge::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$deletedDetails} old detail records");
        
        $totalDetailCount = 0;
        
        // Proses untuk setiap form
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $detailCount = 0;
            
            // Proses 25 baris data
            for ($i = 1; $i <= 25; $i++) {
                // Ambil data dari form dengan prefix formIndex
                $nominalUUT = $request->input("nominal_uut_{$formIndex}_{$i}") ?? $request->input("nominal_uut_{$i}");
                $nominalGB = $request->input("nominal_gb_{$formIndex}_{$i}") ?? $request->input("nominal_gb_{$i}");
                
                // Data untuk Pengukuran A dan B
                $ab_gb_a = $request->input("ab_gb_a_{$formIndex}_{$i}") ?? $request->input("ab_gb_a_{$i}");
                $ab_uut_b = $request->input("ab_uut_b_{$formIndex}_{$i}") ?? $request->input("ab_uut_b_{$i}");
                $ab_gb_a2 = $request->input("ab_gb_a2_{$formIndex}_{$i}") ?? $request->input("ab_gb_a2_{$i}");
                $ab_uut_b2 = $request->input("ab_uut_b2_{$formIndex}_{$i}") ?? $request->input("ab_uut_b2_{$i}");
                
                // Data untuk Pengukuran A dan C
                $ac_gb_a = $request->input("ac_gb_a_{$formIndex}_{$i}") ?? $request->input("ac_gb_a_{$i}");
                $ac_uut_c = $request->input("ac_uut_c_{$formIndex}_{$i}") ?? $request->input("ac_uut_c_{$i}");
                $ac_gb_a2 = $request->input("ac_gb_a2_{$formIndex}_{$i}") ?? $request->input("ac_gb_a2_{$i}");
                $ac_uut_c2 = $request->input("ac_uut_c2_{$formIndex}_{$i}") ?? $request->input("ac_uut_c2_{$i}");
                
                // Cek apakah ada data untuk baris ini
                $hasData = !empty($nominalUUT) || !empty($nominalGB) || 
                          !empty($ab_gb_a) || !empty($ab_uut_b) ||
                          !empty($ab_gb_a2) || !empty($ab_uut_b2) ||
                          !empty($ac_gb_a) || !empty($ac_uut_c) ||
                          !empty($ac_gb_a2) || !empty($ac_uut_c2);
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'nominalUUT' => $nominalUUT,
                        'nominalGB' => $nominalGB,
                        'GBA1' => $ab_gb_a,
                        'UUTB1' => $ab_uut_b,
                        'GBA2' => $ab_gb_a2,
                        'UUTB2' => $ab_uut_b2,
                        'GBA3' => $ac_gb_a,
                        'UUTC3' => $ac_uut_c,
                        'GBA4' => $ac_gb_a2,
                        'UUTC4' => $ac_uut_c2,
                    ];
                    
                    DetailFeelerGauge::create($detailData);
                    $detailCount++;
                    $totalDetailCount++;
                }
            }
            
            \Log::info("✅ Saved {$detailCount} DetailFeelerGauge records for form {$formIndex}");
        }
        
        \Log::info("✅ TOTAL Saved {$totalDetailCount} DetailFeelerGauge records");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM 1
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Update jumlah form
        $updateData['jumlah_form'] = $jumlahForm;
        
        // Data TTD dan nama dari calibration
        $calibratedBy = $request->input('calibratedBy') ?? $request->input('calibrated_by');
        if (!empty($calibratedBy)) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy]);
        }
        
        $verifiedBy = $request->input('verifiedBy') ?? $request->input('verified_by');
        if (!empty($verifiedBy)) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy]);
        }
        
        // Data dari form 1 (merek, type, dll)
        if ($request->filled('brandAlat')) {
            $updateData['brandAlat'] = $request->brandAlat;
        }
        if ($request->filled('kodeAlat')) {
            $updateData['kodeAlat'] = $request->kodeAlat;
        }
        if ($request->filled('typeAlat')) {
            $updateData['typeAlat'] = $request->typeAlat;
        }
        if ($request->filled('NoSeri')) {
            $updateData['NoSeri'] = $request->NoSeri;
        }
        if ($request->filled('kapasitas')) {
            $updateData['kapasitas'] = $request->kapasitas;
        }
        if ($request->filled('resolusi')) {
            $updateData['resolusi'] = $request->resolusi;
        }
        if ($request->filled('pemilikAlat')) {
            $updateData['pemilikAlat'] = $request->pemilikAlat;
        }
        if ($request->filled('tanggalMasuk')) {
            $updateData['tanggalMasuk'] = $request->tanggalMasuk;
        }
        if ($request->filled('tanggalKalibrasi')) {
            $updateData['tanggalKalibrasi'] = $request->tanggalKalibrasi;
        }
        if ($request->filled('jenisPembacaan')) {
            $updateData['jenisPembacaan'] = $request->jenisPembacaan;
        }
        if ($request->filled('tempatKalibrasi')) {
            $updateData['tempatKalibrasi'] = $request->tempatKalibrasi;
        }
        if ($request->filled('lokasiPT')) {
            $updateData['lokasiPT'] = $request->lokasiPT;
        }
        if ($request->filled('kondisiAlat')) {
            $updateData['kondisiAlat'] = $request->kondisiAlat;
        }
        if ($request->filled('keterangan')) {
            $updateData['keterangan'] = $request->keterangan;
        }
        
        // Data suhu dan RH
        $suhuFields = ['RT_condition1', 'RT_condition2', 'RT_condition3'];
        $rhFields = ['RH_condition1', 'RH_condition2', 'RH_condition3'];
        
        foreach ($suhuFields as $field) {
            if ($request->filled($field)) {
                $updateData[$field] = $request->$field;
            }
        }
        
        foreach ($rhFields as $field) {
            if ($request->filled($field)) {
                $updateData[$field] = $request->$field;
            }
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated:', array_keys($updateData));
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headsCount = HeadFeelerGauge::where('calibration_id', $calibration->id)->count();
        $totalDetailRecords = DetailFeelerGauge::where('calibration_id', $calibration->id)->count();
        $headForm1 = HeadFeelerGauge::where('calibration_id', $calibration->id)->where('form_index', 1)->first();
        
        \Log::info('📋 UPDATE SUMMARY (Feeler Gauge):', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'heads_count' => $headsCount,
            'detail_records' => $totalDetailRecords,
            'certificate_id_di_head_form1' => $headForm1->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'satuan_unit_uut_form1' => $headForm1->satuan_unit_uut ?? null,
            'satuan_unit_gauge_block_form1' => $headForm1->satuan_unit_gauge_block ?? null,
            'alat_standar' => $alatStandarString,
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);
        
        \Log::info('🎉 updateFeelerGauge COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateFeelerGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Feeler Gauge: " . $e->getMessage());
    }
}

private function storePHMeter($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START storePHMeter');
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - KOMBINASI HIDDEN INPUT + CHECKBOX
        // ==================================================================
        
        // Sumber 1: Hidden input (nilai default - HARUS SELALU ADA)
        $hiddenAlatStandar = trim($request->alat_standar_text ?? '');
        \Log::info('🔧 Hidden alat standar:', ['hidden_value' => $hiddenAlatStandar]);
        
        // Sumber 2: Checkbox array (pilihan tambahan user)
        $checkboxAlatStandar = $request->input('alat_standar', []);
        \Log::info('🔧 Checkbox alat standar:', ['checkbox_values' => $checkboxAlatStandar]);
        
        // KOMBINASI KEDUA DATA:
        // 1. Hidden input selalu dimasukkan
        // 2. Jika ada checkbox, tambahkan setelah hidden input
        
        $standardParts = [];
        
        // Tambahkan hidden input terlebih dahulu
        if (!empty($hiddenAlatStandar)) {
            $standardParts[] = $hiddenAlatStandar;
        } else {
            // Fallback jika hidden input kosong
            $standardParts[] = 'CRM Buffer pH, Merck, 4, 7, & 10';
        }
        
        // Tambahkan checkbox jika ada
        if (is_array($checkboxAlatStandar) && count($checkboxAlatStandar) > 0) {
            $checkboxValues = implode(", ", $checkboxAlatStandar);
            $standardParts[] = $checkboxValues;
        }
        
        // Gabungkan kedua bagian
        $standardValue = implode("; ", $standardParts);
        $source = 'combined';
        
        \Log::info('🔧 Alat standar kombinasi:', [
            'hidden' => $hiddenAlatStandar,
            'checkbox' => $checkboxAlatStandar,
            'combined_result' => $standardValue
        ]);

        // ==================================================================
        // 2. PROSES NAMA KALIBRATOR DAN PEMERIKSA
        // ==================================================================
        // PERHATIAN: Perhatikan name input di HTML
        $namaKalibrator = trim($request->calibrated_by ?? ''); // Sesuai name="calibrated_by"
        $namaPemeriksa = trim($request->verified_by ?? '');    // Sesuai name="verified_by"
        
        \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);

        // ==================================================================
        // 3. SIMPAN KE HEAD PH METER
        // ==================================================================
        $head = HeadPhMeter::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-40',
        ]);

        \Log::info('✅ HeadPhMeter saved:', ['head_id' => $head->id]);

        // ==================================================================
        // 4. SIMPAN DETAIL PH METER (5 TITIK UKUR)
        // ==================================================================
        \Log::info('📊 Saving DetailPhMeter data (5 titik ukur)...');
        $detailCount = 0;
        
        // Proses 5 titik ukur (sesuai form HTML)
        for ($i = 1; $i <= 5; $i++) {
            // Ambil data dari input form sesuai nama input HTML
            $buffer = $request->{"buffer_$i"} ?? null;
            $pembacaan_1 = $request->{"pembacaan_{$i}_1"} ?? null;
            $pembacaan_2 = $request->{"pembacaan_{$i}_2"} ?? null;
            $pembacaan_3 = $request->{"pembacaan_{$i}_3"} ?? null;
            $pembacaan_4 = $request->{"pembacaan_{$i}_4"} ?? null;
            $pembacaan_5 = $request->{"pembacaan_{$i}_5"} ?? null;
            $resolusi = $request->{"resolusi_$i"} ?? null;
            $suhu = $request->{"suhu_$i"} ?? null;
            
            \Log::debug("🔍 Row {$i} data from request:", [
                'buffer' => $buffer,
                'pembacaan_1' => $pembacaan_1,
                'pembacaan_2' => $pembacaan_2,
                'pembacaan_3' => $pembacaan_3,
                'pembacaan_4' => $pembacaan_4,
                'pembacaan_5' => $pembacaan_5,
                'resolusi' => $resolusi,
                'suhu' => $suhu,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($buffer) || 
                      !empty($pembacaan_1) || !empty($pembacaan_2) || !empty($pembacaan_3) || 
                      !empty($pembacaan_4) || !empty($pembacaan_5) || 
                      !empty($resolusi) || !empty($suhu);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nilaiBuffer' => $buffer,       // buffer_X
                    'rep01' => $pembacaan_1,       // pembacaan_X_1
                    'rep02' => $pembacaan_2,       // pembacaan_X_2
                    'rep03' => $pembacaan_3,       // pembacaan_X_3
                    'rep04' => $pembacaan_4,       // pembacaan_X_4
                    'rep05' => $pembacaan_5,       // pembacaan_X_5
                    'Resolusi' => $resolusi,       // resolusi_X
                    'TBuffer' => $suhu,            // suhu_X
                ];
                
                \Log::debug("💾 Saving DetailPhMeter row {$i}:", $detailData);
                
                DetailPhMeter::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved pH Meter row {$i}");
            } else {
                \Log::debug("⏭️ Skipping row {$i} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailPhMeter records");

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Update nama kalibrator (jika diisi) - SESUAI NAME INPUT
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $namaKalibrator]);
        }
        
        // Update nama pemeriksa (jika diisi) - SESUAI NAME INPUT
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa:', ['nama' => $namaPemeriksa]);
        }
        
        // Update uncertainty dan keterangan (jika ada)
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailPhMeter::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (pH Meter):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $certificateId,
            'alat_standar' => $standardValue,
            'alat_standar_source' => $source,
            'hidden_alat_standar' => $hiddenAlatStandar,
            'checkbox_alat_standar' => $checkboxAlatStandar,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 storePHMeter COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storePHMeter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailPhMeter::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data pH Meter: " . $e->getMessage());
    }
}

private function updatePhMeter($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START updatePhMeter', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $certificateId
        ]);

        // ==================================================================
        // 1. VALIDASI DAN AMBIL CERTIFICATE ID
        // ==================================================================
        $finalCertificateId = $certificateId;
        
        // Jika certificate_id dari parameter null, ambil dari calibration
        if (empty($finalCertificateId)) {
            $finalCertificateId = $calibration->certificate_id;
            \Log::info('📋 Mengambil certificate_id dari calibration:', [
                'certificate_id' => $finalCertificateId
            ]);
        }
        
        // Jika masih null, ambil dari head yang sudah ada di database
        if (empty($finalCertificateId)) {
            $existingHead = HeadPhMeter::where('calibration_id', $calibration->id)->first();
            if ($existingHead && !empty($existingHead->certificate_id)) {
                $finalCertificateId = $existingHead->certificate_id;
                \Log::info('📋 Mengambil certificate_id dari existing head:', [
                    'certificate_id' => $finalCertificateId,
                    'head_id' => $existingHead->id
                ]);
            }
        }
        
        // Jika masih null, coba ambil dari detail
        if (empty($finalCertificateId)) {
            $existingDetail = DetailPhMeter::where('calibration_id', $calibration->id)->first();
            if ($existingDetail && !empty($existingDetail->certificate_id)) {
                $finalCertificateId = $existingDetail->certificate_id;
                \Log::info('📋 Mengambil certificate_id dari existing detail:', [
                    'certificate_id' => $finalCertificateId
                ]);
            }
        }
        
        // Jika masih null, throw error
        if (empty($finalCertificateId)) {
            \Log::error('❌ Certificate ID tidak ditemukan untuk pH Meter update', [
                'calibration_id' => $calibration->id,
                'certificate_id_from_param' => $certificateId,
                'certificate_id_from_calibration' => $calibration->certificate_id
            ]);
            throw new \Exception('Certificate ID is required for pH Meter update');
        }

        // ==================================================================
        // 2. PROSES ALAT STANDAR - KOMBINASI HIDDEN INPUT + CHECKBOX
        // ==================================================================
        
        // Sumber 1: Hidden input (nilai default - HARUS SELALU ADA)
        $hiddenAlatStandar = trim($request->alat_standar_text ?? '');
        \Log::info('🔧 Hidden alat standar:', ['hidden_value' => $hiddenAlatStandar]);
        
        // Sumber 2: Checkbox array (pilihan tambahan user)
        $checkboxAlatStandar = $request->input('alat_standar', []);
        \Log::info('🔧 Checkbox alat standar:', ['checkbox_values' => $checkboxAlatStandar]);
        
        // KOMBINASI KEDUA DATA:
        $standardParts = [];
        
        // Tambahkan hidden input terlebih dahulu
        if (!empty($hiddenAlatStandar)) {
            $standardParts[] = $hiddenAlatStandar;
        } else {
            // Fallback jika hidden input kosong
            $standardParts[] = 'CRM Buffer pH, Merck, 4, 7, & 10';
        }
        
        // Tambahkan checkbox jika ada
        if (is_array($checkboxAlatStandar) && count($checkboxAlatStandar) > 0) {
            $checkboxValues = implode(", ", $checkboxAlatStandar);
            $standardParts[] = $checkboxValues;
        }
        
        // Gabungkan kedua bagian
        $standardValue = implode("; ", $standardParts);
        $source = 'combined';
        
        \Log::info('🔧 Alat standar kombinasi (update):', [
            'hidden' => $hiddenAlatStandar,
            'checkbox' => $checkboxAlatStandar,
            'combined_result' => $standardValue
        ]);

        // ==================================================================
        // 3. PROSES NAMA KALIBRATOR DAN PEMERIKSA
        // ==================================================================
        $namaKalibrator = trim($request->calibrated_by ?? '');
        $namaPemeriksa = trim($request->verified_by ?? '');
        
        \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);

        // ==================================================================
        // 4. UPDATE HEAD PH METER
        // ==================================================================
        $head = HeadPhMeter::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📊 Head PhMeter BEFORE update:', [
            'head_exists' => $head ? true : false,
            'head_id' => $head->id ?? null,
            'certificate_id_before' => $head->certificate_id ?? null,
        ]);
        
        $headData = [
            'certificate_id' => $finalCertificateId,
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-40',
        ];
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ HeadPhMeter updated:', ['head_id' => $head->id]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadPhMeter::create($headData);
            \Log::info('✅ HeadPhMeter created:', ['head_id' => $head->id]);
        }
        
        \Log::info('✅ HeadPhMeter AFTER update:', [
            'head_id' => $head->id,
            'certificate_id_after' => $head->certificate_id,
        ]);

        // ==================================================================
        // 5. UPDATE DETAIL PH METER (5 TITIK UKUR)
        // ==================================================================
        \Log::info('📊 Updating DetailPhMeter data (5 titik ukur)...');
        
        // Hapus data lama
        $deletedCount = DetailPhMeter::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records:', ['count' => $deletedCount]);
        
        $detailCount = 0;
        
        // Ambil data dari request (sesuai dengan name input di tabel edit)
        $nilaiBufferArray = $request->input('nilaiBuffer', []);
        $rep01Array = $request->input('rep01', []);
        $rep02Array = $request->input('rep02', []);
        $rep03Array = $request->input('rep03', []);
        $rep04Array = $request->input('rep04', []);
        $rep05Array = $request->input('rep05', []);
        $resolusiArray = $request->input('Resolusi', []);
        $tBufferArray = $request->input('TBuffer', []);
        
        \Log::info('📊 Data arrays received:', [
            'nilaiBuffer_count' => count($nilaiBufferArray),
            'rep01_count' => count($rep01Array),
            'rep02_count' => count($rep02Array),
            'rep03_count' => count($rep03Array),
            'rep04_count' => count($rep04Array),
            'rep05_count' => count($rep05Array),
            'resolusi_count' => count($resolusiArray),
            'tBuffer_count' => count($tBufferArray),
        ]);
        
        // Proses 5 titik ukur (sesuai form HTML)
        for ($i = 0; $i < 5; $i++) {
            // Ambil data dari array
            $buffer = $nilaiBufferArray[$i] ?? null;
            $pembacaan_1 = $rep01Array[$i] ?? null;
            $pembacaan_2 = $rep02Array[$i] ?? null;
            $pembacaan_3 = $rep03Array[$i] ?? null;
            $pembacaan_4 = $rep04Array[$i] ?? null;
            $pembacaan_5 = $rep05Array[$i] ?? null;
            $resolusi = $resolusiArray[$i] ?? null;
            $suhu = $tBufferArray[$i] ?? null;
            
            \Log::debug("🔍 Row " . ($i + 1) . " data from request (update):", [
                'buffer' => $buffer,
                'pembacaan_1' => $pembacaan_1,
                'pembacaan_2' => $pembacaan_2,
                'pembacaan_3' => $pembacaan_3,
                'pembacaan_4' => $pembacaan_4,
                'pembacaan_5' => $pembacaan_5,
                'resolusi' => $resolusi,
                'suhu' => $suhu,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($buffer) || 
                      !empty($pembacaan_1) || !empty($pembacaan_2) || !empty($pembacaan_3) || 
                      !empty($pembacaan_4) || !empty($pembacaan_5) || 
                      !empty($resolusi) || !empty($suhu);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'certificate_id' => $finalCertificateId,
                    'nilaiBuffer' => $buffer,
                    'rep01' => $pembacaan_1,
                    'rep02' => $pembacaan_2,
                    'rep03' => $pembacaan_3,
                    'rep04' => $pembacaan_4,
                    'rep05' => $pembacaan_5,
                    'Resolusi' => $resolusi,
                    'TBuffer' => $suhu,
                ];
                
                \Log::debug("💾 Saving DetailPhMeter row " . ($i + 1) . " (update):", $detailData);
                
                DetailPhMeter::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved pH Meter row " . ($i + 1) . " (update)");
            } else {
                \Log::debug("⏭️ Skipping row " . ($i + 1) . " - no data");
            }
        }
        
        \Log::info("✅ Updated {$detailCount} DetailPhMeter records");

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Update nama kalibrator (jika diisi)
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi (update):', ['nama' => $namaKalibrator]);
        }
        
        // Update nama pemeriksa (jika diisi)
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa (update):', ['nama' => $namaPemeriksa]);
        }
        
        // Update uncertainty dan keterangan (jika ada)
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Pastikan certificate_id di calibration juga terupdate
        if (!empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data', $updateData);
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailPhMeter::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (pH Meter):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'certificate_id' => $finalCertificateId,
            'certificate_id_source' => $certificateId ? 'parameter' : ($calibration->certificate_id ? 'calibration' : 'existing_data'),
            'alat_standar' => $standardValue,
            'alat_standar_source' => $source,
            'hidden_alat_standar' => $hiddenAlatStandar,
            'checkbox_alat_standar' => $checkboxAlatStandar,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updatePhMeter COMPLETED');
        
        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePhMeter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'certificate_id' => $certificateId ?? null,
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data pH Meter: " . $e->getMessage());
    }
}

private function storeTachometer($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START storeTachometer');
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - HANYA DARI CHECKBOX INPUTAN
        // ==================================================================
        
        // Ambil checkbox array (pilihan user)
        $checkboxAlatStandar = $request->input('alat_standar', []);
        \Log::info('🔧 Checkbox alat standar:', ['checkbox_values' => $checkboxAlatStandar]);
        
        // HANYA gunakan checkbox yang dipilih, TANPA hidden input
        if (is_array($checkboxAlatStandar) && count($checkboxAlatStandar) > 0) {
            $standardValue = implode(", ", $checkboxAlatStandar);
            \Log::info('🔧 Menggunakan alat standar dari checkbox user:', ['alat_standar' => $standardValue]);
        } else {
            $standardValue = ''; // Kosong jika tidak ada checkbox yang dipilih
            \Log::info('🔧 Tidak ada alat standar yang dipilih');
        }

        // ==================================================================
        // 2. PROSES NAMA KALIBRATOR DAN PEMERIKSA
        // ==================================================================
        $namaKalibrator = trim($request->calibrated_by ?? '');
        $namaPemeriksa = trim($request->verified_by ?? '');
        
        \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);

        // ==================================================================
        // 3. SIMPAN KE HEAD TACHOMETER
        // ==================================================================
        $head = HeadTachometer::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-48', // Sesuai form: PAS-IK1102-48
            'satuan_unit' => $request->satuan_unit ?? null, 
        ]);

        \Log::info('✅ HeadTachometer saved:', ['head_id' => $head->id]);

        // ==================================================================
        // 4. SIMPAN DETAIL TACHOMETER (BERDASARKAN $jumlah_baris)
        // ==================================================================
        \Log::info('📊 Saving DetailTachometer data...');
        $detailCount = 0;
        
        // Tentukan jumlah baris (dari form atau default)
        $jumlahBaris = $request->jumlah_baris ?? 12; // Default 5 baris jika tidak ada
        
        \Log::info('📝 Jumlah baris tachometer:', ['jumlah_baris' => $jumlahBaris]);
        
        // Proses setiap baris
        for ($row = 1; $row <= $jumlahBaris; $row++) {
            // Ambil data dari input form sesuai nama input HTML
            $nominal = $request->{"nominal_$row"} ?? null;
            $pembacaan_1 = $request->{"pembacaan_{$row}_1"} ?? null;
            $pembacaan_2 = $request->{"pembacaan_{$row}_2"} ?? null;
            $pembacaan_3 = $request->{"pembacaan_{$row}_3"} ?? null;
            $pembacaan_4 = $request->{"pembacaan_{$row}_4"} ?? null;
            $pembacaan_5 = $request->{"pembacaan_{$row}_5"} ?? null;
            $resolusi = $request->{"resolusi_$row"} ?? null;
            
            \Log::debug("🔍 Row {$row} data from request:", [
                'nominal' => $nominal,
                'pembacaan_1' => $pembacaan_1,
                'pembacaan_2' => $pembacaan_2,
                'pembacaan_3' => $pembacaan_3,
                'pembacaan_4' => $pembacaan_4,
                'pembacaan_5' => $pembacaan_5,
                'resolusi' => $resolusi,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($nominal) || 
                      !empty($pembacaan_1) || !empty($pembacaan_2) || !empty($pembacaan_3) || 
                      !empty($pembacaan_4) || !empty($pembacaan_5) || 
                      !empty($resolusi);
            
            if ($hasData) {
                // MAPPING KE MODEL DetailTachometer
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nilaiStandard' =>$nominal,     // nominal_X
                    'rep01' =>$pembacaan_1,        // pembacaan_X_1
                    'rep02' =>$pembacaan_2,        // pembacaan_X_2
                    'rep03' =>$pembacaan_3,        // pembacaan_X_3
                    'rep04' =>$pembacaan_4,        // pembacaan_X_4
                    'rep05' =>$pembacaan_5,        // pembacaan_X_5
                    'resolusiAlat' =>$resolusi,    // resolusi_X
                ];
                
                \Log::debug("💾 Saving DetailTachometer row {$row}:", $detailData);
                
                DetailTachometer::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved Tachometer row {$row}");
            } else {
                \Log::debug("⏭️ Skipping row {$row} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailTachometer records");

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Update nama kalibrator (jika diisi)
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $namaKalibrator]);
        }
        
        // Update nama pemeriksa (jika diisi)
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa:', ['nama' => $namaPemeriksa]);
        }
        
        // Update uncertainty dan keterangan (jika ada)
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Update satuan jika ada (sesuai input "Unit (......)")
        if ($request->filled('unit_tachometer')) {
            $updateData['unit'] = $request->unit_tachometer;
            \Log::info('📏 Satuan tachometer:', ['unit' => $request->unit_tachometer]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailTachometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Tachometer):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'total_rows' => $jumlahBaris,
            'certificate_id' => $certificateId,
            'alat_standar' => $standardValue,
            'alat_standar_checkbox' => $checkboxAlatStandar,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
            'unit' => $calibration->unit ?? null,
        ]);

        \Log::info('🎉 storeTachometer COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeTachometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailTachometer::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Tachometer: " . $e->getMessage());
    }
}

private function updateTachometer($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateTachometer');
        \Log::info('📝 Updating Tachometer data for calibration ID: ' . $calibration->id);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headTachometer;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - HANYA DARI CHECKBOX INPUTAN
        // ==================================================================
        
        // Ambil checkbox array (pilihan user)
        $checkboxAlatStandar = $request->input('alat_standar', []);
        \Log::info('🔧 Checkbox alat standar:', ['checkbox_values' => $checkboxAlatStandar]);
        
        // HANYA gunakan checkbox yang dipilih
        if (is_array($checkboxAlatStandar) && count($checkboxAlatStandar) > 0) {
            $standardValue = implode(", ", $checkboxAlatStandar);
            \Log::info('🔧 Menggunakan alat standar dari checkbox user:', ['alat_standar' => $standardValue]);
        } else {
            $standardValue = '';
            \Log::info('🔧 Tidak ada alat standar yang dipilih');
        }
        
        // ==================================================================
        // 2. PROSES NAMA KALIBRATOR DAN PEMERIKSA
        // ==================================================================
        $namaKalibrator = trim($request->calibrated_by ?? '');
        $namaPemeriksa = trim($request->verified_by ?? '');
        
        \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);
        
        // ==================================================================
        // 3. UPDATE ATAU CREATE HEAD TACHOMETER
        // ==================================================================
        $head = HeadTachometer::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-48',
            'satuan_unit' => $request->satuan_unit,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadTachometer updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadTachometer::create($headData);
            \Log::info('➕ HeadTachometer created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 4. UPDATE DETAIL TACHOMETER - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating DetailTachometer data...');
        
        // Hapus data lama terlebih dahulu
        $deletedDetails = DetailTachometer::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$deletedDetails} old detail records");
        
        $detailCount = 0;
        
        // Tentukan jumlah baris (dari form atau default)
        $jumlahBaris = $request->jumlah_baris ?? 12;
        
        \Log::info('📝 Jumlah baris tachometer:', ['jumlah_baris' => $jumlahBaris]);
        
        // Proses setiap baris - LANGSUNG TANPA FORMAT
        for ($row = 1; $row <= $jumlahBaris; $row++) {
            // Ambil data dari input form - LANGSUNG TANPA FORMAT
            $nominal = $request->input("nominal_{$row}");
            $pembacaan_1 = $request->input("pembacaan_{$row}_1");
            $pembacaan_2 = $request->input("pembacaan_{$row}_2");
            $pembacaan_3 = $request->input("pembacaan_{$row}_3");
            $pembacaan_4 = $request->input("pembacaan_{$row}_4");
            $pembacaan_5 = $request->input("pembacaan_{$row}_5");
            $resolusi = $request->input("resolusi_{$row}");
            
            \Log::debug("🔍 Row {$row} data from request:", [
                'nominal' => $nominal,
                'pembacaan_1' => $pembacaan_1,
                'pembacaan_2' => $pembacaan_2,
                'pembacaan_3' => $pembacaan_3,
                'pembacaan_4' => $pembacaan_4,
                'pembacaan_5' => $pembacaan_5,
                'resolusi' => $resolusi,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($nominal) || 
                      !empty($pembacaan_1) || !empty($pembacaan_2) || !empty($pembacaan_3) || 
                      !empty($pembacaan_4) || !empty($pembacaan_5) || 
                      !empty($resolusi);
            
            if ($hasData) {
                // Mapping ke model DetailTachometer - LANGSUNG TANPA FORMAT
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nilaiStandard' => $nominal,           // LANGSUNG, tanpa format
                    'rep01' => $pembacaan_1,               // LANGSUNG, tanpa format
                    'rep02' => $pembacaan_2,               // LANGSUNG, tanpa format
                    'rep03' => $pembacaan_3,               // LANGSUNG, tanpa format
                    'rep04' => $pembacaan_4,               // LANGSUNG, tanpa format
                    'rep05' => $pembacaan_5,               // LANGSUNG, tanpa format
                    'resolusiAlat' => $resolusi,           // LANGSUNG, tanpa format
                ];
                
                \Log::debug("💾 Saving DetailTachometer row {$row}:", $detailData);
                
                DetailTachometer::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved Tachometer row {$row}");
            } else {
                \Log::debug("⏭️ Skipping row {$row} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailTachometer records");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Update nama kalibrator (jika diisi)
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $namaKalibrator]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        // Update nama pemeriksa (jika diisi)
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa:', ['nama' => $namaPemeriksa]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        // Update uncertainty dan keterangan (jika ada)
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Update satuan jika ada (sesuai input "Unit (......)")
        if ($request->filled('unit_tachometer')) {
            $updateData['unit'] = $request->unit_tachometer;
            \Log::info('📏 Satuan tachometer:', ['unit' => $request->unit_tachometer]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headTachometer;
        $savedDetailCount = DetailTachometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Tachometer):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $savedDetailCount,
            'total_rows' => $jumlahBaris,
            'alat_standar' => $standardValue,
            'satuan_unit' => $request->satuan_unit,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
            'nama_alat' => $calibration->namaAlat,
        ]);
        
        \Log::info('🎉 updateTachometer COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTachometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Tachometer: " . $e->getMessage());
    }
}

private function storePinGauge($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START storePinGauge');
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - HANYA DARI CHECKBOX INPUTAN
        // ==================================================================
        
        // Ambil checkbox array (pilihan user)
        $checkboxAlatStandar = $request->input('alat_standar', []);
        \Log::info('🔧 Checkbox alat standar:', ['checkbox_values' => $checkboxAlatStandar]);
        
        // HANYA gunakan checkbox yang dipilih, TANPA hidden input
        if (is_array($checkboxAlatStandar) && count($checkboxAlatStandar) > 0) {
            $standardValue = implode(", ", $checkboxAlatStandar);
            \Log::info('🔧 Menggunakan alat standar dari checkbox user:', ['alat_standar' => $standardValue]);
        } else {
            $standardValue = ''; // Kosong jika tidak ada checkbox yang dipilih
            \Log::info('🔧 Tidak ada alat standar yang dipilih');
        }

        // ==================================================================
        // 2. PROSES NAMA KALIBRATOR DAN PEMERIKSA
        // ==================================================================
        $namaKalibrator = trim($request->calibrated_by ?? '');
        $namaPemeriksa = trim($request->verified_by ?? '');
        
        \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);

        // ==================================================================
        // 3. SIMPAN KE HEAD PIN GAUGE
        // ==================================================================
        $head = HeadPinGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-49', // Sesuai form Pin Gauge: PAS-IK1102-49
        ]);

        \Log::info('✅ HeadPinGauge saved:', ['head_id' => $head->id]);

        // ==================================================================
        // 4. SIMPAN DETAIL PIN GAUGE (BERDASARKAN 22 BARIS)
        // ==================================================================
        \Log::info('📊 Saving DetailPinGauge data...');
        $detailCount = 0;
        
        // Tentukan jumlah baris - PIN GAUGE selalu 22 baris (1-22)
        $jumlahBaris = 22;
        
        \Log::info('📝 Jumlah baris pin gauge:', ['jumlah_baris' => $jumlahBaris]);
        
        // Proses setiap baris dari 1 sampai 22
        for ($row = 1; $row <= $jumlahBaris; $row++) {
            // Ambil data dari input form sesuai nama input HTML dari tabel
            $nominal = $request->{"nominal_$row"} ?? null;
            $atas1 = $request->{"atas_{$row}_1"} ?? null;
            $atas4 = $request->{"atas_{$row}_4"} ?? null;
            $tengah2 = $request->{"tengah_{$row}_2"} ?? null;
            $tengah5 = $request->{"tengah_{$row}_5"} ?? null;
            $bawah3 = $request->{"bawah_{$row}_3"} ?? null;
            $bawah6 = $request->{"bawah_{$row}_6"} ?? null;
            
            \Log::debug("🔍 Row {$row} data from request:", [
                'nominal' => $nominal,
                'atas_1' => $atas1,
                'tengah_2' => $tengah2,
                'bawah_3' => $bawah3,
                'atas_4' => $atas4,
                'tengah_5' => $tengah5,
                'bawah_6' => $bawah6,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($nominal) || 
                      !empty($atas1) || !empty($tengah2) || !empty($bawah3) || 
                      !empty($atas4) || !empty($tengah5) || !empty($bawah6);
            
            if ($hasData) {
                // MAPPING KE MODEL DetailPinGauge sesuai field database
                // Mapping: titikUkur → nominal, ulangan1-6 → posisi pengukuran
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $nominal,  // nominal_X
                    'ulangan1' => $atas1,     // atas_X_1
                    'ulangan2' => $tengah2,   // tengah_X_2
                    'ulangan3' => $bawah3,    // bawah_X_3
                    'ulangan4' => $atas4,     // atas_X_4
                    'ulangan5' => $tengah5,   // tengah_X_5
                    'ulangan6' => $bawah6,    // bawah_X_6
                ];
                
                \Log::debug("💾 Saving DetailPinGauge row {$row}:", $detailData);
                
                DetailPinGauge::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved Pin Gauge row {$row}");
            } else {
                \Log::debug("⏭️ Skipping row {$row} - no data");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailPinGauge records");

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Update nama kalibrator (jika diisi)
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $namaKalibrator]);
        }
        
        // Update nama pemeriksa (jika diisi)
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa:', ['nama' => $namaPemeriksa]);
        }
        
        // Update uncertainty dan keterangan global (jika ada)
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Update satuan jika ada (sesuai input "Unit (......)")
        if ($request->filled('unit_pin_gauge')) {
            $updateData['unit'] = $request->unit_pin_gauge;
            \Log::info('📏 Satuan pin gauge:', ['unit' => $request->unit_pin_gauge]);
        }
        
        // Update kondisi lingkungan khusus untuk pin gauge
        $environmentData = [];
        
        if ($request->filled('temperature')) {
            $environmentData['temperature'] = $request->temperature;
        }
        
        if ($request->filled('humidity')) {
            $environmentData['humidity'] = $request->humidity;
        }
        
        if (!empty($environmentData)) {
            $updateData['environment_condition'] = json_encode($environmentData);
            \Log::info('🌡️ Kondisi lingkungan:', $environmentData);
        }
        
        // Tambahan: Update range jika ada di form Pin Gauge
        if ($request->filled('range_pin_gauge')) {
            $updateData['range'] = $request->range_pin_gauge;
            \Log::info('📐 Range pin gauge:', ['range' => $request->range_pin_gauge]);
        }
        
        // Tambahan: Update resolusi jika ada di form Pin Gauge
        if ($request->filled('resolution_pin_gauge')) {
            $updateData['resolution'] = $request->resolution_pin_gauge;
            \Log::info('🔍 Resolusi pin gauge:', ['resolution' => $request->resolution_pin_gauge]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data');
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailPinGauge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Pin Gauge):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'total_rows' => $jumlahBaris,
            'certificate_id' => $certificateId,
            'alat_standar' => $standardValue,
            'alat_standar_checkbox' => $checkboxAlatStandar,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
            'unit' => $calibration->unit ?? null,
            'range' => $calibration->range ?? null,
            'resolution' => $calibration->resolution ?? null,
            'environment_condition' => $calibration->environment_condition ?? null,
        ]);

        \Log::info('🎉 storePinGauge COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR storePinGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailPinGauge::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Pin Gauge: " . $e->getMessage());
    }
}

private function updatePinGauge($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START updatePinGauge', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $certificateId
        ]);

        // ==================================================================
        // 1. VALIDASI DAN AMBIL CERTIFICATE ID
        // ==================================================================
        $finalCertificateId = $certificateId;
        
        // Jika certificate_id dari parameter null, ambil dari calibration
        if (empty($finalCertificateId)) {
            $finalCertificateId = $calibration->certificate_id;
            \Log::info('📋 Mengambil certificate_id dari calibration:', [
                'certificate_id' => $finalCertificateId
            ]);
        }
        
        // Jika masih null, ambil dari head yang sudah ada di database
        if (empty($finalCertificateId)) {
            $existingHead = HeadPinGauge::where('calibration_id', $calibration->id)->first();
            if ($existingHead && !empty($existingHead->certificate_id)) {
                $finalCertificateId = $existingHead->certificate_id;
                \Log::info('📋 Mengambil certificate_id dari existing head:', [
                    'certificate_id' => $finalCertificateId,
                    'head_id' => $existingHead->id
                ]);
            }
        }
        
        // Jika masih null, coba ambil dari detail
        if (empty($finalCertificateId)) {
            $existingDetail = DetailPinGauge::where('calibration_id', $calibration->id)->first();
            if ($existingDetail && !empty($existingDetail->certificate_id)) {
                $finalCertificateId = $existingDetail->certificate_id;
                \Log::info('📋 Mengambil certificate_id dari existing detail:', [
                    'certificate_id' => $finalCertificateId
                ]);
            }
        }
        
        // Jika masih null, throw error
        if (empty($finalCertificateId)) {
            \Log::error('❌ Certificate ID tidak ditemukan untuk Pin Gauge update', [
                'calibration_id' => $calibration->id,
                'certificate_id_from_param' => $certificateId,
                'certificate_id_from_calibration' => $calibration->certificate_id
            ]);
            throw new \Exception('Certificate ID is required for Pin Gauge update');
        }

        // ==================================================================
        // 2. PROSES ALAT STANDAR - HANYA DARI CHECKBOX INPUTAN
        // ==================================================================
        
        // Ambil checkbox array (pilihan user)
        $checkboxAlatStandar = $request->input('alat_standar', []);
        \Log::info('🔧 Checkbox alat standar:', ['checkbox_values' => $checkboxAlatStandar]);
        
        // HANYA gunakan checkbox yang dipilih, TANPA hidden input
        if (is_array($checkboxAlatStandar) && count($checkboxAlatStandar) > 0) {
            $standardValue = implode(", ", $checkboxAlatStandar);
            \Log::info('🔧 Menggunakan alat standar dari checkbox user (update):', ['alat_standar' => $standardValue]);
        } else {
            $standardValue = ''; // Kosong jika tidak ada checkbox yang dipilih
            \Log::info('🔧 Tidak ada alat standar yang dipilih (update)');
        }

        // ==================================================================
        // 3. PROSES NAMA KALIBRATOR DAN PEMERIKSA
        // ==================================================================
        $namaKalibrator = trim($request->calibrated_by ?? '');
        $namaPemeriksa = trim($request->verified_by ?? '');
        
        \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);

        // ==================================================================
        // 4. UPDATE HEAD PIN GAUGE
        // ==================================================================
        $head = HeadPinGauge::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📊 Head PinGauge BEFORE update:', [
            'head_exists' => $head ? true : false,
            'head_id' => $head->id ?? null,
            'certificate_id_before' => $head->certificate_id ?? null,
        ]);
        
        $headData = [
            'certificate_id' => $finalCertificateId,
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-49',
        ];
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ HeadPinGauge updated:', ['head_id' => $head->id]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadPinGauge::create($headData);
            \Log::info('✅ HeadPinGauge created:', ['head_id' => $head->id]);
        }
        
        \Log::info('✅ HeadPinGauge AFTER update:', [
            'head_id' => $head->id,
            'certificate_id_after' => $head->certificate_id,
        ]);

        // ==================================================================
        // 5. UPDATE DETAIL PIN GAUGE (22 BARIS)
        // ==================================================================
        \Log::info('📊 Updating DetailPinGauge data (22 baris)...');
        
        // Hapus data lama
        $deletedCount = DetailPinGauge::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records:', ['count' => $deletedCount]);
        
        $detailCount = 0;
        $jumlahBaris = 22;
        
        // Ambil data dari array input (sesuai dengan name input di tabel edit)
        $nominalArray = $request->input('titikUkur', []);
        $atas1Array = $request->input('ulangan1', []);
        $tengah2Array = $request->input('ulangan2', []);
        $bawah3Array = $request->input('ulangan3', []);
        $atas4Array = $request->input('ulangan4', []);
        $tengah5Array = $request->input('ulangan5', []);
        $bawah6Array = $request->input('ulangan6', []);
        
        \Log::info('📊 Data arrays received:', [
            'nominal_count' => count($nominalArray),
            'atas1_count' => count($atas1Array),
            'tengah2_count' => count($tengah2Array),
            'bawah3_count' => count($bawah3Array),
            'atas4_count' => count($atas4Array),
            'tengah5_count' => count($tengah5Array),
            'bawah6_count' => count($bawah6Array),
        ]);
        
        // Proses setiap baris dari 1 sampai 22
        for ($row = 0; $row < $jumlahBaris; $row++) {
            // Ambil data dari array (index mulai dari 0)
            $nominal = $nominalArray[$row] ?? null;
            $atas1 = $atas1Array[$row] ?? null;
            $tengah2 = $tengah2Array[$row] ?? null;
            $bawah3 = $bawah3Array[$row] ?? null;
            $atas4 = $atas4Array[$row] ?? null;
            $tengah5 = $tengah5Array[$row] ?? null;
            $bawah6 = $bawah6Array[$row] ?? null;
            
            \Log::debug("🔍 Row " . ($row + 1) . " data from request (update):", [
                'nominal' => $nominal,
                'atas_1' => $atas1,
                'tengah_2' => $tengah2,
                'bawah_3' => $bawah3,
                'atas_4' => $atas4,
                'tengah_5' => $tengah5,
                'bawah_6' => $bawah6,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($nominal) || 
                      !empty($atas1) || !empty($tengah2) || !empty($bawah3) || 
                      !empty($atas4) || !empty($tengah5) || !empty($bawah6);
            
            if ($hasData) {
                // MAPPING KE MODEL DetailPinGauge sesuai field database
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'certificate_id' => $finalCertificateId,
                    'titikUkur' => $nominal,
                    'ulangan1' => $atas1,
                    'ulangan2' => $tengah2,
                    'ulangan3' => $bawah3,
                    'ulangan4' => $atas4,
                    'ulangan5' => $tengah5,
                    'ulangan6' => $bawah6,
                ];
                
                \Log::debug("💾 Saving DetailPinGauge row " . ($row + 1) . " (update):", $detailData);
                
                DetailPinGauge::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved Pin Gauge row " . ($row + 1) . " (update)");
            } else {
                \Log::debug("⏭️ Skipping row " . ($row + 1) . " - no data");
            }
        }
        
        \Log::info("✅ Updated {$detailCount} DetailPinGauge records");

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Update nama kalibrator (jika diisi)
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi (update):', ['nama' => $namaKalibrator]);
        }
        
        // Update nama pemeriksa (jika diisi)
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa (update):', ['nama' => $namaPemeriksa]);
        }
        
        // Update uncertainty dan keterangan global (jika ada)
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Update satuan jika ada (sesuai input "Unit (......)")
        if ($request->filled('unit_pin_gauge')) {
            $updateData['unit'] = $request->unit_pin_gauge;
            \Log::info('📏 Satuan pin gauge (update):', ['unit' => $request->unit_pin_gauge]);
        }
        
        // Update kondisi lingkungan khusus untuk pin gauge
        $environmentData = [];
        
        if ($request->filled('temperature')) {
            $environmentData['temperature'] = $request->temperature;
        }
        
        if ($request->filled('humidity')) {
            $environmentData['humidity'] = $request->humidity;
        }
        
        if (!empty($environmentData)) {
            $updateData['environment_condition'] = json_encode($environmentData);
            \Log::info('🌡️ Kondisi lingkungan (update):', $environmentData);
        }
        
        // Tambahan: Update range jika ada di form Pin Gauge
        if ($request->filled('range_pin_gauge')) {
            $updateData['range'] = $request->range_pin_gauge;
            \Log::info('📐 Range pin gauge (update):', ['range' => $request->range_pin_gauge]);
        }
        
        // Tambahan: Update resolusi jika ada di form Pin Gauge
        if ($request->filled('resolution_pin_gauge')) {
            $updateData['resolution'] = $request->resolution_pin_gauge;
            \Log::info('🔍 Resolusi pin gauge (update):', ['resolution' => $request->resolution_pin_gauge]);
        }
        
        // Pastikan certificate_id di calibration juga terupdate
        if (!empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data', $updateData);
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailPinGauge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Pin Gauge):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'total_rows' => $jumlahBaris,
            'certificate_id' => $finalCertificateId,
            'certificate_id_source' => $certificateId ? 'parameter' : ($calibration->certificate_id ? 'calibration' : 'existing_data'),
            'alat_standar' => $standardValue,
            'alat_standar_checkbox' => $checkboxAlatStandar,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
            'unit' => $calibration->unit ?? null,
            'range' => $calibration->range ?? null,
            'resolution' => $calibration->resolution ?? null,
            'environment_condition' => $calibration->environment_condition ?? null,
        ]);

        \Log::info('🎉 updatePinGauge COMPLETED');
        
        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePinGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'certificate_id' => $certificateId ?? null,
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Pin Gauge: " . $e->getMessage());
    }
}


    private function storeViscoCup($request, $calibration, $certificateId)
    {
        try {
            \Log::info('🚀 START storeViscoCup');
            
            // ==================================================================
            // 1. PROSES ALAT STANDAR DAN TYPE
            // ==================================================================
            
            // Ambil alat standar yang dipilih (radio button array)
            $alatStandarArray = $request->alat_standar ?? [];
            $alatStandar = !empty($alatStandarArray) ? $alatStandarArray[0] : '';
            \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandar]);
            
            // Ambil type berdasarkan alat standar yang dipilih
            $typeSelected = '';
            if ($alatStandar === 'Viscosity Standard Paragon') {
                $typeSelected = $request->viscosity_type ?? '';
                \Log::info('🔧 Viscosity type selected:', ['type' => $typeSelected]);
            } elseif ($alatStandar === 'Digital Stopwatch') {
                $typeSelected = $request->stopwatch_type ?? '';
                \Log::info('🔧 Stopwatch type selected:', ['type' => $typeSelected]);
            } elseif ($alatStandar === 'Thermometer') {
                $typeSelected = $request->thermometer_type ?? '';
                \Log::info('🔧 Thermometer type selected:', ['type' => $typeSelected]);
            }
            
            // FORMAT: "AlatStandar TYPE" (misal: "Thermometer TAS")
            $standardValue = $alatStandar;
            if (!empty($typeSelected)) {
                $standardValue .= ' ' . $typeSelected; // Format: "Thermometer TAS"
            }
            
            // ==================================================================
            // 2. PROSES TYPE CUP DAN KODE NOMOR (untuk AddViscoCup) - REVISI
            // ==================================================================
            
            // Kumpulkan semua pilihan type cup dalam array
            $typeCupArray = [];
            
            // 1. Cek radio button type_cup (bisa multiple karena mungkin array)
            $typeCupInput = $request->type_cup;
            
            if (is_array($typeCupInput)) {
                // Jika multiple selection (checkbox style)
                foreach ($typeCupInput as $type) {
                    if (!empty($type) && $type !== 'Others') {
                        $typeCupArray[] = $type;
                    }
                }
            } elseif (!empty($typeCupInput) && $typeCupInput !== 'Others') {
                // Jika single selection (radio button)
                $typeCupArray[] = $typeCupInput;
            }
            
            // 2. Cek jika ada Others yang dipilih
            $othersRadio = $request->others ?? '';
            $typeOtherInput = trim($request->type_other ?? '');
            $othersValue = '';
            
            // Tentukan nilai untuk field "others"
            if ($othersRadio === 'Others' && !empty($typeOtherInput)) {
                // Jika Others dipilih dan ada input text
                $othersValue = $typeOtherInput;
                // Tambahkan "Others" ke array type cup
                if (!in_array('Others', $typeCupArray)) {
                    $typeCupArray[] = 'Others';
                }
            } elseif (!empty($typeOtherInput) && $othersRadio !== 'Others') {
                // Jika user mengisi input text tanpa memilih radio Others
                $othersValue = $typeOtherInput;
                // Tambahkan "Others" ke array type cup
                if (!in_array('Others', $typeCupArray)) {
                    $typeCupArray[] = 'Others';
                }
            }
            
            // Gabungkan semua type cup dengan koma (tidak termasuk nilai custom)
            $typeCupCombined = !empty($typeCupArray) ? implode(', ', $typeCupArray) : '';
            
            // Ambil kode nomor
            $kodeNomor = $request->kode_nomor ?? ''; // 1, 2, 3, 4, atau 5
            
            \Log::info('🥤 AddViscoCup Data:', [
                'type_cup_array' => $typeCupArray,
                'type_cup_combined' => $typeCupCombined,
                'kode_nomor' => $kodeNomor,
                'others_value' => $othersValue,
                'type_other_input' => $typeOtherInput,
                'others_radio' => $othersRadio
            ]);
            
            // Simpan ke AddViscoCup jika ada data
            if (!empty($typeCupCombined) || !empty($kodeNomor) || !empty($othersValue)) {
                AddViscoCup::create([
                    'calibration_id' => $calibration->id,
                    'type' => $typeCupCombined, // Contoh: "ZAHN Cup, FORD Cup, Others"
                    'kodeNomor' => $kodeNomor,
                    'others' => $othersValue, // Nilai custom dari input text Others
                ]);
                \Log::info('✅ AddViscoCup saved');
            }
            
            // Catatan hanya dari input catatan_penting saja
            $catatan = trim($request->catatan_penting ?? '');
            
            // ==================================================================
            // 3. PROSES NAMA KALIBRATOR DAN PEMERIKSA
            // ==================================================================
            $namaKalibrator = trim($request->calibrated_by ?? '');
            $namaPemeriksa = trim($request->verified_by ?? '');
            
            \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
            \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);
    
            // ==================================================================
            // 4. SIMPAN KE HEAD VISCOCUP
            // ==================================================================
            $head = HeadViscoCup::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateId,
                'standard' => $standardValue, // Contoh: "Thermometer TAS"
                'calibrationMethod' => 'PAS-IK1102-43B',
                'catatan' => $catatan, // Hanya dari catatan_penting
            ]);
    
            \Log::info('✅ HeadViscoCup saved:', [
                'head_id' => $head->id,
                'standard' => $standardValue,
                'catatan' => $catatan
            ]);
    
            // ==================================================================
            // 5. SIMPAN DETAIL VISCOCUP (3 BARIS DATA)
            // ==================================================================
            \Log::info('📊 Saving DetailViscoCup data...');
            $detailCount = 0;
            
            // Proses 3 baris data
            for ($row = 1; $row <= 3; $row++) {
                // Ambil data dari input form
                $nilaiStandar = $request->{"kode_nilai_$row"} ?? null;
                $ulangan1 = $request->{"stopwatch_{$row}_1"} ?? null;
                $ulangan2 = $request->{"stopwatch_{$row}_2"} ?? null;
                $ulangan3 = $request->{"stopwatch_{$row}_3"} ?? null;
                $ulangan4 = $request->{"stopwatch_{$row}_4"} ?? null;
                $ulangan5 = $request->{"stopwatch_{$row}_5"} ?? null;
                $suhuCRM = $request->{"suhu_$row"} ?? null;
                
                // Cek apakah ada data untuk baris ini
                $hasData = !empty($nilaiStandar) || 
                          !empty($ulangan1) || !empty($ulangan2) || !empty($ulangan3) || 
                          !empty($ulangan4) || !empty($ulangan5) || 
                          !empty($suhuCRM);
                
                if ($hasData) {
                    // MAPPING KE MODEL DetailViscoCup
                    $detailData = [
                        'head_visco_cup_id' => $head->id,
                        'calibration_id' => $calibration->id,
                        'nilaiStandar' => $nilaiStandar,
                        'ulangan1' => $ulangan1,
                        'ulangan2' => $ulangan2,
                        'ulangan3' => $ulangan3,
                        'ulangan4' => $ulangan4,
                        'ulangan5' => $ulangan5,
                        'suhuCRM' => $suhuCRM,
                    ];
                    
                    DetailViscoCup::create($detailData);
                    $detailCount++;
                    
                    \Log::debug("✅ Saved ViscoCup row {$row}");
                }
            }
            
            \Log::info("✅ Saved {$detailCount} DetailViscoCup records");
    
            // ==================================================================
            // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
            // ==================================================================
            $updateData = [];
            
            // Update nama kalibrator (jika diisi)
            if (!empty($namaKalibrator)) {
                $updateData['calibrated_by'] = $namaKalibrator;
            }
            
            // Update nama pemeriksa (jika diisi)
            if (!empty($namaPemeriksa)) {
                $updateData['verified_by'] = $namaPemeriksa;
            }
            
            // Update uncertainty dan keterangan (jika ada)
            if ($request->filled('uncertainty')) {
                $updateData['uncertainty'] = $request->uncertainty;
                $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
            }
            
            // Update satuan jika ada
            if ($request->filled('unit')) {
                $updateData['unit'] = $request->unit;
            }
            
            // Update range jika ada
            if ($request->filled('range')) {
                $updateData['range'] = $request->range;
            }
            
            // Update kondisi lingkungan
            $environmentData = [];
            
            if ($request->filled('temperature')) {
                $environmentData['temperature'] = $request->temperature;
            }
            
            if ($request->filled('humidity')) {
                $environmentData['humidity'] = $request->humidity;
            }
            
            if (!empty($environmentData)) {
                $updateData['environment_condition'] = json_encode($environmentData);
            }
            
            if (!empty($updateData)) {
                $calibration->update($updateData);
            }
    
            // ==================================================================
            // 7. LOG HASIL AKHIR
            // ==================================================================
            $savedDetailCount = DetailViscoCup::where('calibration_id', $calibration->id)->count();
            $addViscoCupCount = AddViscoCup::where('calibration_id', $calibration->id)->count();
            
            \Log::info('📋 STORE SUMMARY (ViscoCup):', [
                'calibration_id' => $calibration->id,
                'head_id' => $head->id,
                'detail_records' => $savedDetailCount,
                'add_visco_cup_records' => $addViscoCupCount,
                'certificate_id' => $certificateId,
                'alat_standar' => $alatStandar,
                'type_selected' => $typeSelected,
                'standard_value' => $standardValue, // "Thermometer TAS"
                'type_cup_array' => $typeCupArray,
                'type_cup_combined' => $typeCupCombined,
                'kode_nomor' => $kodeNomor,
                'others_value' => $othersValue,
                'catatan' => $catatan, // Hanya dari catatan_penting
                'calibrated_by' => $namaKalibrator,
                'verified_by' => $namaPemeriksa,
            ]);
    
            \Log::info('🎉 storeViscoCup COMPLETED');
            return true;
    
        } catch (\Exception $e) {
            \Log::error('💥 ERROR storeViscoCup:', [
                'message' => $e->getMessage(),
                'file' => $e->getFile(),
                'line' => $e->getLine(),
                'calibration_id' => $calibration->id ?? 'N/A',
                'trace' => $e->getTraceAsString()
            ]);
            
            // Rollback sederhana
            if (isset($head) && $head->id) {
                try {
                    DetailViscoCup::where('head_visco_cup_id', $head->id)->delete();
                    $head->delete();
                    // Juga hapus AddViscoCup jika ada
                    AddViscoCup::where('calibration_id', $calibration->id)->delete();
                } catch (\Exception $rollbackError) {
                    \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
                }
            }
            
            throw new \Exception("Gagal menyimpan data ViscoCup: " . $e->getMessage());
        }
    }
    
 private function updateViscoCup($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateViscoCup');
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headViscoCup;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR DAN TYPE
        // ==================================================================
        
        // Ambil semua alat standar yang dipilih
        $alatStandarArray = $request->alat_standar ?? [];
        \Log::info('🔧 Alat standar selected:', ['alat_standar_array' => $alatStandarArray]);
        
        // Untuk menyimpan semua type yang dipilih
        $selectedTypes = [];
        
        // Proses setiap alat standar yang dipilih
        foreach ($alatStandarArray as $alatStandar) {
            if ($alatStandar === 'Viscosity Standard Paragon') {
                $typeSelected = $request->viscosity_type ?? '';
                if (!empty($typeSelected)) {
                    $selectedTypes[] = $alatStandar . ' ' . $typeSelected;
                } else {
                    $selectedTypes[] = $alatStandar;
                }
                \Log::info('🔧 Viscosity type selected:', ['type' => $typeSelected]);
            } elseif ($alatStandar === 'Digital Stopwatch') {
                $typeSelected = $request->stopwatch_type ?? '';
                if (!empty($typeSelected)) {
                    $selectedTypes[] = $alatStandar . ' ' . $typeSelected;
                } else {
                    $selectedTypes[] = $alatStandar;
                }
                \Log::info('🔧 Stopwatch type selected:', ['type' => $typeSelected]);
            } elseif ($alatStandar === 'Thermometer') {
                $typeSelected = $request->thermometer_type ?? '';
                if (!empty($typeSelected)) {
                    $selectedTypes[] = $alatStandar . ' ' . $typeSelected;
                } else {
                    $selectedTypes[] = $alatStandar;
                }
                \Log::info('🔧 Thermometer type selected:', ['type' => $typeSelected]);
            }
        }
        
        // Gabungkan semua alat standar dengan separator (misalnya koma)
        $standardValue = implode(', ', $selectedTypes);
        
        \Log::info('📝 Combined standard value:', ['standard' => $standardValue]);
        
        // ==================================================================
        // 2. PROSES TYPE CUP DAN KODE NOMOR (untuk AddViscoCup) - TANPA FORMAT
        // ==================================================================
        
        // Kumpulkan semua pilihan type cup dalam array
        $typeCupArray = [];
        
        // 1. Cek radio button type_cup (bisa multiple karena mungkin array)
        $typeCupInput = $request->type_cup;
        
        if (is_array($typeCupInput)) {
            foreach ($typeCupInput as $type) {
                if (!empty($type) && $type !== 'Others') {
                    $typeCupArray[] = $type;
                }
            }
        } elseif (!empty($typeCupInput) && $typeCupInput !== 'Others') {
            $typeCupArray[] = $typeCupInput;
        }
        
        // 2. Cek jika ada Others yang dipilih
        $othersRadio = $request->others ?? '';
        $typeOtherInput = trim($request->type_other ?? '');
        $othersValue = '';
        
        if ($othersRadio === 'Others' && !empty($typeOtherInput)) {
            $othersValue = $typeOtherInput;
            if (!in_array('Others', $typeCupArray)) {
                $typeCupArray[] = 'Others';
            }
        } elseif (!empty($typeOtherInput) && $othersRadio !== 'Others') {
            $othersValue = $typeOtherInput;
            if (!in_array('Others', $typeCupArray)) {
                $typeCupArray[] = 'Others';
            }
        }
        
        $typeCupCombined = !empty($typeCupArray) ? implode(', ', $typeCupArray) : '';
        $kodeNomor = $request->kode_nomor ?? '';
        
        \Log::info('🥤 Update AddViscoCup Data:', [
            'type_cup_array' => $typeCupArray,
            'type_cup_combined' => $typeCupCombined,
            'kode_nomor' => $kodeNomor,
            'others_value' => $othersValue,
        ]);
        
        // Update or create AddViscoCup
        $addViscoCup = AddViscoCup::where('calibration_id', $calibration->id)->first();
        
        if (!empty($typeCupCombined) || !empty($kodeNomor) || !empty($othersValue)) {
            if ($addViscoCup) {
                $addViscoCup->update([
                    'type' => $typeCupCombined,
                    'kodeNomor' => $kodeNomor,
                    'others' => $othersValue,
                ]);
                \Log::info('✅ AddViscoCup updated');
            } else {
                AddViscoCup::create([
                    'calibration_id' => $calibration->id,
                    'type' => $typeCupCombined,
                    'kodeNomor' => $kodeNomor,
                    'others' => $othersValue,
                ]);
                \Log::info('✅ AddViscoCup created');
            }
        } elseif ($addViscoCup) {
            $addViscoCup->delete();
            \Log::info('✅ AddViscoCup deleted (no data)');
        }
        
        $catatan = trim($request->catatan_penting ?? '');
        $namaKalibrator = trim($request->calibrated_by ?? '');
        $namaPemeriksa = trim($request->verified_by ?? '');
        
        \Log::info('👤 Nama Kalibrator:', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa:', ['nama' => $namaPemeriksa]);
        
        // ==================================================================
        // 3. UPDATE HEAD VISCOCUP
        // ==================================================================
        $head = HeadViscoCup::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $standardValue,
            'calibrationMethod' => 'PAS-IK1102-43B',
            'catatan' => $catatan,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ HeadViscoCup updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id,
                'standard' => $standardValue,
                'catatan' => $catatan
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadViscoCup::create($headData);
            \Log::info('✅ HeadViscoCup created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null,
                'standard' => $standardValue,
                'catatan' => $catatan
            ]);
        }
        
        // ==================================================================
        // 4. UPDATE DETAIL VISCOCUP - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating DetailViscoCup data...');
        
        // Delete existing details untuk calibration ini
        $detailDeleted = DetailViscoCup::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$detailDeleted} existing details");
        
        $detailCount = 0;
        
        // Proses 3 baris data - LANGSUNG TANPA FORMAT
        for ($row = 1; $row <= 3; $row++) {
            // Ambil data dari input form - LANGSUNG TANPA FORMAT
            $nilaiStandar = $request->input("kode_nilai_$row");
            $ulangan1 = $request->input("stopwatch_{$row}_1");
            $ulangan2 = $request->input("stopwatch_{$row}_2");
            $ulangan3 = $request->input("stopwatch_{$row}_3");
            $ulangan4 = $request->input("stopwatch_{$row}_4");
            $ulangan5 = $request->input("stopwatch_{$row}_5");
            $suhuCRM = $request->input("suhu_$row");
            
            $hasData = !empty($nilaiStandar) || 
                      !empty($ulangan1) || !empty($ulangan2) || !empty($ulangan3) || 
                      !empty($ulangan4) || !empty($ulangan5) || 
                      !empty($suhuCRM);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nilaiStandar' => $nilaiStandar,  // LANGSUNG, tanpa format
                    'ulangan1' => $ulangan1,          // LANGSUNG, tanpa format
                    'ulangan2' => $ulangan2,          // LANGSUNG, tanpa format
                    'ulangan3' => $ulangan3,          // LANGSUNG, tanpa format
                    'ulangan4' => $ulangan4,          // LANGSUNG, tanpa format
                    'ulangan5' => $ulangan5,          // LANGSUNG, tanpa format
                    'suhuCRM' => $suhuCRM,            // LANGSUNG, tanpa format
                ];
                
                DetailViscoCup::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved ViscoCup row {$row}");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} DetailViscoCup records");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $namaKalibrator]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa:', ['nama' => $namaPemeriksa]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if ($request->filled('unit')) {
            $updateData['unit'] = $request->unit;
        }
        
        if ($request->filled('range')) {
            $updateData['range'] = $request->range;
        }
        
        $environmentData = [];
        if ($request->filled('temperature')) {
            $environmentData['temperature'] = $request->temperature;
        }
        if ($request->filled('humidity')) {
            $environmentData['humidity'] = $request->humidity;
        }
        if (!empty($environmentData)) {
            $updateData['environment_condition'] = json_encode($environmentData);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headViscoCup;
        $savedDetailCount = DetailViscoCup::where('calibration_id', $calibration->id)->count();
        $addViscoCupCount = AddViscoCup::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (ViscoCup):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $savedDetailCount,
            'add_visco_cup_records' => $addViscoCupCount,
            'standard_value' => $standardValue,
            'catatan' => $catatan,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
            'nama_alat' => $calibration->namaAlat,
        ]);
        
        \Log::info('🎉 updateViscoCup COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateViscoCup:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data ViscoCup: " . $e->getMessage());
    }
}
    private function storePlainLimitGauge($request, $calibration, $certificateId, $tabId = null)
{
    \Log::info('🔧 ===== START storePlainLimitGauge =====', [
        'calibration_id' => $calibration->id,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storePlainLimitGauge called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandarArray = [];
        
        // Cari alat standar dari checkbox/select dengan berbagai format
        $alatStandar = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (is_array($alatStandar)) {
            foreach ($alatStandar as $value) {
                if ($value && !in_array($value, $alatStandarArray)) {
                    $alatStandarArray[] = $value;
                }
            }
        } elseif ($alatStandar) {
            $alatStandarArray[] = $alatStandar;
        }
        
        // Coba juga dengan format alat_standar_1, alat_standar_2, dll
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandarArray)) {
                $alatStandarArray[] = $value;
            }
        }
        
        // Ambil Gauge Block mm dengan dukungan tab
        $gaugeBlockMm = $this->getRequestValue($request, 'gauge_block_mm', $tabId);
        if ($gaugeBlockMm) {
            $alatStandarArray[] = "Gauge Block {$gaugeBlockMm} mm";
            \Log::info('📏 Gauge Block mm:', ['value' => $gaugeBlockMm]);
        }
        
        // Ambil Ring Gauge mm dengan dukungan tab
        $ringGaugeMm = $this->getRequestValue($request, 'ring_gauge_mm', $tabId);
        if ($ringGaugeMm) {
            $alatStandarArray[] = "Ring Gauge {$ringGaugeMm} mm";
            \Log::info('📏 Ring Gauge mm:', ['value' => $ringGaugeMm]);
        }
        
        $alatStandarString = !empty($alatStandarArray) ? implode(', ', $alatStandarArray) : '';
        
        \Log::info('📋 Final alat standar string:', [
            'alat_standar_string' => $alatStandarString,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. AMBIL FIELD LAINNYA (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $catatan = $this->getRequestValue($request, 'catatan', $tabId);
        $satuanGo = $this->getRequestValue($request, 'satuan_go', $tabId);
        $satuanNoGo = $this->getRequestValue($request, 'satuan_no_go', $tabId);
        
        // ==================================================================
        // 3. SIMPAN KE HEAD PLAIN LIMIT GAUGE
        // ==================================================================
        $head = HeadPlainLimitGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-63',
            'catatan' => $catatan,
            'satuan_go' => $satuanGo,
            'satuan_no_go' => $satuanNoGo,
            'form_index' => 1,
        ]);
        
        \Log::info('✅ Head Plain Limit Gauge saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 4. SIMPAN DETAIL MEASUREMENTS (GO DAN NO GO) - DENGAN DUKUNGAN _tab
        // ==================================================================
        \Log::info('📊 Saving detail measurements...');
        
        // DATA GO
        $goNominal = $this->getRequestValue($request, 'go_nominal', $tabId);
        
        // POSISI ATAS GO
        $goAtasX1 = $this->getRequestValue($request, 'go_atas_x', $tabId);
        if (!$goAtasX1) {
            $goAtasX1 = $this->getRequestValue($request, 'go_atas_x1', $tabId);
        }
        
        $goAtasX2 = $this->getRequestValue($request, 'go_atas_x2', $tabId);
        $goAtasY1 = $this->getRequestValue($request, 'go_atas_y', $tabId);
        if (!$goAtasY1) {
            $goAtasY1 = $this->getRequestValue($request, 'go_atas_y1', $tabId);
        }
        
        $goAtasY2 = $this->getRequestValue($request, 'go_atas_y2', $tabId);
        
        // POSISI BAWAH GO
        $goBawahX1 = $this->getRequestValue($request, 'go_bawah_x', $tabId);
        if (!$goBawahX1) {
            $goBawahX1 = $this->getRequestValue($request, 'go_bawah_x1', $tabId);
        }
        
        $goBawahX2 = $this->getRequestValue($request, 'go_bawah_x2', $tabId);
        $goBawahY1 = $this->getRequestValue($request, 'go_bawah_y', $tabId);
        if (!$goBawahY1) {
            $goBawahY1 = $this->getRequestValue($request, 'go_bawah_y1', $tabId);
        }
        
        $goBawahY2 = $this->getRequestValue($request, 'go_bawah_y2', $tabId);
        
        // DATA NO GO
        $nogoNominal = $this->getRequestValue($request, 'nogo_nominal', $tabId);
        
        // SUMBU ATAS NO GO
        $nogoAtasX1 = $this->getRequestValue($request, 'nogo_atas_x', $tabId);
        if (!$nogoAtasX1) {
            $nogoAtasX1 = $this->getRequestValue($request, 'nogo_atas_x1', $tabId);
        }
        
        $nogoAtasX2 = $this->getRequestValue($request, 'nogo_atas_x2', $tabId);
        $nogoAtasY1 = $this->getRequestValue($request, 'nogo_atas_y', $tabId);
        if (!$nogoAtasY1) {
            $nogoAtasY1 = $this->getRequestValue($request, 'nogo_atas_y1', $tabId);
        }
        
        $nogoAtasY2 = $this->getRequestValue($request, 'nogo_atas_y2', $tabId);
        
        // SUMBU BAWAH NO GO
        $nogoBawahX1 = $this->getRequestValue($request, 'nogo_bawah_x', $tabId);
        if (!$nogoBawahX1) {
            $nogoBawahX1 = $this->getRequestValue($request, 'nogo_bawah_x1', $tabId);
        }
        
        $nogoBawahX2 = $this->getRequestValue($request, 'nogo_bawah_x2', $tabId);
        $nogoBawahY1 = $this->getRequestValue($request, 'nogo_bawah_y', $tabId);
        if (!$nogoBawahY1) {
            $nogoBawahY1 = $this->getRequestValue($request, 'nogo_bawah_y1', $tabId);
        }
        
        $nogoBawahY2 = $this->getRequestValue($request, 'nogo_bawah_y2', $tabId);
        
        $detailData = [
            'calibration_id' => $calibration->id,
            'form_index' => 1,
            'titikUkurGO' => $goNominal,
            'posisiAtasX1' => $goAtasX1,
            'posisiAtasX2' => $goAtasX2,
            'posisiAtasY1' => $goAtasY1,
            'posisiAtasY2' => $goAtasY2,
            'posisiBawahX1' => $goBawahX1,
            'posisiBawahX2' => $goBawahX2,
            'posisiBawahY1' => $goBawahY1,
            'posisiBawahY2' => $goBawahY2,
            'titikUkurNOGO' => $nogoNominal,
            'sumbuAtasX1' => $nogoAtasX1,
            'sumbuAtasX2' => $nogoAtasX2,
            'sumbuAtasY1' => $nogoAtasY1,
            'sumbuAtasY2' => $nogoAtasY2,
            'sumbuBawahX1' => $nogoBawahX1,
            'sumbuBawahX2' => $nogoBawahX2,
            'sumbuBawahY1' => $nogoBawahY1,
            'sumbuBawahY2' => $nogoBawahY2,
        ];
        
        \Log::info('📝 Saving detail measurement:', [
            'titikUkurGO' => $detailData['titikUkurGO'],
            'titikUkurNOGO' => $detailData['titikUkurNOGO']
        ]);
        
        DetailPlainLimitGauge::create($detailData);
        \Log::info('✅ Detail Plain Limit Gauge saved successfully');
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TTD (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $updateData = [];
        
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('👤 Calibrated by saved:', ['name' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('👤 Verified by saved:', ['name' => $verifiedBy]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with signature data');
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('📋 STORE SUMMARY (Plain Limit Gauge):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
            'satuan_go' => $satuanGo,
            'satuan_no_go' => $satuanNoGo,
        ]);
        
        \Log::info('🎉 storePlainLimitGauge COMPLETED');
        
    } catch (\Exception $e) {
        \Log::error('💥 Error storing Plain Limit Gauge data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

    private function updatePlainLimitGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updatePlainLimitGauge');
        \Log::info('📝 Updating Plain Limit Gauge data for calibration ID: ' . $calibration->id);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headPlainLimitGauge;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        // Inisialisasi array untuk menyimpan alat standar
        $alatStandarArray = [];
        
        // Cek checkbox yang dipilih
        $alatStandar = $request->alat_standar ?? [];
        
        \Log::info('🔧 Alat standar selected for Plain Limit Gauge:', ['alat_standar' => $alatStandar]);

        // Get additional mm selections
        $gaugeBlockMm = $request->gauge_block_mm ?? '';
        $ringGaugeMm = $request->ring_gauge_mm ?? '';
        
        \Log::info('📏 Additional mm selections:', [
            'gauge_block_mm' => $gaugeBlockMm,
            'ring_gauge_mm' => $ringGaugeMm
        ]);

        // Proses checkbox untuk menambahkan ke array alat standar
        if (!empty($alatStandar)) {
            foreach ($alatStandar as $alat) {
                if (empty($alat)) continue;
                $alatStandarArray[] = $alat;
            }
        }

        // Tambahkan Gauge Block dengan ukuran mm jika dipilih
        if ($gaugeBlockMm) {
            $alatStandarArray[] = "Gauge Block {$gaugeBlockMm} mm";
        }

        // Tambahkan Ring Gauge dengan ukuran mm jika dipilih
        if ($ringGaugeMm) {
            $alatStandarArray[] = "Ring Gauge {$ringGaugeMm} mm";
        }

        // Hapus duplikat (jika ada)
        $alatStandarArray = array_unique($alatStandarArray);
        
        // Konversi array menjadi string dengan pemisah koma
        $alatStandarString = !empty($alatStandarArray) ? implode(', ', $alatStandarArray) : '';
        
        \Log::info('📋 Final alat standar string:', ['alat_standar_string' => $alatStandarString]);
        
        // ==================================================================
        // 2. UPDATE ATAU CREATE HEAD PLAIN LIMIT GAUGE
        // ==================================================================
        $head = HeadPlainLimitGauge::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-63',
            'catatan' => $request->catatan ?? '',
            'satuan_go' => $request->satuan_go ?? '',
            'satuan_no_go' => $request->satuan_no_go ?? '',
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ Head Plain Limit Gauge updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadPlainLimitGauge::create($headData);
            \Log::info('➕ Head Plain Limit Gauge created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL PLAIN LIMIT GAUGE - TANPA FORMAT NUMERIC
        // ==================================================================
        \Log::info('📊 Updating detail measurements...');
        
        // Data GO - LANGSUNG TANPA FORMAT
        $goData = [
            'calibration_id' => $calibration->id,
            'titikUkurGO' => $request->go_nominal,
            'posisiAtasX1' => $request->go_atas_x,
            'posisiAtasX2' => $request->go_atas_x2,
            'posisiAtasY1' => $request->go_atas_y,
            'posisiAtasY2' => $request->go_atas_y2,
            'posisiBawahX1' => $request->go_bawah_x,
            'posisiBawahX2' => $request->go_bawah_x2,
            'posisiBawahY1' => $request->go_bawah_y,
            'posisiBawahY2' => $request->go_bawah_y2,
        ];
        
        // Data NO GO - LANGSUNG TANPA FORMAT
        $nogoData = [
            'titikUkurNOGO' => $request->nogo_nominal,
            'sumbuAtasX1' => $request->nogo_atas_x,
            'sumbuAtasX2' => $request->nogo_atas_x2,
            'sumbuAtasY1' => $request->nogo_atas_y,
            'sumbuAtasY2' => $request->nogo_atas_y2,
            'sumbuBawahX1' => $request->nogo_bawah_x,
            'sumbuBawahX2' => $request->nogo_bawah_x2,
            'sumbuBawahY1' => $request->nogo_bawah_y,
            'sumbuBawahY2' => $request->nogo_bawah_y2,
        ];
        
        // Gabungkan data GO dan NO GO
        $detailData = array_merge($goData, $nogoData);
        
        \Log::info('📝 Saving detail measurement:', $detailData);
        
        // Cek apakah detail sudah ada
        $existingDetail = DetailPlainLimitGauge::where('calibration_id', $calibration->id)->first();
        
        if ($existingDetail) {
            $existingDetail->update($detailData);
            \Log::info('✅ Detail Plain Limit Gauge updated:', ['detail_id' => $existingDetail->id]);
        } else {
            $detail = DetailPlainLimitGauge::create($detailData);
            \Log::info('✅ Detail Plain Limit Gauge created:', ['detail_id' => $detail->id]);
        }
        
        // ==================================================================
        // 4. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Ambil nama dari input calibrated_by dan verified_by
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headPlainLimitGauge;
        
        \Log::info('📋 UPDATE SUMMARY (Plain Limit Gauge):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'alat_standar' => $alatStandarString,
            'satuan_go' => $request->satuan_go ?? '',
            'satuan_no_go' => $request->satuan_no_go ?? '',
            'go_nominal' => $request->go_nominal ?? '',
            'nogo_nominal' => $request->nogo_nominal ?? '',
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);
        
        \Log::info('🎉 updatePlainLimitGauge COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePlainLimitGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Plain Limit Gauge: " . $e->getMessage());
    }
}

private function storeTempHumidTransmitter($request, $calibration, $certificateId, $tabId = null)
{
    \Log::info('🌡️ ===== START storeTempHumidTransmitter =====', [
        'calibration_id' => $calibration->id
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeTempHumidTransmitter called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dengan berbagai kemungkinan nama field
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        // Coba juga dengan format array
        $alatStandarArray = $request->input('alat_standar', []);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🌡️ Alat standar selected for TempHumidTransmitter:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. SIMPAN HEAD TEMP HUMID TRANSMITTER (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $head = HeadTempHumidTransmitter::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-67',
            'tertelusur' => 'Certus Metrology',
            'form_index' => 1,
        ]);
        
        \Log::info('✅ HeadTempHumidTransmitter saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 3. SIMPAN DETAIL MEASUREMENTS UNTUK TEMPERATURE (T) - 8 BARIS
        // ==================================================================
        \Log::info('🌡️ Saving temperature (T) detail measurements...');
        $temperatureCount = 0;
        
        for ($row = 1; $row <= 8; $row++) {
            // Cari T_setting dengan dukungan _tab
            $tSetting = $this->getRequestValue($request, "T_setting_{$row}", $tabId);
            if (!$tSetting) {
                $tSetting = $this->getRequestValue($request, "T_setting", $tabId);
                if (is_array($tSetting)) {
                    $tSetting = $tSetting[$row - 1] ?? null;
                }
            }
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($tSetting);
            
            // Cek T_STD1, T_STD2, T_STD3
            for ($j = 1; $j <= 3; $j++) {
                $tStd = $this->getRequestValue($request, "T_STD{$row}_{$j}", $tabId);
                if (!$tStd) {
                    $tStd = $this->getRequestValue($request, "T_STD", $tabId);
                    if (is_array($tStd)) {
                        $index = ($row - 1) * 3 + ($j - 1);
                        $tStd = $tStd[$index] ?? null;
                    }
                }
                if (!empty($tStd)) {
                    $hasData = true;
                    break;
                }
            }
            
            // Cek T_OSmA1, T_OSmA2, T_OSmA3
            for ($j = 1; $j <= 3; $j++) {
                $tOsmA = $this->getRequestValue($request, "T_OSmA{$row}_{$j}", $tabId);
                if (!$tOsmA) {
                    $tOsmA = $this->getRequestValue($request, "T_OSmA", $tabId);
                    if (is_array($tOsmA)) {
                        $index = ($row - 1) * 3 + ($j - 1);
                        $tOsmA = $tOsmA[$index] ?? null;
                    }
                }
                if (!empty($tOsmA)) {
                    $hasData = true;
                    break;
                }
            }
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'form_index' => 1,
                    'T_setting' => $tSetting,
                    'T_STD1' => $this->getRequestValue($request, "T_STD{$row}_1", $tabId),
                    'T_STD2' => $this->getRequestValue($request, "T_STD{$row}_2", $tabId),
                    'T_STD3' => $this->getRequestValue($request, "T_STD{$row}_3", $tabId),
                    'T_OSmA1' => $this->getRequestValue($request, "T_OSmA{$row}_1", $tabId),
                    'T_OSmA2' => $this->getRequestValue($request, "T_OSmA{$row}_2", $tabId),
                    'T_OSmA3' => $this->getRequestValue($request, "T_OSmA{$row}_3", $tabId),
                ];
                
                // Jika tidak ditemukan dengan format baris per kolom, coba format array
                if (empty($detailData['T_STD1']) && empty($detailData['T_STD2']) && empty($detailData['T_STD3'])) {
                    $tStdArray = $this->getRequestValue($request, "T_STD", $tabId);
                    if (is_array($tStdArray)) {
                        $index = ($row - 1) * 3;
                        $detailData['T_STD1'] = $tStdArray[$index] ?? null;
                        $detailData['T_STD2'] = $tStdArray[$index + 1] ?? null;
                        $detailData['T_STD3'] = $tStdArray[$index + 2] ?? null;
                    }
                }
                
                if (empty($detailData['T_OSmA1']) && empty($detailData['T_OSmA2']) && empty($detailData['T_OSmA3'])) {
                    $tOsmAArray = $this->getRequestValue($request, "T_OSmA", $tabId);
                    if (is_array($tOsmAArray)) {
                        $index = ($row - 1) * 3;
                        $detailData['T_OSmA1'] = $tOsmAArray[$index] ?? null;
                        $detailData['T_OSmA2'] = $tOsmAArray[$index + 1] ?? null;
                        $detailData['T_OSmA3'] = $tOsmAArray[$index + 2] ?? null;
                    }
                }
                
                Detail_T_TempHumidTransmitter::create($detailData);
                $temperatureCount++;
                \Log::debug("🌡️ Temperature detail saved for row {$row}");
            }
        }
        
        \Log::info("✅ Saved {$temperatureCount} temperature (T) detail measurements");
        
        // ==================================================================
        // 4. SIMPAN DETAIL MEASUREMENTS UNTUK HUMIDITY (RH) - 7 BARIS
        // ==================================================================
        \Log::info('💧 Saving humidity (RH) detail measurements...');
        $humidityCount = 0;
        
        for ($row = 1; $row <= 7; $row++) {
            // Cari RH_setting dengan dukungan _tab
            $rhSetting = $this->getRequestValue($request, "RH_setting_{$row}", $tabId);
            if (!$rhSetting) {
                $rhSetting = $this->getRequestValue($request, "RH_setting", $tabId);
                if (is_array($rhSetting)) {
                    $rhSetting = $rhSetting[$row - 1] ?? null;
                }
            }
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($rhSetting);
            
            // Cek RH_STD1, RH_STD2, RH_STD3
            for ($j = 1; $j <= 3; $j++) {
                $rhStd = $this->getRequestValue($request, "RH_STD{$row}_{$j}", $tabId);
                if (!$rhStd) {
                    $rhStd = $this->getRequestValue($request, "RH_STD", $tabId);
                    if (is_array($rhStd)) {
                        $index = ($row - 1) * 3 + ($j - 1);
                        $rhStd = $rhStd[$index] ?? null;
                    }
                }
                if (!empty($rhStd)) {
                    $hasData = true;
                    break;
                }
            }
            
            // Cek RH_OSmA1, RH_OSmA2, RH_OSmA3
            for ($j = 1; $j <= 3; $j++) {
                $rhOsmA = $this->getRequestValue($request, "RH_OSmA{$row}_{$j}", $tabId);
                if (!$rhOsmA) {
                    $rhOsmA = $this->getRequestValue($request, "RH_OSmA", $tabId);
                    if (is_array($rhOsmA)) {
                        $index = ($row - 1) * 3 + ($j - 1);
                        $rhOsmA = $rhOsmA[$index] ?? null;
                    }
                }
                if (!empty($rhOsmA)) {
                    $hasData = true;
                    break;
                }
            }
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'form_index' => 1,
                    'RH_setting' => $rhSetting,
                    'RH_STD1' => $this->getRequestValue($request, "RH_STD{$row}_1", $tabId),
                    'RH_STD2' => $this->getRequestValue($request, "RH_STD{$row}_2", $tabId),
                    'RH_STD3' => $this->getRequestValue($request, "RH_STD{$row}_3", $tabId),
                    'RH_OSmA1' => $this->getRequestValue($request, "RH_OSmA{$row}_1", $tabId),
                    'RH_OSmA2' => $this->getRequestValue($request, "RH_OSmA{$row}_2", $tabId),
                    'RH_OSmA3' => $this->getRequestValue($request, "RH_OSmA{$row}_3", $tabId),
                ];
                
                // Jika tidak ditemukan dengan format baris per kolom, coba format array
                if (empty($detailData['RH_STD1']) && empty($detailData['RH_STD2']) && empty($detailData['RH_STD3'])) {
                    $rhStdArray = $this->getRequestValue($request, "RH_STD", $tabId);
                    if (is_array($rhStdArray)) {
                        $index = ($row - 1) * 3;
                        $detailData['RH_STD1'] = $rhStdArray[$index] ?? null;
                        $detailData['RH_STD2'] = $rhStdArray[$index + 1] ?? null;
                        $detailData['RH_STD3'] = $rhStdArray[$index + 2] ?? null;
                    }
                }
                
                if (empty($detailData['RH_OSmA1']) && empty($detailData['RH_OSmA2']) && empty($detailData['RH_OSmA3'])) {
                    $rhOsmAArray = $this->getRequestValue($request, "RH_OSmA", $tabId);
                    if (is_array($rhOsmAArray)) {
                        $index = ($row - 1) * 3;
                        $detailData['RH_OSmA1'] = $rhOsmAArray[$index] ?? null;
                        $detailData['RH_OSmA2'] = $rhOsmAArray[$index + 1] ?? null;
                        $detailData['RH_OSmA3'] = $rhOsmAArray[$index + 2] ?? null;
                    }
                }
                
                Detail_RH_TempHumidTransmitter::create($detailData);
                $humidityCount++;
                \Log::debug("💧 Humidity detail saved for row {$row}");
            }
        }
        
        \Log::info("✅ Saved {$humidityCount} humidity (RH) detail measurements");
        
        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('📋 STORE SUMMARY (TempHumidTransmitter):', [
            'calibration_id' => $calibration->id,
            'temperature_details' => $temperatureCount,
            'humidity_details' => $humidityCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
        ]);
        
        \Log::info('🎉 storeTempHumidTransmitter COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR storeTempHumidTransmitter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                Detail_T_TempHumidTransmitter::where('calibration_id', $calibration->id)->delete();
                Detail_RH_TempHumidTransmitter::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data TempHumidTransmitter: " . $e->getMessage());
    }
}

private function updateTempHumidTransmitter($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START updateTempHumidTransmitter - WITH CERTIFICATE ID UPDATE');
        
        // ==================================================================
        // 1. TENTUKAN NAMA ALAT YANG BARU DARI BERBAGAI SUMBER
        // ==================================================================
        $namaAlatLama = $calibration->namaAlat;
        $namaAlatBaru = $namaAlatLama; // Default: tetap sama
        
        \Log::info('🔍 Nama alat sebelum update:', [
            'nama_alat_lama' => $namaAlatLama,
            'from_dropdown' => $request->nama_alat ?? 'not_set'
        ]);
        
        // Priority: Dari dropdown nama_alat
        if ($request->filled('nama_alat') && $request->nama_alat !== 'MANUAL_INPUT') {
            $namaAlatBaru = $request->nama_alat;
            \Log::info('📝 Nama alat dari dropdown:', ['nama_alat_baru' => $namaAlatBaru]);
        }
        
        // ==================================================================
        // 2. PERBARUI NAMA ALAT DI CALIBRATION JIKA BERBEDA
        // ==================================================================
        $namaAlatUpdated = false;
        if ($namaAlatLama !== $namaAlatBaru) {
            $calibration->update(['namaAlat' => $namaAlatBaru]);
            $namaAlatUpdated = true;
            \Log::info('✅ Nama alat diupdate di calibration:', [
                'dari' => $namaAlatLama,
                'menjadi' => $namaAlatBaru
            ]);
        }
        
        // ==================================================================
        // 3. GENERATE CERTIFICATE ID BARU JIKA NAMA ALAT BERUBAH
        // ==================================================================
        $certificateIdLama = $calibration->certificate_id;
        $certificateIdBaru = $certificateIdLama;
        $certificateIdUpdated = false;
        
        if ($namaAlatUpdated) {
            // Generate certificate ID baru menggunakan generateCertificateIdFromNamaAlat()
            // Hasilnya akan seperti: PAS-00115-K26-Humidity Transmitter
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatBaru);
            $certificateIdUpdated = true;
            
            // Update certificate_id di calibration
            $calibration->update(['certificate_id' => $certificateIdBaru]);
            
            \Log::info('🆔 Certificate ID updated menggunakan generateCertificateIdFromNamaAlat():', [
                'nama_alat_lama' => $namaAlatLama,
                'nama_alat_baru' => $namaAlatBaru,
                'certificate_id_lama' => $certificateIdLama,
                'certificate_id_baru' => $certificateIdBaru
            ]);
        } elseif (empty($certificateIdLama) || strpos($certificateIdLama, 'MANUAL_INPUT') !== false) {
            // Jika certificate_id masih kosong atau mengandung MANUAL_INPUT, generate baru
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatBaru);
            $calibration->update(['certificate_id' => $certificateIdBaru]);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID generated menggunakan generateCertificateIdFromNamaAlat():', [
                'reason' => empty($certificateIdLama) ? 'certificate_id kosong' : 'mengandung MANUAL_INPUT',
                'certificate_id_baru' => $certificateIdBaru
            ]);
        } else {
            \Log::info('✅ Certificate ID tidak berubah:', [
                'certificate_id' => $certificateIdLama,
                'reason' => 'nama alat tidak berubah'
            ]);
        }
        
        // Gunakan certificate_id yang sudah ditentukan
        $certificateIdToUse = $certificateIdBaru;
        
        // ==================================================================
        // 4. AMBIL ATAU BUAT HEAD TEMP HUMID TRANSMITTER
        // ==================================================================
        $head = HeadTempHumidTransmitter::where('calibration_id', $calibration->id)->first();
        
        // ==================================================================
        // 5. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🌡️ Alat standar selected for TempHumidTransmitter:', ['alat_standar' => $alatStandar]);

        // ==================================================================
        // 6. UPDATE ATAU BUAT HEAD TEMP HUMID TRANSMITTER
        // ==================================================================
        if ($head) {
            // Update existing head
            $head->update([
                'certificate_id' => $certificateIdToUse,
                'standard' => $alatStandarString,
                'calibrationMethod' => 'PAS-IK1102-67',
                'tertelusur' => 'Certus Metrology',
            ]);
            \Log::info('✅ Head TempHumidTransmitter updated:', ['head_id' => $head->id, 'certificate_id' => $certificateIdToUse]);
        } else {
            // Create new head if doesn't exist
            $head = HeadTempHumidTransmitter::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateIdToUse,
                'standard' => $alatStandarString,
                'calibrationMethod' => 'PAS-IK1102-67',
                'tertelusur' => 'Certus Metrology',
            ]);
            \Log::info('✅ Head TempHumidTransmitter created:', ['head_id' => $head->id, 'certificate_id' => $certificateIdToUse]);
        }

        // ==================================================================
        // 7. UPDATE DETAIL MEASUREMENTS UNTUK TEMPERATURE (T) - 8 BARIS
        // ==================================================================
        \Log::info('🌡️ Updating temperature (T) detail measurements...');
        
        // Hapus detail temperature lama
        $deletedTempCount = Detail_T_TempHumidTransmitter::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old temperature (T) detail records:', ['count' => $deletedTempCount]);
        
        $temperatureCount = 0;
        
        for ($i = 1; $i <= 8; $i++) { // 8 BARIS UNTUK TEMPERATURE
            // Cek apakah ada data untuk baris ini
            $hasTemperatureData = false;
            
            // Cek apakah ada T_STD atau T_OSmA yang diisi
            for ($j = 1; $j <= 3; $j++) {
                if ($request->has("T_STD{$i}_{$j}") && !empty(trim($request->{"T_STD{$i}_{$j}"}))) {
                    $hasTemperatureData = true;
                    break;
                }
                if ($request->has("T_OSmA{$i}_{$j}") && !empty(trim($request->{"T_OSmA{$i}_{$j}"}))) {
                    $hasTemperatureData = true;
                    break;
                }
            }
            
            // Simpan jika ada data T_setting atau T_STD/T_OSmA
            if (($request->has("T_setting_{$i}") && !empty(trim($request->{"T_setting_{$i}"}))) || $hasTemperatureData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'T_setting' => $request->{"T_setting_{$i}"} ?? null,
                    'T_STD1' => $request->{"T_STD{$i}_1"} ?? null,
                    'T_STD2' => $request->{"T_STD{$i}_2"} ?? null,
                    'T_STD3' => $request->{"T_STD{$i}_3"} ?? null,
                    'T_OSmA1' => $request->{"T_OSmA{$i}_1"} ?? null,
                    'T_OSmA2' => $request->{"T_OSmA{$i}_2"} ?? null,
                    'T_OSmA3' => $request->{"T_OSmA{$i}_3"} ?? null,
                ];

                \Log::info("🌡️ Saving temperature (T) detail row $i:", $detailData);
                
                Detail_T_TempHumidTransmitter::create($detailData);
                $temperatureCount++;
            }
        }
        
        \Log::info("✅ Saved $temperatureCount temperature (T) detail measurements");

        // ==================================================================
        // 8. UPDATE DETAIL MEASUREMENTS UNTUK HUMIDITY (RH) - 7 BARIS
        // ==================================================================
        \Log::info('💧 Updating humidity (RH) detail measurements...');
        
        // Hapus detail humidity lama
        $deletedRhCount = Detail_RH_TempHumidTransmitter::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old humidity (RH) detail records:', ['count' => $deletedRhCount]);
        
        $humidityCount = 0;
        
        for ($i = 1; $i <= 7; $i++) { // 7 BARIS UNTUK HUMIDITY
            // Cek apakah ada data untuk baris ini
            $hasHumidityData = false;
            
            // Cek apakah ada RH_STD atau RH_OSmA yang diisi
            for ($j = 1; $j <= 3; $j++) {
                if ($request->has("RH_STD{$i}_{$j}") && !empty(trim($request->{"RH_STD{$i}_{$j}"}))) {
                    $hasHumidityData = true;
                    break;
                }
                if ($request->has("RH_OSmA{$i}_{$j}") && !empty(trim($request->{"RH_OSmA{$i}_{$j}"}))) {
                    $hasHumidityData = true;
                    break;
                }
            }
            
            // Simpan jika ada data RH_setting atau RH_STD/RH_OSmA
            if (($request->has("RH_setting_{$i}") && !empty(trim($request->{"RH_setting_{$i}"}))) || $hasHumidityData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'RH_setting' => $request->{"RH_setting_{$i}"} ?? null,
                    'RH_STD1' => $request->{"RH_STD{$i}_1"} ?? null,
                    'RH_STD2' => $request->{"RH_STD{$i}_2"} ?? null,
                    'RH_STD3' => $request->{"RH_STD{$i}_3"} ?? null,
                    'RH_OSmA1' => $request->{"RH_OSmA{$i}_1"} ?? null,
                    'RH_OSmA2' => $request->{"RH_OSmA{$i}_2"} ?? null,
                    'RH_OSmA3' => $request->{"RH_OSmA{$i}_3"} ?? null,
                ];

                \Log::info("💧 Saving humidity (RH) detail row $i:", $detailData);
                
                Detail_RH_TempHumidTransmitter::create($detailData);
                $humidityCount++;
            }
        }
        
        \Log::info("✅ Saved $humidityCount humidity (RH) detail measurements");

        // ==================================================================
        // 9. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Data TTD dan nama dari calibration
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } else {
            $updateData['calibrated_by'] = '-';
            \Log::warning('⚠️ calibrated_by kosong, set calibrated_by = "-"');
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } else {
            $updateData['verified_by'] = '-';
            \Log::warning('⚠️ verified_by kosong, set verified_by = "-"');
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', $updateData);
        }

        // ==================================================================
        // 10. LOG HASIL AKHIR
        // ==================================================================
        $totalTempRecords = Detail_T_TempHumidTransmitter::where('calibration_id', $calibration->id)->count();
        $totalRhRecords = Detail_RH_TempHumidTransmitter::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (TempHumidTransmitter):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'temperature_records' => $totalTempRecords,
            'humidity_records' => $totalRhRecords,
            'certificate_id' => $certificateIdToUse,
            'nama_alat' => $namaAlatBaru,
            'nama_alat_updated' => $namaAlatUpdated,
            'certificate_id_updated' => $certificateIdUpdated,
            'alat_standar' => $alatStandarString,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updateTempHumidTransmitter COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTempHumidTransmitter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Temperature/Humidity Transmitter: " . $e->getMessage());
    }
}

private function storeTempTransmitter($request, $calibration, $certificateId)
{
    try {
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        // Pastikan indicator dan media diambil sebagai array
        $indicator = $request->indicator ?? [];
        $indicatorString = !empty($indicator) ? implode(', ', $indicator) : '';
        
        $media = $request->media ?? [];
        $mediaString = !empty($media) ? implode(', ', $media) : '';
        
        // Debug log untuk melihat data yang diterima
        \Log::info('🌡️ Data untuk TempTransmitter:', [
            'alat_standar' => $alatStandar,
            'alat_standar_string' => $alatStandarString,
            'indicator' => $indicator,
            'indicator_string' => $indicatorString,
            'media' => $media,
            'media_string' => $mediaString,
            'all_request_data' => $request->all() // Lihat semua data request
        ]);

        // Simpan ke Head TempTransmitter
        $head = HeadTempTransmitter::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-66 (Temp. Transmitter)',
            'indicator' => $indicatorString,
            'media' => $mediaString,
            'satuan_suhu_kiri' => $request->satuan_suhu_kiri,
            'satuan_suhu_kanan' => $request->satuan_suhu_kanan,
            'satuan_std_kiri' => $request->satuan_std_kiri,
            'satuan_std_kanan' => $request->satuan_std_kanan,
            'satuan_indicator_kiri' => $request->satuan_indicator_kiri,
            'satuan_indicator_kanan' => $request->satuan_indicator_kanan,
        ]);

        \Log::info('✅ Head TempTransmitter saved:', ['head_id' => $head->id]);

        // Simpan nama penandatangan ke calibration
        $calibration->update([
            'calibratedBy' => $request->calibrated_by ?? '',
            'verifiedBy' => $request->verified_by ?? '',
        ]);

        \Log::info('✅ Penandatangan saved:', [
            'calibratedBy' => $request->calibrated_by ?? '',
            'verifiedBy' => $request->verified_by ?? ''
        ]);

        // Simpan detail measurements - 10 records (5 kiri + 5 kanan)
        \Log::info('🌡️ Saving temperature detail measurements...');
        $detailCount = 0;
        
        // SIMPAN DATA KIRI (5 records)
        for ($group = 1; $group <= 5; $group++) {
            $T_setting_kiri = $request->{"setting_suhu_kiri_{$group}"} ?? null;
            
            // Cek apakah ada data untuk grup kiri ini
            $hasLeftData = false;
            
            // Cek apakah ada STD atau Indicator yang diisi
            for ($row = 1; $row <= 3; $row++) {
                if ($request->has("std_kiri_{$group}_{$row}") && !empty(trim($request->{"std_kiri_{$group}_{$row}"}))) {
                    $hasLeftData = true;
                    break;
                }
                if ($request->has("indicator_kiri_{$group}_{$row}") && !empty(trim($request->{"indicator_kiri_{$group}_{$row}"}))) {
                    $hasLeftData = true;
                    break;
                }
            }
            
            // Simpan jika ada data
            if (!empty($T_setting_kiri) || $hasLeftData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'T_setting' => $T_setting_kiri,
                    'T_STD1' => $request->{"std_kiri_{$group}_1"} ?? null,
                    'T_STD2' => $request->{"std_kiri_{$group}_2"} ?? null,
                    'T_STD3' => $request->{"std_kiri_{$group}_3"} ?? null,
                    'T_Indicator1' => $request->{"indicator_kiri_{$group}_1"} ?? null,
                    'T_Indicator2' => $request->{"indicator_kiri_{$group}_2"} ?? null,
                    'T_Indicator3' => $request->{"indicator_kiri_{$group}_3"} ?? null,
                ];

                \Log::info("🌡️ Saving LEFT data - Group {$group}:", $detailData);
                
                DetailTempTransmitter::create($detailData);
                $detailCount++;
            }
        }
        
        // SIMPAN DATA KANAN (5 records)
        for ($group = 1; $group <= 5; $group++) {
            $T_setting_kanan = $request->{"setting_suhu_kanan_{$group}"} ?? null;
            
            // Cek apakah ada data untuk grup kanan ini
            $hasRightData = false;
            
            // Cek apakah ada STD atau Indicator yang diisi
            for ($row = 1; $row <= 3; $row++) {
                if ($request->has("std_kanan_{$group}_{$row}") && !empty(trim($request->{"std_kanan_{$group}_{$row}"}))) {
                    $hasRightData = true;
                    break;
                }
                if ($request->has("indicator_kanan_{$group}_{$row}") && !empty(trim($request->{"indicator_kanan_{$group}_{$row}"}))) {
                    $hasRightData = true;
                    break;
                }
            }
            
            // Simpan jika ada data
            if (!empty($T_setting_kanan) || $hasRightData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'T_setting' => $T_setting_kanan,
                    'T_STD1' => $request->{"std_kanan_{$group}_1"} ?? null,
                    'T_STD2' => $request->{"std_kanan_{$group}_2"} ?? null,
                    'T_STD3' => $request->{"std_kanan_{$group}_3"} ?? null,
                    'T_Indicator1' => $request->{"indicator_kanan_{$group}_1"} ?? null,
                    'T_Indicator2' => $request->{"indicator_kanan_{$group}_2"} ?? null,
                    'T_Indicator3' => $request->{"indicator_kanan_{$group}_3"} ?? null,
                ];

                \Log::info("🌡️ Saving RIGHT data - Group {$group}:", $detailData);
                
                DetailTempTransmitter::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved $detailCount detail measurements");

    } catch (\Exception $e) {
        \Log::error('💥 Error storing TempTransmitter data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function updateTempTransmitter($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateTempTransmitter', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = HeadTempTransmitter::where('calibration_id', $calibration->id)->first();
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // Jika certificate_id masih kosong, gunakan dari parameter atau generate
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $calibration->certificate_id;
        }
        
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        }
        
        $finalCertificateId = $certificateIdBaru;
        
        \Log::info('📋 Final Certificate ID:', [
            'certificate_id' => $finalCertificateId,
            'certificate_id_updated' => $certificateIdUpdated
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR, INDICATOR, DAN MEDIA
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        $indicator = $request->indicator ?? [];
        $indicatorString = !empty($indicator) ? implode(', ', $indicator) : '';
        
        $media = $request->media ?? [];
        $mediaString = !empty($media) ? implode(', ', $media) : '';
        
        \Log::info('🌡️ Data untuk TempTransmitter update:', [
            'alat_standar' => $alatStandar,
            'indicator' => $indicator,
            'media' => $media,
        ]);
        
        // ==================================================================
        // 2. UPDATE HEAD TEMP TRANSMITTER
        // ==================================================================
        $head = HeadTempTransmitter::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-66 (Temp. Transmitter)',
            'indicator' => $indicatorString,
            'media' => $mediaString,
            'satuan_suhu_kiri' => $request->satuan_suhu_kiri,
            'satuan_suhu_kanan' => $request->satuan_suhu_kanan,
            'satuan_std_kiri' => $request->satuan_std_kiri,
            'satuan_std_kanan' => $request->satuan_std_kanan,
            'satuan_indicator_kiri' => $request->satuan_indicator_kiri,
            'satuan_indicator_kanan' => $request->satuan_indicator_kanan,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $headData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $finalCertificateId]);
        }
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ Head TempTransmitter updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadTempTransmitter::create($headData);
            \Log::info('✅ Head TempTransmitter created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL MEASUREMENTS - 10 RECORDS (5 KIRI + 5 KANAN)
        // ==================================================================
        \Log::info('🌡️ Updating temperature detail measurements...');
        
        // Hapus data lama
        DetailTempTransmitter::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        // SIMPAN DATA KIRI (5 records) - LANGSUNG TANPA FORMAT
        for ($group = 1; $group <= 5; $group++) {
            $T_setting_kiri = $request->input("setting_suhu_kiri_{$group}");
            
            // Cek apakah ada data untuk grup kiri ini
            $hasLeftData = false;
            
            // Cek apakah ada STD atau Indicator yang diisi
            for ($row = 1; $row <= 3; $row++) {
                $stdValue = $request->input("std_kiri_{$group}_{$row}");
                $indicatorValue = $request->input("indicator_kiri_{$group}_{$row}");
                
                if (!empty(trim($stdValue ?? ''))) {
                    $hasLeftData = true;
                    break;
                }
                if (!empty(trim($indicatorValue ?? ''))) {
                    $hasLeftData = true;
                    break;
                }
            }
            
            // Simpan jika ada data
            if (!empty($T_setting_kiri) || $hasLeftData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'T_setting' => $T_setting_kiri,
                    'T_STD1' => $request->input("std_kiri_{$group}_1"),
                    'T_STD2' => $request->input("std_kiri_{$group}_2"),
                    'T_STD3' => $request->input("std_kiri_{$group}_3"),
                    'T_Indicator1' => $request->input("indicator_kiri_{$group}_1"),
                    'T_Indicator2' => $request->input("indicator_kiri_{$group}_2"),
                    'T_Indicator3' => $request->input("indicator_kiri_{$group}_3"),
                ];

                \Log::debug("🌡️ Saving LEFT data - Group {$group}:", $detailData);
                
                DetailTempTransmitter::create($detailData);
                $detailCount++;
            }
        }
        
        // SIMPAN DATA KANAN (5 records) - LANGSUNG TANPA FORMAT
        for ($group = 1; $group <= 5; $group++) {
            $T_setting_kanan = $request->input("setting_suhu_kanan_{$group}");
            
            // Cek apakah ada data untuk grup kanan ini
            $hasRightData = false;
            
            // Cek apakah ada STD atau Indicator yang diisi
            for ($row = 1; $row <= 3; $row++) {
                $stdValue = $request->input("std_kanan_{$group}_{$row}");
                $indicatorValue = $request->input("indicator_kanan_{$group}_{$row}");
                
                if (!empty(trim($stdValue ?? ''))) {
                    $hasRightData = true;
                    break;
                }
                if (!empty(trim($indicatorValue ?? ''))) {
                    $hasRightData = true;
                    break;
                }
            }
            
            // Simpan jika ada data
            if (!empty($T_setting_kanan) || $hasRightData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'T_setting' => $T_setting_kanan,
                    'T_STD1' => $request->input("std_kanan_{$group}_1"),
                    'T_STD2' => $request->input("std_kanan_{$group}_2"),
                    'T_STD3' => $request->input("std_kanan_{$group}_3"),
                    'T_Indicator1' => $request->input("indicator_kanan_{$group}_1"),
                    'T_Indicator2' => $request->input("indicator_kanan_{$group}_2"),
                    'T_Indicator3' => $request->input("indicator_kanan_{$group}_3"),
                ];

                \Log::debug("🌡️ Saving RIGHT data - Group {$group}:", $detailData);
                
                DetailTempTransmitter::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements");
        
        // ==================================================================
        // 4. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $finalCertificateId]);
        }
        
        // Update nama penandatangan ke calibration
        if ($request->filled('calibrated_by')) {
            $updateData['calibratedBy'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibratedBy'] = $request->calibratedBy;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verifiedBy'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verifiedBy'] = $request->verifiedBy;
        }
        
        // Update uncertainty jika ada
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $head->refresh();
        $savedDetailCount = DetailTempTransmitter::where('calibration_id', $calibration->id)->count();
        
        \Log::info('🏁 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'certificate_id_di_head' => $head->certificate_id,
            'certificate_id_di_calibration' => $calibration->certificate_id,
            'detail_records' => $savedDetailCount,
            'nama_alat' => $calibration->namaAlat,
            'calibratedBy' => $calibration->calibratedBy,
            'verifiedBy' => $calibration->verifiedBy,
        ]);

        \Log::info('🎉 updateTempTransmitter COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateTempTransmitter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data TempTransmitter: " . $e->getMessage());
    }
}


private function storeIrThermometer($request, $calibration, $certificateId, $tabId = null)
{
    \Log::info('🌡️ ===== START storeIrThermometer =====', [
        'calibration_id' => $calibration->id,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeIrThermometer called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dari checkbox dengan berbagai format
        $alatStandarArray = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        } elseif ($alatStandarArray) {
            $alatStandar[] = $alatStandarArray;
        }
        
        // Coba juga dengan format alat_standar_1, alat_standar_2, dll
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. AMBIL SATUAN SUHU (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $satuanSuhuKiri = $this->getRequestValue($request, 'satuan_suhu_kiri', $tabId);
        $satuanSuhuKanan = $this->getRequestValue($request, 'satuan_suhu_kanan', $tabId);
        
        // ==================================================================
        // 3. SIMPAN KE HEAD IR THERMOMETER
        // ==================================================================
        $head = HeadIrThermometer::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-47',
            'satuan_suhu_kiri' => $satuanSuhuKiri,
            'satuan_suhu_kanan' => $satuanSuhuKanan,
            'form_index' => 1,
        ]);
        
        \Log::info('✅ Head IrThermometer saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 4. SIMPAN DATA JARAK KALIBRASI KE ADD_IR_THERMOMETER (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $jarakKalibrasi = $this->getRequestValue($request, 'jarak_kalibrasi', $tabId);
        $merek = $this->getRequestValue($request, 'merek', $tabId);
        
        if ($merek && !empty(trim($merek))) {
            AddIrThermometer::create([
                'calibration_id' => $calibration->id,
                'jarakKalibrasi' => $jarakKalibrasi,
                'form_index' => 1,
            ]);
            \Log::info('✅ Jarak kalibrasi saved:', ['jarak' => $jarakKalibrasi]);
        }
        
        // ==================================================================
        // 5. SIMPAN DETAIL MEASUREMENTS UNTUK TABEL KIRI (1-5) DAN KANAN (6-10)
        // ==================================================================
        \Log::info('📊 Saving detail measurements for IrThermometer...');
        $detailCount = 0;
        
        for ($row = 1; $row <= 10; $row++) {
            // Ambil titik ukur (setting suhu)
            $titikUkur = $this->getRequestValue($request, "setting_suhu_{$row}", $tabId);
            if (!$titikUkur) {
                $titikUkur = $this->getRequestValue($request, "titik_ukur_{$row}", $tabId);
            }
            
            // Hitung index STD/UUT (1-30)
            $startStd = (($row - 1) * 3) + 1;
            
            // Ambil nilai STD (3 nilai per baris)
            $stdValues = [];
            for ($col = 0; $col < 3; $col++) {
                $stdKey = "std_" . ($startStd + $col);
                $value = $this->getRequestValue($request, $stdKey, $tabId);
                
                // Coba format alternatif
                if (!$value) {
                    $value = $this->getRequestValue($request, "std_{$row}_" . ($col + 1), $tabId);
                }
                if (!$value) {
                    $value = $this->getRequestValue($request, "STD_{$row}_" . ($col + 1), $tabId);
                }
                
                $stdValues[] = $value;
            }
            
            // Ambil nilai UUT (3 nilai per baris)
            $uutValues = [];
            for ($col = 0; $col < 3; $col++) {
                $uutKey = "uut_" . ($startStd + $col);
                $value = $this->getRequestValue($request, $uutKey, $tabId);
                
                // Coba format alternatif
                if (!$value) {
                    $value = $this->getRequestValue($request, "uut_{$row}_" . ($col + 1), $tabId);
                }
                if (!$value) {
                    $value = $this->getRequestValue($request, "UUT_{$row}_" . ($col + 1), $tabId);
                }
                
                $uutValues[] = $value;
            }
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($titikUkur) || 
                       !empty($stdValues[0]) || !empty($stdValues[1]) || !empty($stdValues[2]) ||
                       !empty($uutValues[0]) || !empty($uutValues[1]) || !empty($uutValues[2]);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_ir_thermometer_id' => $head->id,
                    'form_index' => 1,
                    'titikUkur' => $titikUkur,
                    'STD01' => $stdValues[0] ?? null,
                    'STD02' => $stdValues[1] ?? null,
                    'STD03' => $stdValues[2] ?? null,
                    'UUT01' => $uutValues[0] ?? null,
                    'UUT02' => $uutValues[1] ?? null,
                    'UUT03' => $uutValues[2] ?? null,
                ];
                
                \Log::debug("📝 Saving IrThermometer detail row {$row}:", [
                    'titikUkur' => $detailData['titikUkur'],
                    'STD01' => $detailData['STD01'],
                    'UUT01' => $detailData['UUT01']
                ]);
                
                DetailIrThermometer::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for IrThermometer");
        
        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TTD (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $updateData = [];
        
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('👤 Calibrated by saved:', ['name' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('👤 Verified by saved:', ['name' => $verifiedBy]);
        }
        
        // Ambil satuan suhu umum jika ada
        $satuanSuhu = $this->getRequestValue($request, 'satuan_suhu', $tabId);
        if ($satuanSuhu) {
            $updateData['satuan_suhu'] = $satuanSuhu;
            \Log::info('🌡️ Satuan suhu:', ['satuan' => $satuanSuhu]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with signature data');
        }
        
        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('📋 STORE SUMMARY (IrThermometer):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $detailCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
            'satuan_suhu_kiri' => $satuanSuhuKiri,
            'satuan_suhu_kanan' => $satuanSuhuKanan,
        ]);
        
        \Log::info('🎉 storeIrThermometer COMPLETED');
        return $head;
        
    } catch (\Exception $e) {
        \Log::error('💥 Error storing IrThermometer data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}
private function updateIrThermometer($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateIrThermometer');
        \Log::info('📝 Updating IrThermometer data for calibration ID: ' . $calibration->id);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headIrThermometer;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandar]);
        
        $satuanSuhuKiri = $request->satuan_suhu_kiri;
        $satuanSuhuKanan = $request->satuan_suhu_kanan;
        
        // ==================================================================
        // 2. UPDATE ATAU CREATE HEAD IR THERMOMETER
        // ==================================================================
        $head = HeadIrThermometer::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-47',
            'satuan_suhu_kiri' => $satuanSuhuKiri,
            'satuan_suhu_kanan' => $satuanSuhuKanan,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ Head IrThermometer updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadIrThermometer::create($headData);
            \Log::info('➕ Head IrThermometer created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 3. UPDATE ATAU CREATE ADD IR THERMOMETER (JARAK KALIBRASI) - TANPA FORMAT
        // ==================================================================
        if ($request->has('jarak_kalibrasi')) {
            $addData = [
                'jarakKalibrasi' => $request->jarak_kalibrasi,  // LANGSUNG, tanpa format
            ];
            
            $add = AddIrThermometer::where('calibration_id', $calibration->id)->first();
            
            if ($add) {
                $add->update($addData);
                \Log::info('✅ AddIrThermometer updated:', ['jarak' => $request->jarak_kalibrasi]);
            } else {
                $addData['calibration_id'] = $calibration->id;
                AddIrThermometer::create($addData);
                \Log::info('✅ AddIrThermometer created:', ['jarak' => $request->jarak_kalibrasi]);
            }
        }
        
        // ==================================================================
        // 4. UPDATE DETAIL IR THERMOMETER - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating detail measurements...');
        
        // Hapus data lama terlebih dahulu
        $deletedDetails = DetailIrThermometer::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$deletedDetails} old detail records");
        
        $detailCount = 0;
        
        // Proses data untuk tabel kiri (1-5) dan kanan (6-10) - LANGSUNG TANPA FORMAT
        for ($i = 1; $i <= 10; $i++) {
            $settingSuhuField = "setting_suhu_$i";
            
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada STD/UUT yang diisi
            $startStd = (($i - 1) * 3) + 1;
            for ($j = 0; $j < 3; $j++) {
                $stdField = "std_" . ($startStd + $j);
                $uutField = "uut_" . ($startStd + $j);
                
                $stdValue = $request->input($stdField);
                $uutValue = $request->input($uutField);
                
                if ((!empty($stdValue)) || (!empty($uutValue))) {
                    $hasData = true;
                    break;
                }
            }
            
            // Simpan jika ada data setting suhu atau STD/UUT
            $titikUkur = $request->input($settingSuhuField);
            if ((!empty($titikUkur)) || $hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_ir_thermometer_id' => $head->id,
                    'titikUkur' => $titikUkur,  // LANGSUNG, tanpa format
                    'STD01' => $request->input("std_" . $startStd),      // LANGSUNG, tanpa format
                    'STD02' => $request->input("std_" . ($startStd + 1)), // LANGSUNG, tanpa format
                    'STD03' => $request->input("std_" . ($startStd + 2)), // LANGSUNG, tanpa format
                    'UUT01' => $request->input("uut_" . $startStd),       // LANGSUNG, tanpa format
                    'UUT02' => $request->input("uut_" . ($startStd + 1)),  // LANGSUNG, tanpa format
                    'UUT03' => $request->input("uut_" . ($startStd + 2)),  // LANGSUNG, tanpa format
                ];
                
                \Log::debug("📝 Saving detail row {$i}:", $detailData);
                
                DetailIrThermometer::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for IrThermometer");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Nama untuk TTD Dikalibrasi
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        // Nama untuk TTD Diperiksa
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        // Data uncertainty dan conclusion
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headIrThermometer;
        $savedDetailCount = DetailIrThermometer::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (IrThermometer):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $savedDetailCount,
            'alat_standar' => $alatStandarString,
            'satuan_suhu_kiri' => $satuanSuhuKiri,
            'satuan_suhu_kanan' => $satuanSuhuKanan,
            'jarak_kalibrasi' => $request->jarak_kalibrasi,
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);
        
        \Log::info('🎉 updateIrThermometer COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateIrThermometer:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data IrThermometer: " . $e->getMessage());
    }
}

private function storeThermoindicator($request, $calibration, $certificateId)
{
    try {
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🌡️ Alat standar selected untuk Thermoindicator:', ['alat_standar' => $alatStandar]);

        // Simpan ke Head ThermoIndicator
        $head = HeadThermoIndicator::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-37',
            'satuan_std' => $request->satuan_std ?? '°C',
            'satuan_uut' => $request->satuan_uut ?? '°C',
        ]);

        \Log::info('✅ Head ThermoIndicator saved:', ['head_id' => $head->id]);

        // Simpan detail measurements untuk ThermoIndicator
        \Log::info('📊 Saving ThermoIndicator detail measurements...');
        $detailCount = 0;
        
        // Tabel Kiri (baris 1-10)
        for ($i = 1; $i <= 10; $i++) {
            // Ambil data pembacaan alat kiri (array)
            $pembacaanAlatKiri = $request->pembacaan_alat_kiri ?? [];
            $PenunjukanSTD = isset($pembacaanAlatKiri[$i-1]) ? $pembacaanAlatKiri[$i-1] : null;
            
            // Cek apakah ada data untuk baris ini
            if (!empty($PenunjukanSTD) || 
                $request->has("naik_kiri_$i") || 
                $request->has("turun_kiri_$i")) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'PenunjukanSTD' => $PenunjukanSTD,
                    'UUTnaik' => $request->{"naik_kiri_$i"} ?? null,
                    'UUTturun' => $request->{"turun_kiri_$i"} ?? null,
                ];

                \Log::info("📝 Saving ThermoIndicator detail row kiri $i:", $detailData);
                
                DetailThermoIndicator::create($detailData);
                $detailCount++;
            }
        }
        
        // Tabel Kanan (baris 11-20)
        for ($i = 11; $i <= 20; $i++) {
            // Ambil data pembacaan alat kanan (array)
            $pembacaanAlatKanan = $request->pembacaan_alat_kanan ?? [];
            // Perhatikan: untuk kanan, indexnya $i-11 karena mulai dari index 0
            $PenunjukanSTD = isset($pembacaanAlatKanan[$i-11]) ? $pembacaanAlatKanan[$i-11] : null;
            
            // Cek apakah ada data untuk baris ini
            if (!empty($PenunjukanSTD) || 
                $request->has("naik_kanan_$i") || 
                $request->has("turun_kanan_$i")) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'PenunjukanSTD' => $PenunjukanSTD,
                    'UUTnaik' => $request->{"naik_kanan_$i"} ?? null,
                    'UUTturun' => $request->{"turun_kanan_$i"} ?? null,
                ];

                \Log::info("📝 Saving ThermoIndicator detail row kanan $i:", $detailData);
                
                DetailThermoIndicator::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved $detailCount ThermoIndicator detail measurements");

        // Simpan data tambahan (AddThermoIndicator)
        \Log::info('📋 Saving additional ThermoIndicator data...');
        
        // Mapping data repeatability dari input repX_colY ke field rep01-rep05
        $additionalData = [
            'calibration_id' => $calibration->id,
            'wireType' => $request->tipe_wire ?? null,
        ];
        
        // Mapping langsung berdasarkan pola input name
        // Baris 1, Kolom 1-3 -> rep01, rep02, rep03
        // Baris 2, Kolom 1-2 -> rep04, rep05
        
        // Gunakan ternary operator untuk mengambil data
        $additionalData['rep01'] = $request->has('rep1_col1') && !empty(trim($request->rep1_col1)) 
            ? $request->rep1_col1 
            : null;
        
        $additionalData['rep02'] = $request->has('rep1_col2') && !empty(trim($request->rep1_col2)) 
            ? $request->rep1_col2 
            : null;
        
        $additionalData['rep03'] = $request->has('rep1_col3') && !empty(trim($request->rep1_col3)) 
            ? $request->rep1_col3 
            : null;
        
        $additionalData['rep04'] = $request->has('rep2_col1') && !empty(trim($request->rep2_col1)) 
            ? $request->rep2_col1 
            : null;
        
        $additionalData['rep05'] = $request->has('rep2_col2') && !empty(trim($request->rep2_col2)) 
            ? $request->rep2_col2 
            : null;
        
        // Jika ada data rep2_col3 atau baris lainnya, bisa ditambahkan
        if ($request->has('rep2_col3') && !empty(trim($request->rep2_col3))) {
            \Log::info('⚠️ Extra repeatability data rep2_col3 found:', ['value' => $request->rep2_col3]);
            // Jika Anda ingin menyimpan di field lain, tambahkan di sini
        }
        
        // Loop untuk menangani data tambahan jika ada lebih banyak baris
        for ($row = 3; $row <= 10; $row++) {
            for ($col = 1; $col <= 3; $col++) {
                $fieldName = "rep{$row}_col{$col}";
                if ($request->has($fieldName) && !empty(trim($request->$fieldName))) {
                    \Log::info("⚠️ Extra repeatability data {$fieldName} found:", ['value' => $request->$fieldName]);
                }
            }
        }

        // Cek apakah minimal ada satu data yang diisi (selain calibration_id)
        $hasAdditionalData = false;
        foreach ($additionalData as $key => $value) {
            if ($key !== 'calibration_id' && $value !== null && $value !== '') {
                $hasAdditionalData = true;
                break;
            }
        }

        if ($hasAdditionalData) {
            $addThermoIndicator = AddThermoIndicator::create($additionalData);
            \Log::info('✅ Additional ThermoIndicator data saved:', ['additional_id' => $addThermoIndicator->id]);
            \Log::info('📊 Repeatability data:', [
                'rep01' => $additionalData['rep01'] ?? 'null',
                'rep02' => $additionalData['rep02'] ?? 'null',
                'rep03' => $additionalData['rep03'] ?? 'null',
                'rep04' => $additionalData['rep04'] ?? 'null',
                'rep05' => $additionalData['rep05'] ?? 'null',
            ]);
        } else {
            \Log::info('ℹ️ No additional data to save for AddThermoIndicator');
        }

        // Log untuk debugging
        \Log::info('📊 Form data summary:', [
            'pembacaan_alat_kiri_count' => count($request->pembacaan_alat_kiri ?? []),
            'pembacaan_alat_kanan_count' => count($request->pembacaan_alat_kanan ?? []),
            'tipe_wire' => $request->tipe_wire ?? 'null',
            'alat_standar_count' => count($alatStandar),
            'repeatability_data' => [
                'rep1_col1' => $request->rep1_col1 ?? 'null',
                'rep1_col2' => $request->rep1_col2 ?? 'null',
                'rep1_col3' => $request->rep1_col3 ?? 'null',
                'rep2_col1' => $request->rep2_col1 ?? 'null',
                'rep2_col2' => $request->rep2_col2 ?? 'null',
            ],
        ]);

        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 Error storing ThermoIndicator data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function storePlasticShim($request, $calibration, $certificateId, $tabId = null)
{
    \Log::info('🔧 ===== START storePlasticShim =====', [
        'calibration_id' => $calibration->id,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storePlasticShim called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dengan berbagai kemungkinan nama field
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        // Coba juga dengan format array
        $alatStandarArray = $request->input('alat_standar', []);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        }
        
        // Coba dengan alat_standar_text (fallback)
        $alatStandarText = $this->getRequestValue($request, 'alat_standar_text', $tabId);
        if ($alatStandarText && !in_array($alatStandarText, $alatStandar)) {
            $alatStandar[] = $alatStandarText;
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar for Plastic Shim:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. AMBIL SATUAN UNIT
        // ==================================================================
        $satuanUnit = $this->getRequestValue($request, 'unit_nominal', $tabId);
        if (empty($satuanUnit)) {
            $satuanUnit = $this->getRequestValue($request, 'satuan_unit', $tabId);
        }
        
        \Log::info('📏 Satuan unit:', ['satuan_unit' => $satuanUnit]);
        
        // ==================================================================
        // 3. SIMPAN KE HEAD PLASTIC SHIM
        // ==================================================================
        $head = HeadPlasticShim::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-60',
            'satuan_unit' => $satuanUnit,
            'form_index' => 1,
        ]);
        
        \Log::info('✅ Head Plastic Shim saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 4. SIMPAN DETAIL MEASUREMENTS - 20 BARIS (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving Plastic Shim detail measurements...');
        $detailCount = 0;
        
        for ($row = 1; $row <= 20; $row++) {
            // Ambil nilai nominal dengan berbagai kemungkinan format
            $nominalValue = $this->getRequestValue($request, "nominal_{$row}", $tabId);
            if (!$nominalValue) {
                $nominalValue = $this->getRequestValue($request, "nominal", $tabId);
                if (is_array($nominalValue)) {
                    $nominalValue = $nominalValue[$row - 1] ?? null;
                }
            }
            if (!$nominalValue) {
                $nominalValue = $this->getRequestValue($request, "nilai_nominal_{$row}", $tabId);
            }
            
            // Ambil serial number
            $serialNumber = $this->getRequestValue($request, "serial_number_{$row}", $tabId);
            if (!$serialNumber) {
                $serialNumber = $this->getRequestValue($request, "serial_number", $tabId);
                if (is_array($serialNumber)) {
                    $serialNumber = $serialNumber[$row - 1] ?? null;
                }
            }
            if (!$serialNumber) {
                $serialNumber = $this->getRequestValue($request, "sn_{$row}", $tabId);
            }
            
            // Ambil 5 nilai penunjukan (STD01 - STD05)
            $penunjukanValues = [];
            for ($col = 1; $col <= 5; $col++) {
                $penunjukan = $this->getRequestValue($request, "penunjukan_{$row}_{$col}", $tabId);
                if (!$penunjukan) {
                    $penunjukan = $this->getRequestValue($request, "penunjukan", $tabId);
                    if (is_array($penunjukan)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $penunjukan = $penunjukan[$index] ?? null;
                    }
                }
                if (!$penunjukan) {
                    $penunjukan = $this->getRequestValue($request, "STD{$col}_{$row}", $tabId);
                }
                if (!$penunjukan) {
                    $penunjukan = $this->getRequestValue($request, "pembacaan_{$row}_{$col}", $tabId);
                }
                $penunjukanValues[] = $penunjukan;
            }
            
            // Cek apakah ada data untuk baris ini
            $hasNominal = !empty($nominalValue);
            $hasSerial = !empty($serialNumber);
            $hasPenunjukan = !empty($penunjukanValues[0]) || !empty($penunjukanValues[1]) || 
                            !empty($penunjukanValues[2]) || !empty($penunjukanValues[3]) || 
                            !empty($penunjukanValues[4]);
            
            if ($hasNominal || $hasSerial || $hasPenunjukan) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'form_index' => 1,
                    'nominal' => $nominalValue,
                    'sn' => $serialNumber ?? '',
                    'STD01' => $penunjukanValues[0] ?? null,
                    'STD02' => $penunjukanValues[1] ?? null,
                    'STD03' => $penunjukanValues[2] ?? null,
                    'STD04' => $penunjukanValues[3] ?? null,
                    'STD05' => $penunjukanValues[4] ?? null,
                ];
                
                // Jika masih ada yang kosong, coba cari dengan format array STD values
                if (empty($detailData['STD01']) && empty($detailData['STD02']) && 
                    empty($detailData['STD03']) && empty($detailData['STD04']) && 
                    empty($detailData['STD05'])) {
                    
                    $stdArray = $this->getRequestValue($request, "STD", $tabId);
                    if (is_array($stdArray)) {
                        $index = ($row - 1) * 5;
                        $detailData['STD01'] = $stdArray[$index] ?? null;
                        $detailData['STD02'] = $stdArray[$index + 1] ?? null;
                        $detailData['STD03'] = $stdArray[$index + 2] ?? null;
                        $detailData['STD04'] = $stdArray[$index + 3] ?? null;
                        $detailData['STD05'] = $stdArray[$index + 4] ?? null;
                    }
                }
                
                \Log::debug("📝 Saving Plastic Shim detail row {$row}:", [
                    'nominal' => $detailData['nominal'],
                    'sn' => $detailData['sn'],
                ]);
                
                DetailPlasticShim::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} Plastic Shim detail measurements");
        
        // ==================================================================
        // 5. SIMPAN INFORMASI TANDA TANGAN (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $signatureData = [];
        
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $signatureData['calibrated_by'] = $calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $signatureData['verified_by'] = $verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $verifiedBy]);
        }
        
        if (!empty($signatureData)) {
            $calibration->update($signatureData);
            \Log::info('✅ Signature data saved:', $signatureData);
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $totalDetailRecords = DetailPlasticShim::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Plastic Shim):', [
            'calibration_id' => $calibration->id,
            'detail_records' => $totalDetailRecords,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
            'satuan_unit' => $satuanUnit,
        ]);
        
        \Log::info('🎉 storePlasticShim COMPLETED');
        return $head;
        
    } catch (\Exception $e) {
        \Log::error('💥 Error storing Plastic Shim data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback sederhana
        if (isset($head) && $head->id) {
            try {
                DetailPlasticShim::where('calibration_id', $calibration->id)->delete();
                $head->delete();
            } catch (\Exception $rollbackError) {
                \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
            }
        }
        
        throw new \Exception("Gagal menyimpan data Plastic Shim: " . $e->getMessage());
    }
}

private function updatePlasticShim($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START updatePlasticShim');
        
        // ==================================================================
        // 1. TENTUKAN NAMA ALAT YANG BARU
        // ==================================================================
        $namaAlatLama = $calibration->namaAlat;
        $namaAlatBaru = $namaAlatLama;
        
        if ($request->filled('nama_alat') && $request->nama_alat !== 'MANUAL_INPUT') {
            $namaAlatBaru = $request->nama_alat;
        }
        
        // Update nama alat jika berubah
        $namaAlatUpdated = false;
        if ($namaAlatLama !== $namaAlatBaru) {
            $calibration->update(['namaAlat' => $namaAlatBaru]);
            $namaAlatUpdated = true;
            \Log::info('✅ Nama alat diupdate:', ['dari' => $namaAlatLama, 'menjadi' => $namaAlatBaru]);
        }
        
        // ==================================================================
        // 2. GENERATE CERTIFICATE ID BARU JIKA NAMA ALAT BERUBAH
        // ==================================================================
        $certificateIdLama = $calibration->certificate_id;
        $certificateIdBaru = $certificateIdLama;
        
        if ($namaAlatUpdated || empty($certificateIdLama) || strpos($certificateIdLama, 'MANUAL_INPUT') !== false) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatBaru);
            $calibration->update(['certificate_id' => $certificateIdBaru]);
            \Log::info('🆔 Certificate ID updated:', [
                'lama' => $certificateIdLama,
                'baru' => $certificateIdBaru
            ]);
        }
        
        $certificateIdToUse = $certificateIdBaru;
        
        // ==================================================================
        // 3. AMBIL ATAU BUAT HEAD PLASTIC SHIM
        // ==================================================================
        $head = HeadPlasticShim::where('calibration_id', $calibration->id)->first();
        
        // ==================================================================
        // 4. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandarText = $request->alat_standar_text ?? '';
        
        // ==================================================================
        // 5. UPDATE ATAU BUAT HEAD
        // ==================================================================
        if ($head) {
            $head->update([
                'certificate_id' => $certificateIdToUse,
                'standard' => $alatStandarText,
                'calibrationMethod' => 'PAS-IK1102-60',
                'satuan_unit' => $request->unit_nominal ?? $head->satuan_unit,
            ]);
            \Log::info('✅ Head Plastic Shim updated:', ['head_id' => $head->id]);
        } else {
            $head = HeadPlasticShim::create([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateIdToUse,
                'standard' => $alatStandarText,
                'calibrationMethod' => 'PAS-IK1102-60',
                'satuan_unit' => $request->unit_nominal ?? '',
            ]);
            \Log::info('✅ Head Plastic Shim created:', ['head_id' => $head->id]);
        }

        // ==================================================================
        // 6. UPDATE DETAIL PLASTIC SHIM
        // ==================================================================
        \Log::info('📊 Updating Plastic Shim detail measurements...');
        
        // Hapus detail lama
        $deletedCount = DetailPlasticShim::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records:', ['count' => $deletedCount]);
        
        $detailCount = 0;
        
        // ✅ PERBAIKAN: Ambil data dari array 'detail' sesuai format form
        if ($request->has('detail') && is_array($request->detail)) {
            foreach ($request->detail as $index => $detailData) {
                // Cek apakah baris ini memiliki data
                $hasData = false;
                
                // Cek nominal
                if (!empty($detailData['nominal'])) {
                    $hasData = true;
                }
                
                // Cek serial number
                if (!empty($detailData['sn'])) {
                    $hasData = true;
                }
                
                // Cek STD01 - STD05
                for ($j = 1; $j <= 5; $j++) {
                    $field = "STD0" . $j;
                    if (!empty($detailData[$field])) {
                        $hasData = true;
                        break;
                    }
                }
                
                // Simpan jika ada data
                if ($hasData) {
                    $saveData = [
                        'calibration_id' => $calibration->id,
                        'nominal' => $detailData['nominal'] ?? null,
                        'sn' => $detailData['sn'] ?? null,
                        'STD01' => $detailData['STD01'] ?? null,
                        'STD02' => $detailData['STD02'] ?? null,
                        'STD03' => $detailData['STD03'] ?? null,
                        'STD04' => $detailData['STD04'] ?? null,
                        'STD05' => $detailData['STD05'] ?? null,
                    ];

                    \Log::info("📝 Saving Plastic Shim detail row " . ($index) . ":", [
                        'nominal' => $saveData['nominal'],
                        'sn' => $saveData['sn'],
                        'STD01' => $saveData['STD01'],
                        'STD02' => $saveData['STD02'],
                        'STD03' => $saveData['STD03'],
                        'STD04' => $saveData['STD04'],
                        'STD05' => $saveData['STD05'],
                    ]);
                    
                    DetailPlasticShim::create($saveData);
                    $detailCount++;
                }
            }
        } else {
            \Log::warning('⚠️ Tidak ada data detail yang dikirim');
        }
        
        \Log::info("✅ Saved $detailCount Plastic Shim detail measurements");

        // ==================================================================
        // 7. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated:', $updateData);
        }

        \Log::info('🎉 updatePlasticShim COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePlasticShim:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Plastic Shim: " . $e->getMessage());
    }
}
private function storeProfilProjector($request, $calibration, $certificateId)
{
    try {
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Profil Projector:', ['alat_standar' => $alatStandar]);

        // Simpan ke Head Profil Projector
        $head = HeadProfilProjector::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'satuan_titik_ukur' => $request->satuan_titik_ukur ?? '', // Simpan satuan titik ukur
            'satuan_alat_x' => $request->satuan_alat_x ?? '', // Simpan satuan alat X
            'satuan_alat_y' => $request->satuan_alat_y ?? '', // Simpan satuan alat Y
            'calibrationMethod' => 'PAS-IK1102-42', // Sesuaikan dengan metode kalibrasi profil projector
        ]);

        \Log::info('✅ Head Profil Projector saved:', ['head_id' => $head->id]);

        // Simpan detail measurements - 20 BARIS (sesuai tabel)
        \Log::info('📊 Saving Profil Projector detail measurements...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 20; $i++) { // 20 baris sesuai tabel
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada data X atau Y yang diisi (minimal satu)
            for ($j = 1; $j <= 5; $j++) {
                if (($request->has("x_{$i}_{$j}") && !empty(trim($request->{"x_{$i}_{$j}"}))) || 
                    ($request->has("y_{$i}_{$j}") && !empty(trim($request->{"y_{$i}_{$j}"})))) {
                    $hasData = true;
                    break;
                }
            }
            
            // Cek titik ukur
            $hasTitikUkur = $request->has("titik_ukur_{$i}") && !empty(trim($request->{"titik_ukur_{$i}"}));
            
            // Simpan jika ada data titik ukur, X, atau Y
            if ($hasData || $hasTitikUkur) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $request->{"titik_ukur_{$i}"} ?? null,
                    'X1' => $request->{"x_{$i}_1"} ?? null,
                    'X2' => $request->{"x_{$i}_2"} ?? null,
                    'X3' => $request->{"x_{$i}_3"} ?? null,
                    'X4' => $request->{"x_{$i}_4"} ?? null,
                    'X5' => $request->{"x_{$i}_5"} ?? null,
                    'Y1' => $request->{"y_{$i}_1"} ?? null,
                    'Y2' => $request->{"y_{$i}_2"} ?? null,
                    'Y3' => $request->{"y_{$i}_3"} ?? null,
                    'Y4' => $request->{"y_{$i}_4"} ?? null,
                    'Y5' => $request->{"y_{$i}_5"} ?? null,
                ];

                \Log::info("📝 Saving Profil Projector detail row $i:", $detailData);
                
                DetailProfilProjector::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved $detailCount Profil Projector detail measurements");

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Profil Projector data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine()
        ]);
        throw $e;
    }
}

private function updateProfilProjector($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START updateProfilProjector', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $certificateId
        ]);

        // ==================================================================
        // 1. VALIDASI DAN AMBIL CERTIFICATE ID
        // ==================================================================
        $finalCertificateId = $certificateId;
        
        // Jika certificate_id dari parameter null, ambil dari calibration
        if (empty($finalCertificateId)) {
            $finalCertificateId = $calibration->certificate_id;
            \Log::info('📋 Mengambil certificate_id dari calibration:', [
                'certificate_id' => $finalCertificateId
            ]);
        }
        
        // Jika masih null, ambil dari head yang sudah ada di database
        if (empty($finalCertificateId)) {
            $existingHead = HeadProfilProjector::where('calibration_id', $calibration->id)->first();
            if ($existingHead && !empty($existingHead->certificate_id)) {
                $finalCertificateId = $existingHead->certificate_id;
                \Log::info('📋 Mengambil certificate_id dari existing head:', [
                    'certificate_id' => $finalCertificateId,
                    'head_id' => $existingHead->id
                ]);
            }
        }
        
        // Jika masih null, coba ambil dari detail
        if (empty($finalCertificateId)) {
            $existingDetail = DetailProfilProjector::where('calibration_id', $calibration->id)->first();
            if ($existingDetail && !empty($existingDetail->certificate_id)) {
                $finalCertificateId = $existingDetail->certificate_id;
                \Log::info('📋 Mengambil certificate_id dari existing detail:', [
                    'certificate_id' => $finalCertificateId
                ]);
            }
        }
        
        // Jika masih null, throw error
        if (empty($finalCertificateId)) {
            \Log::error('❌ Certificate ID tidak ditemukan untuk Profil Projector update', [
                'calibration_id' => $calibration->id,
                'certificate_id_from_param' => $certificateId,
                'certificate_id_from_calibration' => $calibration->certificate_id
            ]);
            throw new \Exception('Certificate ID is required for Profil Projector update');
        }

        // ==================================================================
        // 2. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Profil Projector (update):', [
            'alat_standar' => $alatStandar,
            'alat_standar_string' => $alatStandarString
        ]);

        // ==================================================================
        // 3. PROSES NAMA KALIBRATOR DAN PEMERIKSA (jika ada)
        // ==================================================================
        $namaKalibrator = trim($request->calibrated_by ?? '');
        $namaPemeriksa = trim($request->verified_by ?? '');
        
        \Log::info('👤 Nama Kalibrator (update):', ['nama' => $namaKalibrator]);
        \Log::info('👤 Nama Pemeriksa (update):', ['nama' => $namaPemeriksa]);

        // ==================================================================
        // 4. UPDATE HEAD PROFIL PROJECTOR
        // ==================================================================
        $head = HeadProfilProjector::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📊 Head Profil Projector BEFORE update:', [
            'head_exists' => $head ? true : false,
            'head_id' => $head->id ?? null,
            'certificate_id_before' => $head->certificate_id ?? null,
        ]);
        
        $headData = [
            'certificate_id' => $finalCertificateId,
            'standard' => $alatStandarString,
            'satuan_titik_ukur' => $request->satuan_titik_ukur ?? '',
            'satuan_alat_x' => $request->satuan_alat_x ?? '',
            'satuan_alat_y' => $request->satuan_alat_y ?? '',
            'calibrationMethod' => 'PAS-IK1102-42',
        ];
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ Head Profil Projector updated:', ['head_id' => $head->id]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadProfilProjector::create($headData);
            \Log::info('✅ Head Profil Projector created:', ['head_id' => $head->id]);
        }
        
        \Log::info('✅ Head Profil Projector AFTER update:', [
            'head_id' => $head->id,
            'certificate_id_after' => $head->certificate_id,
            'satuan_titik_ukur' => $head->satuan_titik_ukur,
            'satuan_alat_x' => $head->satuan_alat_x,
            'satuan_alat_y' => $head->satuan_alat_y,
        ]);

        // ==================================================================
        // 5. UPDATE DETAIL PROFIL PROJECTOR (20 BARIS)
        // ==================================================================
        \Log::info('📊 Updating Profil Projector detail measurements (20 baris)...');
        
        // Hapus data lama
        $deletedCount = DetailProfilProjector::where('calibration_id', $calibration->id)->delete();
        \Log::info('🗑️ Deleted old detail records:', ['count' => $deletedCount]);
        
        $detailCount = 0;
        
        // Proses 20 baris (sesuai tabel)
        for ($i = 1; $i <= 20; $i++) {
            // Ambil data dari request
            $titikUkur = $request->{"titik_ukur_{$i}"} ?? null;
            
            // Data X
            $x1 = $request->{"x_{$i}_1"} ?? null;
            $x2 = $request->{"x_{$i}_2"} ?? null;
            $x3 = $request->{"x_{$i}_3"} ?? null;
            $x4 = $request->{"x_{$i}_4"} ?? null;
            $x5 = $request->{"x_{$i}_5"} ?? null;
            
            // Data Y
            $y1 = $request->{"y_{$i}_1"} ?? null;
            $y2 = $request->{"y_{$i}_2"} ?? null;
            $y3 = $request->{"y_{$i}_3"} ?? null;
            $y4 = $request->{"y_{$i}_4"} ?? null;
            $y5 = $request->{"y_{$i}_5"} ?? null;
            
            \Log::debug("🔍 Row {$i} data from request (update):", [
                'titikUkur' => $titikUkur,
                'X1' => $x1, 'X2' => $x2, 'X3' => $x3, 'X4' => $x4, 'X5' => $x5,
                'Y1' => $y1, 'Y2' => $y2, 'Y3' => $y3, 'Y4' => $y4, 'Y5' => $y5,
            ]);
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($titikUkur) ||
                      !empty($x1) || !empty($x2) || !empty($x3) || !empty($x4) || !empty($x5) ||
                      !empty($y1) || !empty($y2) || !empty($y3) || !empty($y4) || !empty($y5);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'certificate_id' => $finalCertificateId,
                    'titikUkur' => $titikUkur,
                    'X1' => $x1,
                    'X2' => $x2,
                    'X3' => $x3,
                    'X4' => $x4,
                    'X5' => $x5,
                    'Y1' => $y1,
                    'Y2' => $y2,
                    'Y3' => $y3,
                    'Y4' => $y4,
                    'Y5' => $y5,
                ];

                \Log::debug("💾 Saving Profil Projector detail row {$i} (update):", $detailData);
                
                DetailProfilProjector::create($detailData);
                $detailCount++;
                
                \Log::debug("✅ Saved Profil Projector row {$i} (update)");
            } else {
                \Log::debug("⏭️ Skipping row {$i} - no data");
            }
        }
        
        \Log::info("✅ Updated {$detailCount} Profil Projector detail measurements");

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Update nama kalibrator (jika diisi)
        if (!empty($namaKalibrator)) {
            $updateData['calibrated_by'] = $namaKalibrator;
            \Log::info('📝 Nama dikalibrasi (update):', ['nama' => $namaKalibrator]);
        }
        
        // Update nama pemeriksa (jika diisi)
        if (!empty($namaPemeriksa)) {
            $updateData['verified_by'] = $namaPemeriksa;
            \Log::info('📝 Nama diperiksa (update):', ['nama' => $namaPemeriksa]);
        }
        
        // Update uncertainty dan keterangan (jika ada)
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        // Pastikan certificate_id di calibration juga terupdate
        if (!empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data', $updateData);
        }

        // ==================================================================
        // 7. LOG HASIL AKHIR
        // ==================================================================
        $savedDetailCount = DetailProfilProjector::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Profil Projector):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $savedDetailCount,
            'total_rows' => 20,
            'certificate_id' => $finalCertificateId,
            'certificate_id_source' => $certificateId ? 'parameter' : ($calibration->certificate_id ? 'calibration' : 'existing_data'),
            'alat_standar' => $alatStandarString,
            'satuan_titik_ukur' => $head->satuan_titik_ukur,
            'satuan_alat_x' => $head->satuan_alat_x,
            'satuan_alat_y' => $head->satuan_alat_y,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updateProfilProjector COMPLETED');
        
        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateProfilProjector:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'certificate_id' => $certificateId ?? null,
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Profil Projector: " . $e->getMessage());
    }
}


private function storeSurfaceRoughnessTester($request, $calibration, $certificateId, $tabId = null)
{
    \Log::info('🔧 ===== START storeSurfaceRoughnessTester =====', [
        'calibration_id' => $calibration->id,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeSurfaceRoughnessTester called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandarArray = [];
        
        // Cari alat standar dari checkbox/select dengan berbagai format
        $alatStandar = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (is_array($alatStandar)) {
            foreach ($alatStandar as $value) {
                if ($value && !in_array($value, $alatStandarArray)) {
                    $alatStandarArray[] = $value;
                }
            }
        } elseif ($alatStandar) {
            $alatStandarArray[] = $alatStandar;
        }
        
        // Coba juga dengan format alat_standar_1, alat_standar_2, dll
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandarArray)) {
                $alatStandarArray[] = $value;
            }
        }
        
        // Coba dengan alat_standar_text (fallback)
        $alatStandarText = $this->getRequestValue($request, 'alat_standar_text', $tabId);
        if ($alatStandarText && !in_array($alatStandarText, $alatStandarArray)) {
            if (is_array($alatStandarText)) {
                foreach ($alatStandarText as $value) {
                    if ($value && !in_array($value, $alatStandarArray)) {
                        $alatStandarArray[] = $value;
                    }
                }
            } else {
                $alatStandarArray[] = $alatStandarText;
            }
        }
        
        $alatStandarString = !empty($alatStandarArray) ? implode(', ', $alatStandarArray) : '';
        
        \Log::info('🔧 Alat standar Surface Roughness Tester:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. AMBIL SATUAN UNIT (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $satuanUnit = $this->getRequestValue($request, 'satuan_unit', $tabId);
        $satuanPenunjukanAlat = $this->getRequestValue($request, 'satuan_penunjukan_alat', $tabId);
        $satuanCutOff = $this->getRequestValue($request, 'satuan_cut_off', $tabId);
        
        // ==================================================================
        // 3. SIMPAN KE HEAD SURFACE ROUGHNESS TESTER
        // ==================================================================
        $head = HeadSurfaceRoughnessTester::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-60',
            'satuan_unit' => $satuanUnit,
            'satuan_penunjukan_alat' => $satuanPenunjukanAlat,
            'satuan_cut_off' => $satuanCutOff,
            'form_index' => 1,
        ]);
        
        \Log::info('✅ Head Surface Roughness Tester saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 4. SIMPAN DETAIL MEASUREMENTS (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving detail Surface Roughness Tester measurements...');
        $detailCount = 0;
        
        for ($row = 1; $row <= 10; $row++) {
            // Ambil nominal STD
            $nominalSTD = $this->getRequestValue($request, "nominalSTD_{$row}", $tabId);
            if (!$nominalSTD) {
                $nominalSTD = $this->getRequestValue($request, "nominalSTD", $tabId);
                if (is_array($nominalSTD)) {
                    $nominalSTD = $nominalSTD[$row - 1] ?? null;
                }
            }
            
            // Ambil parameter
            $parameter = $this->getRequestValue($request, "parameter_{$row}", $tabId);
            if (!$parameter) {
                $parameter = $this->getRequestValue($request, "parameter", $tabId);
                if (is_array($parameter)) {
                    $parameter = $parameter[$row - 1] ?? null;
                }
            }
            
            // Ambil nilai ukurAlat1, ukurAlat2, ukurAlat3
            $ukurAlat1 = $this->getRequestValue($request, "ukurAlat1_{$row}", $tabId);
            if (!$ukurAlat1) {
                $ukurAlat1 = $this->getRequestValue($request, "ukurAlat1", $tabId);
                if (is_array($ukurAlat1)) {
                    $ukurAlat1 = $ukurAlat1[$row - 1] ?? null;
                }
            }
            
            $ukurAlat2 = $this->getRequestValue($request, "ukurAlat2_{$row}", $tabId);
            if (!$ukurAlat2) {
                $ukurAlat2 = $this->getRequestValue($request, "ukurAlat2", $tabId);
                if (is_array($ukurAlat2)) {
                    $ukurAlat2 = $ukurAlat2[$row - 1] ?? null;
                }
            }
            
            $ukurAlat3 = $this->getRequestValue($request, "ukurAlat3_{$row}", $tabId);
            if (!$ukurAlat3) {
                $ukurAlat3 = $this->getRequestValue($request, "ukurAlat3", $tabId);
                if (is_array($ukurAlat3)) {
                    $ukurAlat3 = $ukurAlat3[$row - 1] ?? null;
                }
            }
            
            // Ambil CutOff
            $cutOff = $this->getRequestValue($request, "CutOff_{$row}", $tabId);
            if (!$cutOff) {
                $cutOff = $this->getRequestValue($request, "CutOff", $tabId);
                if (is_array($cutOff)) {
                    $cutOff = $cutOff[$row - 1] ?? null;
                }
            }
            if (!$cutOff) {
                $cutOff = $this->getRequestValue($request, "cut_off_{$row}", $tabId);
            }
            
            // Cek apakah ada data untuk baris ini
            $hasData = !empty($nominalSTD) || !empty($parameter) || 
                       !empty($ukurAlat1) || !empty($ukurAlat2) || !empty($ukurAlat3) || 
                       !empty($cutOff);
            
            if ($hasData) {
                $detailData = [
                    'head_surface_roughness_tester_id' => $head->id,
                    'calibration_id' => $calibration->id,
                    'form_index' => 1,
                    'nominalSTD' => $nominalSTD,
                    'parameter' => $parameter,
                    'ukurAlat1' => $ukurAlat1,
                    'ukurAlat2' => $ukurAlat2,
                    'ukurAlat3' => $ukurAlat3,
                    'CutOff' => $cutOff,
                ];
                
                \Log::debug("📝 Saving Surface Roughness Tester detail row {$row}:", [
                    'nominalSTD' => $detailData['nominalSTD'],
                    'parameter' => $detailData['parameter']
                ]);
                
                DetailSurfaceRoughnessTester::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Surface Roughness Tester");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TTD (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $updateData = [];
        
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('👤 Calibrated by saved:', ['name' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('👤 Verified by saved:', ['name' => $verifiedBy]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with signature data');
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('📋 STORE SUMMARY (Surface Roughness Tester):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $detailCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
            'satuan_unit' => $satuanUnit,
        ]);
        
        \Log::info('🎉 storeSurfaceRoughnessTester COMPLETED');
        return $head;
        
    } catch (\Exception $e) {
        \Log::error('💥 Error storing Surface Roughness Tester data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function updateSurfaceRoughnessTester($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateSurfaceRoughnessTester');
        \Log::info('📝 Updating Surface Roughness Tester data for calibration ID: ' . $calibration->id);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headSurfaceRoughnessTester;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandarString = $request->alat_standar_text ?? '';
        
        \Log::info('🔧 Alat standar Surface Roughness Tester selected:', ['alat_standar' => $alatStandarString]);
        
        // ==================================================================
        // 2. UPDATE ATAU CREATE HEAD SURFACE ROUGHNESS TESTER
        // ==================================================================
        $head = HeadSurfaceRoughnessTester::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-60',
            'satuan_unit' => $request->satuan_unit,
            'satuan_penunjukan_alat' => $request->satuan_penunjukan_alat,
            'satuan_cut_off' => $request->satuan_cut_off,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ Head Surface Roughness Tester updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadSurfaceRoughnessTester::create($headData);
            \Log::info('➕ Head Surface Roughness Tester created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL SURFACE ROUGHNESS TESTER - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating detail Surface Roughness Tester measurements...');
        
        // Hapus data lama terlebih dahulu
        $deletedDetails = DetailSurfaceRoughnessTester::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$deletedDetails} old detail records");
        
        $detailCount = 0;
        
        // Proses 10 baris data - LANGSUNG TANPA FORMAT
        for ($i = 1; $i <= 10; $i++) {
            // Ambil data dari request - LANGSUNG TANPA FORMAT
            $nominalSTD = $request->input("nominalSTD_{$i}");
            $parameter = $request->input("parameter_{$i}");
            $ukurAlat1 = $request->input("ukurAlat1_{$i}");
            $ukurAlat2 = $request->input("ukurAlat2_{$i}");
            $ukurAlat3 = $request->input("ukurAlat3_{$i}");
            $cutOff = $request->input("CutOff_{$i}");
            
            $hasData = !empty($nominalSTD) || !empty($parameter) || 
                       !empty($ukurAlat1) || !empty($ukurAlat2) || 
                       !empty($ukurAlat3) || !empty($cutOff);
            
            if ($hasData) {
                $detailData = [
                    'head_surface_roughness_tester_id' => $head->id,
                    'calibration_id' => $calibration->id,
                    'nominalSTD' => $nominalSTD,    // LANGSUNG, tanpa format
                    'parameter' => $parameter,      // LANGSUNG, tanpa format
                    'ukurAlat1' => $ukurAlat1,      // LANGSUNG, tanpa format
                    'ukurAlat2' => $ukurAlat2,      // LANGSUNG, tanpa format
                    'ukurAlat3' => $ukurAlat3,      // LANGSUNG, tanpa format
                    'CutOff' => $cutOff,            // LANGSUNG, tanpa format
                ];
                
                \Log::debug("📝 Saving Surface Roughness Tester detail row {$i}:", $detailData);
                
                DetailSurfaceRoughnessTester::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Surface Roughness Tester");
        
        // ==================================================================
        // 4. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Ambil nama dari input calibrated_by dan verified_by
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headSurfaceRoughnessTester;
        $totalDetailRecords = DetailSurfaceRoughnessTester::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Surface Roughness Tester):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $totalDetailRecords,
            'satuan_unit' => $request->satuan_unit,
            'satuan_penunjukan_alat' => $request->satuan_penunjukan_alat,
            'satuan_cut_off' => $request->satuan_cut_off,
            'alat_standar' => $alatStandarString,
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);
        
        \Log::info('🎉 updateSurfaceRoughnessTester COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateSurfaceRoughnessTester:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Surface Roughness Tester: " . $e->getMessage());
    }
}

private function storeUltrasonicThicknessGauge($request, $calibration, $certificateId)
{
    try {
        $alatStandarString = $request->alat_standar_text ?? [];
      
        
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandarString]);

        // Simpan ke Head Ultrasonic Thickness Gauge
        $head = HeadUltrasonicThicknessGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-01 (JIS B 7502:2016 (JMA/JSA); SNSU PK.P-01:2020)',
            'satuan_unit' => $request->satuan_unit,
        ]);

        \Log::info('✅ Head Ultrasonic Thickness Gauge saved:', ['head_id' => $head->id]);

        // Simpan detail measurements - SEKARANG 14 BARIS
        \Log::info('📊 Saving detail measurements...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 15; $i++) { // UBAH DARI 11 MENJADI 14
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada penunjukan yang diisi (minimal satu)
            for ($j = 1; $j <= 5; $j++) {
                if ($request->has("penunjukan_{$i}_{$j}") && !empty(trim($request->{"penunjukan_{$i}_{$j}"}))) {
                    $hasData = true;
                    break;
                }
            }
            
            // Simpan jika ada data nominal atau penunjukan
            if (($request->has("nominal_$i") && !empty(trim($request->{"nominal_$i"}))) || $hasData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nominalSTD' => $request->{"nominal_$i"} ?? '',
                    'ulangan01' => $request->{"penunjukan_{$i}_1"} ?? null,
                    'ulangan02' => $request->{"penunjukan_{$i}_2"} ?? null,
                    'ulangan03' => $request->{"penunjukan_{$i}_3"} ?? null,
                    'ulangan04' => $request->{"penunjukan_{$i}_4"} ?? null,
                    'ulangan05' => $request->{"penunjukan_{$i}_5"} ?? null,
                ];

                \Log::info("📝 Saving detail row $i:", $detailData);
                
                DetailUltrasonicThicknessGauge::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved $detailCount detail measurements");

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Ultrasonic Thickness Gauge data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine()
        ]);
        throw $e;
    }
}

private function updateUltrasonicThicknessGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateUltrasonicThicknessGauge', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = HeadUltrasonicThicknessGauge::where('calibration_id', $calibration->id)->first();
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // Jika certificate_id masih kosong, gunakan dari parameter atau generate
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $calibration->certificate_id;
        }
        
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        }
        
        $finalCertificateId = $certificateIdBaru;
        
        \Log::info('📋 Final Certificate ID:', [
            'certificate_id' => $finalCertificateId,
            'certificate_id_updated' => $certificateIdUpdated
        ]);

        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandarString = $request->alat_standar_text ?? '';
        
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandarString]);

        // ==================================================================
        // 2. UPDATE HEAD ULTRASONIC THICKNESS GAUGE
        // ==================================================================
        $head = HeadUltrasonicThicknessGauge::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-01 (JIS B 7502:2016 (JMA/JSA); SNSU PK.P-01:2020)',
            'satuan_unit' => $request->satuan_unit,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $headData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $finalCertificateId]);
        }
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ Head Ultrasonic Thickness Gauge updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id,
                'satuan_unit' => $request->satuan_unit
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadUltrasonicThicknessGauge::create($headData);
            \Log::info('✅ Head Ultrasonic Thickness Gauge created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }

        // ==================================================================
        // 3. UPDATE DETAIL MEASUREMENTS - 15 BARIS (TANPA FORMAT)
        // ==================================================================
        \Log::info('📊 Updating detail measurements...');
        
        // Hapus data lama
        DetailUltrasonicThicknessGauge::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        for ($i = 1; $i <= 15; $i++) {
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada penunjukan yang diisi (minimal satu)
            for ($j = 1; $j <= 5; $j++) {
                $penunjukanValue = $request->input("penunjukan_{$i}_{$j}");
                if (!empty(trim($penunjukanValue ?? ''))) {
                    $hasData = true;
                    break;
                }
            }
            
            $nominalValue = $request->input("nominal_{$i}");
            
            // Simpan jika ada data nominal atau penunjukan
            if ((!empty(trim($nominalValue ?? ''))) || $hasData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nominalSTD' => $nominalValue,                                    // LANGSUNG, tanpa format
                    'ulangan01' => $request->input("penunjukan_{$i}_1"),            // LANGSUNG, tanpa format
                    'ulangan02' => $request->input("penunjukan_{$i}_2"),            // LANGSUNG, tanpa format
                    'ulangan03' => $request->input("penunjukan_{$i}_3"),            // LANGSUNG, tanpa format
                    'ulangan04' => $request->input("penunjukan_{$i}_4"),            // LANGSUNG, tanpa format
                    'ulangan05' => $request->input("penunjukan_{$i}_5"),            // LANGSUNG, tanpa format
                ];

                \Log::debug("📝 Saving detail row {$i}:", $detailData);
                
                DetailUltrasonicThicknessGauge::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements");

        // ==================================================================
        // 4. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $finalCertificateId]);
        }
        
        // Update nama kalibrator dan pemeriksa jika ada
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        // Update uncertainty jika ada
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }

        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $head->refresh();
        $savedDetailCount = DetailUltrasonicThicknessGauge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('🏁 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'certificate_id_di_head' => $head->certificate_id,
            'certificate_id_di_calibration' => $calibration->certificate_id,
            'detail_records' => $savedDetailCount,
            'nama_alat' => $calibration->namaAlat,
            'satuan_unit' => $head->satuan_unit,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);

        \Log::info('🎉 updateUltrasonicThicknessGauge COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateUltrasonicThicknessGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Ultrasonic Thickness Gauge: " . $e->getMessage());
    }
}


private function storeThreadGauge($request, $calibration, $certificateId)
{
    try {
        // 1. KELOLA ALAT STANDAR DENGAN DETAIL UKURAN
        $alatStandarItems = [];
        $alatStandarArray = $request->alat_standar ?? [];
        
        // Iterasi setiap alat standar yang dipilih
        foreach ($alatStandarArray as $alat) {
            switch ($alat) {
                case 'Mesin ULM 01-600D':
                    $alatStandarItems[] = $alat;
                    break;
                    
                case 'Gauge Block':
                    // Cek apakah ada nilai gauge block yang dipilih
                    if ($request->filled('gauge_block') && $request->gauge_block !== '') {
                        $alatStandarItems[] = $alat . ' ' . $request->gauge_block . ' mm';
                    } else {
                        $alatStandarItems[] = $alat . ' (tidak ada pilihan ukuran)';
                    }
                    break;
                    
                case 'Ring Gauge':
                    // Cek apakah ada nilai dari select atau manual
                    if ($request->filled('ring_gauge_select') && $request->ring_gauge_select !== '') {
                        $alatStandarItems[] = $alat . ' ' . $request->ring_gauge_select . ' mm ';
                    } elseif ($request->filled('ring_gauge_manual') && !empty(trim($request->ring_gauge_manual))) {
                        $alatStandarItems[] = $alat . ' ' . trim($request->ring_gauge_manual) . ' mm';
                    } else {
                        $alatStandarItems[] = $alat . ' (tidak ada ukuran)';
                    }
                    break;
                    
                default:
                    $alatStandarItems[] = $alat;
            }
        }
        
        $alatStandarString = !empty($alatStandarItems) ? implode(', ', $alatStandarItems) : '';
        
        \Log::info('🔧 Alat standar with measurements:', [
            'alat_standar_array' => $alatStandarArray,
            'gauge_block' => $request->gauge_block,
            'ring_gauge_select' => $request->ring_gauge_select,
            'ring_gauge_manual' => $request->ring_gauge_manual,
            'alat_standar_string' => $alatStandarString
        ]);

        // 2. SENSOR TYPE HANDLING
        $sensorType = $request->sensor_type ?? null;
        $sensorValue = null;
        $sensor = null;
        
        switch ($sensorType) {
            case 't_probe':
                $sensorValue = $request->t_probe_value ?? null;
                $sensor = 'T-Probe: ' . $sensorValue;
                break;
            case 'hanging_wire':
                $sensorValue = $request->hanging_wire_value ?? null;
                $sensor = 'Hanging Wire: ' . $sensorValue;
                break;
            case 'wire_holder':
                $sensorValue = $request->wire_holder_value ?? null;
                $sensor = 'Wire (Holder): ' . $sensorValue;
                break;
            case 'ball':
                $sensorValue = $request->ball_value ?? null;
                $sensor = 'Ball: ' . $sensorValue;
                break;
            default:
                $sensor = null;
        }

        // 3. HANDLE SUDUT ULIR
        $sudutUlir = null;
        $sudutUlirType = $request->sudut_ulir_type ?? null;
        
        switch ($sudutUlirType) {
            case 'metrik':
                $sudutUlir = '60° (Ulir Metrik)';
                break;
            case 'non_metrik':
                $sudutUlir = '55° (Ulir Non Metrik)';
                break;
            case 'lainnya':
                $sudutUlirValue = $request->sudut_ulir_lainnya ?? null;
                $sudutUlir = $sudutUlirValue ? $sudutUlirValue . '' : null;
                break;
            default:
                $sudutUlir = null;
        }

        // 4. CATATAN
        $catatan = $request->catatan ?? null;

        // 5. CALIBRATED BY & VERIFIED BY
        $calibratedBy = $request->calibrated_by ?? null;
        $verifiedBy = $request->verified_by ?? null;

        \Log::info('📏 Thread Gauge Complete Data:', [
            'alat_standar' => $alatStandarString,
            'sensor_type' => $sensorType,
            'sensor_value' => $sensorValue,
            'sudut_ulir_type' => $sudutUlirType,
            'sudut_ulir' => $sudutUlir,
            'catatan' => substr($catatan, 0, 100) . (strlen($catatan) > 100 ? '...' : ''),
            'calibrated_by' => $calibratedBy,
            'verified_by' => $verifiedBy
        ]);

        // 6. SIMPAN KE HEAD THREAD GAUGE
        $head = HeadThreadGauge::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString, // INI SUDAH TERMASUK UKURAN
            'calibrationMethod' => 'PAS-IK1102-64',
            'catatan' => $catatan,
            // Note: Jika perlu field calibrated_by dan verified_by, tambahkan ke migration
        ]);

        \Log::info('✅ Head Thread Gauge saved:', ['head_id' => $head->id]);

        // 7. SIMPAN DETAIL THREAD GAUGE
        \Log::info('📊 Saving Thread Gauge detail measurements...');
        
        // Cek apakah ada data yang perlu disimpan
        $hasGoData = $request->filled('nilai_nominal_go') || 
                     $request->filled('go_atas_x') || 
                     $request->filled('go_atas_y') ||
                     $request->filled('go_bawah_x') ||
                     $request->filled('go_bawah_y');
        
        $hasNotGoData = $request->filled('nilai_nominal_not_go') || 
                        $request->filled('not_go_atas_x') || 
                        $request->filled('not_go_atas_y') ||
                        $request->filled('not_go_bawah_x') ||
                        $request->filled('not_go_bawah_y');
        
        // Simpan detail jika ada data
        if ($hasGoData || $hasNotGoData || $sensor || $request->filled('ukuran_pitch')) {
            $detailData = [
                'calibration_id' => $calibration->id,
                
                // Sensor Data
                'sensor' => $sensor,
                
                // GO Data
                'kodeGO' => $request->kode_go ?? null,
                'satuan_go' => $request->satuan_go ?? null,
                'nominalGO' =>$request->nilai_nominal_go,
                'GOatasX1' => $request->go_atas_x,
                'GOatasY1' => $request->go_atas_y,
                'GObawahX1' => $request->go_bawah_x,
                'GObawahY1' => $request->go_bawah_y,
                
                // NOT GO Data
                'kodeNOTGO' => $request->kode_not_go ?? null,
                'satuan_not_go' => $request->satuan_not_go ?? null,
                'nominalNOTGO' =>$request->nilai_nominal_not_go,
                'NOTGOatasX1' => $request->not_go_atas_x,
                'NOTGOatasY1' => $request->not_go_atas_y,
                'NOTGObawahX1' => $request->not_go_bawah_x,
                'NOTGObawahY1' => $request->not_go_bawah_y,
                
                // Pitch dan Sudut Ulir
                'ukuranPitch' => $request->ukuran_pitch,
                'satuan_pitch' => $request->satuan_pitch ?? null,
                'sudutUlir' => $sudutUlir,
            ];

            // Log data yang akan disimpan
            \Log::info('📝 Thread Gauge detail data to save:', array_filter($detailData, function($value) {
                return $value !== null;
            }));
            
            $detail = DetailThreadGauge::create($detailData);
            \Log::info('✅ Detail Thread Gauge saved:', ['detail_id' => $detail->id]);
            
            $detailCount = 1;
        } else {
            \Log::info('ℹ️ No detail data to save for Thread Gauge');
            $detailCount = 0;
        }

        \Log::info("✅ Saved $detailCount Thread Gauge detail measurements");

        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Thread Gauge data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function updateThreadGauge($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateThreadGauge', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headThreadGauge;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // Jika certificate_id masih kosong, gunakan dari parameter atau generate
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $calibration->certificate_id;
        }
        
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        }
        
        $finalCertificateId = $certificateIdBaru;
        
        \Log::info('📋 Final Certificate ID:', [
            'certificate_id' => $finalCertificateId,
            'certificate_id_updated' => $certificateIdUpdated
        ]);

        // ==================================================================
        // 1. KELOLA ALAT STANDAR DENGAN DETAIL UKURAN - TANPA FORMAT
        // ==================================================================
        $alatStandarItems = [];
        $alatStandarArray = $request->alat_standar ?? [];
        
        foreach ($alatStandarArray as $alat) {
            switch ($alat) {
                case 'Mesin ULM 01-600D':
                    $alatStandarItems[] = $alat;
                    break;
                    
                case 'Gauge Block':
                    $gaugeBlockValue = $request->gauge_block_value;
                    if (!empty($gaugeBlockValue) && $gaugeBlockValue !== '') {
                        $alatStandarItems[] = $alat . ' ' . $gaugeBlockValue . ' mm';
                    } else {
                        $alatStandarItems[] = $alat;
                    }
                    break;
                    
                case 'Ring Gauge':
                    $ringGaugeSelect = $request->ring_gauge_select;
                    $ringGaugeManual = $request->ring_gauge_manual;
                    
                    if (!empty($ringGaugeSelect) && $ringGaugeSelect !== '') {
                        if ($ringGaugeSelect == 'lainnya') {
                            if (!empty(trim($ringGaugeManual ?? ''))) {
                                $alatStandarItems[] = $alat . ' ' . trim($ringGaugeManual) . ' mm';
                            } else {
                                $alatStandarItems[] = $alat;
                            }
                        } else {
                            $alatStandarItems[] = $alat . ' ' . $ringGaugeSelect . ' mm';
                        }
                    } elseif (!empty(trim($ringGaugeManual ?? ''))) {
                        $alatStandarItems[] = $alat . ' ' . trim($ringGaugeManual) . ' mm';
                    } else {
                        $alatStandarItems[] = $alat;
                    }
                    break;
                    
                default:
                    $alatStandarItems[] = $alat;
            }
        }
        
        $alatStandarString = !empty($alatStandarItems) ? implode(', ', $alatStandarItems) : '';

        // ==================================================================
        // 2. SENSOR TYPE HANDLING - TANPA FORMAT
        // ==================================================================
        $sensorType = $request->sensor_type ?? null;
        $sensor = null;
        
        switch ($sensorType) {
            case 'T-Probe':
                $sensorValue = $request->t_probe_value;
                $sensor = 'T-Probe: ' . $sensorValue;
                break;
            case 'Hanging Wire':
                $sensorValue = $request->hanging_wire_value;
                $sensor = 'Hanging Wire: ' . $sensorValue;
                break;
            case 'Wire (Holder)':
                $sensorValue = $request->wire_holder_value;
                $sensor = 'Wire (Holder): ' . $sensorValue;
                break;
            case 'Ball':
                $sensorValue = $request->ball_value;
                $sensor = 'Ball: ' . $sensorValue;
                break;
            default:
                $sensor = null;
        }

        // ==================================================================
        // 3. HANDLE SUDUT ULIR - TANPA FORMAT
        // ==================================================================
        $sudutUlir = null;
        $sudutUlirType = $request->sudut_ulir ?? null;
        
        if ($sudutUlirType) {
            if ($sudutUlirType == 'Ulir Metrik : 60°') {
                $sudutUlir = 'Ulir Metrik : 60°';
            } elseif ($sudutUlirType == 'Ulir Non Metrik : 55°') {
                $sudutUlir = 'Ulir Non Metrik : 55°';
            } elseif ($sudutUlirType == 'lainnya') {
                $sudutLainnyaValue = $request->sudut_lainnya_value;
                if (!empty(trim($sudutLainnyaValue ?? ''))) {
                    $sudutUlir = trim($sudutLainnyaValue) . '°';
                } else {
                    $sudutUlir = null;
                }
            }
        }

        // ==================================================================
        // 4. UPDATE HEAD THREAD GAUGE
        // ==================================================================
        $head = HeadThreadGauge::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-64',
            'catatan' => $request->catatan,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $headData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $finalCertificateId]);
        }
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ Head Thread Gauge updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadThreadGauge::create($headData);
            \Log::info('✅ Head Thread Gauge created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }

        // ==================================================================
        // 5. UPDATE DETAIL THREAD GAUGE - TANPA FORMAT
        // ==================================================================
        DetailThreadGauge::where('calibration_id', $calibration->id)->delete();
        
        $detailData = [
            'calibration_id' => $calibration->id,
            
            // Sensor
            'sensor' => $sensor,
            
            // GO Data - LANGSUNG TANPA FORMAT
            'kodeGO' => $request->kodeGO,
            'satuan_go' => $request->satuan_go,
            'nominalGO' => $request->nominalGO,
            'GOatasX1' => $request->GOatasX1,
            'GOatasY1' => $request->GOatasY1,
            'GObawahX1' => $request->GObawahX1,
            'GObawahY1' => $request->GObawahY1,
            
            // NOT GO Data - LANGSUNG TANPA FORMAT
            'kodeNOTGO' => $request->kodeNOTGO,
            'satuan_not_go' => $request->satuan_not_go,
            'nominalNOTGO' => $request->nominalNOTGO,
            'NOTGOatasX1' => $request->NOTGOatasX1,
            'NOTGOatasY1' => $request->NOTGOatasY1,
            'NOTGObawahX1' => $request->NOTGObawahX1,
            'NOTGObawahY1' => $request->NOTGObawahY1,
            
            // Pitch dan Sudut Ulir - LANGSUNG TANPA FORMAT
            'ukuranPitch' => $request->ukuranPitch,
            'satuan_pitch' => $request->satuan_pitch,
            'sudutUlir' => $sudutUlir,
        ];
        
        // Filter data yang null
        $detailData = array_filter($detailData, function($value) {
            return $value !== null && $value !== '';
        });
        
        if (!empty($detailData)) {
            DetailThreadGauge::create($detailData);
            \Log::info('✅ Detail Thread Gauge created');
        }

        // ==================================================================
        // 6. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $finalCertificateId]);
        }
        
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibratedBy]);
        } elseif ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verifiedBy]);
        } elseif ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 7. FINAL VERIFICATION
        // ==================================================================
        $calibration->refresh();
        $head->refresh();
        
        \Log::info('🏁 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'certificate_id_di_head' => $head->certificate_id,
            'certificate_id_di_calibration' => $calibration->certificate_id,
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);

        \Log::info('🎉 updateThreadGauge COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateThreadGauge:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Thread Gauge: " . $e->getMessage());
    }
}
// Helper function untuk parsing decimal
private function parseDecimal($value)
{
    if (empty($value) || trim($value) === '') {
        return null;
    }
    
    // Hapus karakter non-numerik kecuali titik dan minus
    $value = preg_replace('/[^0-9\.\-]/', '', $value);
    
    if ($value === '' || $value === null) {
        return null;
    }
    
    return (float) $value;
}


private function storeStopwatch($request, $calibration, $certificateId, $tabId = null)
{
    \Log::info('⏱️ ===== START storeStopwatch =====', [
        'calibration_id' => $calibration->id,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        \Log::info('📌 storeStopwatch called with tab_id:', ['tab_id' => $tabId]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - DARI INPUT FORM (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $alatStandar = [];
        
        // Cari alat standar dari checkbox dengan berbagai format
        $alatStandarArray = $this->getRequestValue($request, 'alat_standar', $tabId);
        if (is_array($alatStandarArray)) {
            foreach ($alatStandarArray as $value) {
                if ($value && !in_array($value, $alatStandar)) {
                    $alatStandar[] = $value;
                }
            }
        } elseif ($alatStandarArray) {
            $alatStandar[] = $alatStandarArray;
        }
        
        // Coba juga dengan format alat_standar_1, alat_standar_2, dll
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = "alat_standar_{$i}";
            $value = $this->getRequestValue($request, $fieldName, $tabId);
            if ($value && !in_array($value, $alatStandar)) {
                $alatStandar[] = $value;
            }
        }
        
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar stopwatch:', [
            'alat_standar' => $alatStandarString,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. AMBIL CATATAN (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $catatan = $this->getRequestValue($request, 'catatan', $tabId);
        
        // ==================================================================
        // 3. SIMPAN KE HEAD STOPWATCH
        // ==================================================================
        $head = HeadStopwatch::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-45',
            'catatan' => $catatan,
            'form_index' => 1,
        ]);
        
        \Log::info('✅ Head Stopwatch saved:', ['head_id' => $head->id]);
        
        // ==================================================================
        // 4. SIMPAN DETAIL MEASUREMENTS - 10 TITIK UKUR (DENGAN DUKUNGAN _tab)
        // ==================================================================
        \Log::info('📊 Saving stopwatch measurements...');
        $detailCount = 0;
        
        for ($row = 1; $row <= 10; $row++) {
            // Ambil titik ukur
            $titikUkur = $this->getRequestValue($request, "titik_ukur_{$row}", $tabId);
            if (!$titikUkur) {
                $titikUkur = $this->getRequestValue($request, "titik_ukur", $tabId);
                if (is_array($titikUkur)) {
                    $titikUkur = $titikUkur[$row - 1] ?? null;
                }
            }
            
            // Cek apakah ada data untuk titik ukur ini
            $hasData = !empty($titikUkur);
            
            // Persiapkan data detail
            $detailData = [
                'calibration_id' => $calibration->id,
                'head_stopwatch_id' => $head->id,
                'form_index' => 1,
                'titikUkur' => $titikUkur,
            ];
            
            // Mapping data STANDAR untuk 5 pengulangan
            for ($col = 1; $col <= 5; $col++) {
                $menit = $this->getRequestValue($request, "standar_{$row}_p{$col}_menit", $tabId);
                if (!$menit) {
                    $menit = $this->getRequestValue($request, "standar", $tabId);
                    if (is_array($menit)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $menit = $menit[$index]['menit'] ?? null;
                    }
                }
                
                $second = $this->getRequestValue($request, "standar_{$row}_p{$col}_second", $tabId);
                if (!$second) {
                    $second = $this->getRequestValue($request, "standar", $tabId);
                    if (is_array($second)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $second = $second[$index]['second'] ?? null;
                    }
                }
                
                $milisecond = $this->getRequestValue($request, "standar_{$row}_p{$col}_milisecond", $tabId);
                if (!$milisecond) {
                    $milisecond = $this->getRequestValue($request, "standar", $tabId);
                    if (is_array($milisecond)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $milisecond = $milisecond[$index]['milisecond'] ?? null;
                    }
                }
                
                $detailData["STDm{$col}"] = $menit;
                $detailData["STDs{$col}"] = $second;
                $detailData["STDms{$col}"] = $milisecond;
                
                if (!empty($menit) || !empty($second) || !empty($milisecond)) {
                    $hasData = true;
                }
            }
            
            // Mapping data ALAT (UUT) untuk 5 pengulangan
            for ($col = 1; $col <= 5; $col++) {
                $menit = $this->getRequestValue($request, "alat_{$row}_p{$col}_menit", $tabId);
                if (!$menit) {
                    $menit = $this->getRequestValue($request, "alat", $tabId);
                    if (is_array($menit)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $menit = $menit[$index]['menit'] ?? null;
                    }
                }
                
                $second = $this->getRequestValue($request, "alat_{$row}_p{$col}_second", $tabId);
                if (!$second) {
                    $second = $this->getRequestValue($request, "alat", $tabId);
                    if (is_array($second)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $second = $second[$index]['second'] ?? null;
                    }
                }
                
                $milisecond = $this->getRequestValue($request, "alat_{$row}_p{$col}_milisecond", $tabId);
                if (!$milisecond) {
                    $milisecond = $this->getRequestValue($request, "alat", $tabId);
                    if (is_array($milisecond)) {
                        $index = ($row - 1) * 5 + ($col - 1);
                        $milisecond = $milisecond[$index]['milisecond'] ?? null;
                    }
                }
                
                $detailData["UUTm{$col}"] = $menit;
                $detailData["UUTs{$col}"] = $second;
                $detailData["UUTms{$col}"] = $milisecond;
                
                if (!empty($menit) || !empty($second) || !empty($milisecond)) {
                    $hasData = true;
                }
            }
            
            if ($hasData) {
                \Log::debug("📝 Saving stopwatch detail row {$row}:", [
                    'titik_ukur' => $detailData['titikUkur'],
                    'std_p1_menit' => $detailData['STDm1'] ?? null,
                    'uut_p1_menit' => $detailData['UUTm1'] ?? null
                ]);
                
                DetailStopwatch::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} stopwatch detail measurements");
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA TTD (DENGAN DUKUNGAN _tab)
        // ==================================================================
        $updateData = [];
        
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
            \Log::info('👤 Calibrated by saved:', ['name' => $calibratedBy]);
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
            \Log::info('👤 Verified by saved:', ['name' => $verifiedBy]);
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with signature data');
        }
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        \Log::info('📋 STORE SUMMARY (Stopwatch):', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'detail_records' => $detailCount,
            'certificate_id' => $certificateId,
            'tab_id' => $tabId,
            'alat_standar' => $alatStandarString,
        ]);
        
        \Log::info('🎉 storeStopwatch COMPLETED');
        return $head;
        
    } catch (\Exception $e) {
        \Log::error('💥 Error storing Stopwatch data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'tab_id' => $tabId ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}


private function updateStopwatch($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateStopwatch');
        \Log::info('📝 Updating Stopwatch data for calibration ID: ' . $calibration->id);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = $calibration->headStopwatch;
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR
        // ==================================================================
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar stopwatch:', ['alat_standar' => $alatStandarString]);
        
        // ==================================================================
        // 2. UPDATE ATAU CREATE HEAD STOPWATCH
        // ==================================================================
        $head = HeadStopwatch::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-45',
            'catatan' => $request->catatan,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $certificateIdBaru]);
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ Head Stopwatch updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadStopwatch::create($headData);
            \Log::info('➕ Head Stopwatch created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // ==================================================================
        // 3. UPDATE DETAIL STOPWATCH - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating stopwatch measurements...');
        
        // Hapus data lama terlebih dahulu
        $deletedDetails = DetailStopwatch::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$deletedDetails} old detail records");
        
        $detailCount = 0;
        
        // Proses 10 titik ukur - LANGSUNG TANPA FORMAT
        for ($i = 1; $i <= 10; $i++) {
            // Cek apakah ada data untuk titik ukur ini
            $hasData = false;
            
            // Cek data STANDAR untuk titik ukur ini
            for ($p = 1; $p <= 5; $p++) {
                if ($request->has("standar_{$i}_p{$p}_menit") && !empty(trim($request->input("standar_{$i}_p{$p}_menit")))) {
                    $hasData = true;
                    break;
                }
                if ($request->has("standar_{$i}_p{$p}_second") && !empty(trim($request->input("standar_{$i}_p{$p}_second")))) {
                    $hasData = true;
                    break;
                }
                if ($request->has("standar_{$i}_p{$p}_milisecond") && !empty(trim($request->input("standar_{$i}_p{$p}_milisecond")))) {
                    $hasData = true;
                    break;
                }
            }
            
            // Cek data ALAT (UUT) untuk titik ukur ini
            if (!$hasData) {
                for ($p = 1; $p <= 5; $p++) {
                    if ($request->has("alat_{$i}_p{$p}_menit") && !empty(trim($request->input("alat_{$i}_p{$p}_menit")))) {
                        $hasData = true;
                        break;
                    }
                    if ($request->has("alat_{$i}_p{$p}_second") && !empty(trim($request->input("alat_{$i}_p{$p}_second")))) {
                        $hasData = true;
                        break;
                    }
                    if ($request->has("alat_{$i}_p{$p}_milisecond") && !empty(trim($request->input("alat_{$i}_p{$p}_milisecond")))) {
                        $hasData = true;
                        break;
                    }
                }
            }
            
            // Simpan jika ada titik ukur atau data pengukuran
            $titikUkur = $request->input("titik_ukur_{$i}");
            if ((!empty($titikUkur)) || $hasData) {
                
                // Persiapkan data detail - LANGSUNG TANPA FORMAT
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_stopwatch_id' => $head->id,
                    'titikUkur' => $titikUkur,
                ];
                
                // Mapping data STANDAR untuk 5 pengulangan - LANGSUNG TANPA FORMAT
                $detailData["STDm1"] = $request->input("standar_{$i}_p1_menit");
                $detailData["STDs1"] = $request->input("standar_{$i}_p1_second");
                $detailData["STDms1"] = $request->input("standar_{$i}_p1_milisecond");
                
                $detailData["STDm2"] = $request->input("standar_{$i}_p2_menit");
                $detailData["STDs2"] = $request->input("standar_{$i}_p2_second");
                $detailData["STDms2"] = $request->input("standar_{$i}_p2_milisecond");
                
                $detailData["STDm3"] = $request->input("standar_{$i}_p3_menit");
                $detailData["STDs3"] = $request->input("standar_{$i}_p3_second");
                $detailData["STDms3"] = $request->input("standar_{$i}_p3_milisecond");
                
                $detailData["STDm4"] = $request->input("standar_{$i}_p4_menit");
                $detailData["STDs4"] = $request->input("standar_{$i}_p4_second");
                $detailData["STDms4"] = $request->input("standar_{$i}_p4_milisecond");
                
                $detailData["STDm5"] = $request->input("standar_{$i}_p5_menit");
                $detailData["STDs5"] = $request->input("standar_{$i}_p5_second");
                $detailData["STDms5"] = $request->input("standar_{$i}_p5_milisecond");
                
                // Mapping data ALAT (UUT) untuk 5 pengulangan - LANGSUNG TANPA FORMAT
                $detailData["UUTm1"] = $request->input("alat_{$i}_p1_menit");
                $detailData["UUTs1"] = $request->input("alat_{$i}_p1_second");
                $detailData["UUTms1"] = $request->input("alat_{$i}_p1_milisecond");
                
                $detailData["UUTm2"] = $request->input("alat_{$i}_p2_menit");
                $detailData["UUTs2"] = $request->input("alat_{$i}_p2_second");
                $detailData["UUTms2"] = $request->input("alat_{$i}_p2_milisecond");
                
                $detailData["UUTm3"] = $request->input("alat_{$i}_p3_menit");
                $detailData["UUTs3"] = $request->input("alat_{$i}_p3_second");
                $detailData["UUTms3"] = $request->input("alat_{$i}_p3_milisecond");
                
                $detailData["UUTm4"] = $request->input("alat_{$i}_p4_menit");
                $detailData["UUTs4"] = $request->input("alat_{$i}_p4_second");
                $detailData["UUTms4"] = $request->input("alat_{$i}_p4_milisecond");
                
                $detailData["UUTm5"] = $request->input("alat_{$i}_p5_menit");
                $detailData["UUTs5"] = $request->input("alat_{$i}_p5_second");
                $detailData["UUTms5"] = $request->input("alat_{$i}_p5_milisecond");

                \Log::debug("📝 Saving stopwatch detail row {$i}:", [
                    'titik_ukur' => $detailData['titikUkur']
                ]);
                
                DetailStopwatch::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} stopwatch detail measurements");
        
        // ==================================================================
        // 4. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $certificateIdBaru]);
        }
        
        // Nama untuk TTD Dikalibrasi
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibrated_by]);
        } elseif ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        // Nama untuk TTD Diperiksa
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verified_by]);
        } elseif ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        // Data uncertainty dan conclusion
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }
        
        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $headBaru = $calibration->headStopwatch;
        $savedDetailCount = DetailStopwatch::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 UPDATE SUMMARY (Stopwatch):', [
            'calibration_id' => $calibration->id,
            'head_id' => $headBaru->id ?? null,
            'certificate_id_di_head' => $headBaru->certificate_id ?? null,
            'certificate_id_di_calibration' => $calibration->certificate_id ?? null,
            'detail_records' => $savedDetailCount,
            'alat_standar' => $alatStandarString,
            'catatan' => $request->catatan,
            'nama_alat' => $calibration->namaAlat,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);
        
        \Log::info('🎉 updateStopwatch COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateStopwatch:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Stopwatch: " . $e->getMessage());
    }
}

private function storeCentrifuge($request, $calibration, $newCertificateId = null, $isMultipleSubmit = false, $jumlahForm = 1, $tabId = null)
{
    \Log::info('🚀 ===== START storeCentrifuge =====', [
        'calibration_id' => $calibration->id,
        'is_multiple_submit' => $isMultipleSubmit,
        'jumlah_form' => $jumlahForm,
        'tab_id' => $tabId
    ]);
    
    try {
        // Ambil tabId dari request jika tidak dikirim
        if ($tabId === null) {
            $tabId = $request->input('tab_id', 1);
        }
        
        // ==================================================================
        // 1. KONFIGURASI MULTIPLE FORM
        // ==================================================================
        if (!$isMultipleSubmit) {
            $isMultipleSubmit = $request->has('submit_all') && $request->submit_all == 'true';
        }
        if ($jumlahForm <= 1) {
            $jumlahForm = (int) ($request->jumlah_form ?? 1);
        }
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 Form configuration:', [
            'is_multiple_submit' => $isMultipleSubmit,
            'jumlah_form' => $jumlahForm,
            'tab_id' => $tabId
        ]);
        
        // ==================================================================
        // 2. FUNGSI BANTU UNTUK MENCARI NILAI (LOOPING SEMUA KEMUNGKINAN TAB)
        // ==================================================================
        
        /**
         * Mencari nilai dari request dengan berbagai kemungkinan format key (termasuk tab)
         */
        $findValue = function($baseKey, $formIndex, $additionalParams = []) use ($request, $tabId) {
            $possibleKeys = [];
            $suffix = !empty($additionalParams) ? '_' . implode('_', $additionalParams) : '';
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                // Format dengan prefix form_{formIndex}_ dan suffix _tab{tab}
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tab}";
                
                // Format dengan tab_id yang spesifik
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}_tab{$tabId}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}{$suffix}_tab{$tabId}";
                
                // Format tanpa tab suffix
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}{$suffix}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}{$suffix}";
                $possibleKeys[] = "{$baseKey}{$suffix}";
            }
            
            // Hapus duplikasi
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && $value !== '') {
                    \Log::debug("Found value for key: {$key} = {$value}");
                    return $value;
                }
            }
            
            return null;
        };
        
        /**
         * Mencari nilai array (alat_standar) dengan berbagai format (termasuk tab)
         */
        $findArrayValue = function($baseKey, $formIndex) use ($request, $tabId) {
            $possibleKeys = [];
            
            // Loop untuk tab 1-10
            for ($tab = 1; $tab <= 10; $tab++) {
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tab}";
                $possibleKeys[] = "{$baseKey}_tab{$tab}";
                
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}_tab{$tabId}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}_tab{$tabId}";
                $possibleKeys[] = "{$baseKey}_tab{$tabId}";
                
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}_{$formIndex}";
                $possibleKeys[] = "form_{$formIndex}_{$baseKey}";
                $possibleKeys[] = "{$baseKey}_{$formIndex}";
                $possibleKeys[] = $baseKey;
            }
            
            $possibleKeys = array_unique($possibleKeys);
            
            foreach ($possibleKeys as $key) {
                $value = $request->input($key);
                if ($value !== null && !empty($value)) {
                    if (is_array($value)) {
                        return array_filter($value);
                    }
                    return [$value];
                }
            }
            
            return [];
        };
        
        // ==================================================================
        // 3. AMBIL ALAT STANDAR DARI FORM 1
        // ==================================================================
        $alatStandar = $findArrayValue('alat_standar', 1);
        $standardValue = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('📋 Alat Standar:', ['standard_value' => $standardValue]);
        
        // ==================================================================
        // 4. LOOP UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("=========================================");
            \Log::info("📝 PROCESSING FORM {$formIndex} - Centrifuge");
            \Log::info("=========================================");
            
            // ==========================================================
            // SIMPAN HEAD CENTRIFUGE
            // ==========================================================
            HeadCentrifuge::updateOrCreate(
                ['calibration_id' => $calibration->id, 'form_index' => $formIndex],
                [
                    'standard' => $standardValue,
                    'calibrationMethod' => 'PAS-IK1102-52',
                    'certificate_id' => $newCertificateId ?? $calibration->certificate_id ?? 'NEW-' . time(),
                ]
            );
            \Log::info("✅ HeadCentrifuge saved for form {$formIndex}");
            
            // ==========================================================
            // SIMPAN DETAILS UNTUK CENTRIFUGE (12 BARIS)
            // ==========================================================
            $detailCount = 0;
            
            for ($row = 1; $row <= 12; $row++) {
                // Cari nilai setpoint (nominal RPM)
                $setpoint = $findValue("setpoint", $formIndex, [$row]);
                if (empty($setpoint)) {
                    $setpoint = $findValue("nominalRPM", $formIndex, [$row]);
                }
                if (empty($setpoint)) {
                    $setpoint = $findValue("nominal_rpm", $formIndex, [$row]);
                }
                if (empty($setpoint)) {
                    $setpoint = $findValue("rpm", $formIndex, [$row]);
                }
                
                // Cari 5 nilai STD
                $stdValues = [];
                for ($col = 1; $col <= 5; $col++) {
                    $value = $findValue("std", $formIndex, [$row, $col]);
                    if (empty($value)) {
                        $value = $findValue("STD", $formIndex, [$row, $col]);
                    }
                    if (empty($value)) {
                        $value = $findValue("pembacaan", $formIndex, [$row, $col]);
                    }
                    $stdValues[] = $value;
                }
                
                // Cari resolusi alat
                $resolusi = $findValue("resolusi", $formIndex, [$row]);
                if (empty($resolusi)) {
                    $resolusi = $findValue("resolusi_alat", $formIndex, [$row]);
                }
                if (empty($resolusi)) {
                    $resolusi = $findValue("resolution", $formIndex, [$row]);
                }
                
                $hasSetpoint = !empty(trim($setpoint ?? ''));
                $hasAnyStd = !empty($stdValues[0]) || !empty($stdValues[1]) || 
                            !empty($stdValues[2]) || !empty($stdValues[3]) || 
                            !empty($stdValues[4]);
                $hasResolusi = !empty(trim($resolusi ?? ''));
                
                if ($hasSetpoint || $hasAnyStd || $hasResolusi) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'nominalRPM' => $setpoint,
                        'STD1' => !empty($stdValues[0]) ? $stdValues[0] : null,
                        'STD2' => !empty($stdValues[1]) ? $stdValues[1] : null,
                        'STD3' => !empty($stdValues[2]) ? $stdValues[2] : null,
                        'STD4' => !empty($stdValues[3]) ? $stdValues[3] : null,
                        'STD5' => !empty($stdValues[4]) ? $stdValues[4] : null,
                        'resolusi' => $resolusi,
                    ];
                    
                    DetailCentrifuge::updateOrCreate(
                        [
                            'calibration_id' => $calibration->id,
                            'form_index' => $formIndex,
                            'nominalRPM' => $setpoint
                        ],
                        $detailData
                    );
                    $detailCount++;
                    \Log::debug("Detail saved for form {$formIndex}, row {$row}", ['setpoint' => $setpoint]);
                }
            }
            
            \Log::info("✅ Saved {$detailCount} details for form {$formIndex}");
        }
        
        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN JUMLAH FORM DAN SIGNATURE
        // ==================================================================
        $updateData = ['jumlah_form' => $jumlahForm];
        
        // Ambil signature dari form 1 dengan dukungan tab
        $calibratedBy = $this->getRequestValue($request, 'calibrated_by', $tabId);
        if ($calibratedBy) {
            $updateData['calibrated_by'] = $calibratedBy;
        }
        
        $verifiedBy = $this->getRequestValue($request, 'verified_by', $tabId);
        if ($verifiedBy) {
            $updateData['verified_by'] = $verifiedBy;
        }
        
        $calibration->update($updateData);
        
        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $totalHeadRecords = HeadCentrifuge::where('calibration_id', $calibration->id)->count();
        $totalDetailRecords = DetailCentrifuge::where('calibration_id', $calibration->id)->count();
        
        \Log::info('📋 STORE SUMMARY (Centrifuge):', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
            'head_records' => $totalHeadRecords,
            'detail_records' => $totalDetailRecords,
            'certificate_id' => $newCertificateId ?? $calibration->certificate_id,
            'alat_standar' => $standardValue,
            'tab_id' => $tabId
        ]);
        
        \Log::info('🎉 storeCentrifuge COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 storeCentrifuge FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        // Rollback
        try {
            DetailCentrifuge::where('calibration_id', $calibration->id)->delete();
            HeadCentrifuge::where('calibration_id', $calibration->id)->delete();
        } catch (\Exception $rollbackError) {
            \Log::error('💥 Rollback failed:', ['error' => $rollbackError->getMessage()]);
        }
        
        throw $e;
    }
}

private function updateCentrifuge($request, $calibration, $newCertificateId = null)
{
    \Log::info('🚀 ===== START updateCentrifuge =====', [
        'calibration_id' => $calibration->id,
        'timestamp' => now()->toDateTimeString()
    ]);
    
    try {
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'namaAlat_di_calibration' => $calibration->namaAlat,
            'certificate_id_lama_di_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $calibration->namaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $calibration->namaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } elseif (empty($calibration->certificate_id) || strpos($calibration->certificate_id ?? '', 'MANUAL_INPUT') !== false) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong atau MANUAL_INPUT):', [
                'certificate_id_lama' => $calibration->certificate_id,
                'certificate_id_baru' => $certificateIdBaru
            ]);
        }
        
        // Update certificate_id di tabel calibration
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $calibration->update(['certificate_id' => $certificateIdBaru]);
            $calibration->refresh();
            
            \Log::info('📝 UPDATE CERTIFICATE ID DI CALIBRATION:', [
                'certificate_id_baru' => $certificateIdBaru,
                'current_certificate_id' => $calibration->certificate_id
            ]);
        }
        
        // Ambil jumlah form dari request
        $jumlahForm = (int) ($request->jumlah_form ?? $calibration->jumlah_form ?? 1);
        $jumlahForm = max(1, $jumlahForm);
        
        \Log::info('📊 UPDATE Centrifuge - Multiple Form', [
            'calibration_id' => $calibration->id,
            'jumlah_form' => $jumlahForm,
        ]);
        
        // ==================================================================
        // 1. UPDATE HEAD UNTUK SETIAP FORM
        // ==================================================================
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            $head = HeadCentrifuge::where('calibration_id', $calibration->id)
                ->where('form_index', $formIndex)
                ->first();
            
            $headData = [];
            
            // Alat standar untuk form 1
            if ($formIndex == 1) {
                $alatStandar = $request->alat_standar ?? [];
                $headData['standard'] = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
            }
            
            // 🔥 UPDATE CERTIFICATE ID UNTUK SEMUA HEAD (FORM 1-4) 🔥
            if ($certificateIdUpdated && !empty($certificateIdBaru)) {
                $headData['certificate_id'] = $certificateIdBaru;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex}: {$certificateIdBaru}");
            } elseif ($newCertificateId && !$certificateIdUpdated) {
                $headData['certificate_id'] = $newCertificateId;
                \Log::info("📝 Setting certificate_id untuk head form {$formIndex} dari parameter: {$newCertificateId}");
            }
            
            if ($head) {
                $head->update($headData);
                \Log::info("✅ Head updated for form {$formIndex}", [
                    'head_id' => $head->id,
                    'certificate_id' => $head->certificate_id ?? 'not_set'
                ]);
            } else {
                $headData['calibration_id'] = $calibration->id;
                $headData['form_index'] = $formIndex;
                $headData['calibrationMethod'] = 'PAS-IK1102-52';
                $headData['certificate_id'] = $headData['certificate_id'] ?? $certificateIdBaru ?? $calibration->certificate_id ?? 'NEW-' . time();
                $head = HeadCentrifuge::create($headData);
                \Log::info("➕ New head created for form {$formIndex}");
            }
        }
        
        // Hapus head untuk form yang tidak digunakan
        HeadCentrifuge::where('calibration_id', $calibration->id)
            ->where('form_index', '>', $jumlahForm)
            ->delete();
        
        // ==================================================================
        // 2. UPDATE DETAIL MEASUREMENTS
        // ==================================================================
        DetailCentrifuge::where('calibration_id', $calibration->id)->delete();
        
        $totalDetailCount = 0;
        
        for ($formIndex = 1; $formIndex <= $jumlahForm; $formIndex++) {
            \Log::info("📊 Processing details for form {$formIndex}");
            
            $nominalArray = $request->input("nominal_{$formIndex}", []);
            $std1Array = $request->input("std1_{$formIndex}", []);
            $std2Array = $request->input("std2_{$formIndex}", []);
            $std3Array = $request->input("std3_{$formIndex}", []);
            $std4Array = $request->input("std4_{$formIndex}", []);
            $std5Array = $request->input("std5_{$formIndex}", []);
            $resolusiArray = $request->input("resolusi_alat_{$formIndex}", []);
            
            for ($i = 0; $i < 12; $i++) {
                $nominal = $nominalArray[$i] ?? '';
                $std1 = $std1Array[$i] ?? '';
                $std2 = $std2Array[$i] ?? '';
                $std3 = $std3Array[$i] ?? '';
                $std4 = $std4Array[$i] ?? '';
                $std5 = $std5Array[$i] ?? '';
                $resolusi = $resolusiArray[$i] ?? '';
                
                $hasData = !empty(trim($nominal)) || 
                          !empty(trim($std1)) || 
                          !empty(trim($std2)) || 
                          !empty(trim($std3)) || 
                          !empty(trim($std4)) || 
                          !empty(trim($std5)) ||
                          !empty(trim($resolusi));
                
                if ($hasData) {
                    $detailData = [
                        'calibration_id' => $calibration->id,
                        'form_index' => $formIndex,
                        'nominalRPM' => $nominal,
                        'STD1' => !empty($std1) ? $std1 : null,
                        'STD2' => !empty($std2) ? $std2 : null,
                        'STD3' => !empty($std3) ? $std3 : null,
                        'STD4' => !empty($std4) ? $std4 : null,
                        'STD5' => !empty($std5) ? $std5 : null,
                        'resolusi' => !empty($resolusi) ? $resolusi : null,
                    ];
                    
                    DetailCentrifuge::create($detailData);
                    $totalDetailCount++;
                }
            }
        }
        
        // ==================================================================
        // 3. UPDATE CALIBRATION DENGAN DATA TAMBAHAN
        // ==================================================================
        $updateData = [];
        
        // Data TTD dari form 1 (calibratedBy dan verifiedBy)
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibratedBy]);
        } else {
            $updateData['calibrated_by'] = '-';
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verifiedBy]);
        } else {
            $updateData['verified_by'] = '-';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with signature data:', $updateData);
        }
        
        // Update jumlah_form di calibration
        $calibration->update(['jumlah_form' => $jumlahForm]);
        
        // Refresh untuk memastikan data terbaru
        $calibration->refresh();
        
        \Log::info('🎉 updateCentrifuge completed successfully', [
            'calibration_id' => $calibration->id,
            'details_created' => $totalDetailCount,
            'jumlah_form' => $jumlahForm,
            'certificate_id_updated' => $certificateIdUpdated,
            'certificate_id_final' => $certificateIdBaru ?? $calibration->certificate_id
        ]);
        
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 updateCentrifuge FAILED:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
        ]);
        throw $e;
    }
}

private function storeUtm($request, $calibration, $certificateId)
{
    try {
        // Handle alat_standar yang berupa array (radio button)
        $alatStandar = $request->alat_standar_text;
        $alatStandarString = '';
        
        if (is_array($alatStandar)) {
            // Jika berupa array, ambil nilai pertama
            $alatStandarString = !empty($alatStandar) ? $alatStandar[0] : '';
        } else {
            // Jika sudah string
            $alatStandarString = $alatStandar ?? '';
        }
        
        \Log::info('🔧 Alat standar UTM selected:', [
            'alat_standar_raw' => $alatStandar,
            'alat_standar_string' => $alatStandarString
        ]);

        // Simpan ke Head Utm
        $head = HeadUtm::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-54',
            'satuan_titik_ukur_tekan' => $request->satuan_titik_tekan ?? null,
            'satuan_read_tekan_std' => $request->satuan_tekan_standar ?? null,
            'satuan_read_tekan_uut' => $request->satuan_tekan_uut ?? null,
            'satuan_titik_ukur_tarik' => $request->satuan_titik_tarik ?? null,
            'satuan_read_tarik_std' => $request->satuan_tarik_standar ?? null,
            'satuan_read_tarik_uut' => $request->satuan_tarik_uut ?? null,
        ]);

        \Log::info('✅ Head Utm saved:', ['head_id' => $head->id]);

        // Simpan detail measurements untuk TEKAN - 8 BARIS
        \Log::info('📊 Saving UTM TEKAN detail measurements...');
        $detailCountTekan = 0;
        
        for ($i = 1; $i <= 8; $i++) {
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada data yang diisi (titik ukur atau minimal satu pembacaan)
            $titikUkur = $request->{"titik_ukur_tekan_$i"} ?? null;
            $std1 = $request->{"tekan_standar_{$i}_0_1"} ?? null;
            $std2 = $request->{"tekan_standar_{$i}_120_2"} ?? null;
            $std3 = $request->{"tekan_standar_{$i}_240_3"} ?? null;
            $uut1 = $request->{"tekan_uut_{$i}_0_1"} ?? null;
            $uut2 = $request->{"tekan_uut_{$i}_120_2"} ?? null;
            $uut3 = $request->{"tekan_uut_{$i}_240_3"} ?? null;
            
            // Cek jika ada nilai yang tidak kosong
            if (!empty(trim($titikUkur ?? '')) || 
                !empty(trim($std1 ?? '')) || 
                !empty(trim($std2 ?? '')) || 
                !empty(trim($std3 ?? '')) || 
                !empty(trim($uut1 ?? '')) || 
                !empty(trim($uut2 ?? '')) || 
                !empty(trim($uut3 ?? ''))) {
                $hasData = true;
            }
            
            // Simpan jika ada data
            if ($hasData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    'readTekanSTD1' => $std1,
                    'readTekanSTD2' => $std2,
                    'readTekanSTD3' => $std3,
                    'readTekanUUT1' => $uut1,
                    'readTekanUUT2' => $uut2,
                    'readTekanUUT3' => $uut3,
                    // Kolom tarik dikosongkan untuk data tekan
                    'readTarikSTD1' => null,
                    'readTarikSTD2' => null,
                    'readTarikSTD3' => null,
                    'readTarikUUT1' => null,
                    'readTarikUUT2' => null,
                    'readTarikUUT3' => null,
                ];

                \Log::info("📝 Saving TEKAN detail row $i:", $detailData);
                
                DetailUtm::create($detailData);
                $detailCountTekan++;
            }
        }
        
        \Log::info("✅ Saved $detailCountTekan TEKAN detail measurements");

        // Simpan detail measurements untuk TARIK - 8 BARIS
        \Log::info('📊 Saving UTM TARIK detail measurements...');
        $detailCountTarik = 0;
        
        for ($i = 1; $i <= 8; $i++) {
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek apakah ada data yang diisi (titik ukur atau minimal satu pembacaan)
            $titikUkur = $request->{"titik_ukur_tarik_$i"} ?? null;
            $std1 = $request->{"tarik_standar_{$i}_0_1"} ?? null;
            $std2 = $request->{"tarik_standar_{$i}_120_2"} ?? null;
            $std3 = $request->{"tarik_standar_{$i}_240_3"} ?? null;
            $uut1 = $request->{"tarik_uut_{$i}_0_1"} ?? null;
            $uut2 = $request->{"tarik_uut_{$i}_120_2"} ?? null;
            $uut3 = $request->{"tarik_uut_{$i}_240_3"} ?? null;
            
            // Cek jika ada nilai yang tidak kosong
            if (!empty(trim($titikUkur ?? '')) || 
                !empty(trim($std1 ?? '')) || 
                !empty(trim($std2 ?? '')) || 
                !empty(trim($std3 ?? '')) || 
                !empty(trim($uut1 ?? '')) || 
                !empty(trim($uut2 ?? '')) || 
                !empty(trim($uut3 ?? ''))) {
                $hasData = true;
            }
            
            // Simpan jika ada data
            if ($hasData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'titikUkur' => $titikUkur,
                    // Kolom tekan dikosongkan untuk data tarik
                    'readTekanSTD1' => null,
                    'readTekanSTD2' => null,
                    'readTekanSTD3' => null,
                    'readTekanUUT1' => null,
                    'readTekanUUT2' => null,
                    'readTekanUUT3' => null,
                    'readTarikSTD1' => $std1,
                    'readTarikSTD2' => $std2,
                    'readTarikSTD3' => $std3,
                    'readTarikUUT1' => $uut1,
                    'readTarikUUT2' => $uut2,
                    'readTarikUUT3' => $uut3,
                ];

                \Log::info("📝 Saving TARIK detail row $i:", $detailData);
                
                DetailUtm::create($detailData);
                $detailCountTarik++;
            }
        }
        
        \Log::info("✅ Saved $detailCountTarik TARIK detail measurements");
        
        \Log::info("📊 Total UTM measurements saved: {$detailCountTekan} TEKAN + {$detailCountTarik} TARIK = " . ($detailCountTekan + $detailCountTarik));

        // Simpan informasi tanda tangan (jika ada field di model HeadUtm)
        $signatureData = [];
        
        if ($request->has('calibrated_by') && !empty(trim($request->calibrated_by))) {
            $signatureData['calibrated_by'] = $request->calibrated_by;
            \Log::info('📝 Calibrated by:', ['name' => $request->calibrated_by]);
        }
        
        if ($request->has('verified_by') && !empty(trim($request->verified_by))) {
            $signatureData['verified_by'] = $request->verified_by;
            \Log::info('📝 Verified by:', ['name' => $request->verified_by]);
        }
        
        // Jika ingin menyimpan tanda tangan di head, perlu tambah field di model
        if (!empty($signatureData)) {
            \Log::info('✅ Signature data captured:', $signatureData);
        }

        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 Error storing UTM data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function updateUtm($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateUtm - TEKAN & TARIK (8 baris masing-masing)', [
            'calibration_id' => $calibration->id,
            'new_certificate_id' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID DI HEAD
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->namaAlat ?? $request->nama_alat ?? $calibration->namaAlat;
        
        // Ambil head utm untuk cek certificate_id
        $headUtm = HeadUtm::where('calibration_id', $calibration->id)->first();
        $currentCertificateId = $headUtm->certificate_id ?? null;
        
        // Ambil nama alat asli dari database
        $originalCalibration = Calibration::find($calibration->id);
        $originalNamaAlat = $originalCalibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'certificate_id_lama_di_head' => $currentCertificateId
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head kosong
        elseif (empty($currentCertificateId)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $currentCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ==================================================================
        // 1. UPDATE HEAD UTM
        // ==================================================================
        // Handle alat_standar yang berupa array (radio button)
        $alatStandar = $request->alat_standar_text;
        $alatStandarString = '';
        
        if (is_array($alatStandar)) {
            $alatStandarString = !empty($alatStandar) ? $alatStandar[0] : '';
        } else {
            $alatStandarString = $alatStandar ?? '';
        }
        
        // Data untuk update head
        $headUpdateData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-54',
            'satuan_titik_ukur_tekan' => $request->satuan_titik_ukur_tekan ?? null,
            'satuan_read_tekan_std' => $request->satuan_read_tekan_std ?? null,
            'satuan_read_tekan_uut' => $request->satuan_read_tekan_uut ?? null,
            'satuan_titik_ukur_tarik' => $request->satuan_titik_ukur_tarik ?? null,
            'satuan_read_tarik_std' => $request->satuan_read_tarik_std ?? null,
            'satuan_read_tarik_uut' => $request->satuan_read_tarik_uut ?? null,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headUpdateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headUpdateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($headUtm) {
            $headUtm->update($headUpdateData);
            \Log::info('✅ HeadUtm updated:', $headUpdateData);
        } else {
            // Jika head belum ada, buat baru
            $headUtm = HeadUtm::create(array_merge([
                'calibration_id' => $calibration->id,
                'certificate_id' => $certificateIdBaru ?? $newCertificateId,
            ], $headUpdateData));
            \Log::info('➕ HeadUtm created baru:', ['head_id' => $headUtm->id]);
        }

        // ==================================================================
        // 2. UPDATE DETAIL UTM (DELETE & RECREATE untuk TEKAN & TARIK)
        // ==================================================================
        // Hapus data detail lama
        DetailUtm::where('calibration_id', $calibration->id)->delete();
        
        $detailCountTekan = 0;
        $detailCountTarik = 0;
        
        // ==================== PROSES DATA TEKAN ====================
        \Log::info('📊 Saving UTM TEKAN detail measurements...');
        
        // Proses 8 baris TEKAN
        if ($request->has('tekan') && is_array($request->tekan)) {
            foreach ($request->tekan as $index => $tekanData) {
                // Cek apakah ada data yang diisi
                $titikUkur = $tekanData['titikUkur'] ?? null;
                $std1 = $tekanData['readTekanSTD1'] ?? null;
                $std2 = $tekanData['readTekanSTD2'] ?? null;
                $std3 = $tekanData['readTekanSTD3'] ?? null;
                $uut1 = $tekanData['readTekanUUT1'] ?? null;
                $uut2 = $tekanData['readTekanUUT2'] ?? null;
                $uut3 = $tekanData['readTekanUUT3'] ?? null;
                
                // Cek jika ada nilai yang tidak kosong
                $hasData = !empty(trim($titikUkur ?? '')) || 
                          !empty(trim($std1 ?? '')) || 
                          !empty(trim($std2 ?? '')) || 
                          !empty(trim($std3 ?? '')) || 
                          !empty(trim($uut1 ?? '')) || 
                          !empty(trim($uut2 ?? '')) || 
                          !empty(trim($uut3 ?? ''));
                
                if ($hasData) {
                    DetailUtm::create([
                        'calibration_id' => $calibration->id,
                        'certificate_id' => $headUtm->certificate_id,
                        'titikUkur' => $titikUkur,
                        'readTekanSTD1' => $std1,
                        'readTekanSTD2' => $std2,
                        'readTekanSTD3' => $std3,
                        'readTekanUUT1' => $uut1,
                        'readTekanUUT2' => $uut2,
                        'readTekanUUT3' => $uut3,
                        'readTarikSTD1' => null,
                        'readTarikSTD2' => null,
                        'readTarikSTD3' => null,
                        'readTarikUUT1' => null,
                        'readTarikUUT2' => null,
                        'readTarikUUT3' => null,
                    ]);
                    $detailCountTekan++;
                }
            }
        }
        
        \Log::info("✅ Saved $detailCountTekan TEKAN detail measurements");

        // ==================== PROSES DATA TARIK ====================
        \Log::info('📊 Saving UTM TARIK detail measurements...');
        
        // Proses 8 baris TARIK
        if ($request->has('tarik') && is_array($request->tarik)) {
            foreach ($request->tarik as $index => $tarikData) {
                // Cek apakah ada data yang diisi
                $titikUkur = $tarikData['titikUkur'] ?? null;
                $std1 = $tarikData['readTarikSTD1'] ?? null;
                $std2 = $tarikData['readTarikSTD2'] ?? null;
                $std3 = $tarikData['readTarikSTD3'] ?? null;
                $uut1 = $tarikData['readTarikUUT1'] ?? null;
                $uut2 = $tarikData['readTarikUUT2'] ?? null;
                $uut3 = $tarikData['readTarikUUT3'] ?? null;
                
                // Cek jika ada nilai yang tidak kosong
                $hasData = !empty(trim($titikUkur ?? '')) || 
                          !empty(trim($std1 ?? '')) || 
                          !empty(trim($std2 ?? '')) || 
                          !empty(trim($std3 ?? '')) || 
                          !empty(trim($uut1 ?? '')) || 
                          !empty(trim($uut2 ?? '')) || 
                          !empty(trim($uut3 ?? ''));
                
                if ($hasData) {
                    DetailUtm::create([
                        'calibration_id' => $calibration->id,
                        'certificate_id' => $headUtm->certificate_id,
                        'titikUkur' => $titikUkur,
                        'readTekanSTD1' => null,
                        'readTekanSTD2' => null,
                        'readTekanSTD3' => null,
                        'readTekanUUT1' => null,
                        'readTekanUUT2' => null,
                        'readTekanUUT3' => null,
                        'readTarikSTD1' => $std1,
                        'readTarikSTD2' => $std2,
                        'readTarikSTD3' => $std3,
                        'readTarikUUT1' => $uut1,
                        'readTarikUUT2' => $uut2,
                        'readTarikUUT3' => $uut3,
                    ]);
                    $detailCountTarik++;
                }
            }
        }
        
        \Log::info("✅ Saved $detailCountTarik TARIK detail measurements");

        // ==================================================================
        // 3. UPDATE CALIBRATION (HANYA YANG PERLU)
        // ==================================================================
        $updateData = [];
        
        // Update certificate_id di calibration jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk calibration: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $updateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk calibration dari parameter: {$newCertificateId}");
        }
        
        // Update nama alat jika berubah (untuk keperluan generate certificate ID)
        if ($request->filled('namaAlat') && $request->namaAlat != $calibration->namaAlat) {
            $updateData['namaAlat'] = $request->namaAlat;
        }
        
        // Update calibrated_by dan verified_by
        if ($request->filled('nama_dikalibrasi')) {
            $updateData['calibrated_by'] = $request->nama_dikalibrasi;
        }
        
        if ($request->filled('nama_diperiksa')) {
            $updateData['verified_by'] = $request->nama_diperiksa;
        }
        
        // Update uncertainty dan conclusion
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
        }
        
        if ($request->filled('conclusion')) {
            $updateData['keterangan'] = $request->conclusion;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('📝 Calibration updated', array_keys($updateData));
        }

        // ==================================================================
        // 4. LOG HASIL AKHIR
        // ==================================================================
        $finalDetailCount = DetailUtm::where('calibration_id', $calibration->id)->count();
        
        // Ambil head terbaru untuk cek certificate_id
        $finalHead = HeadUtm::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📋 UPDATE SUMMARY (UTM - TEKAN & TARIK):', [
            'calibration_id' => $calibration->id,
            'certificate_id_calibration' => $calibration->certificate_id,
            'certificate_id_head' => $finalHead->certificate_id ?? null,
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'detail_records_total' => $finalDetailCount,
            'detail_records_tekan' => $detailCountTekan,
            'detail_records_tarik' => $detailCountTarik,
            'standard' => $alatStandarString,
            'calibrated_by' => $calibration->calibrated_by ?? null,
            'verified_by' => $calibration->verified_by ?? null,
        ]);

        \Log::info('🎉 updateUtm COMPLETED');
        return $headUtm;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateUtm:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        throw $e;
    }
}

private function storeAnakTimbangan($request, $calibration, $certificateId)
{
    try {
        \Log::info('🔧 Starting storeAnakTimbangan function...');
        
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandar]);

        // Simpan ke Head Anak Timbangan
        $head = HeadAnakTimbangan::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'satuan_unit01' => $request->satuan_unit01 ?? '',
            'satuan_unit02' => $request->satuan_unit02 ?? '',
            'calibrationMethod' => 'PAS-IK1102-16',
        ]);

        \Log::info('✅ Head Anak Timbangan saved:', ['head_id' => $head->id]);

        // Simpan detail measurements - 5 NOMOR (TANPA FORMAT)
        \Log::info('📊 Saving detail measurements for Anak Timbangan...');
        $detailCount = 0;
        
        for ($i = 1; $i <= 5; $i++) {
            // Cek apakah ada data untuk nomor ini
            $hasData = false;
            
            // Cek massa nominal
            $massaNominal = $request->input("massa_nominal_$i");
            if (!empty($massaNominal) && trim($massaNominal) !== '') {
                $hasData = true;
            }
            
            // Cek AT Standard
            $atStandard = $request->input("at_standard_$i");
            if (!empty($atStandard) && trim($atStandard) !== '') {
                $hasData = true;
            }
            
            // Cek minimal satu nilai input untuk konfirmasi ada data
            if (!$hasData) {
                $checks = [
                    "unit01_s_{$i}_1",
                    "unit02_s_{$i}_1",
                    "unit01_t_{$i}_1",
                    "unit02_t_{$i}_1",
                    "unit01_t_{$i}_2",
                    "unit02_t_{$i}_2",
                    "unit01_s_{$i}_2",
                    "unit02_s_{$i}_2"
                ];
                
                foreach ($checks as $check) {
                    $value = $request->input($check);
                    if (!empty($value) && trim($value) !== '') {
                        $hasData = true;
                        break;
                    }
                }
            }
            
            // Simpan jika ada data - LANGSUNG TANPA FORMAT
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nominalAlat' => $massaNominal ?? '',
                    'ATSTD' => $atStandard ?? '',
                    
                    // Baris 1: S - S (Upper Left/Right STD)
                    'ULSTD' => $request->input("unit01_s_{$i}_1"),
                    'URSTD' => $request->input("unit02_s_{$i}_1"),
                    
                    // Baris 2: T - T (Upper Left/Right UUT)
                    'ULUUT' => $request->input("unit01_t_{$i}_1"),
                    'URUUT' => $request->input("unit02_t_{$i}_1"),
                    
                    // Baris 3: T - T (Lower Left/Right UUT)
                    'LLUUT' => $request->input("unit01_t_{$i}_2"),
                    'LRUUT' => $request->input("unit02_t_{$i}_2"),
                    
                    // Baris 4: S - S (Lower Left/Right STD)
                    'LLSTD' => $request->input("unit01_s_{$i}_2"),
                    'LRSTD' => $request->input("unit02_s_{$i}_2"),
                ];
                
                \Log::debug("📝 Saving Anak Timbangan - Nomor {$i}:", $detailData);
                
                DetailAnakTimbangan::create($detailData);
                $detailCount++;
                
            } else {
                \Log::debug("⚠️ Skipping Nomor {$i} - No data found");
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements for Anak Timbangan");

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Anak Timbangan data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function updateAnakTimbangan($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateAnakTimbangan', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request (name="namaAlat")
        $namaAlatDariRequest = $request->input('namaAlat') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        // Ambil head yang sudah ada
        $existingHead = HeadAnakTimbangan::where('calibration_id', $calibration->id)->first();
        $currentHeadCertificateId = $existingHead ? $existingHead->certificate_id : null;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_head_certificate_id' => $currentHeadCertificateId,
            'current_calibration_certificate_id' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah ATAU certificate_id di head masih lama/tidak sesuai
        $expectedCertificateId = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
        
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $expectedCertificateId;
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di head berbeda dengan yang seharusnya
        elseif ($currentHeadCertificateId != $expectedCertificateId && !empty($expectedCertificateId)) {
            $certificateIdBaru = $expectedCertificateId;
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (tidak sesuai):', [
                'old_certificate_id_head' => $currentHeadCertificateId,
                'expected_certificate_id' => $expectedCertificateId,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        elseif (empty($currentHeadCertificateId) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // Pastikan certificate_idBaru diisi dari parameter jika masih kosong
        if (empty($certificateIdBaru) && !empty($newCertificateId)) {
            $certificateIdBaru = $newCertificateId;
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID menggunakan dari parameter:', ['certificate_id' => $certificateIdBaru]);
        }
        
        // Jika masih kosong, generate dari nama alat
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $expectedCertificateId;
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID digenerate dari nama alat:', ['certificate_id' => $certificateIdBaru]);
        }
        
        $finalCertificateId = $certificateIdBaru;
        
        \Log::info('📋 Final Certificate ID:', [
            'certificate_id' => $finalCertificateId,
            'certificate_id_updated' => $certificateIdUpdated
        ]);
        
        // ==================================================================
        // 1. PROSES ALAT STANDAR - SESUAI NAME INPUT DI FORM (alatStandar[])
        // ==================================================================
        $alatStandar = $request->input('alatStandar', []);
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandar]);
        
        // ==================================================================
        // 2. UPDATE ATAU CREATE HEAD ANAK TIMBANGAN
        // ==================================================================
        $headData = [
            'standard' => $alatStandarString,
            'satuan_unit01' => $request->input('satuanUnit01', ''),
            'satuan_unit02' => $request->input('satuanUnit02', ''),
            'calibrationMethod' => 'PAS-IK1102-16',
        ];
        
        // Update certificate_id di HEAD - PASTIKAN SELALU UPDATE
        if (!empty($finalCertificateId)) {
            $headData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $finalCertificateId]);
        }
        
        if ($existingHead) {
            $existingHead->update($headData);
            $existingHead->refresh();
            \Log::info('✅ Head Anak Timbangan updated:', [
                'head_id' => $existingHead->id,
                'certificate_id' => $existingHead->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadAnakTimbangan::create($headData);
            \Log::info('✅ Head Anak Timbangan created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }
        
        // Refresh head untuk mendapatkan data terbaru
        $head = HeadAnakTimbangan::where('calibration_id', $calibration->id)->first();
        
        // ==================================================================
        // 3. UPDATE DETAIL ANAK TIMBANGAN - 5 NOMOR
        // ==================================================================
        \Log::info('📊 Updating detail measurements for Anak Timbangan...');
        
        // Hapus data lama
        DetailAnakTimbangan::where('calibration_id', $calibration->id)->delete();
        
        $detailCount = 0;
        
        for ($i = 1; $i <= 5; $i++) {
            // Cek apakah ada data untuk nomor ini
            $hasData = false;
            
            // Massa nominal (name: massa_nominal_1, massa_nominal_2, dst)
            $massaNominal = $request->input("massa_nominal_{$i}");
            if (!empty($massaNominal) && trim($massaNominal) !== '') {
                $hasData = true;
            }
            
            // AT Standard (name: at_standard_1, at_standard_2, dst)
            $atStandard = $request->input("at_standard_{$i}");
            if (!empty($atStandard) && trim($atStandard) !== '') {
                $hasData = true;
            }
            
            // Cek data pengukuran
            $checks = [
                "unit01_s_{$i}_1", "unit02_s_{$i}_1",
                "unit01_t_{$i}_1", "unit02_t_{$i}_1",
                "unit01_t_{$i}_2", "unit02_t_{$i}_2",
                "unit01_s_{$i}_2", "unit02_s_{$i}_2"
            ];
            
            foreach ($checks as $check) {
                $value = $request->input($check);
                if (!empty($value) && trim($value) !== '') {
                    $hasData = true;
                    break;
                }
            }
            
            // Simpan jika ada data
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'nominalAlat' => $massaNominal ?? '',
                    'ATSTD' => $atStandard ?? '',
                    
                    // Baris 1: S - S (Upper Left/Right STD)
                    'ULSTD' => $request->input("unit01_s_{$i}_1"),
                    'URSTD' => $request->input("unit02_s_{$i}_1"),
                    
                    // Baris 2: T - T (Upper Left/Right UUT)
                    'ULUUT' => $request->input("unit01_t_{$i}_1"),
                    'URUUT' => $request->input("unit02_t_{$i}_1"),
                    
                    // Baris 3: T - T (Lower Left/Right UUT)
                    'LLUUT' => $request->input("unit01_t_{$i}_2"),
                    'LRUUT' => $request->input("unit02_t_{$i}_2"),
                    
                    // Baris 4: S - S (Lower Left/Right STD)
                    'LLSTD' => $request->input("unit01_s_{$i}_2"),
                    'LRSTD' => $request->input("unit02_s_{$i}_2"),
                ];
                
                \Log::debug("📝 Saving Anak Timbangan - Nomor {$i}");
                
                DetailAnakTimbangan::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved {$detailCount} detail measurements");
        
        // ==================================================================
        // 4. UPDATE CALIBRATION (TANPA CERTIFICATE ID, HANYA DATA UMUM)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
        }
        
        // Update nama kalibrator dan pemeriksa
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
        }
        
        // JANGAN update certificate_id di calibration
        if (!empty($updateData)) {
            $calibration->update($updateData);
        }
        
        // ==================================================================
        // 5. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $head->refresh();
        
        \Log::info('🏁 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'certificate_id_di_head' => $head->certificate_id,
            'certificate_id_di_calibration' => $calibration->certificate_id,
            'detail_records' => $detailCount,
            'nama_alat' => $calibration->namaAlat,
            'satuan_unit01' => $head->satuan_unit01,
            'satuan_unit02' => $head->satuan_unit02,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);

        \Log::info('🎉 updateAnakTimbangan COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateAnakTimbangan:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        
        throw new \Exception("Gagal mengupdate data Anak Timbangan: " . $e->getMessage());
    }
}
/**
 * Helper function untuk membersihkan nilai numerik
 */
private function cleanNumericValue($value)
{
    if (empty($value) || trim($value) === '') {
        return null;
    }
    
    // Hapus spasi dan karakter non-numerik kecuali titik dan minus
    $cleaned = preg_replace('/[^\d\.\-]/', '', $value);
    
    // Cek jika kosong setelah dibersihkan
    if ($cleaned === '' || $cleaned === '-') {
        return null;
    }
    
    return $cleaned;
}

private function storePressureTransmitter($request, $calibration, $certificateId)
{
    try {
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        \Log::info('🔧 Alat standar selected for Pressure Transmitter:', ['alat_standar' => $alatStandar]);

        // Simpan ke Head Pressure Transmitter
        $head = HeadPressureTransmitter::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-55',
            'satuan_set_point' => $request->satuan_set_point ?? null,
            'satuan_p_naik' => $request->satuan_p_naik ?? null,
            'satuan_so_naik' => $request->satuan_signal_naik ?? null,
            'satuan_p_turun' => $request->satuan_p_turun ?? null,
            'satuan_so_turun' => $request->satuan_signal_turun ?? null,
            'tertelusur' => $request->tertelusur ?? null,
        ]);

        \Log::info('✅ Head Pressure Transmitter saved:', ['head_id' => $head->id]);

        // Simpan detail measurements (setPoint dan readings)
        \Log::info('📊 Saving pressure transmitter detail measurements...');
        $detailCount = 0;
        
        // Loop untuk 11 titik pengukuran (sesuai HTML)
        for ($i = 1; $i <= 11; $i++) {
            // Cek apakah ada data untuk baris ini
            $hasData = false;
            
            // Cek field-field yang mungkin ada datanya
            $fieldsToCheck = [
                "set_point_$i",
                "pembacaan_naik_$i",
                "signal_naik_$i",
                "pembacaan_turun_$i",
                "signal_turun_$i"
            ];
            
            foreach ($fieldsToCheck as $field) {
                if ($request->has($field) && !empty(trim($request->{$field}))) {
                    $hasData = true;
                    break;
                }
            }
            
            // Simpan jika ada data
            if ($hasData) {
                
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_pressure_transmitter_id' => $head->id,
                    'setPoint' => $request->{"set_point_$i"} ?? null,
                    'readP_UP' => $request->{"pembacaan_naik_$i"} ?? null,    // Map ke readP_UP
                    'readS_UP' => $request->{"signal_naik_$i"} ?? null,      // Map ke readS_UP
                    'readP_DOWN' => $request->{"pembacaan_turun_$i"} ?? null, // Map ke readP_DOWN
                    'readS_DOWN' => $request->{"signal_turun_$i"} ?? null,   // Map ke readS_DOWN
                ];

                \Log::info("📝 Saving pressure transmitter detail row $i:", $detailData);
                
                DetailPressureTransmitter::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Saved $detailCount detail measurements");

        // Simpan data satuan dari tabel utama (jika ada)
        $mainSatuan = [];
        if ($request->has('satuan_set_point') && !empty(trim($request->satuan_set_point))) {
            $mainSatuan['satuan_set_point'] = $request->satuan_set_point;
        }
        if ($request->has('satuan_naik') && !empty(trim($request->satuan_naik))) {
            $mainSatuan['satuan_naik'] = $request->satuan_naik;
        }
        if ($request->has('satuan_signal_naik') && !empty(trim($request->satuan_signal_naik))) {
            $mainSatuan['satuan_signal_naik'] = $request->satuan_signal_naik;
        }
        if ($request->has('satuan_turun') && !empty(trim($request->satuan_turun))) {
            $mainSatuan['satuan_turun'] = $request->satuan_turun;
        }
        if ($request->has('satuan_signal_turun') && !empty(trim($request->satuan_signal_turun))) {
            $mainSatuan['satuan_signal_turun'] = $request->satuan_signal_turun;
        }
        
        if (!empty($mainSatuan)) {
            \Log::info('💾 Main table satuan data:', $mainSatuan);
            // Anda bisa menyimpan ini ke tabel AddPressureTransmitter atau tempat lain
        }

        // Simpan data tambahan (AddPressureTransmitter)
        \Log::info('💾 Checking for additional pressure transmitter data...');
        
        // Cek apakah ada data untuk disimpan
        $hasAdditionalData = false;
        
        // Cek field-field utama
        $mainFields = ['repeatability_p', 'satuan_p', 'repeatibility_SO', 'satuan_SO'];
        foreach ($mainFields as $field) {
            if ($request->has($field) && !empty(trim($request->{$field}))) {
                $hasAdditionalData = true;
                break;
            }
        }
        
        // Cek data repeatability pressure (repP01-repP10)
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = 'repP' . sprintf('%02d', $i);
            if ($request->has($fieldName) && !empty(trim($request->{$fieldName}))) {
                $hasAdditionalData = true;
                break;
            }
        }
        
        // Cek data repeatability signal output (repSO01-repSO10)
        for ($i = 1; $i <= 10; $i++) {
            $fieldName = 'repSO' . sprintf('%02d', $i);
            if ($request->has($fieldName) && !empty(trim($request->{$fieldName}))) {
                $hasAdditionalData = true;
                break;
            }
        }

        if ($hasAdditionalData) {
            // Data utama
            $additionalData = [
                'calibration_id' => $calibration->id,
                'satuan_P' => $request->satuan_p ?? null,
                'repeatibility_P' => $request->repeatability_p ?? null, // Perhatikan: HTML 'repeatability_p', DB 'repeatibility_P'
                'satuan_SO' => $request->satuan_SO ?? null,
                'repeatibility_SO' => $request->repeatibility_SO ?? null,
            ];

            // Tambahkan data repeatability untuk Pressure (repP01-repP10)
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = 'repP' . sprintf('%02d', $i); // Format: repP01, repP02, ..., repP10
                $additionalData[$fieldName] = $request->{$fieldName} ?? null;
            }

            // Tambahkan data repeatability untuk Signal Output (repSO01-repSO10)
            for ($i = 1; $i <= 10; $i++) {
                $fieldName = 'repSO' . sprintf('%02d', $i); // Format: repSO01, repSO02, ..., repSO10
                $additionalData[$fieldName] = $request->{$fieldName} ?? null;
            }

            // Tambahkan data satuan dari tabel utama jika ada
            $additionalData = array_merge($additionalData, $mainSatuan);

            \Log::info('💾 Saving additional pressure transmitter data:', $additionalData);
            
            AddPressureTransmitter::create($additionalData);
            \Log::info('✅ Additional pressure transmitter data saved');
        } else {
            \Log::info('ℹ️ No additional pressure transmitter data to save');
        }

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Pressure Transmitter data:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'trace' => $e->getTraceAsString()
        ]);
        throw $e;
    }
}

private function updatePressureTransmitter($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updatePressureTransmitter', [
            'calibration_id' => $calibration->id,
            'certificate_id_received' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->input('namaAlat') ?? $request->input('nama_alat') ?? $request->input('nama_alat_final') ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT UNTUK CERTIFICATE ID:', [
            'nama_alat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'new_certificate_id_from_param' => $newCertificateId,
            'current_certificate_id_calibration' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id di calibration kosong
        elseif (empty($calibration->certificate_id) && !empty($certificateIdBaru)) {
            $certificateIdUpdated = true;
            \Log::info('🆔 Certificate ID akan diupdate (kosong):', [
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        // Jika certificate_id di head kosong
        else {
            $existingHead = HeadPressureTransmitter::where('calibration_id', $calibration->id)->first();
            if ($existingHead && empty($existingHead->certificate_id) && !empty($certificateIdBaru)) {
                $certificateIdUpdated = true;
                \Log::info('🆔 Certificate ID akan diupdate (head kosong):', [
                    'new_certificate_id' => $certificateIdBaru
                ]);
            }
        }
        
        // Jika certificate_id masih kosong, gunakan dari parameter atau generate
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $calibration->certificate_id;
        }
        
        if (empty($certificateIdBaru)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
        }
        
        $finalCertificateId = $certificateIdBaru;
        
        \Log::info('📋 Final Certificate ID:', [
            'certificate_id' => $finalCertificateId,
            'certificate_id_updated' => $certificateIdUpdated
        ]);

        // ==================================================================
        // 1. PROSES ALAT STANDAR (CHECKBOX) - TANPA FORMAT
        // ==================================================================
        $alatStandarItems = [];
        
        if ($request->has('const_P001') && $request->const_P001 == '1') {
            $alatStandarItems[] = 'Const P.001 (0 ~ 700 bar ; Hydraulic)';
        }
        
        if ($request->has('adittel_P002') && $request->adittel_P002 == '1') {
            $alatStandarItems[] = 'Adittel P.002 (-125 ~ 1000 Pa ; Pneumatic)';
        }
        
        if ($request->has('adittel_P003') && $request->adittel_P003 == '1') {
            $alatStandarItems[] = 'Adittel P.003 (-1 ~ 20 bar ; Pneumatic)';
        }
        
        if ($request->has('adittel_P004') && $request->adittel_P004 == '1') {
            $alatStandarItems[] = 'Adittel P.004 (0 ~ 700 bar ; Hydraulic)';
        }
        
        $alatStandarString = !empty($alatStandarItems) ? implode(', ', $alatStandarItems) : '';
        
        \Log::info('🔧 Alat standar selected:', ['alat_standar' => $alatStandarItems]);

        // ==================================================================
        // 2. UPDATE HEAD PRESSURE TRANSMITTER
        // ==================================================================
        $head = HeadPressureTransmitter::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-55',
            'satuan_set_point' => $request->satuan_set_point,
            'satuan_p_naik' => $request->satuan_p_naik,
            'satuan_so_naik' => $request->satuan_so_naik,
            'satuan_p_turun' => $request->satuan_p_turun,
            'satuan_so_turun' => $request->satuan_so_turun,
            'tertelusur' => $request->tertelusur,
        ];
        
        // Update certificate_id di HEAD jika diperlukan
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $headData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Setting certificate_id di HEAD:', ['certificate_id' => $finalCertificateId]);
        }
        
        if ($head) {
            $head->update($headData);
            $head->refresh();
            \Log::info('✅ Head Pressure Transmitter updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $head = HeadPressureTransmitter::create($headData);
            \Log::info('✅ Head Pressure Transmitter created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null
            ]);
        }

        // ==================================================================
        // 3. UPDATE DETAIL PRESSURE TRANSMITTER (11 BARIS) - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating Pressure Transmitter detail measurements...');
        
        DetailPressureTransmitter::where('calibration_id', $calibration->id)->delete();
        
        $setPointArray = $request->setPoint ?? [];
        $readP_UPArray = $request->readP_UP ?? [];
        $readS_UPArray = $request->readS_UP ?? [];
        $readP_DOWNArray = $request->readP_DOWN ?? [];
        $readS_DOWNArray = $request->readS_DOWN ?? [];
        
        $detailCount = 0;
        
        for ($i = 0; $i < 11; $i++) {
            $setPoint = $setPointArray[$i] ?? null;
            $readP_UP = $readP_UPArray[$i] ?? null;
            $readS_UP = $readS_UPArray[$i] ?? null;
            $readP_DOWN = $readP_DOWNArray[$i] ?? null;
            $readS_DOWN = $readS_DOWNArray[$i] ?? null;
            
            $hasData = !empty($setPoint) || !empty($readP_UP) || !empty($readS_UP) || !empty($readP_DOWN) || !empty($readS_DOWN);
            
            if ($hasData) {
                $detailData = [
                    'calibration_id' => $calibration->id,
                    'head_pressure_transmitter_id' => $head->id,
                    'setPoint' => $setPoint,        // LANGSUNG, tanpa format
                    'readP_UP' => $readP_UP,        // LANGSUNG, tanpa format
                    'readS_UP' => $readS_UP,        // LANGSUNG, tanpa format
                    'readP_DOWN' => $readP_DOWN,    // LANGSUNG, tanpa format
                    'readS_DOWN' => $readS_DOWN,    // LANGSUNG, tanpa format
                ];
                
                DetailPressureTransmitter::create($detailData);
                $detailCount++;
            }
        }
        
        \Log::info("✅ Updated {$detailCount} detail measurements");

        // ==================================================================
        // 4. UPDATE ADD PRESSURE TRANSMITTER (REPEATABILITY) - TANPA FORMAT
        // ==================================================================
        \Log::info('📊 Updating Add Pressure Transmitter data...');
        
        AddPressureTransmitter::where('calibration_id', $calibration->id)->delete();
        
        $additionalData = [
            'calibration_id' => $calibration->id,
            'repeatibility_P' => $request->repeatibility_P,
            'satuan_P' => $request->satuan_P,
            'repeatibility_SO' => $request->repeatibility_SO,
            'satuan_SO' => $request->satuan_SO,
        ];

        $repPValues = $request->repP_value ?? [];
        for ($i = 0; $i < 10; $i++) {
            $fieldName = 'repP' . sprintf('%02d', $i + 1);
            $additionalData[$fieldName] = $repPValues[$i] ?? null;
        }
        
        $repSOValues = $request->repSO_value ?? [];
        for ($i = 0; $i < 10; $i++) {
            $fieldName = 'repSO' . sprintf('%02d', $i + 1);
            $additionalData[$fieldName] = $repSOValues[$i] ?? null;
        }
        
        $filteredData = array_filter($additionalData, function($value) {
            return $value !== null && $value !== '';
        });
        
        $filteredData['calibration_id'] = $calibration->id;
        
        if (count($filteredData) > 1) {
            AddPressureTransmitter::create($filteredData);
            \Log::info('✅ Add Pressure Transmitter data updated');
        }

        // ==================================================================
        // 5. UPDATE CALIBRATION DENGAN DATA DARI FORM (TERMASUK CERTIFICATE ID)
        // ==================================================================
        $updateData = [];
        
        // Update nama alat jika berubah
        if (!empty($namaAlatDariRequest) && $namaAlatDariRequest != $originalNamaAlat) {
            $updateData['namaAlat'] = $namaAlatDariRequest;
            \Log::info('📝 Nama alat diupdate di calibration:', [
                'old' => $originalNamaAlat,
                'new' => $namaAlatDariRequest
            ]);
        }
        
        // Update certificate_id di CALIBRATION (opsional, untuk memudahkan query)
        if ($certificateIdUpdated && !empty($finalCertificateId)) {
            $updateData['certificate_id'] = $finalCertificateId;
            \Log::info('📝 Certificate ID diupdate di CALIBRATION:', ['new' => $finalCertificateId]);
        }
        
        if ($request->filled('calibratedBy')) {
            $updateData['calibrated_by'] = $request->calibratedBy;
            \Log::info('📝 Nama dikalibrasi:', ['nama' => $request->calibratedBy]);
        } elseif ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verifiedBy')) {
            $updateData['verified_by'] = $request->verifiedBy;
            \Log::info('📝 Nama diperiksa:', ['nama' => $request->verifiedBy]);
        } elseif ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if ($request->filled('uncertainty')) {
            $updateData['uncertainty'] = $request->uncertainty;
            $updateData['keterangan'] = $request->conclusion ?? 'Alat diterima, memenuhi kriteria kalibrasi';
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated with additional data:', array_keys($updateData));
        }

        // ==================================================================
        // 6. LOG HASIL AKHIR
        // ==================================================================
        $calibration->refresh();
        $head->refresh();
        
        \Log::info('🏁 FINAL VERIFICATION:', [
            'calibration_id' => $calibration->id,
            'head_id' => $head->id,
            'certificate_id_di_head' => $head->certificate_id,
            'certificate_id_di_calibration' => $calibration->certificate_id,
            'nama_alat' => $calibration->namaAlat,
            'alat_standar' => $alatStandarString,
            'calibrated_by' => $calibration->calibrated_by,
            'verified_by' => $calibration->verified_by,
        ]);

        \Log::info('🎉 updatePressureTransmitter COMPLETED');
        return true;

    } catch (\Exception $e) {
        \Log::error('💥 ERROR updatePressureTransmitter:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
            'trace' => $e->getTraceAsString()
        ]);
        
        throw new \Exception("Gagal mengupdate data Pressure Transmitter: " . $e->getMessage());
    }
}
private function storeSurfacePlate($request, $calibration, $certificateId)
{
    try {
        \Log::info('🎯 Starting storeSurfacePlate function');
        
        // ============================================
        // 1. DATA DARI TABEL SETTING SUHU (a1_1 - a10_4)
        // ============================================
        $settingSuhuData = [
            'a1_1' => $request->input('a1_1', null),
            'a1_2' => $request->input('a1_2', null),
            'a1_3' => $request->input('a1_3', null),
            'a1_4' => $request->input('a1_4', null),
            
            'a2_1' => $request->input('a2_1', null),
            'a2_2' => $request->input('a2_2', null),
            'a2_3' => $request->input('a2_3', null),
            'a2_4' => $request->input('a2_4', null),
            
            'a3_1' => $request->input('a3_1', null),
            'a3_2' => $request->input('a3_2', null),
            'a3_3' => $request->input('a3_3', null),
            'a3_4' => $request->input('a3_4', null),
            
            'a4_1' => $request->input('a4_1', null),
            'a4_2' => $request->input('a4_2', null),
            'a4_3' => $request->input('a4_3', null),
            'a4_4' => $request->input('a4_4', null),
            
            'a5_1' => $request->input('a5_1', null),
            'a5_2' => $request->input('a5_2', null),
            'a5_3' => $request->input('a5_3', null),
            'a5_4' => $request->input('a5_4', null),
            
            'a6_1' => $request->input('a6_1', null),
            'a6_2' => $request->input('a6_2', null),
            'a6_3' => $request->input('a6_3', null),
            'a6_4' => $request->input('a6_4', null),
            
            'a7_1' => $request->input('a7_1', null),
            'a7_2' => $request->input('a7_2', null),
            'a7_3' => $request->input('a7_3', null),
            'a7_4' => $request->input('a7_4', null),
            
            'a8_1' => $request->input('a8_1', null),
            'a8_2' => $request->input('a8_2', null),
            'a8_3' => $request->input('a8_3', null),
            'a8_4' => $request->input('a8_4', null),
            
            'a9_1' => $request->input('a9_1', null),
            'a9_2' => $request->input('a9_2', null),
            'a9_3' => $request->input('a9_3', null),
            'a9_4' => $request->input('a9_4', null),
            
            'a10_1' => $request->input('a10_1', null),
            'a10_2' => $request->input('a10_2', null),
            'a10_3' => $request->input('a10_3', null),
            'a10_4' => $request->input('a10_4', null),
        ];
        
        // ============================================
        // 2. DATA DARI TABEL REPEATABILITY MATRIX (tbl1 - tbl10)
        // ============================================
        $repeatabilityData = [];
        
        // Mapping antara group, tabel, dan prefix
        $mapping = [
            'tbl1' => ['prefix' => 'repeat_a', 'rows' => 9, 'start_col' => 1],
            'tbl2' => ['prefix' => 'b', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'b'],
            'tbl3' => ['prefix' => 'c', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'c'],
            'tbl4' => ['prefix' => 'd', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'd'],
            'tbl5' => ['prefix' => 'e', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'e'],
            'tbl6' => ['prefix' => 'f', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'f'],
            'tbl7' => ['prefix' => 'g', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'g'],
            'tbl8' => ['prefix' => 'h', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'h'],
            'tbl9' => ['prefix' => 'i', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'i'],
            'tbl10' => ['prefix' => 'j', 'rows' => 8, 'start_col' => 2, 'input_prefix' => 'j'],
        ];
        
        foreach ($mapping as $tbl => $config) {
            if ($tbl == 'tbl1') {
                // Group A (9 baris)
                for ($i = 1; $i <= 9; $i++) {
                    $repeatabilityData["a{$i}_1_{$tbl}"] = $request->input("repeat_a{$i}_1", null);
                    $repeatabilityData["a{$i}_2_{$tbl}"] = $request->input("repeat_a{$i}_2", null);
                }
            } else {
                $prefix = $config['prefix'];
                $inputPrefix = $config['input_prefix'];
                $startCol = $config['start_col'];
                
                // Kolom pertama (a1_1_tblX, a1_2_tblX)
                $repeatabilityData["a1_1_{$tbl}"] = $request->input("{$inputPrefix}_row1_col1", null);
                $repeatabilityData["a1_2_{$tbl}"] = $request->input("{$inputPrefix}_row2_col1", null);
                
                // Kolom selanjutnya (b1_1_tbl2, b1_2_tbl2, dst)
                for ($i = 1; $i <= 8; $i++) {
                    $repeatabilityData["{$prefix}{$i}_1_{$tbl}"] = $request->input("{$inputPrefix}_row1_col" . ($i+1), null);
                    $repeatabilityData["{$prefix}{$i}_2_{$tbl}"] = $request->input("{$inputPrefix}_row2_col" . ($i+1), null);
                }
            }
        }
        
        // ============================================
        // 3. FIELD LAINNYA
        // ============================================
        $keteranganValue = $request->input('keterangan');
        
        $alatStandar = $request->alat_standar_text ?? [];
        if (is_array($alatStandar)) {
            $alatStandar = implode(', ', $alatStandar);
        }

        // ============================================
        // SIMPAN GAMBAR CANVAS
        // ============================================
        $keteranganText = '';
        
        if ($keteranganValue && strpos($keteranganValue, 'data:image') === 0) {
            $canvasImagePath = $this->saveCanvasImage($keteranganValue, $calibration->id);
            if ($canvasImagePath) {
                $keteranganText = $canvasImagePath;
            }
        } else {
            $keteranganText = $keteranganValue ?? '';
        }

        // ============================================
        // SIMPAN KE HEAD SURFACE PLATE
        // ============================================
        $head = HeadSurfacePlate::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandar,
            'calibrationMethod' => 'PAS-IK1102-53',
            'keterangan' => $keteranganText,
        ]);

        // ============================================
        // SIMPAN KE DETAIL SURFACE PLATE
        // ============================================
        // Gabungkan semua data
        $detailData = array_merge(
            ['calibration_id' => $calibration->id],
            $settingSuhuData,
            $repeatabilityData
        );
        
        // Log data yang akan disimpan untuk debugging
        \Log::info('📊 Detail data yang akan disimpan:', [
            'setting_suhu_keys' => array_keys(array_filter($settingSuhuData)),
            'repeatability_keys' => array_keys(array_filter($repeatabilityData))
        ]);
        
        $detail = DetailSurfacePlate::create($detailData);
        
        \Log::info('✅ Surface Plate saved:', [
            'head_id' => $head->id,
            'detail_id' => $detail->id,
            'setting_suhu_count' => count(array_filter($settingSuhuData)),
            'repeatability_count' => count(array_filter($repeatabilityData))
        ]);

        return $head;

    } catch (\Exception $e) {
        \Log::error('💥 Error storing Surface Plate data:', [
            'message' => $e->getMessage(),
            'line' => $e->getLine(),
        ]);
        throw $e;
    }
}

private function updateSurfacePlate($request, $calibration, $newCertificateId = null)
{
    try {
        \Log::info('🚀 START updateSurfacePlate', [
            'calibration_id' => $calibration->id,
            'new_certificate_id' => $newCertificateId
        ]);
        
        // ==================================================================
        // 0. CEK PERUBAHAN NAMA ALAT UNTUK UPDATE CERTIFICATE ID
        // ==================================================================
        $certificateIdBaru = $newCertificateId;
        $certificateIdUpdated = false;
        
        // Ambil nama alat dari request
        $namaAlatDariRequest = $request->nama_alat ?? $request->nama_alat_final ?? $calibration->namaAlat;
        
        // Ambil nama alat asli dari database
        $originalNamaAlat = $calibration->namaAlat;
        
        \Log::info('🔍 CEK NAMA ALAT & CERTIFICATE:', [
            'namaAlat_dari_request' => $namaAlatDariRequest,
            'original_nama_alat' => $originalNamaAlat,
            'current_nama_alat' => $calibration->namaAlat,
            'current_certificate_id' => $calibration->certificate_id
        ]);
        
        // Cek apakah nama alat berubah
        if ($namaAlatDariRequest != $originalNamaAlat && !empty($namaAlatDariRequest)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan diupdate (nama alat berubah):', [
                'old_nama' => $originalNamaAlat,
                'new_nama' => $namaAlatDariRequest,
                'old_certificate_id' => $calibration->certificate_id,
                'new_certificate_id' => $certificateIdBaru
            ]);
        } 
        // Jika certificate_id kosong
        elseif (empty($calibration->certificate_id)) {
            $certificateIdBaru = $this->generateCertificateIdFromNamaAlat($namaAlatDariRequest, $calibration);
            $certificateIdUpdated = true;
            
            \Log::info('🆔 Certificate ID akan digenerate (kosong):', [
                'old_certificate_id' => $calibration->certificate_id,
                'new_certificate_id' => $certificateIdBaru
            ]);
        }
        
        // ============================================
        // 1. PROSES ALAT STANDAR
        // ============================================
        $alatStandar = $request->alat_standar_text ?? [];
        \Log::info('🔧 Alat standar:', ['alat_standar' => $alatStandar]);
        
        // ============================================
        // 2. AMBIL DATA HEAD LAMA (UNTUK GAMBAR LAMA)
        // ============================================
        $oldHead = HeadSurfacePlate::where('calibration_id', $calibration->id)->first();
        $oldImagePath = $oldHead ? $oldHead->keterangan : null;
        
        // ============================================
        // 3. PROSES GAMBAR CANVAS
        // ============================================
        $keteranganGambar = $request->input('keterangan_gambar');
        $keteranganText = '';
        $isNewImageUploaded = false;
        
        // Cek apakah ada gambar baru (base64) dan gambar TIDAK kosong
        if ($keteranganGambar && strpos($keteranganGambar, 'data:image') === 0) {
            $data = substr($keteranganGambar, strpos($keteranganGambar, ',') + 1);
            $decodedData = base64_decode($data, true);
            
            if (strlen($decodedData) > 500) {
                \Log::info('🖼️ Valid canvas image detected! Size: ' . strlen($decodedData) . ' bytes');
                $isNewImageUploaded = true;
                
                $canvasImagePath = $this->saveCanvasImage($keteranganGambar, $calibration->id);
                
                if ($canvasImagePath) {
                    $keteranganText = $canvasImagePath;
                    \Log::info('✅ New canvas image saved. Path: ' . $canvasImagePath);
                } else {
                    $oldHead = HeadSurfacePlate::where('calibration_id', $calibration->id)->first();
                    $keteranganText = $oldHead ? $oldHead->keterangan : '';
                    \Log::warning('⚠️ Failed to save new image, keeping old image');
                    $isNewImageUploaded = false;
                }
            } else {
                \Log::info('📝 Canvas empty, skipping image save');
                $oldHead = HeadSurfacePlate::where('calibration_id', $calibration->id)->first();
                $keteranganText = $oldHead ? $oldHead->keterangan : '';
            }
        } else {
            $oldHead = HeadSurfacePlate::where('calibration_id', $calibration->id)->first();
            $keteranganText = $oldHead ? $oldHead->keterangan : '';
            \Log::info('📝 No new image, keeping existing image: ' . ($keteranganText ?: '(empty)'));
        }
        
        // ============================================
        // 4. UPDATE ATAU CREATE HEAD SURFACE PLATE
        // ============================================
        $head = HeadSurfacePlate::where('calibration_id', $calibration->id)->first();
        
        $headData = [
            'standard' => $alatStandar,
            'calibrationMethod' => 'PAS-IK1102-53',
            'keterangan' => $keteranganText,
        ];
        
        // UPDATE CERTIFICATE ID DI HEAD jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $headData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk head: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $headData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk head dari parameter: {$newCertificateId}");
        }
        
        if ($head) {
            $head->update($headData);
            \Log::info('✅ Head Surface Plate updated:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id ?? null,
                'keterangan_saved' => $keteranganText,
                'is_new_image' => $isNewImageUploaded
            ]);
        } else {
            $headData['calibration_id'] = $calibration->id;
            $headData['certificate_id'] = $certificateIdBaru ?? $newCertificateId ?? $calibration->certificate_id;
            $head = HeadSurfacePlate::create($headData);
            \Log::info('✅ Head Surface Plate created:', [
                'head_id' => $head->id,
                'certificate_id' => $head->certificate_id,
                'keterangan_saved' => $keteranganText
            ]);
        }
        
        // ============================================
        // 5. UPDATE DETAIL SURFACE PLATE
        // ============================================
        \Log::info('📊 Updating detail measurements for Surface Plate...');
        
        // Hapus data detail lama
        $deletedDetails = DetailSurfacePlate::where('calibration_id', $calibration->id)->delete();
        \Log::info("🗑️ Deleted {$deletedDetails} old detail records");
        
        $detailData = [
            'calibration_id' => $calibration->id,
        ];
        
        // ============================================
        // 5A. DATA TABEL UTAMA (a1_1 sampai a10_4)
        // ============================================
        for ($row = 1; $row <= 10; $row++) {
            for ($col = 1; $col <= 4; $col++) {
                $key = "a{$row}_{$col}";
                $value = $request->input($key) ?? null;
                $detailData[$key] = $value;
            }
        }
       // ============================================
        // 5B. DATA TABEL REPEATABILITY MATRIX (tbl1 - tbl10)
        // ============================================
        
        // TBL1 (Group A) - a1_1_tbl1 sampai a9_2_tbl1
        for ($i = 1; $i <= 9; $i++) {
            $detailData["a{$i}_1_tbl1"] = $request->input("a{$i}_1_tbl1", null);
            $detailData["a{$i}_2_tbl1"] = $request->input("a{$i}_2_tbl1", null);
        }
        
        // TBL2 - TBL10 (Group B - J)
        $groups = [
            2 => 'b', 3 => 'c', 4 => 'd', 5 => 'e',
            6 => 'f', 7 => 'g', 8 => 'h', 9 => 'i', 10 => 'j'
        ];
        
        foreach ($groups as $tableNum => $letter) {
            // Kolom pertama (a1_1_tblX, a1_2_tblX)
            $detailData["a1_1_tbl{$tableNum}"] = $request->input("a1_1_tbl{$tableNum}", null);
            $detailData["a1_2_tbl{$tableNum}"] = $request->input("a1_2_tbl{$tableNum}", null);
            
            // Kolom 2-9 (b1_1_tbl2, b1_2_tbl2, dst)
            for ($i = 1; $i <= 8; $i++) {
                $detailData["{$letter}{$i}_1_tbl{$tableNum}"] = $request->input("{$letter}{$i}_1_tbl{$tableNum}", null);
                $detailData["{$letter}{$i}_2_tbl{$tableNum}"] = $request->input("{$letter}{$i}_2_tbl{$tableNum}", null);
            }
        }
        
        // ============================================
        // 6. SIMPAN KE DATABASE
        // ============================================
        $detail = DetailSurfacePlate::create($detailData);
        \Log::info('✅ Detail saved, record ID: ' . $detail->id);
        
        // ============================================
        // 7. UPDATE CALIBRATION
        // ============================================
        $updateData = [];
        
        // Update certificate_id di calibration jika ada perubahan
        if ($certificateIdUpdated && !empty($certificateIdBaru)) {
            $updateData['certificate_id'] = $certificateIdBaru;
            \Log::info("📝 Setting certificate_id untuk calibration: {$certificateIdBaru}");
        } elseif ($newCertificateId && !$certificateIdUpdated) {
            $updateData['certificate_id'] = $newCertificateId;
            \Log::info("📝 Setting certificate_id untuk calibration dari parameter: {$newCertificateId}");
        }
        
        // Update nama alat jika berubah
        if ($request->filled('nama_alat_final') && $request->nama_alat_final != $calibration->namaAlat) {
            $updateData['namaAlat'] = $request->nama_alat_final;
        } elseif ($request->filled('nama_alat') && $request->nama_alat != $calibration->namaAlat) {
            $updateData['namaAlat'] = $request->nama_alat;
        }
        
        // Update calibrated_by dan verified_by
        if ($request->filled('calibrated_by')) {
            $updateData['calibrated_by'] = $request->calibrated_by;
        }
        
        if ($request->filled('verified_by')) {
            $updateData['verified_by'] = $request->verified_by;
        }
        
        if (!empty($updateData)) {
            $calibration->update($updateData);
            \Log::info('✅ Calibration updated:', array_keys($updateData));
        }
        
        // ============================================
        // 8. VERIFIKASI FINAL
        // ============================================
        $savedHead = HeadSurfacePlate::where('calibration_id', $calibration->id)->first();
        
        \Log::info('📋 UPDATE SUMMARY (Surface Plate):', [
            'calibration_id' => $calibration->id,
            'certificate_id_calibration' => $calibration->certificate_id,
            'certificate_id_head' => $savedHead->certificate_id ?? null,
            'certificate_id_updated' => $certificateIdUpdated,
            'new_certificate_id' => $certificateIdBaru,
            'head_id' => $head->id,
            'detail_records' => DetailSurfacePlate::where('calibration_id', $calibration->id)->count(),
            'is_new_image_uploaded' => $isNewImageUploaded
        ]);
        
        \Log::info('🎉 updateSurfacePlate COMPLETED');
        return true;
        
    } catch (\Exception $e) {
        \Log::error('💥 ERROR updateSurfacePlate:', [
            'message' => $e->getMessage(),
            'file' => $e->getFile(),
            'line' => $e->getLine(),
            'calibration_id' => $calibration->id ?? 'N/A',
        ]);
        
        throw new \Exception("Gagal mengupdate data Surface Plate: " . $e->getMessage());
    }
}

private function saveCanvasImage($canvasData, $calibrationId)
{
    try {
        \Log::info('💾 Starting saveCanvasImage...');
        
        // ============================================
        // 1. VALIDASI DAN CEK APAKAH GAMBAR VALID (BUKAN KOSONG)
        // ============================================
        if (empty($canvasData) || !is_string($canvasData)) {
            \Log::warning('⚠️ Canvas data is empty or not string');
            return null;
        }
        
        \Log::info('📏 Canvas data length: ' . strlen($canvasData));
        
        // Validasi base64 image
        if (!preg_match('/^data:image\/(png|jpeg|jpg|gif);base64,/', $canvasData)) {
            \Log::warning('⚠️ Not a valid base64 image data');
            return null;
        }
        
        // Decode base64 image
        preg_match('/^data:image\/(\w+);base64,/', $canvasData, $matches);
        $type = strtolower($matches[1]);
        \Log::info('📸 Image type detected: ' . $type);
        
        $data = substr($canvasData, strpos($canvasData, ',') + 1);
        $decodedData = base64_decode($data, true);
        
        if ($decodedData === false) {
            \Log::error('❌ base64_decode failed');
            return null;
        }
        
        \Log::info('✅ Base64 decoded successfully, size: ' . strlen($decodedData) . ' bytes');
        
        // ============================================
        // 2. CEK APAKAH GAMBAR KOSONG (PUTIH SEMUA)
        // ============================================
        // Cek ukuran decoded data - gambar kosong biasanya sangat kecil (< 500 bytes)
        if (strlen($decodedData) < 500) {
            \Log::info('📝 Image too small (' . strlen($decodedData) . ' bytes), likely empty canvas, NOT saving');
            return null;
        }
        
        // ============================================
        // 3. HAPUS GAMBAR LAMA (HANYA JIKA GAMBAR VALID)
        // ============================================
        $pattern = public_path('img_SurfacePlate/surface_plate_' . $calibrationId . '_*.png');
        $oldFiles = glob($pattern);
        
        \Log::info('📁 Mencari gambar lama dengan pattern: ' . $pattern);
        \Log::info('📁 Ditemukan ' . count($oldFiles) . ' file gambar lama');
        
        foreach ($oldFiles as $oldFile) {
            if (file_exists($oldFile)) {
                if (@unlink($oldFile)) {
                    \Log::info('🗑️ Berhasil hapus gambar lama: ' . basename($oldFile));
                } else {
                    \Log::warning('⚠️ Gagal hapus gambar lama: ' . basename($oldFile));
                }
            }
        }
        
        // ============================================
        // 4. SIMPAN GAMBAR BARU
        // ============================================
        $filename = 'surface_plate_' . $calibrationId . '_' . time() . '.' . $type;
        
        $directory = public_path('img_SurfacePlate');
        if (!file_exists($directory)) {
            \Log::info('📁 Creating directory: ' . $directory);
            if (!mkdir($directory, 0755, true)) {
                \Log::error('❌ Failed to create directory: ' . $directory);
                return null;
            }
        }
        
        if (!is_writable($directory)) {
            \Log::error('❌ Directory not writable: ' . $directory);
            return null;
        }
        
        $fullPath = $directory . '/' . $filename;
        $bytesWritten = file_put_contents($fullPath, $decodedData);
        
        if ($bytesWritten === false) {
            \Log::error('❌ Failed to write file to: ' . $fullPath);
            return null;
        }
        
        $webPath = 'img_SurfacePlate/' . $filename;
        
        \Log::info('🎉 Canvas image saved successfully!', [
            'filename' => $filename,
            'web_path' => $webPath,
            'size' => $this->formatBytes($bytesWritten)
        ]);
        
        return $webPath;
        
    } catch (\Exception $e) {
        \Log::error('💥 Error in saveCanvasImage:', [
            'message' => $e->getMessage(),
            'trace' => $e->getTraceAsString()
        ]);
        return null;
    }
}

private function storeAbrationTester($request, $calibration, $certificateId)
{
    try {
        \Log::info('🚀 START storeAbrationTester - Abration Tester Calibration');
        
        // Alat standar
        $alatStandar = $request->alat_standar ?? [];
        $alatStandarString = !empty($alatStandar) ? implode(', ', $alatStandar) : '';
        
        // Simpan ke HEAD
        $head = HeadAbrationTester::create([
            'calibration_id' => $calibration->id,
            'certificate_id' => $certificateId,
            'standard' => $alatStandarString,
            'calibrationMethod' => 'PAS-IK1102-52, PAS-IK1102-45',
            'catatan' => $request->catatan ?? null,
        ]);
        
        // Ambil data dari form (ARRAY untuk 12 baris)
        $titikUkur = $request->titikUkur ?? []; // 10 data
        $nominalRPM = $request->nominalRPM ?? []; // 12 data
        $resolusi = $request->resolusi_alat ?? []; // 12 data
        
        // Data STD (array 12 baris)
        $STD1 = $request->STD1 ?? [];
        $STD2 = $request->STD2 ?? [];
        $STD3 = $request->STD3 ?? [];
        $STD4 = $request->STD4 ?? [];
        $STD5 = $request->STD5 ?? [];
        
        // Data STD terpisah (array 10 baris untuk titik ukur)
        $STDm1 = $request->STDm1 ?? [];
        $STDs1 = $request->STDs1 ?? [];
        $STDms1 = $request->STDms1 ?? [];
        $STDm2 = $request->STDm2 ?? [];
        $STDs2 = $request->STDs2 ?? [];
        $STDms2 = $request->STDms2 ?? [];
        $STDm3 = $request->STDm3 ?? [];
        $STDs3 = $request->STDs3 ?? [];
        $STDms3 = $request->STDms3 ?? [];
        $STDm4 = $request->STDm4 ?? [];
        $STDs4 = $request->STDs4 ?? [];
        $STDms4 = $request->STDms4 ?? [];
        $STDm5 = $request->STDm5 ?? [];
        $STDs5 = $request->STDs5 ?? [];
        $STDms5 = $request->STDms5 ?? [];
        
        // Data UUT (array 10 baris)
        $UUTm1 = $request->UUTm1 ?? [];
        $UUTs1 = $request->UUTs1 ?? [];
        $UUTms1 = $request->UUTms1 ?? [];
        $UUTm2 = $request->UUTm2 ?? [];
        $UUTs2 = $request->UUTs2 ?? [];
        $UUTms2 = $request->UUTms2 ?? [];
        $UUTm3 = $request->UUTm3 ?? [];
        $UUTs3 = $request->UUTs3 ?? [];
        $UUTms3 = $request->UUTms3 ?? [];
        $UUTm4 = $request->UUTm4 ?? [];
        $UUTs4 = $request->UUTs4 ?? [];
        $UUTms4 = $request->UUTms4 ?? [];
