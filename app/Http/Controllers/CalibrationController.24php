        AddPressureTransmitter::class,
        
        // Surface Plate
        HeadSurfacePlate::class,
        DetailSurfacePlate::class,
        
        // Bore Gauge
        HeadBoreGauge::class,
        DetailBoreGauge::class,
        AddBoreGauge::class,
        
        HeadAbrationTester::class,
        DetailAbrationTester::class,
    ];
    
    // Hapus semua data yang memiliki calibration_id = $calibrationId
    $totalDeleted = 0;
    $deletedModels = [];
    
    foreach ($models as $modelClass) {
        try {
            // Cek apakah model class exists
            if (!class_exists($modelClass)) {
                \Log::warning("⚠️ Model class tidak ditemukan: " . $modelClass);
                continue;
            }
            
            $deleted = $modelClass::where('calibration_id', $calibrationId)->delete();
            
            if ($deleted > 0) {
                $totalDeleted += $deleted;
                $deletedModels[] = class_basename($modelClass) . "($deleted)";
                \Log::info("🗑️ Deleted {$deleted} record(s) from " . class_basename($modelClass));
            }
        } catch (\Exception $e) {
            \Log::warning("⚠️ Error deleting from " . class_basename($modelClass) . ": " . $e->getMessage());
            // Lanjutkan ke model berikutnya
        }
    }
    
    \Log::info('✅ Semua data spesifik alat berhasil dihapus', [
        'calibration_id' => $calibrationId,
        'total_records_deleted' => $totalDeleted,
        'models' => $deletedModels
    ]);
}
 
    private function autoCompleteRequiredColumns($data)
    {
        \Log::info('🛠️ START autoCompleteRequiredColumns (SIMPLIFIED)');
         \Log::info('🔍 DATA AWAL:', [
        'form_type' => $data['form_type'] ?? 'TIDAK ADA',
        'namaAlat' => $data['namaAlat'] ?? 'TIDAK ADA'
    ]);
        
        // DEBUG: Log semua data input
        \Log::info('🔍 ALL INPUT DATA:', $data);
        
        // Daftar kolom required yang HARUS ada
        $requiredColumns = [
            'NIK',
            'namaAlat',
            'LK',
            'brandAlat',
            'kodeAlat',
            'typeAlat',
            'kapasitas',
            'resolusi',
            'rangeMin',
            'rangeMax',
            'pemilikAlat',
            'tanggalMasuk',
            'tanggalKalibrasi', // ✅ PASTIKAN INI ADA
            'tempatKalibrasi',
            'jenisPembacaan',
            'lokasiPT',
            'RT_condition1',
            'RT_condition2',
            'RT_condition3',
            'RH_condition1',
            'RH_condition2',
            'RH_condition3',
            'kondisiAlat',
            'keterangan',
            'status',
            'calibratedBy',
            'verifiedBy',
            'NoSeri'
        ];
        
        $completedData = $data;
        
        // Pastikan semua required columns ada
        foreach ($requiredColumns as $column) {
            if (!array_key_exists($column, $completedData) || 
                $completedData[$column] === null || 
                $completedData[$column] === '') {
                
                // Beri default value
                $defaultValue = $this->getSmartDefaultValue($column, $completedData);
                $completedData[$column] = $defaultValue;
                
                \Log::warning("⚠️ Set {$column} to default: {$defaultValue}");
            }
        }
        
        // LOG khusus untuk tanggalKalibrasi
        \Log::info('🔍 tanggalKalibrasi FINAL:', [
            'value' => $completedData['tanggalKalibrasi'],
            'exists' => isset($completedData['tanggalKalibrasi'])
        ]);
        
        \Log::info('🛠️ END autoCompleteRequiredColumns');
          \Log::info('🔍 DATA AKHIR:', [
        'form_type' => $completedData['form_type'] ?? 'TIDAK ADA',
        'namaAlat' => $completedData['namaAlat'] ?? 'TIDAK ADA'
    ]);
    
        return $completedData;
    }
    
    private function getSmartDefaultValue($column, $currentData)
    {
        // Default values berdasarkan nama kolom
        $defaults = [
            'tanggalKalibrasi' => $currentData['tanggalMasuk'] ?? now()->toDateString(),
            'tanggalMasuk' => now()->toDateString(),
            'status' => '-',
            'NIK' => '-',
            'calibratedBy' => auth()->user()->nama ?? '-',
            'verifiedBy' =>'-',
            'kondisiAlat' => 'ok',
            'tempatKalibrasi' => '-',
            'jenisPembacaan' => '-',
            'RT_condition1' => '-',
            'RT_condition2' => '-',
            'RT_condition3' => '-',
            'RH_condition1' => '-',
            'RH_condition2' => '-',
            'RH_condition3' => '-',
            'rangeMin' => '0',
            'rangeMax' => '100',
        ];
        
        return $defaults[$column] ?? '';
    }

